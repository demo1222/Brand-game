diff --git a/src/shared/LootRoll.luau b/src/shared/LootRoll.luau
new file mode 100644
index 0000000..3229c9d
--- /dev/null
+++ b/src/shared/LootRoll.luau
@@ -0,0 +1,124 @@
+-- Pure loot-rolling logic (Master Plan §7). Shared so the client's odds display uses the
+-- exact same table the server rolls from (§16 "displayed odds must match").
+
+local Config = script.Parent.Config
+local Rarities = require(Config.Rarities)
+local Mutations = require(Config.Mutations)
+local Relics = require(Config.Relics)
+local Zones = require(Config.Zones)
+local WeightedRandom = require(script.Parent.WeightedRandom)
+
+local LootRoll = {}
+
+export type Modifiers = {
+	luck: number?, -- multiplies weights of Epic and above
+	pity: number?, -- added to Legendary weight
+	rarityMult: { [string]: number }?, -- event multipliers per rarity
+	mutationMult: number?, -- global mutation-chance multiplier (potions)
+	mutationById: { [string]: number }?, -- per-mutation multipliers (events)
+	mutationAdd: { [string]: number }?, -- flat chance added (event-only mutations)
+}
+
+function LootRoll.RarityTable(zoneIndex: number, mods: Modifiers?)
+	local zone = Zones.List[zoneIndex]
+	local m = mods or {}
+	local luck = m.luck or 1
+	local out = {}
+	for _, name in Rarities.Order do
+		local w = zone.RarityWeights[name] or 0
+		if w > 0 then
+			if Rarities[name].Tier >= Rarities.Epic.Tier then
+				w *= luck
+			end
+			if m.rarityMult and m.rarityMult[name] then
+				w *= m.rarityMult[name]
+			end
+			if name == "Legendary" and m.pity then
+				w += m.pity
+			end
+			table.insert(out, { item = name, weight = w })
+		end
+	end
+	return out
+end
+
+function LootRoll.MutationTable(mods: Modifiers?)
+	local m = mods or {}
+	local mult = m.mutationMult or 1
+	local entries = {}
+	local mutatedTotal = 0
+	for _, def in Mutations.List do
+		local c = def.Chance * mult
+		if m.mutationById and m.mutationById[def.Id] then
+			c *= m.mutationById[def.Id]
+		end
+		if m.mutationAdd and m.mutationAdd[def.Id] then
+			c += m.mutationAdd[def.Id]
+		end
+		if c > 0 then
+			table.insert(entries, { item = def.Id, weight = c })
+			mutatedTotal += c
+		end
+	end
+	-- Cap total mutated chance at 95% so "None" always exists
+	if mutatedTotal > 95 then
+		local scale = 95 / mutatedTotal
+		for _, e in entries do
+			e.weight *= scale
+		end
+		mutatedTotal = 95
+	end
+	table.insert(entries, 1, { item = "None", weight = 100 - mutatedTotal })
+	return entries
+end
+
+function LootRoll.RollMutations(rng: Random, mods: Modifiers?): { string }
+	local tbl = LootRoll.MutationTable(mods)
+	local first = WeightedRandom.pick(tbl, rng)
+	if first == "None" then
+		return {}
+	end
+	local result = { first }
+	if rng:NextNumber() * 100 < Mutations.DoubleChance then
+		local rest = {}
+		for _, e in tbl do
+			if e.item ~= "None" and e.item ~= first then
+				table.insert(rest, e)
+			end
+		end
+		if #rest > 0 then
+			table.insert(result, WeightedRandom.pick(rest, rng))
+		end
+	end
+	return result
+end
+
+-- §7.5 size 0.8–1.5, approximately normal (Box–Muller), "Huge" above 1.35
+function LootRoll.RollSize(rng: Random): number
+	local u1 = math.max(rng:NextNumber(), 1e-9)
+	local u2 = rng:NextNumber()
+	local z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
+	local size = 1.05 + z * 0.12
+	return math.floor(math.clamp(size, 0.8, 1.5) * 100 + 0.5) / 100
+end
+
+function LootRoll.RollRarity(rng: Random, zoneIndex: number, mods: Modifiers?): string
+	return WeightedRandom.pick(LootRoll.RarityTable(zoneIndex, mods), rng)
+end
+
+function LootRoll.RollRelicId(rng: Random, zoneIndex: number, rarity: string): string
+	return WeightedRandom.pick(Relics.PoolFor(zoneIndex, rarity), rng)
+end
+
+-- Full roll: returns a plain table (no uid; InventoryService assigns it)
+function LootRoll.Roll(rng: Random, zoneIndex: number, mods: Modifiers?)
+	local rarity = LootRoll.RollRarity(rng, zoneIndex, mods)
+	return {
+		id = LootRoll.RollRelicId(rng, zoneIndex, rarity),
+		rarity = rarity,
+		mutations = LootRoll.RollMutations(rng, mods),
+		size = LootRoll.RollSize(rng),
+	}
+end
+
+return LootRoll
diff --git a/src/shared/Net.luau b/src/shared/Net.luau
new file mode 100644
index 0000000..1ee20ae
--- /dev/null
+++ b/src/shared/Net.luau
@@ -0,0 +1,117 @@
+-- Remote definitions (Master Plan §20.4).
+-- Remotes are named by intent. The client only ever sends intent + IDs, never values.
+-- Server: Net.Setup() creates the instances. Client: Net.<Name> waits for them.
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+
+local EVENTS = {
+	-- client -> server
+	"ClientReady",
+	"SetBoost",
+	"UseSonar",
+	"UseFlare",
+	"RequestUpgrade",
+	"RequestBuySuit",
+	"RequestSell",
+	"RequestSellCommons",
+	"RequestToggleLock",
+	"RequestPlaceRelic",
+	"RequestPickupRelic",
+	"RequestCollect",
+	"RequestClaimOffline",
+	"RequestFreeRevive",
+	"RequestInstantSurface",
+	"RequestRebirth",
+	"RequestTalent",
+	"RequestClaimQuest",
+	"RequestClaimDaily",
+	"RequestClaimTier",
+	"RequestBuyTidePassPearls",
+	"RequestRedeemCode",
+	"RequestPurchase", -- (kind, key): server validates and prompts
+	"RequestRevenge",
+	"ActivateGate",
+	"RequestCleanBarnacle",
+	"TradeRequest",
+	"TradeRespond",
+	"TradeSetOffer",
+	"TradeConfirm",
+	"TradeCancel",
+	"PartyInvite",
+	"PartyRespond",
+	"PartyLeave",
+	"UpdateSettings",
+	"RenameDock",
+	"OfferShown",
+	-- server -> client
+	"StateUpdated",
+	"Notify",
+	"Announce",
+	"RevealRelic",
+	"PlayerDied",
+	"Revived",
+	"Robbed",
+	"Intruder",
+	"OfflineEarnings",
+	"EventsChanged",
+	"SonarResult",
+	"Knockback",
+	"TradeUpdated",
+	"PartyUpdated",
+	"Offer",
+	"Leaderboards",
+	"CarryChanged",
+}
+
+local UNRELIABLE = {
+	"DiveStatus", -- oxygen/depth/zone at 5 Hz
+	"PredatorHint", -- leviathan proximity for audio/UI
+}
+
+local Net = {}
+local folder: Folder? = nil
+
+function Net.Setup()
+	assert(RunService:IsServer(), "Net.Setup is server-only")
+	local f = Instance.new("Folder")
+	f.Name = "Remotes"
+	for _, name in EVENTS do
+		local r = Instance.new("RemoteEvent")
+		r.Name = name
+		r.Parent = f
+	end
+	for _, name in UNRELIABLE do
+		local r = Instance.new("UnreliableRemoteEvent")
+		r.Name = name
+		r.Parent = f
+	end
+	f.Parent = ReplicatedStorage
+	folder = f
+end
+
+local function getFolder(): Folder
+	if folder then
+		return folder
+	end
+	if RunService:IsServer() then
+		error("Net used before Net.Setup()")
+	end
+	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
+	return folder :: Folder
+end
+
+setmetatable(Net, {
+	__index = function(_, name: string)
+		local f = getFolder()
+		local r = f:FindFirstChild(name)
+		if not r and RunService:IsClient() then
+			r = f:WaitForChild(name, 10)
+		end
+		assert(r, "Unknown remote " .. tostring(name))
+		rawset(Net, name, r)
+		return r
+	end,
+})
+
+return Net
diff --git a/src/shared/NumberFormat.luau b/src/shared/NumberFormat.luau
new file mode 100644
index 0000000..ff3dd06
--- /dev/null
+++ b/src/shared/NumberFormat.luau
@@ -0,0 +1,60 @@
+--!strict
+-- Big-number formatting up to 1e33 (Master Plan §13.4, Appendix B).
+
+local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
+
+local NumberFormat = {}
+
+function NumberFormat.short(n: number): string
+	if n ~= n then
+		return "0"
+	end
+	local sign = if n < 0 then "-" else ""
+	n = math.abs(n)
+	if n < 1000 then
+		return sign .. tostring(math.floor(n))
+	end
+	local i = math.floor(math.log10(n) / 3)
+	i = math.min(i, #SUFFIXES - 1)
+	local v = n / 10 ^ (i * 3)
+	-- Guard against 999.95K rounding to "1000K"
+	if v >= 999.5 and i < #SUFFIXES - 1 then
+		i += 1
+		v = n / 10 ^ (i * 3)
+	end
+	local fmt = if v < 10 then "%.2f%s" elseif v < 100 then "%.1f%s" else "%.0f%s"
+	return sign .. string.format(fmt, v, SUFFIXES[i + 1])
+end
+
+function NumberFormat.commas(n: number): string
+	local s = tostring(math.floor(math.abs(n)))
+	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
+	if out:sub(1, 1) == "," then
+		out = out:sub(2)
+	end
+	return (if n < 0 then "-" else "") .. out
+end
+
+function NumberFormat.time(seconds: number): string
+	seconds = math.max(0, math.floor(seconds))
+	local h = seconds // 3600
+	local m = (seconds % 3600) // 60
+	local s = seconds % 60
+	if h > 0 then
+		return string.format("%dh %02dm", h, m)
+	elseif m > 0 then
+		return string.format("%dm %02ds", m, s)
+	end
+	return string.format("%ds", s)
+end
+
+function NumberFormat.percent(p: number): string
+	if p >= 1 then
+		return string.format("%.1f%%", p)
+	elseif p >= 0.01 then
+		return string.format("%.2f%%", p)
+	end
+	return string.format("%.3f%%", p)
+end
+
+return NumberFormat
diff --git a/src/shared/RateLimiter.luau b/src/shared/RateLimiter.luau
new file mode 100644
index 0000000..2990ceb
--- /dev/null
+++ b/src/shared/RateLimiter.luau
@@ -0,0 +1,30 @@
+-- Token-bucket rate limiter per player (Master Plan §23, Appendix C).
+
+local RateLimiter = {}
+RateLimiter.__index = RateLimiter
+
+function RateLimiter.new(maxTokens: number, refillPerSec: number)
+	return setmetatable({ max = maxTokens, rate = refillPerSec, buckets = {} }, RateLimiter)
+end
+
+function RateLimiter:Check(key: any): boolean
+	local now = os.clock()
+	local b = self.buckets[key]
+	if not b then
+		b = { tokens = self.max, t = now }
+		self.buckets[key] = b
+	end
+	b.tokens = math.min(self.max, b.tokens + (now - b.t) * self.rate)
+	b.t = now
+	if b.tokens >= 1 then
+		b.tokens -= 1
+		return true
+	end
+	return false
+end
+
+function RateLimiter:Remove(key: any)
+	self.buckets[key] = nil
+end
+
+return RateLimiter
diff --git a/src/shared/Signal.luau b/src/shared/Signal.luau
new file mode 100644
index 0000000..85c7c1d
--- /dev/null
+++ b/src/shared/Signal.luau
@@ -0,0 +1,43 @@
+-- Minimal signal implementation (no dependencies).
+
+local Signal = {}
+Signal.__index = Signal
+
+function Signal.new()
+	return setmetatable({ _handlers = {} }, Signal)
+end
+
+function Signal:Connect(fn)
+	local handlers = self._handlers
+	local entry = { fn = fn, connected = true }
+	table.insert(handlers, entry)
+	return {
+		Disconnect = function()
+			entry.connected = false
+			local i = table.find(handlers, entry)
+			if i then
+				table.remove(handlers, i)
+			end
+		end,
+	}
+end
+
+function Signal:Fire(...)
+	for _, entry in table.clone(self._handlers) do
+		if entry.connected then
+			task.spawn(entry.fn, ...)
+		end
+	end
+end
+
+function Signal:Wait()
+	local thread = coroutine.running()
+	local conn
+	conn = self:Connect(function(...)
+		conn.Disconnect()
+		task.spawn(thread, ...)
+	end)
+	return coroutine.yield()
+end
+
+return Signal
