+	{ "R002", "Glass Bottle Message", 1, "Common", 3, "Cylinder", "The ink has run, but one word remains: DEEPER." },
+	{ "R003", "Cracked Snorkel", 1, "Common", 1, "Cylinder", "Someone surfaced in a hurry." },
