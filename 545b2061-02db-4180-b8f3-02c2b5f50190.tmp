diff --git a/tests/harness.luau b/tests/harness.luau
new file mode 100644
index 0000000..3b692d9
--- /dev/null
+++ b/tests/harness.luau
@@ -0,0 +1,155 @@
+-- Lune test harness: loads Roblox-style ModuleScripts from src/ by emulating `script`,
+-- `script.Parent.X` lookups and `require(instance)` on top of the file system, plus minimal
+-- shims for the Roblox globals the pure shared modules use (Color3, Vector3, Random).
+-- Run with:  lune run tests/run
+
+local fs = require("@lune/fs")
+local luau = require("@lune/luau")
+
+local Harness = {}
+
+------------------------------------------------------------------------------------------
+-- Roblox datatype shims (only what the shared modules touch)
+------------------------------------------------------------------------------------------
+local Color3 = {}
+function Color3.fromRGB(r, g, b)
+	return { R = r / 255, G = g / 255, B = b / 255 }
+end
+function Color3.new(r, g, b)
+	return { R = r, G = g, B = b }
+end
+
+local Vector3 = {}
+function Vector3.new(x, y, z)
+	return { X = x or 0, Y = y or 0, Z = z or 0 }
+end
+
+-- Deterministic Random shim (xorshift32) with the Roblox Random API subset
+local Random = {}
+Random.__index = Random
+function Random.new(seed)
+	local s = math.floor(seed or os.clock() * 1e6) % 4294967296
+	if s == 0 then
+		s = 2463534242
+	end
+	return setmetatable({ s = s }, Random)
+end
+function Random:_next()
+	local x = self.s
+	x = bit32.bxor(x, bit32.lshift(x, 13))
+	x = bit32.bxor(x, bit32.rshift(x, 17))
+	x = bit32.bxor(x, bit32.lshift(x, 5))
+	self.s = x
+	return x / 4294967296
+end
+function Random:NextNumber(min, max)
+	local r = self:_next()
+	if min then
+		return min + (max - min) * r
+	end
+	return r
+end
+function Random:NextInteger(min, max)
+	return min + math.floor(self:_next() * (max - min + 1))
+end
+
+Harness.Random = Random
+
+------------------------------------------------------------------------------------------
+-- Fake instance tree over the file system
+------------------------------------------------------------------------------------------
+local cache = {}
+local nodeMeta = {}
+
+local function makeNode(path: string, parent)
+	return setmetatable({ __path = path, __parent = parent }, nodeMeta)
+end
+
+nodeMeta.__index = function(self, key)
+	if key == "Parent" then
+		return rawget(self, "__parent")
+	end
+	local path = rawget(self, "__path")
+	local dir = path:gsub("%.luau$", "")
+	local child = dir .. "/" .. key
+	if fs.isDir(child) then
+		local n = makeNode(child, self)
+		rawset(self, key, n)
+		return n
+	elseif fs.isFile(child .. ".luau") then
+		local n = makeNode(child .. ".luau", self)
+		rawset(self, key, n)
+		return n
+	end
+	error(`No child '{key}' under {path}`)
+end
+
+local function load(node)
+	local path = rawget(node, "__path")
+	if cache[path] ~= nil then
+		return cache[path]
+	end
+	local source = fs.readFile(path)
+	local env = setmetatable({
+		script = node,
+		require = function(target)
+			return load(target)
+		end,
+		Color3 = Color3,
+		Vector3 = Vector3,
+		Random = Random,
+	}, { __index = _G })
+	local fn = luau.load(source, { debugName = path, environment = env })
+	local result = fn()
+	cache[path] = result
+	return result
+end
+
+-- Harness.require("src/shared/LootRoll")
+function Harness.require(relPath: string)
+	local parts = string.split(relPath, "/")
+	local node = makeNode(parts[1], nil)
+	for i = 2, #parts do
+		node = node[parts[i]]
+	end
+	return load(node)
+end
+
+------------------------------------------------------------------------------------------
+-- Tiny test runner
+------------------------------------------------------------------------------------------
+local results = { passed = 0, failed = 0 }
+
+function Harness.test(name: string, fn: () -> ())
+	local ok, err = pcall(fn)
+	if ok then
+		results.passed += 1
+		print("  ✓ " .. name)
+	else
+		results.failed += 1
+		print("  ✗ " .. name .. "\n      " .. tostring(err))
+	end
+end
+
+function Harness.describe(name: string, fn: () -> ())
+	print(name)
+	fn()
+end
+
+function Harness.expect(cond: boolean, msg: string?)
+	if not cond then
+		error(msg or "expectation failed", 2)
+	end
+end
+
+function Harness.near(a: number, b: number, tol: number, msg: string?)
+	if math.abs(a - b) > tol then
+		error(`{msg or "value"}: expected {b} ± {tol}, got {a}`, 2)
+	end
+end
+
+function Harness.results()
+	return results
+end
+
+return Harness
diff --git a/tests/run.luau b/tests/run.luau
new file mode 100644
index 0000000..f577511
--- /dev/null
+++ b/tests/run.luau
@@ -0,0 +1,207 @@
+-- Unit tests for the pure shared modules (Master Plan §30.1). Run from the repo root:
+--   lune run tests/run
+
+local process = require("@lune/process")
+local H = require("./harness")
+local test, describe, expect, near = H.test, H.describe, H.expect, H.near
+
+local WeightedRandom = H.require("src/shared/WeightedRandom")
+local NumberFormat = H.require("src/shared/NumberFormat")
+local LootRoll = H.require("src/shared/LootRoll")
+local Formulas = H.require("src/shared/Formulas")
+local Zones = H.require("src/shared/Config/Zones")
+local Relics = H.require("src/shared/Config/Relics")
+local Rarities = H.require("src/shared/Config/Rarities")
+local Mutations = H.require("src/shared/Config/Mutations")
+local Upgrades = H.require("src/shared/Config/Upgrades")
+local Economy = H.require("src/shared/Config/Economy")
+local Passes = H.require("src/shared/Config/Passes")
+local Products = H.require("src/shared/Config/Products")
+
+describe("WeightedRandom", function()
+	test("100k rolls match configured weights within ±0.5%", function()
+		local entries = { { item = "a", weight = 60 }, { item = "b", weight = 25 }, { item = "c", weight = 10 }, { item = "d", weight = 5 } }
+		local rng = H.Random.new(42)
+		local counts = { a = 0, b = 0, c = 0, d = 0 }
+		local N = 100000
+		for _ = 1, N do
+			local k = WeightedRandom.pick(entries, rng)
+			counts[k] += 1
+		end
+		near(counts.a / N * 100, 60, 0.5, "a")
+		near(counts.b / N * 100, 25, 0.5, "b")
+		near(counts.c / N * 100, 10, 0.5, "c")
+		near(counts.d / N * 100, 5, 0.5, "d")
+	end)
+	test("zero-weight entries are never picked", function()
+		local rng = H.Random.new(7)
+		for _ = 1, 5000 do
+			expect(WeightedRandom.pick({ { item = "x", weight = 0 }, { item = "y", weight = 1 } }, rng) == "y")
+		end
+	end)
+	test("percentages sum to 100", function()
+		local total = 0
+		for _, e in WeightedRandom.percentages(Economy.Crate) do
+			total += e.percent
+		end
+		near(total, 100, 1e-6, "crate odds total")
+	end)
+end)
+
+describe("NumberFormat", function()
+	test("short suffixes", function()
+		expect(NumberFormat.short(0) == "0")
+		expect(NumberFormat.short(999) == "999")
+		expect(NumberFormat.short(1000) == "1.00K", NumberFormat.short(1000))
+		expect(NumberFormat.short(12400) == "12.4K", NumberFormat.short(12400))
+		expect(NumberFormat.short(1.5e6) == "1.50M", NumberFormat.short(1.5e6))
+		expect(NumberFormat.short(999999) == "1.00M", NumberFormat.short(999999))
+		expect(NumberFormat.short(2.5e15) == "2.50Qa", NumberFormat.short(2.5e15))
+	end)
+	test("commas", function()
+		expect(NumberFormat.commas(48210) == "48,210", NumberFormat.commas(48210))
+		expect(NumberFormat.commas(123) == "123")
+		expect(NumberFormat.commas(1234567) == "1,234,567")
+	end)
+	test("time", function()
+		expect(NumberFormat.time(59) == "59s")
+		expect(NumberFormat.time(125) == "2m 05s")
+		expect(NumberFormat.time(3700) == "1h 01m")
+	end)
+end)
+
+describe("Config integrity", function()
+	test("60 relics with unique ids", function()
+		expect(#Relics.List == 60, "relic count " .. #Relics.List)
+		local seen = {}
+		for _, r in Relics.List do
+			expect(not seen[r.Id], "duplicate " .. r.Id)
+			seen[r.Id] = true
+			expect(Rarities[r.Rarity] ~= nil, "bad rarity " .. r.Rarity)
+		end
+	end)
+	test("zone rarity weights sum to 100%", function()
+		for _, z in Zones.List do
+			local total = 0
+			for _, w in z.RarityWeights do
+				total += w
+			end
+			near(total, 100, 1e-6, z.Id)
+		end
+	end)
+	test("every rarity a zone can roll has a relic pool in that zone", function()
+		for _, z in Zones.List do
+			for rarity, w in z.RarityWeights do
+				if w > 0 then
+					local bucket = Relics.ByZoneAndRarity[z.Index]
+					expect(bucket and bucket[rarity] and #bucket[rarity] > 0, `{z.Id} has no {rarity} relics`)
+				end
+			end
+		end
+	end)
+	test("mutation base chances leave room for None", function()
+		local total = 0
+		for _, m in Mutations.List do
+			total += m.Chance
+		end
+		expect(total < 100)
+		near(100 - total, 85, 0.01, "None chance (§7.4)")
+	end)
+	test("every product and pass has a price", function()
+		for key, p in Passes do
+			expect(type(p.price) == "number" and p.price > 0, key)
+		end
+		for key, p in Products do
+			expect(type(p.price) == "number" and p.price > 0, key)
+		end
+	end)
+end)
+
+describe("LootRoll", function()
+	test("rarity distribution in the Reef matches §7.3", function()
+		local rng = H.Random.new(1)
+		local counts = {}
+		local N = 100000
+		for _ = 1, N do
+			local r = LootRoll.RollRarity(rng, 1, nil)
+			counts[r] = (counts[r] or 0) + 1
+		end
+		near((counts.Common or 0) / N * 100, 75, 0.5, "Common")
+		near((counts.Uncommon or 0) / N * 100, 20, 0.5, "Uncommon")
+		expect((counts.Legendary or 0) == 0, "Reef must never roll Legendary")
+	end)
+	test("luck multiplies Epic+ weights only", function()
+		local base = LootRoll.RarityTable(4, nil)
+		local lucky = LootRoll.RarityTable(4, { luck = 2 })
+		for i, e in base do
+			local tier = Rarities[e.item].Tier
+			local expected = if tier >= Rarities.Epic.Tier then e.weight * 2 else e.weight
+			near(lucky[i].weight, expected, 1e-9, e.item)
+		end
+	end)
+	test("pity adds to Legendary weight", function()
+		local t = LootRoll.RarityTable(4, { pity = 5 })
+		for _, e in t do
+			if e.item == "Legendary" then
+				near(e.weight, 6.5 + 5, 1e-9, "Legendary with pity")
+			end
+		end
+	end)
+	test("mutation 'None' is ~85% and sizes stay in 0.8–1.5", function()
+		local rng = H.Random.new(99)
+		local none, N = 0, 50000
+		for _ = 1, N do
+			if #LootRoll.RollMutations(rng, nil) == 0 then
+				none += 1
+			end
+			local s = LootRoll.RollSize(rng)
+			expect(s >= 0.8 and s <= 1.5, "size " .. s)
+		end
+		near(none / N * 100, 85, 0.6, "None")
+	end)
+	test("event-only mutations appear only when added", function()
+		local rng = H.Random.new(5)
+		for _ = 1, 20000 do
+			for _, m in LootRoll.RollMutations(rng, nil) do
+				expect(m ~= "Wet" and m ~= "KrakenTouched", "event mutation without event")
+			end
+		end
+	end)
+end)
+
+describe("Formulas", function()
+	local data = { Upgrades = {}, Talents = {}, Rebirths = 0, Stands = {}, Vault = {} }
+	test("base stats", function()
+		expect(Formulas.MaxOxygen(data, {}) == 60)
+		expect(Formulas.BagSize(data, {}) == 3)
+		expect(Formulas.StandCount(data, {}) == 6)
+	end)
+	test("passes", function()
+		expect(Formulas.MaxOxygen(data, { DoubleOxygen = true }) == 120)
+		expect(Formulas.BagSize(data, { BigBag = true }) == 7)
+		expect(Formulas.StandCount(data, { ExtraSlots = true }) == 10)
+		expect(Formulas.VaultCount(data, { VaultLock = true }) == 2)
+	end)
+	test("upgrade cost curve (§11.1)", function()
+		expect(Upgrades.Cost("Oxygen", 0) == 50)
+		expect(Upgrades.Cost("Oxygen", 1) == math.floor(50 * 1.45))
+		expect(Upgrades.Cost("Bag", 3) == math.floor(200 * 1.8 ^ 3))
+	end)
+	test("rebirth multipliers (§12)", function()
+		expect(Formulas.RebirthMultiplier(0) == 1)
+		expect(Formulas.RebirthMultiplier(3) == 2.5)
+		near(Formulas.RebirthLuck(50), 1.30, 1e-9, "luck cap")
+		expect(Formulas.RebirthRequirement(1) == 15e6)
+	end)
+	test("relic CPS and sell price (§8.2, §13.2)", function()
+		local relic = { id = "R021", size = 1.2, mutations = { "Gilded" } }
+		near(Formulas.RelicCPS(relic), 55 * 1.2 * 2, 1e-9, "CPS")
+		expect(Formulas.SellPrice(relic) == math.floor(55 * 1.2 * 2 * 60))
+	end)
+end)
+
+local r = H.results()
+print(`\n{r.passed} passed, {r.failed} failed`)
+if r.failed > 0 then
+	process.exit(1)
+end
diff --git a/tools/economy_sim.luau b/tools/economy_sim.luau
new file mode 100644
index 0000000..315e175
--- /dev/null
+++ b/tools/economy_sim.luau
@@ -0,0 +1,198 @@
+-- Economy simulation (Master Plan §30.3). Simulates virtual players over 30 days with
+-- different play patterns and prints median time-to-milestone, to compare with §13.3.
+-- Uses the REAL configs and loot tables from src/shared, so tuning a config and re-running
+-- shows the effect immediately.
+--
+--   lune run tools/economy_sim            (defaults: 300 players per profile)
+--   lune run tools/economy_sim 1000
+--
+-- Model (deliberately simple): a dive lasts the oxygen time; the player salvages one relic
+-- every ~9s (faster with Salvage upgrades), dives in the deepest zone their suit allows,
+-- displays the best relics, sells the rest, then greedily buys the cheapest useful upgrade or
+-- the next suit. Offline income is 25% of CPS, capped at 4h (plus upgrades).
+
+local process = require("@lune/process")
+local H = require("../tests/harness")
+
+local LootRoll = H.require("src/shared/LootRoll")
+local Formulas = H.require("src/shared/Formulas")
+local Upgrades = H.require("src/shared/Config/Upgrades")
+
+local PLAYERS = tonumber(process.args[1]) or 300
+local DAYS = 30
+
+local PROFILES = {
+	{ Name = "Casual (20 min/day)", MinutesPerDay = 20, Passes = {} },
+	{ Name = "Core (2 h/day)", MinutesPerDay = 120, Passes = {} },
+	{ Name = "Payer (VIP+2xO2+Drone, 2 h/day)", MinutesPerDay = 120, Passes = { VIP = true, DoubleOxygen = true, Drone = true } },
+}
+
+local MILESTONES = {
+	{ Id = "FirstUpgrade", Label = "First upgrade" },
+	{ Id = "Suit2", Label = "Kelp suit" },
+	{ Id = "Suit3", Label = "Wrecks suit" },
+	{ Id = "Suit4", Label = "Abyss suit" },
+	{ Id = "Rebirth", Label = "First Resurface" },
+	{ Id = "Suit5", Label = "Trench suit" },
+	{ Id = "Mythic", Label = "First Mythic" },
+}
+
+local function simulate(profile, seed: number)
+	local rng = H.Random.new(seed)
+	local data = { Upgrades = {}, Talents = {}, Rebirths = 0, Stands = {}, Vault = {}, Suit = 1 }
+	local displayed = {}
+	local coins, lifetime = 0, 0
+	local playSeconds = 0
+	local reached = {}
+	local coinMult = if profile.Passes.VIP then 1.5 else 1
+
+	local function cps(): number
+		local total = 0
+		for _, r in displayed do
+			total += Formulas.RelicCPS(r)
+		end
+		return total * Formulas.RebirthMultiplier(data.Rebirths) * coinMult
+	end
+	local function earn(amount: number)
+		coins += amount
+		lifetime += amount
+	end
+	local function mark(id: string)
+		if not reached[id] then
+			reached[id] = playSeconds
+		end
+	end
+
+	local function spend()
+		-- next suit first when affordable, else cheapest upgrade among core tracks
+		local nextSuit = Upgrades.Suits[data.Suit + 1]
+		if nextSuit and not nextSuit.ComingSoon and coins >= nextSuit.Cost then
+			coins -= nextSuit.Cost
+			data.Suit += 1
+			mark("Suit" .. data.Suit)
+			return true
+		end
+		local best, bestCost = nil, math.huge
+		for _, id in { "Oxygen", "Bag", "Display", "Fins", "Salvage" } do
+			local lvl = data.Upgrades[id] or 0
+			if lvl < Upgrades.ById[id].Max then
+				local cost = Upgrades.Cost(id, lvl)
+				if cost < bestCost then
+					best, bestCost = id, cost
+				end
+			end
+		end
+		-- save up for the suit when it's within 3 minutes of income
+		if nextSuit and not nextSuit.ComingSoon and nextSuit.Cost - coins < cps() * 180 then
+			return false
+		end
+		if best and coins >= bestCost then
+			coins -= bestCost
+			data.Upgrades[best] = (data.Upgrades[best] or 0) + 1
+			mark("FirstUpgrade")
+			return true
+		end
+		return false
+	end
+
+	local function dive()
+		local oxygen = Formulas.MaxOxygen(data, profile.Passes)
+		local zone = math.min(data.Suit, 5)
+		local perRelic = 9 * (Formulas.SalvageSeconds(data) / Upgrades.Base.SalvageSeconds)
+		local travel = 8 + zone * 6
+		local relicCount = math.clamp(math.floor((oxygen - travel) / perRelic), 1, Formulas.BagSize(data, profile.Passes))
+		if profile.Passes.Drone then
+			relicCount = math.min(relicCount + 1, Formulas.BagSize(data, profile.Passes))
+		end
+		local duration = math.max(oxygen * 0.8, 30) + 20 -- dive + time at the dock
+		for _ = 1, relicCount do
+			local relic = LootRoll.Roll(rng, zone, {})
+			if relic.rarity == "Mythic" or relic.rarity == "Secret" then
+				mark("Mythic")
+			end
+			-- display if better than the weakest stand, else sell
+			local stands = Formulas.StandCount(data, profile.Passes)
+			if #displayed < stands then
+				table.insert(displayed, relic)
+			else
+				table.sort(displayed, function(a, b)
+					return Formulas.RelicCPS(a) < Formulas.RelicCPS(b)
+				end)
+				if Formulas.RelicCPS(relic) > Formulas.RelicCPS(displayed[1]) then
+					earn(Formulas.SellPrice(displayed[1], coinMult))
+					displayed[1] = relic
+				else
+					earn(Formulas.SellPrice(relic, coinMult))
+				end
+			end
+		end
+		earn(cps() * duration)
+		playSeconds += duration
+		while spend() do
+		end
+		-- Resurface as soon as allowed
+		if data.Suit >= 4 and lifetime >= Formulas.RebirthRequirement(data.Rebirths) then
+			data.Rebirths += 1
+			mark("Rebirth")
+			coins = 0
+			data.Upgrades = { Display = data.Upgrades.Display }
+			data.Suit = 1
+		end
+	end
+
+	for _ = 1, DAYS do
+		local sessionEnd = playSeconds + profile.MinutesPerDay * 60
+		while playSeconds < sessionEnd do
+			dive()
+		end
+		-- 22+ hours offline, capped
+		local capH = Formulas.OfflineCapHours(data, profile.Passes, false)
+		earn(cps() * Formulas.OfflineRate(data) * capH * 3600)
+		while spend() do
+		end
+	end
+	return reached
+end
+
+local function median(list)
+	if #list == 0 then
+		return nil
+	end
+	table.sort(list)
+	return list[math.ceil(#list / 2)]
+end
+
+local function fmt(seconds: number?): string
+	if not seconds then
+		return "not reached"
+	end
+	if seconds < 3600 then
+		return string.format("%.0f min", seconds / 60)
+	end
+	return string.format("%.1f h", seconds / 3600)
+end
+
+print(`Abyss Salvage economy simulation · {PLAYERS} players/profile · {DAYS} days\n`)
+for pi, profile in PROFILES do
+	local times = {}
+	local counts = {}
+	for _, m in MILESTONES do
+		times[m.Id] = {}
+		counts[m.Id] = 0
+	end
+	for i = 1, PLAYERS do
+		local reached = simulate(profile, pi * 100000 + i)
+		for _, m in MILESTONES do
+			if reached[m.Id] then
+				table.insert(times[m.Id], reached[m.Id])
+				counts[m.Id] += 1
+			end
+		end
+	end
+	print(profile.Name)
+	for _, m in MILESTONES do
+		print(string.format("  %-16s median %-12s (%d%% reached) — playtime", m.Label, fmt(median(times[m.Id])), math.floor(counts[m.Id] / PLAYERS * 100)))
+	end
+	print("")
+end
+print("Targets (§13.3): first upgrade 2 min · Kelp 12 min · Wrecks 1.5 h · Abyss 6 h · Resurface 10–12 h · Trench 25 h · Mythic 8–15 h")
-- 
2.43.0

