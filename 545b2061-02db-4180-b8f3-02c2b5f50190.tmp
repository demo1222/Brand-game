diff --git a/src/shared/Config/Events.luau b/src/shared/Config/Events.luau
new file mode 100644
index 0000000..4cbcd5c
--- /dev/null
+++ b/src/shared/Config/Events.luau
@@ -0,0 +1,59 @@
+-- Recurring events (Master Plan §26.2)
+-- Schedules are derived from os.time() so every server agrees on what is active.
+-- PeriodSeconds/DurationSeconds: active while (time - Offset) % Period < Duration.
+-- Random events use a deterministic seed per period so all servers roll the same result.
+
+return {
+	List = {
+		{
+			Id = "BloodTide",
+			Name = "Blood Tide",
+			Desc = "Leviathans x2 · Mythic odds x3",
+			PeriodSeconds = 2 * 3600,
+			DurationSeconds = 5 * 60,
+			Offset = 3600,
+			Color = Color3.fromRGB(200, 20, 30),
+			RarityMult = { Mythic = 3 },
+			LeviathanMult = 2,
+		},
+		{
+			Id = "GoldenCurrent",
+			Name = "Golden Current",
+			Desc = "Gilded mutation x5",
+			PeriodSeconds = 3600,
+			DurationSeconds = 3 * 60,
+			Offset = 30 * 60,
+			Color = Color3.fromRGB(255, 200, 40),
+			MutationMult = { Gilded = 5 },
+		},
+		{
+			Id = "BioBloom",
+			Name = "Bioluminescent Bloom",
+			Desc = "Bioluminescent mutation x10",
+			PeriodSeconds = 3600,
+			DurationSeconds = 10 * 60,
+			RandomChance = 0.25, -- 25% of hours, same hours on every server
+			Color = Color3.fromRGB(40, 240, 255),
+			MutationMult = { Bioluminescent = 10 },
+		},
+		{
+			Id = "StormSurge",
+			Name = "Storm Surge",
+			Desc = "Wet mutation active · bonus relic spawns",
+			Weekends = true,
+			Color = Color3.fromRGB(90, 140, 255),
+			MutationAdd = { Wet = 3 },
+			NodeMult = 1.3,
+		},
+		{
+			Id = "TreasureFleet",
+			Name = "Treasure Fleet",
+			Desc = "Epic+ odds x2 in the Midnight Wrecks",
+			PeriodSeconds = 24 * 3600,
+			DurationSeconds = 20 * 60,
+			Offset = 20 * 3600, -- 20:00 UTC daily
+			Color = Color3.fromRGB(150, 110, 60),
+			ZoneRarityMult = { Wrecks = { Epic = 2, Legendary = 2, Mythic = 2 } },
+		},
+	},
+}
diff --git a/src/shared/Config/Mutations.luau b/src/shared/Config/Mutations.luau
new file mode 100644
index 0000000..d5903ba
--- /dev/null
+++ b/src/shared/Config/Mutations.luau
@@ -0,0 +1,48 @@
+-- Mutations (Master Plan §7.4)
+-- Chance is the base probability per relic (percent). Event-only mutations have Chance = 0
+-- and only appear while an event multiplies them (EventService).
+
+local Mutations = {
+	List = {
+		{ Id = "Gilded", Chance = 6, Mult = 2, Color = Color3.fromRGB(255, 200, 60), Material = "Foil" },
+		{ Id = "Barnacled", Chance = 4, Mult = 1.5, Color = Color3.fromRGB(150, 130, 100), Material = "Slate" },
+		{ Id = "Bioluminescent", Chance = 2.5, Mult = 3, Color = Color3.fromRGB(40, 240, 255), Material = "Neon" },
+		{ Id = "Frozen", Chance = 1, Mult = 4, Color = Color3.fromRGB(190, 230, 255), Material = "Ice" },
+		{ Id = "Cursed", Chance = 0.8, Mult = 6, Color = Color3.fromRGB(140, 40, 200), Material = "Neon", Noisy = true },
+		{ Id = "Ancient", Chance = 0.5, Mult = 8, Color = Color3.fromRGB(200, 170, 110), Material = "Sandstone" },
+		{ Id = "Prismatic", Chance = 0.15, Mult = 15, Color = Color3.fromRGB(255, 120, 230), Material = "Glass" },
+		{ Id = "Void", Chance = 0.05, Mult = 30, Color = Color3.fromRGB(10, 0, 20), Material = "ForceField" },
+		{ Id = "Wet", Chance = 0, Mult = 1.5, Color = Color3.fromRGB(90, 160, 255), Material = "Glass", EventOnly = true },
+		{
+			Id = "KrakenTouched",
+			Chance = 0,
+			Mult = 10,
+			Color = Color3.fromRGB(60, 0, 90),
+			Material = "Neon",
+			EventOnly = true,
+		},
+	},
+	ById = {},
+	-- Percent of mutated relics that roll a second, different mutation
+	DoubleChance = 1,
+	-- Barnacled relics can be cleaned (dev product) for a reroll
+}
+
+for _, m in Mutations.List do
+	Mutations.ById[m.Id] = m
+end
+
+function Mutations.MultiplierOf(list: { string }?): number
+	local m = 1
+	if list then
+		for _, id in list do
+			local def = Mutations.ById[id]
+			if def then
+				m *= def.Mult
+			end
+		end
+	end
+	return m
+end
+
+return Mutations
