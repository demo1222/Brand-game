+-- Shared types (Master Plan §21.1)
+
+export type RelicInstance = {
+	uid: string, -- HttpService:GenerateGUID(false)
+	id: string, -- "R041"
+	rarity: string,
+	mutations: { string },
+	size: number,
+	foundAt: number, -- os.time()
+	foundBy: number, -- original finder UserId (provenance for trades)
+	locked: boolean?, -- favourite lock (prevents selling)
+	placedAt: number?, -- os.time() when put on a stand (steal protection)
+}
+
+-- DataStores require string keys for sparse maps, so stands are keyed "1".."34".
+export type ProfileData = {
+	Version: number,
+	Coins: number,
+	Pearls: number,
+	LifetimeCoins: number,
+	Uncollected: number,
+	Level: number,
+	XP: number,
+	Rebirths: number,
+	RebirthTokens: number,
+	Talents: { [string]: number },
+	Upgrades: { [string]: number },
+	Suit: number,
+	Bag: { RelicInstance }, -- carried on the current dive (lost on death)
+	Storage: { RelicInstance }, -- secured at the dock (overflow inventory)
+	Stands: { [string]: RelicInstance },
+	Vault: { [string]: RelicInstance },
+	Codex: { [string]: { [string]: boolean } },
+	Pity: { [string]: number },
+	Flares: number,
+	LastLogout: number,
+	PlayTime: number,
+	LoginStreak: number,
+	LastLoginDay: number,
+	LastDailyClaimDay: number,
+	Quests: any,
+	TidePass: { SeasonId: string, XP: number, Premium: boolean, ClaimedFree: { [string]: boolean }, ClaimedPremium: { [string]: boolean } },
+	PurchaseHistory: { [string]: number },
+	ProductCounts: { [string]: number },
+	ActiveBoosts: { [string]: number },
+	RedeemedCodes: { [string]: boolean },
+	StarterPackShownAt: number?,
+	StarterPackBought: boolean,
+	LastFreeRevive: number,
+	LastSubPearlsDay: number,
+	LastVipChestDay: number,
+	LastPremiumChest: number,
+	DockName: string?,
+	RenameTokens: number,
+	Settings: { Music: number, SFX: number, LowScare: boolean },
+	Stats: {
+		Dives: number,
+		Deaths: number,
+		Steals: number,
+		TimesRobbed: number,
+		DeepestDepth: number,
+		MythicsFound: number,
+		Salvaged: number,
+	},
+	Flags: { [string]: boolean },
+}
+
+return {}
diff --git a/src/shared/WeightedRandom.luau b/src/shared/WeightedRandom.luau
new file mode 100644
index 0000000..5089209
--- /dev/null
+++ b/src/shared/WeightedRandom.luau
@@ -0,0 +1,52 @@
+--!strict
+-- Weighted random pick (Master Plan §20.5). Pure module; unit-tested in tests/.
+
+local WeightedRandom = {}
+
+export type Entry<T> = { item: T, weight: number }
+
+function WeightedRandom.pick<T>(entries: { Entry<T> }, rng: Random): T
+	local total = 0
+	for _, e in entries do
+		if e.weight > 0 then
+			total += e.weight
+		end
+	end
+	local roll = rng:NextNumber() * total
+	for _, e in entries do
+		if e.weight > 0 then
+			roll -= e.weight
+			if roll <= 0 then
+				return e.item
+			end
+		end
+	end
+	return entries[#entries].item
+end
+
+-- Convert a {[name] = weight} map into an ordered entry list using `order` (stable odds display).
+function WeightedRandom.fromMap(map: { [string]: number }, order: { string }): { Entry<string> }
+	local out = {}
+	for _, name in order do
+		local w = map[name]
+		if w and w > 0 then
+			table.insert(out, { item = name, weight = w })
+		end
+	end
+	return out
+end
+
+-- Normalised percentages for odds display (§16: displayed odds must match the roll table).
+function WeightedRandom.percentages<T>(entries: { Entry<T> }): { { item: T, percent: number } }
+	local total = 0
+	for _, e in entries do
+		total += math.max(e.weight, 0)
+	end
+	local out = {}
+	for _, e in entries do
+		table.insert(out, { item = e.item, percent = if total > 0 then math.max(e.weight, 0) / total * 100 else 0 })
+	end
+	return out
+end
+
+return WeightedRandom
