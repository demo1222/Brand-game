diff --git a/src/server/Services/AdminService.luau b/src/server/Services/AdminService.luau
new file mode 100644
index 0000000..4fca42d
--- /dev/null
+++ b/src/server/Services/AdminService.luau
@@ -0,0 +1,222 @@
+-- AdminService (Master Plan §20.6, §23, §26.1): whitelisted chat commands, audit log,
+-- LiveConfig (tune without publishing), Admin Abuse events, and the ban tool.
+--
+-- Chat commands (admins only), prefix "/as":
+--   /as coins <n> | pearls <n> | level <n> | suit <n> | relic <Rarity>
+--   /as pass <Key> | product <Key>            (grant / simulate for testing)
+--   /as event <EventId> [minutes]             (Admin Abuse Hour)
+--   /as luck <mult> <minutes>                 (server luck boost)
+--   /as raids on|off
+--   /as live reload                           (reload LiveConfig on every server)
+--   /as kick <name> | ban <userId> <hours> [reason]
+
+local Players = game:GetService("Players")
+local DataStoreService = game:GetService("DataStoreService")
+local MessagingService = game:GetService("MessagingService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local Economy = require(Shared.Config.Economy)
+
+local LIVE_TOPIC = "AbyssSalvage_Live"
+local AdminService = {}
+local services
+local auditStore, liveStore
+
+function AdminService.Init(s)
+	services = s
+end
+
+function AdminService.IsAdmin(player: Player): boolean
+	if player.UserId == game.CreatorId and game.CreatorType == Enum.CreatorType.User then
+		return true
+	end
+	if table.find(Economy.AdminUserIds, player.UserId) then
+		return true
+	end
+	if game.CreatorType == Enum.CreatorType.Group then
+		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
+		if ok and rank >= 254 then
+			return true
+		end
+	end
+	return false
+end
+
+local function audit(player: Player, command: string)
+	print(`[Admin] {player.Name}: {command}`)
+	if auditStore then
+		task.spawn(function()
+			pcall(auditStore.SetAsync, auditStore, `{os.time()}_{player.UserId}`, { cmd = command, user = player.UserId })
+		end)
+	end
+end
+
+-- Deep-merge LiveConfig overrides into the shared Economy config table
+local function merge(target, source)
+	for k, v in source do
+		if typeof(v) == "table" and typeof(target[k]) == "table" and #v == 0 then
+			merge(target[k], v)
+		else
+			target[k] = v
+		end
+	end
+end
+
+function AdminService.ReloadLiveConfig()
+	if not liveStore then
+		return
+	end
+	local ok, config = pcall(liveStore.GetAsync, liveStore, "LiveConfig")
+	if ok and typeof(config) == "table" then
+		if config.Codes then
+			services.CodesService.SetLiveCodes(config.Codes)
+			config.Codes = nil
+		end
+		merge(Economy, config)
+		print("[Admin] LiveConfig applied")
+	end
+end
+
+local function findPlayer(name: string): Player?
+	name = name:lower()
+	for _, p in Players:GetPlayers() do
+		if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
+			return p
+		end
+	end
+	return nil
+end
+
+local COMMANDS = {}
+
+COMMANDS.coins = function(player, args)
+	local n = tonumber(args[1])
+	if n then
+		services.CurrencyService.AddCoins(player, n, "Admin")
+	end
+end
+COMMANDS.pearls = function(player, args)
+	local n = tonumber(args[1])
+	if n then
+		services.CurrencyService.AddPearls(player, n, "Admin")
+	end
+end
+COMMANDS.level = function(player, args)
+	local data = services.DataService.GetData(player)
+	local n = tonumber(args[1])
+	if data and n then
+		data.Level = math.max(1, math.floor(n))
+		data.XP = 0
+		services.DataService.Replicate(player, "Level", "XP")
+	end
+end
+COMMANDS.suit = function(player, args)
+	local data = services.DataService.GetData(player)
+	local n = tonumber(args[1])
+	if data and n then
+		data.Suit = math.clamp(math.floor(n), 1, 5)
+		services.DataService.Replicate(player, "Suit")
+		services.UpgradeService.PushDerived(player)
+		services.UpgradeService.ApplySuitVisual(player)
+	end
+end
+COMMANDS.relic = function(player, args)
+	services.InventoryService.GrantRandomRelic(player, args[1] or "Rare", "Admin")
+end
+COMMANDS.pass = function(player, args)
+	if args[1] then
+		services.MonetizationService.GrantPassKey(player, args[1])
+	end
+end
+COMMANDS.product = function(player, args)
+	if args[1] then
+		local ok = services.MonetizationService.SimulateProduct(player, args[1])
+		Net.Notify:FireClient(player, `Simulated {args[1]}: {ok}`, "info")
+	end
+end
+COMMANDS.event = function(_, args)
+	local minutes = tonumber(args[2]) or 10
+	services.EventService.StartAdminEvent(args[1] or "", minutes * 60)
+end
+COMMANDS.luck = function(player, args)
+	services.EventService.StartServerBoost("Luck", tonumber(args[1]) or 2, (tonumber(args[2]) or 15) * 60, player)
+	services.AnnouncementService.Server("ADMIN ABUSE: Server luck boost!", "Mythic")
+end
+COMMANDS.raids = function(_, args)
+	Economy.Raid.Enabled = args[1] ~= "off"
+end
+COMMANDS.live = function(_, args)
+	if args[1] == "reload" then
+		AdminService.ReloadLiveConfig()
+		pcall(MessagingService.PublishAsync, MessagingService, LIVE_TOPIC, "reload")
+	end
+end
+COMMANDS.kick = function(_, args)
+	local target = args[1] and findPlayer(args[1])
+	if target then
+		target:Kick("Removed by a moderator.")
+	end
+end
+COMMANDS.ban = function(player, args)
+	local userId = tonumber(args[1])
+	local hours = tonumber(args[2]) or 24
+	if not userId then
+		return
+	end
+	local reason = table.concat(args, " ", 3)
+	local ok, err = pcall(function()
+		Players:BanAsync({
+			UserIds = { userId },
+			Duration = math.floor(hours * 3600),
+			DisplayReason = "Exploiting",
+			PrivateReason = reason ~= "" and reason or ("Banned by " .. player.Name),
+			ExcludeAltAccounts = false,
+			ApplyToUniverse = true,
+		})
+	end)
+	Net.Notify:FireClient(player, if ok then `Banned {userId} for {hours}h` else `Ban failed: {err}`, "info")
+end
+
+local function onChatted(player: Player, message: string)
+	if message:sub(1, 4):lower() ~= "/as " or not AdminService.IsAdmin(player) then
+		return
+	end
+	local args = string.split(message:sub(5), " ")
+	local cmd = table.remove(args, 1)
+	local fn = cmd and COMMANDS[cmd:lower()]
+	if fn then
+		audit(player, message)
+		local ok, err = pcall(fn, player, args)
+		if not ok then
+			Net.Notify:FireClient(player, "Command error: " .. tostring(err), "error")
+		end
+	end
+end
+
+function AdminService.Start()
+	pcall(function()
+		auditStore = DataStoreService:GetDataStore("AbyssSalvage_Audit")
+		liveStore = DataStoreService:GetDataStore("AbyssSalvage_Live")
+	end)
+	task.spawn(AdminService.ReloadLiveConfig)
+	task.spawn(function()
+		pcall(function()
+			MessagingService:SubscribeAsync(LIVE_TOPIC, function()
+				AdminService.ReloadLiveConfig()
+			end)
+		end)
+	end)
+	local function hook(player: Player)
+		player.Chatted:Connect(function(msg)
+			onChatted(player, msg)
+		end)
+	end
+	Players.PlayerAdded:Connect(hook)
+	for _, p in Players:GetPlayers() do
+		hook(p)
+	end
+end
+
+return AdminService
diff --git a/src/server/Services/AnalyticsService.luau b/src/server/Services/AnalyticsService.luau
new file mode 100644
index 0000000..cd89e4f
--- /dev/null
+++ b/src/server/Services/AnalyticsService.luau
@@ -0,0 +1,92 @@
+-- AnalyticsService wrapper (Master Plan §25): funnels, economy events, custom events, and
+-- deterministic A/B buckets. All Roblox calls are pcall-wrapped so analytics can never break
+-- gameplay.
+
+local RobloxAnalytics = game:GetService("AnalyticsService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Economy = require(ReplicatedStorage.Shared.Config.Economy)
+
+local Analytics = {}
+
+local FTUE_STEPS = {
+	"Join",
+	"FirstDive",
+	"FirstSalvage",
+	"FirstRare",
+	"FirstDisplay",
+	"FirstUpgrade",
+	"SecondDive",
+	"KelpSuit",
+	"RaidTutorial",
+	"Session10min",
+}
+local services
+
+function Analytics.Init(s)
+	services = s
+end
+
+-- §25.4 deterministic bucket: hash(UserId) % 100
+function Analytics.Bucket(player: Player, experiment: string): string
+	local variants = Economy.Experiments[experiment]
+	if not variants then
+		return "control"
+	end
+	local h = 0
+	local s = tostring(player.UserId) .. experiment
+	for i = 1, #s do
+		h = (h * 31 + string.byte(s, i)) % 2147483647
+	end
+	return variants[(h % 100) % #variants + 1]
+end
+
+function Analytics.Funnel(player: Player, step: string)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	if data.Flags["F_" .. step] then
+		return
+	end
+	data.Flags["F_" .. step] = true
+	services.DataService.Replicate(player, "Flags")
+	local index = table.find(FTUE_STEPS, step)
+	if index then
+		pcall(function()
+			RobloxAnalytics:LogOnboardingFunnelStepEvent(player, index, step)
+		end)
+	end
+end
+
+function Analytics.Economy(player: Player, flowIn: boolean, currency: string, amount: number, balance: number, txType: string, sku: string)
+	if amount <= 0 then
+		return
+	end
+	pcall(function()
+		RobloxAnalytics:LogEconomyEvent(
+			player,
+			if flowIn then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink,
+			currency,
+			math.floor(amount),
+			math.floor(balance),
+			txType,
+			sku
+		)
+	end)
+end
+
+function Analytics.Custom(player: Player, name: string, value: number?, fields: { [string]: any }?)
+	pcall(function()
+		RobloxAnalytics:LogCustomEvent(player, name, value or 1, fields)
+	end)
+end
+
+function Analytics.LogPurchase(player: Player, kind: string, key: string, robux: number?)
+	Analytics.Custom(player, "Purchase_" .. kind, robux or 0, {
+		[Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = key,
+		[Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = Analytics.Bucket(player, "StarterPackPrice"),
+	})
+end
+
+return Analytics
diff --git a/src/server/Services/AnnouncementService.luau b/src/server/Services/AnnouncementService.luau
new file mode 100644
index 0000000..121cc99
--- /dev/null
+++ b/src/server/Services/AnnouncementService.luau
@@ -0,0 +1,121 @@
+-- AnnouncementService (Master Plan §14): local, server-wide and cross-server announcements,
+-- plus overhead titles ([VIP] tag, level, rebirth tier). Global messages go through
+-- MessagingService, rate-limited to 1 per 10s per server (§21.3).
+
+local Players = game:GetService("Players")
+local MessagingService = game:GetService("MessagingService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+
+local TOPIC = "AbyssSalvage_Global"
+local NEAR_RADIUS = 200
+
+local AnnouncementService = {}
+local services
+local lastGlobal = 0
+
+function AnnouncementService.Init(s)
+	services = s
+end
+
+function AnnouncementService.Server(text: string, rarity: string?)
+	Net.Announce:FireAllClients(text, rarity or "Rare")
+end
+
+function AnnouncementService.Near(source: Player, text: string, rarity: string?)
+	local hrp = source.Character and source.Character:FindFirstChild("HumanoidRootPart")
+	for _, p in Players:GetPlayers() do
+		local other = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
+		if p == source or (hrp and other and (hrp.Position - other.Position).Magnitude < NEAR_RADIUS) then
+			Net.Announce:FireClient(p, text, rarity or "Legendary")
+		end
+	end
+end
+
+function AnnouncementService.Global(text: string, rarity: string?)
+	AnnouncementService.Server(text, rarity)
+	if os.clock() - lastGlobal < 10 then
+		return
+	end
+	lastGlobal = os.clock()
+	task.spawn(function()
+		pcall(function()
+			MessagingService:PublishAsync(TOPIC, { Text = text, Rarity = rarity, JobId = game.JobId })
+		end)
+	end)
+end
+
+-- Overhead title: [VIP] Name · Lv 12 · ✦3
+function AnnouncementService.UpdateTitle(player: Player)
+	local char = player.Character
+	local head = char and char:FindFirstChild("Head")
+	local data = services.DataService.GetData(player)
+	if not head or not data then
+		return
+	end
+	local bb = head:FindFirstChild("Title") :: BillboardGui?
+	if not bb then
+		bb = Instance.new("BillboardGui")
+		bb.Name = "Title"
+		bb.Size = UDim2.fromOffset(220, 46)
+		bb.StudsOffset = Vector3.new(0, 2.6, 0)
+		bb.MaxDistance = 80
+		local label = Instance.new("TextLabel")
+		label.Name = "Label"
+		label.BackgroundTransparency = 1
+		label.Size = UDim2.fromScale(1, 1)
+		label.Font = Enum.Font.GothamBold
+		label.TextScaled = true
+		label.TextStrokeTransparency = 0.3
+		label.Parent = bb
+		bb.Parent = head
+	end
+	local vip = services.MonetizationService.Owns(player, "VIP")
+	local tags = {}
+	if vip then
+		table.insert(tags, "[VIP]")
+	end
+	if services.MonetizationService.HasActiveSubscription(player) then
+		table.insert(tags, "[PASS+]")
+	end
+	local rebirth = if data.Rebirths > 0 then ` · ✦{data.Rebirths}` else ""
+	local label = bb:FindFirstChild("Label") :: TextLabel
+	label.Text = `{table.concat(tags, " ")} {player.DisplayName}\nLv {data.Level}{rebirth}`
+	label.TextColor3 = if vip then Color3.fromRGB(255, 210, 80) else Color3.new(1, 1, 1)
+	local hum = char:FindFirstChildOfClass("Humanoid")
+	if hum then
+		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
+	end
+end
+
+function AnnouncementService.Start()
+	task.spawn(function()
+		local ok, err = pcall(function()
+			MessagingService:SubscribeAsync(TOPIC, function(message)
+				local data = message.Data
+				if typeof(data) == "table" and data.JobId ~= game.JobId and typeof(data.Text) == "string" then
+					Net.Announce:FireAllClients("🌐 " .. data.Text, data.Rarity or "Secret")
+				end
+			end)
+		end)
+		if not ok then
+			warn("[Announcement] MessagingService unavailable: " .. tostring(err))
+		end
+	end)
+	services.DataService.ProfileLoaded:Connect(function(player)
+		player.CharacterAdded:Connect(function(char)
+			char:WaitForChild("Head", 5)
+			AnnouncementService.UpdateTitle(player)
+		end)
+		if player.Character then
+			AnnouncementService.UpdateTitle(player)
+		end
+	end)
+	services.MonetizationService.PassGranted:Connect(function(player)
+		AnnouncementService.UpdateTitle(player)
+	end)
+end
+
+return AnnouncementService
diff --git a/src/server/Services/BoostService.luau b/src/server/Services/BoostService.luau
new file mode 100644
index 0000000..daf18d8
--- /dev/null
+++ b/src/server/Services/BoostService.luau
@@ -0,0 +1,58 @@
+-- BoostService: timed personal boosts stored as expiry timestamps (os.time) in the profile,
+-- so they survive rejoining (Master Plan §15.3 potions, §17 free luck potion).
+
+local BoostService = {}
+local services
+
+function BoostService.Init(s)
+	services = s
+end
+
+function BoostService.Active(player: Player, id: string): boolean
+	local data = services.DataService.GetData(player)
+	return data ~= nil and (data.ActiveBoosts[id] or 0) > os.time()
+end
+
+function BoostService.Remaining(player: Player, id: string): number
+	local data = services.DataService.GetData(player)
+	if not data then
+		return 0
+	end
+	return math.max(0, (data.ActiveBoosts[id] or 0) - os.time())
+end
+
+-- Stacks duration on top of any remaining time.
+function BoostService.Add(player: Player, id: string, seconds: number): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local now = os.time()
+	data.ActiveBoosts[id] = math.max(data.ActiveBoosts[id] or 0, now) + seconds
+	services.DataService.Replicate(player, "ActiveBoosts")
+	return true
+end
+
+function BoostService.Start()
+	-- Clean up expired entries occasionally so the profile doesn't grow
+	task.spawn(function()
+		while true do
+			task.wait(60)
+			local now = os.time()
+			for player, profile in services.DataService.All() do
+				local changed = false
+				for id, t in profile.Data.ActiveBoosts do
+					if t <= now then
+						profile.Data.ActiveBoosts[id] = nil
+						changed = true
+					end
+				end
+				if changed then
+					services.DataService.Replicate(player, "ActiveBoosts")
+				end
+			end
+		end
+	end)
+end
+
+return BoostService
diff --git a/src/server/Services/CodesService.luau b/src/server/Services/CodesService.luau
new file mode 100644
index 0000000..d4f1998
--- /dev/null
+++ b/src/server/Services/CodesService.luau
@@ -0,0 +1,53 @@
+-- CodesService (Master Plan §27.1): redeemable promo codes, once per player.
+-- Codes live in Config/Economy.Codes and can be added live through LiveConfig (AdminService).
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Economy = require(Shared.Config.Economy)
+
+local CodesService = {}
+local services
+local limiter = RateLimiter.new(3, 0.2)
+local liveCodes = {}
+
+function CodesService.Init(s)
+	services = s
+end
+
+function CodesService.SetLiveCodes(codes)
+	liveCodes = if typeof(codes) == "table" then codes else {}
+end
+
+function CodesService.Start()
+	Net.RequestRedeemCode.OnServerEvent:Connect(function(player, code)
+		if not limiter:Check(player) then
+			return Net.Notify:FireClient(player, "Slow down!", "error")
+		end
+		if typeof(code) ~= "string" or #code > 32 then
+			return
+		end
+		code = code:upper():gsub("%s", "")
+		local reward = liveCodes[code] or Economy.Codes[code]
+		local data = services.DataService.GetData(player)
+		if not reward or not data then
+			return Net.Notify:FireClient(player, "Invalid code.", "error")
+		end
+		if data.RedeemedCodes[code] then
+			return Net.Notify:FireClient(player, "Code already redeemed.", "error")
+		end
+		data.RedeemedCodes[code] = true
+		local lines = services.CurrencyService.GrantReward(player, reward, "Code")
+		services.DataService.Replicate(player, "RedeemedCodes")
+		services.AnalyticsService.Custom(player, "CodeRedeemed", 1, { CustomField01 = code })
+		Net.Notify:FireClient(player, `Code redeemed: {table.concat(lines, ", ")}`, "reward")
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return CodesService
diff --git a/src/server/Services/CurrencyService.luau b/src/server/Services/CurrencyService.luau
new file mode 100644
index 0000000..6373594
--- /dev/null
+++ b/src/server/Services/CurrencyService.luau
@@ -0,0 +1,143 @@
+-- CurrencyService (Master Plan §13.1): the single source of truth for Coins and Pearls.
+-- Every add/spend goes through here so analytics and leaderstats stay consistent.
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local NumberFormat = require(ReplicatedStorage.Shared.NumberFormat)
+
+local CurrencyService = {}
+local services
+
+function CurrencyService.Init(s)
+	services = s
+end
+
+local function refreshLeaderstats(player: Player, data)
+	local ls = player:FindFirstChild("leaderstats")
+	if not ls then
+		return
+	end
+	local coins = ls:FindFirstChild("Coins")
+	if coins then
+		coins.Value = NumberFormat.short(data.Coins)
+	end
+	local rebirths = ls:FindFirstChild("Resurfaces")
+	if rebirths then
+		rebirths.Value = data.Rebirths
+	end
+	local deepest = ls:FindFirstChild("Deepest")
+	if deepest then
+		deepest.Value = math.floor(data.Stats.DeepestDepth)
+	end
+end
+CurrencyService.RefreshLeaderstats = refreshLeaderstats
+
+function CurrencyService.AddCoins(player: Player, amount: number, source: string): boolean
+	local data = services.DataService.GetData(player)
+	if not data or amount ~= amount or amount <= 0 or amount == math.huge then
+		return false
+	end
+	amount = math.floor(amount)
+	data.Coins += amount
+	data.LifetimeCoins += amount
+	services.AnalyticsService.Economy(player, true, "Coins", amount, data.Coins, source, source)
+	services.DataService.Replicate(player, "Coins", "LifetimeCoins")
+	refreshLeaderstats(player, data)
+	return true
+end
+
+function CurrencyService.SpendCoins(player: Player, amount: number, sink: string): boolean
+	local data = services.DataService.GetData(player)
+	if not data or amount ~= amount or amount < 0 or data.Coins < amount then
+		return false
+	end
+	data.Coins -= amount
+	services.AnalyticsService.Economy(player, false, "Coins", amount, data.Coins, sink, sink)
+	services.DataService.Replicate(player, "Coins")
+	refreshLeaderstats(player, data)
+	return true
+end
+
+function CurrencyService.AddPearls(player: Player, amount: number, source: string): boolean
+	local data = services.DataService.GetData(player)
+	if not data or amount ~= amount or amount <= 0 then
+		return false
+	end
+	amount = math.floor(amount)
+	data.Pearls += amount
+	services.AnalyticsService.Economy(player, true, "Pearls", amount, data.Pearls, source, source)
+	services.DataService.Replicate(player, "Pearls")
+	return true
+end
+
+function CurrencyService.SpendPearls(player: Player, amount: number, sink: string): boolean
+	local data = services.DataService.GetData(player)
+	if not data or amount ~= amount or amount < 0 or data.Pearls < amount then
+		return false
+	end
+	data.Pearls -= amount
+	services.AnalyticsService.Economy(player, false, "Pearls", amount, data.Pearls, sink, sink)
+	services.DataService.Replicate(player, "Pearls")
+	return true
+end
+
+-- §15.3 Coin packs scale with the player's current income ("X minutes of your income").
+function CurrencyService.GrantIncomeMinutes(player: Player, minutes: number, floor: number?): boolean
+	local cps = services.DockService.GetIncomePerSecond(player)
+	local amount = math.max(cps * minutes * 60, floor or 0)
+	return CurrencyService.AddCoins(player, amount, "CoinPack")
+end
+
+-- Generic reward table: {Coins, Pearls, Boost, Seconds, Relic (rarity), Flares, TidePassXp}
+function CurrencyService.GrantReward(player: Player, reward, source: string): { string }
+	local lines = {}
+	if reward.Coins then
+		CurrencyService.AddCoins(player, reward.Coins, source)
+		table.insert(lines, `+{NumberFormat.short(reward.Coins)} Coins`)
+	end
+	if reward.Pearls then
+		CurrencyService.AddPearls(player, reward.Pearls, source)
+		table.insert(lines, `+{reward.Pearls} Pearls`)
+	end
+	if reward.Boost then
+		services.BoostService.Add(player, reward.Boost, reward.Seconds or 600)
+		table.insert(lines, `{reward.Boost} ({NumberFormat.time(reward.Seconds or 600)})`)
+	end
+	if reward.Flares then
+		local data = services.DataService.GetData(player)
+		if data then
+			data.Flares += reward.Flares
+			services.DataService.Replicate(player, "Flares")
+			table.insert(lines, `+{reward.Flares} Flares`)
+		end
+	end
+	if reward.Relic then
+		local relic = services.InventoryService.GrantRandomRelic(player, reward.Relic, source)
+		if relic then
+			table.insert(lines, `{reward.Relic} relic!`)
+		end
+	end
+	if reward.TidePassXp then
+		services.QuestService.AddSeasonXp(player, reward.TidePassXp)
+	end
+	return lines
+end
+
+function CurrencyService.Start()
+	services.DataService.ProfileLoaded:Connect(function(player, profile)
+		local ls = Instance.new("Folder")
+		ls.Name = "leaderstats"
+		local coins = Instance.new("StringValue")
+		coins.Name = "Coins"
+		coins.Parent = ls
+		local deepest = Instance.new("IntValue")
+		deepest.Name = "Deepest"
+		deepest.Parent = ls
+		local rebirths = Instance.new("IntValue")
+		rebirths.Name = "Resurfaces"
+		rebirths.Parent = ls
+		ls.Parent = player
+		refreshLeaderstats(player, profile.Data)
+	end)
+end
+
+return CurrencyService
diff --git a/src/server/Services/DataService.luau b/src/server/Services/DataService.luau
new file mode 100644
index 0000000..aa739d5
--- /dev/null
+++ b/src/server/Services/DataService.luau
@@ -0,0 +1,464 @@
+-- DataService (Master Plan §21): session-locked profiles on DataStoreService, autosave,
+-- schema migrations, and state replication to the owning client.
+--
+-- Session lock: each record stores {Data, Lock = {JobId, Time}}. A server only loads a
+-- profile whose lock is absent, its own, or stale (> LOCK_STALE seconds without refresh).
+-- Autosave refreshes the lock; release clears it. If another server steals the lock, this
+-- server stops saving and kicks the player so items can never be duplicated (§23).
+--
+-- In Studio without API access the profile runs in memory only (nothing is saved).
+
+local DataStoreService = game:GetService("DataStoreService")
+local Players = game:GetService("Players")
+local RunService = game:GetService("RunService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local Signal = require(Shared.Signal)
+
+local STORE_NAME = "AbyssSalvage_Profiles_v1"
+local LOCK_STALE = 180
+local AUTOSAVE_SECONDS = 90
+local LOAD_ATTEMPTS = 7
+local PURCHASE_HISTORY_MAX = 500
+local CURRENT_VERSION = 2
+
+local DataService = {}
+DataService.ProfileLoaded = Signal.new() -- (player, profile)
+
+local profiles: { [Player]: any } = {}
+local releaseHooks: { (Player, any) -> () } = {}
+local store: DataStore? = nil
+local services
+
+local TEMPLATE = {
+	Version = CURRENT_VERSION,
+	Coins = 0,
+	Pearls = 0,
+	LifetimeCoins = 0,
+	Uncollected = 0,
+	Level = 1,
+	XP = 0,
+	Rebirths = 0,
+	RebirthTokens = 0,
+	Talents = {},
+	Upgrades = {},
+	Suit = 1,
+	Bag = {},
+	Storage = {},
+	Stands = {},
+	Vault = {},
+	Codex = {},
+	Pity = {},
+	Flares = 3,
+	LastLogout = 0,
+	PlayTime = 0,
+	LoginStreak = 0,
+	LastLoginDay = 0,
+	LastDailyClaimDay = 0,
+	Quests = {},
+	TidePass = { SeasonId = "", XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} },
+	PurchaseHistory = {},
+	ProductCounts = {},
+	ActiveBoosts = {},
+	RedeemedCodes = {},
+	TradeLog = {},
+	StarterPackShownAt = 0,
+	StarterPackBought = false,
+	LastFreeRevive = 0,
+	LastSubPearlsDay = 0,
+	LastVipChestDay = 0,
+	LastPremiumChest = 0,
+	DockName = "",
+	RenameTokens = 0,
+	Settings = { Music = 0.6, SFX = 0.8, LowScare = false },
+	Stats = {
+		Dives = 0,
+		Deaths = 0,
+		Steals = 0,
+		TimesRobbed = 0,
+		DeepestDepth = 0,
+		MythicsFound = 0,
+		Salvaged = 0,
+	},
+	Flags = {},
+}
+
+-- Migrations keyed by the version they upgrade FROM (§21.2)
+local MIGRATIONS = {
+	[1] = function(data)
+		-- v1 stored Stands as an array; v2 uses string keys for DataStore safety
+		if data.Stands and data.Stands[1] ~= nil then
+			local map = {}
+			for i, relic in data.Stands do
+				map[tostring(i)] = relic
+			end
+			data.Stands = map
+		end
+	end,
+}
+
+local function deepCopy(t)
+	if type(t) ~= "table" then
+		return t
+	end
+	local out = {}
+	for k, v in t do
+		out[k] = deepCopy(v)
+	end
+	return out
+end
+
+local function reconcile(data, template)
+	for k, v in template do
+		if data[k] == nil then
+			data[k] = deepCopy(v)
+		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
+			reconcile(data[k], v)
+		end
+	end
+end
+
+local function migrate(data)
+	local v = data.Version or 1
+	while v < CURRENT_VERSION do
+		local m = MIGRATIONS[v]
+		if m then
+			m(data)
+		end
+		v += 1
+	end
+	data.Version = CURRENT_VERSION
+end
+
+local function keyFor(userId: number): string
+	return "Player_" .. userId
+end
+
+local function getStore(): DataStore?
+	if store then
+		return store
+	end
+	local ok, result = pcall(function()
+		return DataStoreService:GetDataStore(STORE_NAME)
+	end)
+	if ok then
+		store = result
+	end
+	return store
+end
+
+local function tryLoad(key: string, force: boolean)
+	local ds = getStore()
+	if not ds then
+		return false, nil, "no datastore"
+	end
+	local loadedData, lockedBy
+	local ok, err = pcall(function()
+		ds:UpdateAsync(key, function(record)
+			record = record or {}
+			local lock = record.Lock
+			if
+				not force
+				and lock
+				and lock.JobId ~= game.JobId
+				and os.time() - (lock.Time or 0) < LOCK_STALE
+			then
+				lockedBy = lock
+				return nil -- cancel write
+			end
+			lockedBy = nil
+			record.Lock = { JobId = game.JobId, Time = os.time() }
+			loadedData = record.Data
+			return record
+		end)
+	end)
+	if not ok then
+		return false, nil, err
+	end
+	if lockedBy then
+		return false, nil, "locked"
+	end
+	return true, loadedData, nil
+end
+
+local function writeRecord(profile, release: boolean): boolean
+	if profile.Offline or profile.LockLost then
+		return profile.Offline == true
+	end
+	local ds = getStore()
+	if not ds then
+		return false
+	end
+	local lost = false
+	local ok, err = pcall(function()
+		ds:UpdateAsync(profile.Key, function(record)
+			record = record or {}
+			local lock = record.Lock
+			if lock and lock.JobId ~= game.JobId then
+				lost = true
+				return nil
+			end
+			record.Data = profile.Data
+			record.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
+			return record
+		end)
+	end)
+	if lost then
+		profile.LockLost = true
+		warn(`[DataService] session lock lost for {profile.Key}; refusing to save`)
+		local player = profile.Player
+		if player and player.Parent then
+			player:Kick("Your data was opened in another server. Please rejoin.")
+		end
+		return false
+	end
+	if not ok then
+		warn(`[DataService] save failed for {profile.Key}: {err}`)
+		return false
+	end
+	profile.LastSave = os.clock()
+	return true
+end
+
+local function trimPurchaseHistory(data)
+	local count = 0
+	for _ in data.PurchaseHistory do
+		count += 1
+	end
+	if count <= PURCHASE_HISTORY_MAX then
+		return
+	end
+	local list = {}
+	for id, t in data.PurchaseHistory do
+		table.insert(list, { id = id, t = t })
+	end
+	table.sort(list, function(a, b)
+		return a.t < b.t
+	end)
+	for i = 1, count - PURCHASE_HISTORY_MAX do
+		data.PurchaseHistory[list[i].id] = nil
+	end
+end
+
+local function loadProfile(player: Player)
+	local key = keyFor(player.UserId)
+	local data, offline = nil, false
+	local loaded = false
+	for attempt = 1, LOAD_ATTEMPTS do
+		local ok, result, err = tryLoad(key, attempt == LOAD_ATTEMPTS)
+		if ok then
+			data = result
+			loaded = true
+			break
+		end
+		if err ~= "locked" then
+			-- API not enabled (Studio) or DataStore outage
+			if RunService:IsStudio() then
+				warn(`[DataService] DataStore unavailable in Studio ({err}); using in-memory profile`)
+				offline = true
+				loaded = true
+				break
+			end
+			warn(`[DataService] load attempt {attempt} failed: {err}`)
+		end
+		if not player.Parent then
+			return nil
+		end
+		task.wait(if err == "locked" then 5 else 2)
+	end
+	if not loaded then
+		player:Kick("Could not load your data. Please rejoin in a minute.")
+		return nil
+	end
+	if not player.Parent then
+		-- left while loading: release the lock we just took
+		if not offline then
+			writeRecord({ Key = key, Data = data or deepCopy(TEMPLATE) }, true)
+		end
+		return nil
+	end
+
+	data = data or deepCopy(TEMPLATE)
+	migrate(data)
+	reconcile(data, TEMPLATE)
+
+	local profile = {
+		Player = player,
+		Key = key,
+		Data = data,
+		Offline = offline,
+		LockLost = false,
+		LastSave = os.clock(),
+		JoinedAt = os.time(),
+		IsNew = data.LastLogout == 0,
+	}
+	profiles[player] = profile
+	return profile
+end
+
+local function releaseProfile(player: Player)
+	local profile = profiles[player]
+	if not profile or profile.Releasing then
+		return
+	end
+	profile.Releasing = true
+	for _, hook in releaseHooks do
+		local ok, err = pcall(hook, player, profile)
+		if not ok then
+			warn("[DataService] release hook error: " .. tostring(err))
+		end
+	end
+	profile.Data.LastLogout = os.time()
+	trimPurchaseHistory(profile.Data)
+	writeRecord(profile, true)
+	profiles[player] = nil
+end
+
+function DataService.Init(s)
+	services = s
+end
+
+function DataService.Get(player: Player)
+	return profiles[player]
+end
+
+function DataService.GetData(player: Player)
+	local p = profiles[player]
+	return p and p.Data
+end
+
+function DataService.All()
+	return profiles
+end
+
+-- Register a synchronous hook that runs just before a profile is saved & released.
+function DataService.OnRelease(fn: (Player, any) -> ())
+	table.insert(releaseHooks, fn)
+end
+
+-- Yields. Returns true when the profile is persisted (or when running offline in Studio).
+function DataService.SaveNow(player: Player): boolean
+	local profile = profiles[player]
+	if not profile then
+		return false
+	end
+	trimPurchaseHistory(profile.Data)
+	return writeRecord(profile, false)
+end
+
+-- Send selected top-level keys of the profile to the owning client.
+function DataService.Replicate(player: Player, ...: string)
+	local profile = profiles[player]
+	if not profile then
+		return
+	end
+	local payload = {}
+	for _, key in { ... } do
+		payload[key] = profile.Data[key]
+	end
+	Net.StateUpdated:FireClient(player, payload)
+end
+
+-- Send arbitrary derived values (passes, stats, timers…)
+function DataService.Push(player: Player, payload)
+	if profiles[player] then
+		Net.StateUpdated:FireClient(player, payload)
+	end
+end
+
+function DataService.FullSnapshot(player: Player)
+	local profile = profiles[player]
+	if not profile then
+		return
+	end
+	local payload = table.clone(profile.Data)
+	payload.PurchaseHistory = nil
+	payload.UserId = player.UserId
+	Net.StateUpdated:FireClient(player, payload)
+end
+
+function DataService.Template()
+	return deepCopy(TEMPLATE)
+end
+
+function DataService.Start()
+	local function onAdded(player: Player)
+		local profile = loadProfile(player)
+		if profile then
+			DataService.ProfileLoaded:Fire(player, profile)
+		end
+	end
+	Players.PlayerAdded:Connect(onAdded)
+	for _, p in Players:GetPlayers() do
+		task.spawn(onAdded, p)
+	end
+	Players.PlayerRemoving:Connect(releaseProfile)
+
+	Net.ClientReady.OnServerEvent:Connect(function(player)
+		-- Client UI is up: send the full snapshot (profile may still be loading)
+		for _ = 1, 60 do
+			if profiles[player] then
+				break
+			end
+			task.wait(0.5)
+		end
+		DataService.FullSnapshot(player)
+		if services.MonetizationService then
+			services.MonetizationService.PushOwnership(player)
+		end
+		if services.UpgradeService then
+			services.UpgradeService.PushDerived(player)
+		end
+	end)
+
+	Net.UpdateSettings.OnServerEvent:Connect(function(player, settings)
+		local profile = profiles[player]
+		if not profile or typeof(settings) ~= "table" then
+			return
+		end
+		local s = profile.Data.Settings
+		if typeof(settings.Music) == "number" then
+			s.Music = math.clamp(settings.Music, 0, 1)
+		end
+		if typeof(settings.SFX) == "number" then
+			s.SFX = math.clamp(settings.SFX, 0, 1)
+		end
+		if typeof(settings.LowScare) == "boolean" then
+			s.LowScare = settings.LowScare
+		end
+		DataService.Replicate(player, "Settings")
+	end)
+
+	-- Autosave loop + playtime tracking
+	task.spawn(function()
+		while true do
+			task.wait(10)
+			for player, profile in profiles do
+				profile.Data.PlayTime += 10
+				if os.clock() - profile.LastSave >= AUTOSAVE_SECONDS then
+					task.spawn(writeRecord, profile, false)
+				end
+			end
+		end
+	end)
+
+	game:BindToClose(function()
+		local threads = {}
+		for player in profiles do
+			table.insert(
+				threads,
+				task.spawn(function()
+					releaseProfile(player)
+				end)
+			)
+		end
+		local deadline = os.clock() + 25
+		while next(profiles) and os.clock() < deadline do
+			task.wait(0.5)
+		end
+	end)
+end
+
+return DataService
diff --git a/src/server/Services/DiveService.luau b/src/server/Services/DiveService.luau
new file mode 100644
index 0000000..dbd29fd
--- /dev/null
+++ b/src/server/Services/DiveService.luau
@@ -0,0 +1,483 @@
+-- DiveService (Master Plan §5.2, §6, §10.3): oxygen, depth, zone detection, pressure damage,
+-- air pockets, escapes (bag secured at your dock), death, revive in place, bag drops.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Zones = require(Shared.Config.Zones)
+local World = require(Shared.Config.World)
+local Economy = require(Shared.Config.Economy)
+local Build = require(script.Parent.Parent.Util.Build)
+
+local TICK = 0.1
+local REVIVE_WINDOW = 10
+local BAG_DROP_SECONDS = 90
+local AIR_POCKET_COOLDOWN = 45
+
+local DiveService = {}
+local services
+local state: { [Player]: any } = {}
+local pendingDeath: { [Player]: any } = {}
+local reviveSpawn: { [Player]: Vector3 } = {}
+local limiter = RateLimiter.new(10, 5)
+
+function DiveService.Init(s)
+	services = s
+end
+
+local function newState()
+	return {
+		oxygen = 60,
+		maxOxygen = 60,
+		boosting = false,
+		diving = false,
+		deepest = 0,
+		zone = 0,
+		instantUsed = false,
+		lowWarned = false,
+		lastCause = "Unknown",
+		pockets = {},
+		lastDepth = 0,
+	}
+end
+
+function DiveService.GetState(player: Player)
+	return state[player]
+end
+
+function DiveService.IsDiving(player: Player): boolean
+	local s = state[player]
+	return s ~= nil and s.diving
+end
+
+function DiveService.SetCause(player: Player, cause: string)
+	local s = state[player]
+	if s then
+		s.lastCause = cause
+	end
+end
+
+function DiveService.RefillOxygen(player: Player): boolean
+	local s = state[player]
+	if not s then
+		return false
+	end
+	s.oxygen = s.maxOxygen
+	s.lowWarned = false
+	return true
+end
+
+function DiveService.AddOxygen(player: Player, seconds: number)
+	local s = state[player]
+	if s then
+		s.oxygen = math.clamp(s.oxygen + seconds, 0, s.maxOxygen)
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Dive start / escape
+------------------------------------------------------------------------------------------
+local function startDive(player: Player, s)
+	s.diving = true
+	s.deepest = 0
+	s.instantUsed = false
+	s.lowWarned = false
+	local data = services.DataService.GetData(player)
+	data.Stats.Dives += 1
+	services.DataService.Replicate(player, "Stats")
+	services.AnalyticsService.Funnel(player, "FirstDive")
+	if data.Stats.Dives >= 2 then
+		services.AnalyticsService.Funnel(player, "SecondDive")
+	end
+	if data.Stats.Dives == 10 and not services.MonetizationService.Owns(player, "Drone") then
+		Net.Offer:FireClient(player, "Drone")
+	end
+	services.PredatorService.ClearHunted(player)
+end
+
+local function escape(player: Player, s)
+	s.diving = false
+	local data = services.DataService.GetData(player)
+	local secured = services.InventoryService.SecureBag(player)
+	if s.deepest > 5 then
+		services.QuestService.Progress(player, "Escape", 1)
+		services.QuestService.AddXp(player, Economy.Xp.Escape)
+		if services.PredatorService.WasHunted(player) then
+			services.QuestService.Progress(player, "LeviathanEscape", 1)
+			services.AnalyticsService.Custom(player, "LeviathanEscape", 1)
+			Net.Notify:FireClient(player, "You escaped the Leviathan!", "reward")
+		end
+	end
+	if secured > 0 then
+		Net.Notify:FireClient(player, `Secured {secured} relic{secured == 1 and "" or "s"} at your dock. Display them on stands!`, "reward")
+	end
+	if s.deepest > data.Stats.DeepestDepth then
+		data.Stats.DeepestDepth = math.floor(s.deepest)
+		services.DataService.Replicate(player, "Stats")
+		services.CurrencyService.RefreshLeaderstats(player, data)
+	end
+	s.oxygen = s.maxOxygen
+end
+
+------------------------------------------------------------------------------------------
+-- Death, revive, bag drop
+------------------------------------------------------------------------------------------
+local function bagValue(bag): number
+	local v = 0
+	for _, r in bag do
+		v += Formulas.SellPrice(r)
+	end
+	return v
+end
+
+local function createBagDrop(position: Vector3, relics, ownerName: string)
+	if #relics == 0 then
+		return
+	end
+	local root = services.WorldService.Root():FindFirstChild("Drops")
+	local part = Build.Part({
+		Name = "LostBag",
+		Size = Vector3.new(3, 3, 3),
+		CFrame = CFrame.new(position),
+		Color = Color3.fromRGB(200, 160, 60),
+		Material = Enum.Material.Fabric,
+		CanCollide = false,
+		Parent = root,
+	})
+	Build.Instance("PointLight", { Range = 20, Brightness = 3, Color = Color3.fromRGB(255, 200, 80), Parent = part })
+	Build.Billboard(part, `{ownerName}'s lost bag ({#relics})`, UDim2.fromOffset(200, 40), Vector3.new(0, 3, 0), Color3.fromRGB(255, 220, 120))
+	local prompt = Build.Prompt(part, "Loot bag", `{#relics} relics`, 1, "Loot")
+	prompt.Triggered:Connect(function(player)
+		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+		if not hrp or (hrp.Position - part.Position).Magnitude > 16 then
+			return
+		end
+		local taken = 0
+		while #relics > 0 and not services.InventoryService.BagFull(player) do
+			local relic = table.remove(relics, 1)
+			services.InventoryService.AddToBag(player, relic)
+			taken += 1
+		end
+		if taken > 0 then
+			Net.Notify:FireClient(player, `Looted {taken} relic{taken == 1 and "" or "s"}!`, "reward")
+		elseif #relics > 0 then
+			Net.Notify:FireClient(player, "Your bag is full.", "error")
+		end
+		if #relics == 0 then
+			part:Destroy()
+		else
+			prompt.ObjectText = `{#relics} relics`
+		end
+	end)
+	task.delay(BAG_DROP_SECONDS, function()
+		if part.Parent then
+			part:Destroy()
+		end
+	end)
+end
+
+local function onDied(player: Player, character: Model)
+	local s = state[player]
+	local data = services.DataService.GetData(player)
+	if not s or not data then
+		return
+	end
+	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
+	local position = if hrp then hrp.Position else Vector3.zero
+	local depth = World.WaterSurfaceY - position.Y
+	local zone = Zones.ForDepth(depth)
+	data.Stats.Deaths += 1
+	services.DataService.Replicate(player, "Stats")
+	services.AnalyticsService.Custom(player, "Death", 1, { CustomField01 = s.lastCause, CustomField02 = zone and zone.Id or "Surface" })
+	services.RaidService.OnCarrierDied(player)
+
+	local bag = data.Bag
+	data.Bag = {}
+	-- Insurance (Vault Lock): keep the single most valuable relic (§10.3)
+	local kept = nil
+	if #bag > 0 and services.MonetizationService.Owns(player, "VaultLock") then
+		table.sort(bag, function(a, b)
+			return Formulas.RelicCPS(a) > Formulas.RelicCPS(b)
+		end)
+		kept = table.remove(bag, 1)
+		services.InventoryService.AddToStorage(player, kept)
+	end
+	services.DataService.Replicate(player, "Bag")
+
+	local subscribed = services.MonetizationService.HasActiveSubscription(player)
+	local freeRevive = subscribed and (data.LastFreeRevive // 86400) ~= (os.time() // 86400)
+	local pending = {
+		bag = bag,
+		position = position,
+		expires = os.clock() + REVIVE_WINDOW,
+		revived = false,
+	}
+	pendingDeath[player] = pending
+	s.diving = false
+	Net.PlayerDied:FireClient(player, {
+		BagCount = #bag,
+		BagValue = bagValue(bag),
+		Kept = kept and kept.id or nil,
+		Timer = REVIVE_WINDOW,
+		FreeRevive = freeRevive,
+		Cause = s.lastCause,
+		Underwater = depth > 2,
+	})
+	if zone and zone.Index >= 3 and not services.MonetizationService.Owns(player, "InstantSurface") then
+		data.Flags.DeepDeaths = (data.Flags.DeepDeaths or 0) + 1
+		if data.Flags.DeepDeaths == 1 or data.Flags.DeepDeaths == 2 then
+			task.delay(REVIVE_WINDOW + 1, function()
+				Net.Offer:FireClient(player, "InstantSurface")
+			end)
+		end
+	end
+	task.delay(REVIVE_WINDOW, function()
+		if pendingDeath[player] == pending and not pending.revived then
+			pendingDeath[player] = nil
+			createBagDrop(position, pending.bag, player.DisplayName)
+		end
+	end)
+end
+
+function DiveService.CanRevive(player: Player): boolean
+	local p = pendingDeath[player]
+	return p ~= nil and not p.revived and os.clock() < p.expires + 3 -- grace for purchase latency
+end
+
+function DiveService.ReviveInPlace(player: Player): boolean
+	local p = pendingDeath[player]
+	if not p or p.revived then
+		return false
+	end
+	p.revived = true
+	pendingDeath[player] = nil
+	local data = services.DataService.GetData(player)
+	for _, relic in p.bag do
+		table.insert(data.Bag, relic)
+	end
+	services.DataService.Replicate(player, "Bag")
+	reviveSpawn[player] = p.position
+	local char = player.Character
+	local hum = char and char:FindFirstChildOfClass("Humanoid")
+	if hum and hum.Health > 0 then
+		-- Already respawned at the dock: send them back down
+		DiveService.ConsumeReviveSpawn(player, char)
+	else
+		player:LoadCharacter()
+	end
+	Net.Revived:FireClient(player)
+	return true
+end
+
+-- Called by DockService on CharacterAdded; returns true if it handled positioning.
+function DiveService.ConsumeReviveSpawn(player: Player, character: Model): boolean
+	local pos = reviveSpawn[player]
+	if not pos then
+		return false
+	end
+	reviveSpawn[player] = nil
+	task.defer(function()
+		local hrp = character:WaitForChild("HumanoidRootPart", 5)
+		if hrp then
+			services.SecurityService.AllowTeleport(player)
+			character:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
+			local s = state[player]
+			if s then
+				s.oxygen = s.maxOxygen
+				s.diving = true
+			end
+			-- brief invulnerability against the Leviathan
+			character:SetAttribute("SpawnShield", os.clock() + 4)
+		end
+	end)
+	return true
+end
+
+------------------------------------------------------------------------------------------
+-- Tick
+------------------------------------------------------------------------------------------
+local function tickPlayer(player: Player, s, dt: number, sendStatus: boolean)
+	local char = player.Character
+	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+	local hum = char and char:FindFirstChildOfClass("Humanoid")
+	local data = services.DataService.GetData(player)
+	if not hrp or not hum or hum.Health <= 0 or not data then
+		return
+	end
+	s.maxOxygen = Formulas.MaxOxygen(data, services.MonetizationService.OwnedSet(player))
+	local depth = World.WaterSurfaceY - hrp.Position.Y
+	s.lastDepth = depth
+	local underwater = depth > 1.5
+	local zone = Zones.ForDepth(depth)
+
+	if underwater and zone then
+		if not s.diving then
+			startDive(player, s)
+		end
+		s.deepest = math.max(s.deepest, depth)
+		if zone.Index ~= s.zone then
+			s.zone = zone.Index
+			if zone.Index >= 3 then
+				services.QuestService.Progress(player, "ReachZone3", 1)
+			end
+		end
+		local drain = zone.OxygenDrain * (if s.boosting then 2 else 1)
+		s.oxygen = math.max(0, s.oxygen - drain * dt)
+		if s.oxygen <= 0 then
+			s.lastCause = "Oxygen"
+			hum:TakeDamage(hum.MaxHealth * 0.2 * dt)
+			if not data.Flags.OxygenOfferShown and not services.MonetizationService.Owns(player, "DoubleOxygen") then
+				data.Flags.OxygenOfferShown = true
+				Net.Offer:FireClient(player, "DoubleOxygen")
+			end
+		end
+		if data.Suit < zone.SuitIndex then
+			s.lastCause = "Pressure"
+			hum:TakeDamage(hum.MaxHealth * Zones.PressureDamagePerSec * dt)
+		end
+		-- Air pockets
+		for _, pocket in services.WorldService.GetAirPockets() do
+			if (pocket.Position - hrp.Position).Magnitude < 8 then
+				local last = s.pockets[pocket] or 0
+				if os.clock() - last > AIR_POCKET_COOLDOWN then
+					s.pockets[pocket] = os.clock()
+					DiveService.AddOxygen(player, s.maxOxygen * 0.5)
+					Net.Notify:FireClient(player, "Air pocket! +50% oxygen", "info")
+				end
+			end
+		end
+	else
+		s.oxygen = math.min(s.maxOxygen, s.oxygen + s.maxOxygen * 0.35 * dt)
+		s.zone = 0
+		if s.diving then
+			local dock = services.DockService.GetDock(player)
+			if dock and services.WorldService.IsInsideDock(dock, hrp.Position) then
+				escape(player, s)
+			elseif depth < -1 then
+				-- Climbed out somewhere else (plaza, another dock): still counts as surfaced
+				-- but the bag is only secured at your own dock.
+				if #data.Bag == 0 then
+					escape(player, s)
+				end
+			end
+		elseif #data.Bag > 0 then
+			local dock = services.DockService.GetDock(player)
+			if dock and services.WorldService.IsInsideDock(dock, hrp.Position) then
+				escape(player, s)
+			end
+		end
+	end
+
+	if sendStatus then
+		Net.DiveStatus:FireClient(player, {
+			O2 = s.oxygen,
+			Max = s.maxOxygen,
+			Depth = depth,
+			Zone = if underwater and zone then zone.Index else 0,
+			Pressure = underwater and zone ~= nil and data.Suit < zone.SuitIndex,
+			Diving = s.diving,
+		})
+	end
+end
+
+function DiveService.Start()
+	services.DataService.ProfileLoaded:Connect(function(player)
+		state[player] = newState()
+		local function onChar(char: Model)
+			local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
+			if hum then
+				hum.Died:Connect(function()
+					onDied(player, char)
+				end)
+			end
+		end
+		player.CharacterAdded:Connect(onChar)
+		if player.Character then
+			task.spawn(onChar, player.Character)
+		end
+	end)
+	services.DataService.OnRelease(function(player)
+		local p = pendingDeath[player]
+		if p and not p.revived then
+			createBagDrop(p.position, p.bag, player.DisplayName)
+		end
+		pendingDeath[player] = nil
+		reviveSpawn[player] = nil
+		state[player] = nil
+	end)
+
+	Net.SetBoost.OnServerEvent:Connect(function(player, on)
+		local s = state[player]
+		if s and limiter:Check(player) then
+			s.boosting = on == true
+			if s.boosting then
+				services.PredatorService.AddNoise(player, 4)
+			end
+		end
+	end)
+
+	Net.RequestFreeRevive.OnServerEvent:Connect(function(player)
+		local data = services.DataService.GetData(player)
+		if not data or not services.MonetizationService.HasActiveSubscription(player) then
+			return
+		end
+		if (data.LastFreeRevive // 86400) == (os.time() // 86400) then
+			return
+		end
+		if DiveService.ReviveInPlace(player) then
+			data.LastFreeRevive = os.time()
+			Net.Notify:FireClient(player, "Free Pass+ revive used", "info")
+		end
+	end)
+
+	Net.RequestInstantSurface.OnServerEvent:Connect(function(player)
+		local s = state[player]
+		local dock = services.DockService.GetDock(player)
+		if not s or not dock or not limiter:Check(player) then
+			return
+		end
+		if not services.MonetizationService.Owns(player, "InstantSurface") then
+			Net.Offer:FireClient(player, "InstantSurface")
+			return
+		end
+		if not s.diving or s.instantUsed then
+			Net.Notify:FireClient(player, "Instant Resurface works once per dive.", "error")
+			return
+		end
+		if services.RaidService.IsCarrying(player) then
+			Net.Notify:FireClient(player, "Can't teleport while carrying a stolen relic!", "error")
+			return
+		end
+		s.instantUsed = true
+		local char = player.Character
+		if char then
+			services.SecurityService.AllowTeleport(player)
+			char:PivotTo(dock.SpawnCFrame)
+		end
+	end)
+
+	task.spawn(function()
+		local n = 0
+		while true do
+			local dt = task.wait(TICK)
+			n += 1
+			local send = n % 2 == 0
+			for player, s in state do
+				local ok, err = pcall(tickPlayer, player, s, dt, send)
+				if not ok then
+					warn("[DiveService] tick error: " .. tostring(err))
+				end
+			end
+		end
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return DiveService
diff --git a/src/server/Services/DockService.luau b/src/server/Services/DockService.luau
new file mode 100644
index 0000000..2eaad43
--- /dev/null
+++ b/src/server/Services/DockService.luau
@@ -0,0 +1,626 @@
+-- DockService (Master Plan §8): plot assignment, display stands, vault, Coins/sec income,
+-- collector pad, offline earnings, laser gate, guard crab and alarm.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Relics = require(Shared.Config.Relics)
+local Rarities = require(Shared.Config.Rarities)
+local Mutations = require(Shared.Config.Mutations)
+local Upgrades = require(Shared.Config.Upgrades)
+local Economy = require(Shared.Config.Economy)
+local Build = require(script.Parent.Parent.Util.Build)
+
+local DockService = {}
+local services
+local limiter = RateLimiter.new(8, 3)
+local dockOf: { [Player]: any } = {}
+local pendingOffline: { [Player]: number } = {}
+local gateState: { [Player]: { activeUntil: number, readyAt: number } } = {}
+local alarmSeen: { [string]: number } = {}
+local autoCollectBuffer: { [Player]: number } = {}
+local joinedAt: { [Player]: number } = {}
+
+function DockService.Init(s)
+	services = s
+end
+
+function DockService.GetDock(player: Player)
+	return dockOf[player]
+end
+
+function DockService.GetOwnerOfDock(dock): Player?
+	return dock and dock.Owner
+end
+
+function DockService.JoinedAt(player: Player): number
+	return joinedAt[player] or 0
+end
+
+-- §8.2 / §14 / §15 Coins multiplier stack
+function DockService.GetCoinMultiplier(player: Player): number
+	local data = services.DataService.GetData(player)
+	if not data then
+		return 1
+	end
+	local m = Formulas.RebirthMultiplier(data.Rebirths)
+	m *= services.MonetizationService.GetCoinMultiplier(player)
+	m *= services.SocialService.GetCoinMultiplier(player)
+	m *= services.EventService.GetCoinMultiplier()
+	return m
+end
+
+function DockService.GetBaseCPS(player: Player): number
+	local data = services.DataService.GetData(player)
+	if not data then
+		return 0
+	end
+	local total = 0
+	for _, relic in data.Stands do
+		total += Formulas.RelicCPS(relic)
+	end
+	for _, relic in data.Vault do
+		total += Formulas.RelicCPS(relic)
+	end
+	return total
+end
+
+function DockService.GetIncomePerSecond(player: Player): number
+	return DockService.GetBaseCPS(player) * DockService.GetCoinMultiplier(player)
+end
+
+------------------------------------------------------------------------------------------
+-- Rendering
+------------------------------------------------------------------------------------------
+local function clearModel(stand: BasePart)
+	local m = stand:FindFirstChild("RelicModel")
+	if m then
+		m:Destroy()
+	end
+end
+
+local function renderStand(stand: BasePart, relic, visible: boolean, mult: number, isVault: boolean)
+	clearModel(stand)
+	stand:SetAttribute("Visible", visible)
+	stand:SetAttribute("HasRelic", visible and relic ~= nil)
+	stand.Transparency = if visible then 0 else 1
+	stand.CanCollide = visible
+	local place = stand:FindFirstChild("Place") :: ProximityPrompt
+	local steal = stand:FindFirstChild("Steal") :: ProximityPrompt?
+	local info = stand:FindFirstChild("Info") :: BillboardGui
+	place.Enabled = visible
+	if steal then
+		steal.Enabled = visible and relic ~= nil
+	end
+	if not visible then
+		info.Label.Text = ""
+		return
+	end
+	if relic then
+		local def = Relics.ById[relic.id]
+		local model = Build.RelicModel(def, Rarities[relic.rarity].Color, relic.mutations, Mutations.ById, relic.size)
+		model.Name = "RelicModel"
+		model.CFrame = CFrame.new(stand.Position + Vector3.new(0, 2.8, 0))
+		model.Parent = stand
+		local mut = if #relic.mutations > 0 then table.concat(relic.mutations, " ") .. " " else ""
+		info.Label.Text = `{mut}{def.Name}\n+{NumberFormat.short(Formulas.RelicCPS(relic) * mult)}/s`
+		info.Label.TextColor3 = Rarities[relic.rarity].Color
+		place.ActionText = "Take back"
+		place.ObjectText = def.Name
+		if steal then
+			steal.ObjectText = `{mut}{def.Name}`
+		end
+	else
+		info.Label.Text = if isVault then "VAULT (safe)" else "Empty"
+		info.Label.TextColor3 = Color3.new(1, 1, 1)
+		place.ActionText = if isVault then "Vault" else "Display"
+		place.ObjectText = if isVault then "Unstealable slot" else "Empty stand"
+	end
+end
+
+function DockService.RefreshDock(player: Player)
+	local dock = dockOf[player]
+	local data = services.DataService.GetData(player)
+	if not dock or not data then
+		return
+	end
+	local passes = services.MonetizationService.OwnedSet(player)
+	local standCount = Formulas.StandCount(data, passes)
+	local vaultCount = Formulas.VaultCount(data, passes)
+	local mult = DockService.GetCoinMultiplier(player)
+	for i, stand in dock.Stands do
+		renderStand(stand, data.Stands[tostring(i)], i <= standCount, mult, false)
+	end
+	for i, stand in dock.Vault do
+		renderStand(stand, data.Vault[tostring(i)], i <= vaultCount, mult, true)
+	end
+	dock.GatePrompt.Enabled = (data.Upgrades.Gate or 0) > 0
+	local name = if data.DockName ~= "" then data.DockName else `{player.DisplayName}'s Dock`
+	local vip = if services.MonetizationService.Owns(player, "VIP") then "[VIP] " else ""
+	dock.Sign.Text = `{vip}{name}\n+{NumberFormat.short(DockService.GetIncomePerSecond(player))}/s`
+	dock.Model:SetAttribute("OwnerUserId", player.UserId)
+	services.DataService.Push(player, {
+		DockIndex = dock.Index,
+		IncomePerSecond = DockService.GetIncomePerSecond(player),
+		DockValue = Formulas.DockValue(data),
+	})
+end
+
+------------------------------------------------------------------------------------------
+-- Placement
+------------------------------------------------------------------------------------------
+local function bestUnplaced(data)
+	local best, bestCps = nil, -1
+	for _, list in { data.Storage, data.Bag } do
+		for _, r in list do
+			local cps = Formulas.RelicCPS(r)
+			if cps > bestCps then
+				best, bestCps = r, cps
+			end
+		end
+	end
+	return best
+end
+
+function DockService.PlaceRelic(player: Player, uid: string, slot: number, vault: boolean): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local passes = services.MonetizationService.OwnedSet(player)
+	local count = if vault then Formulas.VaultCount(data, passes) else Formulas.StandCount(data, passes)
+	if slot < 1 or slot > count or slot % 1 ~= 0 then
+		return false
+	end
+	if services.RaidService.IsBeingStolen(player, uid) then
+		return false
+	end
+	local container = if vault then data.Vault else data.Stands
+	local key = tostring(slot)
+	local where = services.InventoryService.Find(data, uid)
+	if where ~= "Bag" and where ~= "Storage" and where ~= "Stands" and where ~= "Vault" then
+		return false
+	end
+	local relic = services.InventoryService.Take(data, uid)
+	if not relic then
+		return false
+	end
+	-- Swap out whatever is on the slot back to storage
+	local existing = container[key]
+	if existing then
+		if services.RaidService.IsBeingStolen(player, existing.uid) then
+			services.InventoryService.AddToStorage(player, relic)
+			return false
+		end
+		container[key] = nil
+		existing.placedAt = nil
+		table.insert(data.Storage, existing)
+	end
+	relic.placedAt = os.time()
+	container[key] = relic
+	services.DataService.Replicate(player, "Bag", "Storage", "Stands", "Vault")
+	DockService.RefreshDock(player)
+	services.AnalyticsService.Funnel(player, "FirstDisplay")
+	return true
+end
+
+function DockService.Pickup(player: Player, slot: number, vault: boolean): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local container = if vault then data.Vault else data.Stands
+	local key = tostring(slot)
+	local relic = container[key]
+	if not relic or services.RaidService.IsBeingStolen(player, relic.uid) then
+		return false
+	end
+	container[key] = nil
+	relic.placedAt = nil
+	table.insert(data.Storage, relic)
+	services.DataService.Replicate(player, "Storage", "Stands", "Vault")
+	DockService.RefreshDock(player)
+	return true
+end
+
+-- Raid support: remove a displayed relic (stolen) without returning it to storage
+function DockService.RemoveDisplayed(owner: Player, slot: number)
+	local data = services.DataService.GetData(owner)
+	if not data then
+		return nil
+	end
+	local relic = data.Stands[tostring(slot)]
+	data.Stands[tostring(slot)] = nil
+	services.DataService.Replicate(owner, "Stands")
+	DockService.RefreshDock(owner)
+	return relic
+end
+
+function DockService.PlacedRecently(owner: Player, slot: number, seconds: number): boolean
+	local data = services.DataService.GetData(owner)
+	local relic = data and data.Stands[tostring(slot)]
+	return relic ~= nil and relic.placedAt ~= nil and os.time() - relic.placedAt < seconds
+end
+
+-- Put a relic on the first free stand, else storage (used for successful raids)
+function DockService.AddRelicToDock(player: Player, relic)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	local count = Formulas.StandCount(data, services.MonetizationService.OwnedSet(player))
+	for i = 1, count do
+		if not data.Stands[tostring(i)] then
+			relic.placedAt = os.time()
+			data.Stands[tostring(i)] = relic
+			services.DataService.Replicate(player, "Stands")
+			DockService.RefreshDock(player)
+			return
+		end
+	end
+	services.InventoryService.AddToStorage(player, relic)
+end
+
+------------------------------------------------------------------------------------------
+-- Collector pad & offline earnings
+------------------------------------------------------------------------------------------
+function DockService.Collect(player: Player)
+	local data = services.DataService.GetData(player)
+	if not data or data.Uncollected < 1 then
+		return
+	end
+	local amount = math.floor(data.Uncollected)
+	data.Uncollected = 0
+	services.CurrencyService.AddCoins(player, amount, "DockIncome")
+	services.QuestService.Progress(player, "Collect", 1)
+	Net.Notify:FireClient(player, `+{NumberFormat.short(amount)} Coins`, "coins")
+	data.Flags.Collects = (data.Flags.Collects or 0) + 1
+	if data.Flags.Collects == 5 and not services.MonetizationService.Owns(player, "AutoCollect") then
+		Net.Offer:FireClient(player, "AutoCollect")
+	end
+end
+
+-- Appendix D
+function DockService.ComputeOffline(player: Player): number
+	local data = services.DataService.GetData(player)
+	if not data or data.LastLogout == 0 then
+		return 0
+	end
+	local elapsed = math.max(0, os.time() - data.LastLogout)
+	local capHours = Formulas.OfflineCapHours(
+		data,
+		services.MonetizationService.OwnedSet(player),
+		services.MonetizationService.HasActiveSubscription(player)
+	)
+	local seconds = math.min(elapsed, capHours * 3600)
+	return math.floor(DockService.GetIncomePerSecond(player) * Formulas.OfflineRate(data) * seconds), elapsed, capHours
+end
+
+function DockService.ResetGateCooldown(player: Player)
+	local g = gateState[player]
+	if g then
+		g.readyAt = 0
+	end
+end
+
+function DockService.GateActive(owner: Player): boolean
+	local g = gateState[owner]
+	return g ~= nil and g.activeUntil > os.clock()
+end
+
+local function activateGate(player: Player)
+	local data = services.DataService.GetData(player)
+	local dock = dockOf[player]
+	if not data or not dock then
+		return
+	end
+	local level = data.Upgrades.Gate or 0
+	if level < 1 then
+		Net.Notify:FireClient(player, "Buy the Laser Gate upgrade first.", "error")
+		return
+	end
+	local g = gateState[player]
+	local now = os.clock()
+	if g.readyAt > now then
+		Net.Notify:FireClient(player, `Gate recharging: {NumberFormat.time(g.readyAt - now)}`, "error")
+		Net.Offer:FireClient(player, "GateRecharge")
+		return
+	end
+	local duration = Upgrades.Base.GateSeconds + (level - 1) * 10
+	g.activeUntil = now + duration
+	g.readyAt = now + duration + Upgrades.Base.GateCooldown
+	dock.Gate.Transparency = 0.6
+	Net.Notify:FireClient(player, `Laser Gate active for {duration}s`, "info")
+	task.delay(duration, function()
+		if dock.Owner == player and gateState[player] and gateState[player].activeUntil <= os.clock() + 0.1 then
+			dock.Gate.Transparency = 1
+		end
+	end)
+end
+
+------------------------------------------------------------------------------------------
+-- Lifecycle
+------------------------------------------------------------------------------------------
+local function assignDock(player: Player)
+	for _, dock in services.WorldService.GetDocks() do
+		if not dock.Owner then
+			dock.Owner = player
+			dockOf[player] = dock
+			return dock
+		end
+	end
+	return nil
+end
+
+local function spawnAtDock(player: Player, character: Model)
+	local dock = dockOf[player]
+	if not dock then
+		return
+	end
+	if services.DiveService.ConsumeReviveSpawn(player, character) then
+		return
+	end
+	task.defer(function()
+		local hrp = character:WaitForChild("HumanoidRootPart", 5)
+		if hrp then
+			services.SecurityService.AllowTeleport(player)
+			character:PivotTo(dock.SpawnCFrame)
+		end
+	end)
+end
+
+local function onProfileLoaded(player: Player, profile)
+	local dock = assignDock(player)
+	joinedAt[player] = os.time()
+	gateState[player] = { activeUntil = 0, readyAt = 0 }
+	if not dock then
+		warn("[DockService] no free dock for " .. player.Name)
+		return
+	end
+	player.CharacterAdded:Connect(function(char)
+		spawnAtDock(player, char)
+	end)
+	if player.Character then
+		spawnAtDock(player, player.Character)
+	end
+	-- 90s Dock Lock on join (§8.4)
+	dock.Gate.Transparency = 0.8
+	task.delay(Economy.Raid.JoinLockSeconds, function()
+		if dock.Owner == player and not DockService.GateActive(player) then
+			dock.Gate.Transparency = 1
+		end
+	end)
+	DockService.RefreshDock(player)
+
+	local amount, elapsed, capHours = DockService.ComputeOffline(player)
+	if amount and amount > 0 then
+		pendingOffline[player] = amount
+		Net.OfflineEarnings:FireClient(player, {
+			Amount = amount,
+			Elapsed = elapsed,
+			CapHours = capHours,
+			CanDouble = services.MonetizationService.HasActiveSubscription(player),
+		})
+	end
+end
+
+local function onRelease(player: Player, profile)
+	local pending = pendingOffline[player]
+	if pending then
+		profile.Data.Coins += pending
+		profile.Data.LifetimeCoins += pending
+		pendingOffline[player] = nil
+	end
+	local buffered = autoCollectBuffer[player]
+	if buffered and buffered > 0 then
+		profile.Data.Coins += math.floor(buffered)
+		profile.Data.LifetimeCoins += math.floor(buffered)
+	end
+	autoCollectBuffer[player] = nil
+	local dock = dockOf[player]
+	if dock then
+		dock.Owner = nil
+		dock.Model:SetAttribute("OwnerUserId", nil)
+		for _, stand in dock.Stands do
+			renderStand(stand, nil, false, 1, false)
+		end
+		for _, stand in dock.Vault do
+			renderStand(stand, nil, false, 1, true)
+		end
+		dock.Sign.Text = "Empty Dock"
+		dock.PadLabel.Text = ""
+		dock.Gate.Transparency = 1
+		dock.GatePrompt.Enabled = false
+	end
+	dockOf[player] = nil
+	gateState[player] = nil
+	joinedAt[player] = nil
+end
+
+function DockService.Start()
+	services.DataService.ProfileLoaded:Connect(onProfileLoaded)
+	services.DataService.OnRelease(onRelease)
+	services.MonetizationService.PassGranted:Connect(function(player)
+		DockService.RefreshDock(player)
+	end)
+
+	-- Stand prompts (server-side Triggered). Client hides irrelevant prompts locally.
+	for _, dock in services.WorldService.GetDocks() do
+		for i, stand in dock.Stands do
+			(stand:FindFirstChild("Place") :: ProximityPrompt).Triggered:Connect(function(player)
+				if dock.Owner ~= player or not limiter:Check(player) then
+					return
+				end
+				local data = services.DataService.GetData(player)
+				if data.Stands[tostring(i)] then
+					DockService.Pickup(player, i, false)
+				else
+					local best = bestUnplaced(data)
+					if best then
+						DockService.PlaceRelic(player, best.uid, i, false)
+					else
+						Net.Notify:FireClient(player, "No relics to display. Go dive!", "info")
+					end
+				end
+			end)
+		end
+		for i, stand in dock.Vault do
+			(stand:FindFirstChild("Place") :: ProximityPrompt).Triggered:Connect(function(player)
+				if dock.Owner ~= player or not limiter:Check(player) then
+					return
+				end
+				local data = services.DataService.GetData(player)
+				if data.Vault[tostring(i)] then
+					DockService.Pickup(player, i, true)
+				else
+					local best = bestUnplaced(data)
+					if best then
+						DockService.PlaceRelic(player, best.uid, i, true)
+					end
+				end
+			end)
+		end
+		dock.Pad.Touched:Connect(function(hit)
+			local player = Players:GetPlayerFromCharacter(hit.Parent)
+			if player and dock.Owner == player then
+				DockService.Collect(player)
+			end
+		end)
+		dock.GatePrompt.Triggered:Connect(function(player)
+			if dock.Owner == player then
+				activateGate(player)
+			end
+		end)
+	end
+
+	Net.RequestPlaceRelic.OnServerEvent:Connect(function(player, uid, slot, vault)
+		if not limiter:Check(player) or typeof(uid) ~= "string" or typeof(slot) ~= "number" then
+			return
+		end
+		DockService.PlaceRelic(player, uid, slot, vault == true)
+	end)
+	Net.RequestPickupRelic.OnServerEvent:Connect(function(player, slot, vault)
+		if not limiter:Check(player) or typeof(slot) ~= "number" then
+			return
+		end
+		DockService.Pickup(player, slot, vault == true)
+	end)
+	Net.RequestCollect.OnServerEvent:Connect(function(player)
+		if limiter:Check(player) then
+			-- Remote collect only works while standing on your own dock
+			local dock = dockOf[player]
+			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+			if dock and hrp and services.WorldService.IsInsideDock(dock, hrp.Position) then
+				DockService.Collect(player)
+			end
+		end
+	end)
+	Net.RequestClaimOffline.OnServerEvent:Connect(function(player, double)
+		local amount = pendingOffline[player]
+		if not amount then
+			return
+		end
+		pendingOffline[player] = nil
+		if double == true and services.MonetizationService.HasActiveSubscription(player) then
+			amount *= 2
+		end
+		services.CurrencyService.AddCoins(player, amount, "Offline")
+		Net.Notify:FireClient(player, `Welcome back! +{NumberFormat.short(amount)} Coins`, "coins")
+	end)
+	Net.ActivateGate.OnServerEvent:Connect(function(player)
+		if limiter:Check(player) then
+			activateGate(player)
+		end
+	end)
+	Net.RenameDock.OnServerEvent:Connect(function(player, text)
+		if not limiter:Check(player) or typeof(text) ~= "string" then
+			return
+		end
+		local data = services.DataService.GetData(player)
+		if not data or data.RenameTokens < 1 then
+			Net.Offer:FireClient(player, "RenameDock")
+			return
+		end
+		text = text:sub(1, 24)
+		local filtered = services.SecurityService.FilterForBroadcast(player, text)
+		if not filtered then
+			Net.Notify:FireClient(player, "That name couldn't be used.", "error")
+			return
+		end
+		data.RenameTokens -= 1
+		data.DockName = filtered
+		services.DataService.Replicate(player, "RenameTokens", "DockName")
+		DockService.RefreshDock(player)
+	end)
+
+	-- Income tick (1 Hz)
+	task.spawn(function()
+		local tick = 0
+		while true do
+			task.wait(1)
+			tick += 1
+			for player, dock in dockOf do
+				local data = services.DataService.GetData(player)
+				if data then
+					local income = DockService.GetIncomePerSecond(player)
+					if services.MonetizationService.Owns(player, "AutoCollect") then
+						autoCollectBuffer[player] = (autoCollectBuffer[player] or 0) + income
+						if tick % 5 == 0 and autoCollectBuffer[player] >= 1 then
+							local amt = math.floor(autoCollectBuffer[player])
+							autoCollectBuffer[player] -= amt
+							services.CurrencyService.AddCoins(player, amt, "DockIncome")
+						end
+						dock.PadLabel.Text = "AUTO"
+					else
+						data.Uncollected += income
+						dock.PadLabel.Text = NumberFormat.short(data.Uncollected)
+					end
+					if tick % 15 == 0 then
+						dock.Sign.Text = dock.Sign.Text:gsub("\n.*$", "") .. `\n+{NumberFormat.short(income)}/s`
+					end
+				end
+			end
+		end
+	end)
+
+	-- Intruder detection: alarm, guard crab slow (§8.4)
+	task.spawn(function()
+		while true do
+			task.wait(0.5)
+			for _, intruder in Players:GetPlayers() do
+				local char = intruder.Character
+				local hrp = char and char:FindFirstChild("HumanoidRootPart")
+				if hrp then
+					local slow = 1
+					for owner, dock in dockOf do
+						local data = services.DataService.GetData(owner)
+						local alarmMargin = 2 + (data and data.Upgrades.Alarm or 0) * 10
+						if owner ~= intruder and services.WorldService.IsInsideDock(dock, hrp.Position, alarmMargin) then
+							local crab = data and data.Upgrades.Crab or 0
+							if crab > 0 and services.WorldService.IsInsideDock(dock, hrp.Position) then
+								slow = math.min(slow, 1 - 0.06 * crab)
+							end
+							local key = owner.UserId .. ":" .. intruder.UserId
+							if (alarmSeen[key] or 0) + 20 < os.clock() then
+								alarmSeen[key] = os.clock()
+								Net.Intruder:FireClient(owner, { Name = intruder.DisplayName, UserId = intruder.UserId })
+							end
+						end
+					end
+					char:SetAttribute("DockSlow", slow)
+				end
+			end
+		end
+	end)
+
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return DockService
diff --git a/src/server/Services/EventService.luau b/src/server/Services/EventService.luau
new file mode 100644
index 0000000..bc0167c
--- /dev/null
+++ b/src/server/Services/EventService.luau
@@ -0,0 +1,249 @@
+-- EventService (Master Plan §26.2): os.time()-scheduled events that every server agrees on,
+-- purchasable Server Luck Boosts (§15.3) and admin-triggered events (Admin Abuse Hour).
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local Events = require(Shared.Config.Events)
+
+local EventService = {}
+local services
+local serverBoosts = {} -- {kind, mult, untilTime, by}
+local adminEvents: { [string]: number } = {} -- id -> until os.time()
+local lastSignature = ""
+
+function EventService.Init(s)
+	services = s
+end
+
+local function hash01(s: string): number
+	local h = 2166136261
+	for i = 1, #s do
+		h = bit32.bxor(h, string.byte(s, i))
+		h = (h * 16777619) % 4294967296
+	end
+	return (h % 100000) / 100000
+end
+
+local function isWeekend(t: number): boolean
+	local wday = tonumber(os.date("!%w", t)) -- 0 = Sunday
+	return wday == 0 or wday == 6
+end
+
+local function scheduledActive(def, t: number): (boolean, number)
+	if adminEvents[def.Id] and adminEvents[def.Id] > t then
+		return true, adminEvents[def.Id] - t
+	end
+	if def.Weekends then
+		if isWeekend(t) then
+			local secsToday = t % 86400
+			return true, 86400 - secsToday
+		end
+		return false, 0
+	end
+	if not def.PeriodSeconds then
+		return false, 0
+	end
+	local shifted = t - (def.Offset or 0)
+	local period = shifted // def.PeriodSeconds
+	local into = shifted % def.PeriodSeconds
+	if into >= def.DurationSeconds then
+		return false, 0
+	end
+	if def.RandomChance then
+		-- Same seed on every server; random start minute inside the hour
+		if hash01(def.Id .. period) > def.RandomChance then
+			return false, 0
+		end
+		local start = math.floor(hash01(def.Id .. "s" .. period) * (def.PeriodSeconds - def.DurationSeconds))
+		if into < start or into >= start + def.DurationSeconds then
+			return false, 0
+		end
+		return true, start + def.DurationSeconds - into
+	end
+	return true, def.DurationSeconds - into
+end
+
+function EventService.GetActive()
+	local t = os.time()
+	local out = {}
+	for _, def in Events.List do
+		local active, remaining = scheduledActive(def, t)
+		if active then
+			table.insert(out, { def = def, remaining = remaining })
+		end
+	end
+	return out
+end
+
+function EventService.IsActive(id: string): boolean
+	for _, e in EventService.GetActive() do
+		if e.def.Id == id then
+			return true
+		end
+	end
+	return false
+end
+
+function EventService.GetLuckMultiplier(): number
+	local m = 1
+	local now = os.time()
+	for _, b in serverBoosts do
+		if b.kind == "Luck" and b.untilTime > now then
+			m *= b.mult
+		end
+	end
+	return m
+end
+
+function EventService.GetCoinMultiplier(): number
+	local m = 1
+	local now = os.time()
+	for _, b in serverBoosts do
+		if b.kind == "Coins" and b.untilTime > now then
+			m *= b.mult
+		end
+	end
+	return m
+end
+
+-- Modifiers merged into LootRoll for a given zone
+function EventService.GetLootMods(zoneId: string)
+	local rarityMult = {}
+	local mutationById = {}
+	local mutationAdd = {}
+	for _, e in EventService.GetActive() do
+		local def = e.def
+		if def.RarityMult then
+			for k, v in def.RarityMult do
+				rarityMult[k] = (rarityMult[k] or 1) * v
+			end
+		end
+		if def.ZoneRarityMult and def.ZoneRarityMult[zoneId] then
+			for k, v in def.ZoneRarityMult[zoneId] do
+				rarityMult[k] = (rarityMult[k] or 1) * v
+			end
+		end
+		if def.MutationMult then
+			for k, v in def.MutationMult do
+				mutationById[k] = (mutationById[k] or 1) * v
+			end
+		end
+		if def.MutationAdd then
+			for k, v in def.MutationAdd do
+				mutationAdd[k] = (mutationAdd[k] or 0) + v
+			end
+		end
+	end
+	return rarityMult, mutationById, mutationAdd
+end
+
+function EventService.LeviathanMult(): number
+	local m = 1
+	for _, e in EventService.GetActive() do
+		m *= e.def.LeviathanMult or 1
+	end
+	return m
+end
+
+function EventService.NodeMult(): number
+	local m = 1
+	for _, e in EventService.GetActive() do
+		m *= e.def.NodeMult or 1
+	end
+	return m
+end
+
+function EventService.StartServerBoost(kind: string, mult: number, seconds: number, by: Player?)
+	-- Stacking purchases extend the duration rather than multiplying further
+	for _, b in serverBoosts do
+		if b.kind == kind and b.mult == mult and b.untilTime > os.time() then
+			b.untilTime += seconds
+			EventService.Broadcast(true)
+			return
+		end
+	end
+	table.insert(serverBoosts, {
+		kind = kind,
+		mult = mult,
+		untilTime = os.time() + seconds,
+		by = by and by.DisplayName or "Admin",
+	})
+	EventService.Broadcast(true)
+end
+
+function EventService.StartAdminEvent(id: string, seconds: number): boolean
+	for _, def in Events.List do
+		if def.Id == id then
+			adminEvents[id] = os.time() + seconds
+			EventService.Broadcast(true)
+			return true
+		end
+	end
+	return false
+end
+
+function EventService.Snapshot()
+	local list = {}
+	for _, e in EventService.GetActive() do
+		table.insert(list, { Id = e.def.Id, Name = e.def.Name, Desc = e.def.Desc, Remaining = e.remaining, Color = e.def.Color })
+	end
+	local now = os.time()
+	for _, b in serverBoosts do
+		if b.untilTime > now then
+			table.insert(list, {
+				Id = "Server" .. b.kind,
+				Name = `Server {b.kind} x{b.mult}`,
+				Desc = `Thanks, {b.by}!`,
+				Remaining = b.untilTime - now,
+				Color = Color3.fromRGB(80, 255, 140),
+			})
+		end
+	end
+	return list
+end
+
+function EventService.Broadcast(force: boolean?)
+	local snap = EventService.Snapshot()
+	local sig = ""
+	for _, e in snap do
+		sig ..= e.Id .. ","
+	end
+	if force or sig ~= lastSignature then
+		local started = {}
+		for _, e in snap do
+			if not string.find(lastSignature, e.Id .. ",", 1, true) then
+				table.insert(started, e.Name)
+			end
+		end
+		lastSignature = sig
+		Net.EventsChanged:FireAllClients(snap)
+		for _, name in started do
+			services.AnnouncementService.Server(`EVENT: {name} has started!`, "Legendary")
+		end
+	end
+end
+
+function EventService.Start()
+	task.spawn(function()
+		while true do
+			EventService.Broadcast(false)
+			-- prune expired boosts
+			local now = os.time()
+			for i = #serverBoosts, 1, -1 do
+				if serverBoosts[i].untilTime <= now then
+					table.remove(serverBoosts, i)
+				end
+			end
+			task.wait(5)
+		end
+	end)
+	Players.PlayerAdded:Connect(function(p)
+		task.wait(3)
+		Net.EventsChanged:FireClient(p, EventService.Snapshot())
+	end)
+end
+
+return EventService
diff --git a/src/server/Services/InventoryService.luau b/src/server/Services/InventoryService.luau
new file mode 100644
index 0000000..291fa80
--- /dev/null
+++ b/src/server/Services/InventoryService.luau
@@ -0,0 +1,317 @@
+-- InventoryService (Master Plan §5.2, §7, §13.2, §21): relic instances with UIDs.
+--   Bag      – relics carried on the current dive; lost on death (§10.3).
+--   Storage  – relics secured at the dock (bag empties into it when you get home).
+--   Stands / Vault – displayed relics (DockService).
+-- Relics are always MOVED between containers, never copied (§23 anti-dupe).
+
+local HttpService = game:GetService("HttpService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local LootRoll = require(Shared.LootRoll)
+local NumberFormat = require(Shared.NumberFormat)
+local Relics = require(Shared.Config.Relics)
+local Rarities = require(Shared.Config.Rarities)
+local Zones = require(Shared.Config.Zones)
+
+local STORAGE_MAX = 80
+
+local InventoryService = {}
+local services
+local limiter = RateLimiter.new(10, 4)
+local rng = Random.new()
+
+function InventoryService.Init(s)
+	services = s
+end
+
+function InventoryService.CreateRelic(player: Player?, roll): any
+	return {
+		uid = HttpService:GenerateGUID(false),
+		id = roll.id,
+		rarity = roll.rarity,
+		mutations = roll.mutations or {},
+		size = roll.size or 1,
+		foundAt = os.time(),
+		foundBy = if player then player.UserId else 0,
+		locked = false,
+	}
+end
+
+-- Returns container name, key/index, relic
+function InventoryService.Find(data, uid: string)
+	for i, r in data.Bag do
+		if r.uid == uid then
+			return "Bag", i, r
+		end
+	end
+	for i, r in data.Storage do
+		if r.uid == uid then
+			return "Storage", i, r
+		end
+	end
+	for k, r in data.Stands do
+		if r.uid == uid then
+			return "Stands", k, r
+		end
+	end
+	for k, r in data.Vault do
+		if r.uid == uid then
+			return "Vault", k, r
+		end
+	end
+	return nil, nil, nil
+end
+
+-- Removes the relic from wherever it is and returns it.
+function InventoryService.Take(data, uid: string)
+	local where, key, relic = InventoryService.Find(data, uid)
+	if not where then
+		return nil, nil
+	end
+	if where == "Bag" or where == "Storage" then
+		table.remove(data[where], key)
+	else
+		data[where][key] = nil
+	end
+	return relic, where
+end
+
+function InventoryService.BagFull(player: Player): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return true
+	end
+	return #data.Bag >= Formulas.BagSize(data, services.MonetizationService.OwnedSet(player))
+end
+
+function InventoryService.AddToBag(player: Player, relic): boolean
+	local data = services.DataService.GetData(player)
+	if not data or InventoryService.BagFull(player) then
+		return false
+	end
+	table.insert(data.Bag, relic)
+	services.DataService.Replicate(player, "Bag")
+	return true
+end
+
+function InventoryService.AddToStorage(player: Player, relic): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	if #data.Storage >= STORAGE_MAX then
+		-- Storage full: auto-sell the incoming relic so nothing is silently lost
+		local price = Formulas.SellPrice(relic, services.DockService.GetCoinMultiplier(player))
+		services.CurrencyService.AddCoins(player, price, "AutoSell")
+		Net.Notify:FireClient(player, `Storage full — sold {Relics.ById[relic.id].Name} for {NumberFormat.short(price)}`, "info")
+		return true
+	end
+	table.insert(data.Storage, relic)
+	services.DataService.Replicate(player, "Storage")
+	return true
+end
+
+-- Bag → Storage when the diver gets home safely (§5.2 "Escape")
+function InventoryService.SecureBag(player: Player): number
+	local data = services.DataService.GetData(player)
+	if not data or #data.Bag == 0 then
+		return 0
+	end
+	local n = #data.Bag
+	for _, relic in data.Bag do
+		InventoryService.AddToStorage(player, relic)
+	end
+	table.clear(data.Bag)
+	services.DataService.Replicate(player, "Bag", "Storage")
+	return n
+end
+
+-- Records a discovery in the Codex (§7.6). Returns true if it's a new entry.
+function InventoryService.RecordCodex(player: Player, relic): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local entry = data.Codex[relic.id]
+	if not entry then
+		entry = {}
+		data.Codex[relic.id] = entry
+	end
+	local key = relic.mutations[1] or "None"
+	if entry[key] then
+		return false
+	end
+	entry[key] = true
+	services.DataService.Replicate(player, "Codex")
+	services.QuestService.Progress(player, "Codex", 1)
+	services.QuestService.AddXp(player, 20)
+	InventoryService.CheckCodexMilestones(player)
+	return true
+end
+
+function InventoryService.CodexPercent(data, zoneIndex: number?): number
+	local total, found = 0, 0
+	for _, def in Relics.List do
+		if not zoneIndex or def.Zone == zoneIndex then
+			total += 1
+			if data.Codex[def.Id] then
+				found += 1
+			end
+		end
+	end
+	return if total > 0 then found / total * 100 else 0
+end
+
+-- Zone milestone rewards at 10/25/50/75/100% (§7.6)
+local MILESTONES = {
+	{ 10, { Pearls = 10 } },
+	{ 25, { Pearls = 20 } },
+	{ 50, { Pearls = 40 } },
+	{ 75, { Pearls = 60 } },
+	{ 100, { Pearls = 120 } },
+}
+function InventoryService.CheckCodexMilestones(player: Player)
+	local data = services.DataService.GetData(player)
+	for _, zone in Zones.List do
+		local pct = InventoryService.CodexPercent(data, zone.Index)
+		for _, m in MILESTONES do
+			local flag = `Codex_{zone.Id}_{m[1]}`
+			if pct >= m[1] and not data.Flags[flag] then
+				data.Flags[flag] = true
+				services.CurrencyService.GrantReward(player, m[2], "Codex")
+				Net.Notify:FireClient(player, `Codex: {zone.Name} {m[1]}% complete! +{m[2].Pearls} Pearls`, "reward")
+				services.AnalyticsService.Custom(player, "CodexMilestone", m[1], { CustomField01 = zone.Id })
+			end
+		end
+	end
+	services.DataService.Replicate(player, "Flags")
+end
+
+-- Codex zone completion gives +5% luck in that zone
+function InventoryService.ZoneLuckBonus(data, zoneIndex: number): number
+	return if data.Flags[`Codex_{Zones.List[zoneIndex].Id}_100`] then 1.05 else 1
+end
+
+-- Grant a random relic of a rarity (crates, daily rewards, starter pack)
+function InventoryService.GrantRandomRelic(player: Player, rarity: string, source: string)
+	if not Rarities[rarity] then
+		return nil
+	end
+	local pool = Relics.ByRarity[rarity]
+	if not pool then
+		return nil
+	end
+	local id = pool[rng:NextInteger(1, #pool)].item
+	local relic = InventoryService.CreateRelic(player, {
+		id = id,
+		rarity = rarity,
+		mutations = LootRoll.RollMutations(rng),
+		size = LootRoll.RollSize(rng),
+	})
+	InventoryService.AddToStorage(player, relic)
+	InventoryService.RecordCodex(player, relic)
+	Net.RevealRelic:FireClient(player, relic, source)
+	services.AnalyticsService.Custom(player, "RelicGranted", 1, { CustomField01 = source })
+	return relic
+end
+
+function InventoryService.Sell(player: Player, uid: string): number
+	local data = services.DataService.GetData(player)
+	if not data then
+		return 0
+	end
+	local where, _, relic = InventoryService.Find(data, uid)
+	if not relic or relic.locked or (where ~= "Bag" and where ~= "Storage") then
+		return 0
+	end
+	InventoryService.Take(data, uid)
+	local price = Formulas.SellPrice(relic, services.DockService.GetCoinMultiplier(player))
+	services.CurrencyService.AddCoins(player, price, "SellRelic")
+	services.DataService.Replicate(player, "Bag", "Storage")
+	services.QuestService.Progress(player, "Sell", 1)
+	return price
+end
+
+function InventoryService.CleanBarnacle(player: Player, uid: string): boolean
+	local data = services.DataService.GetData(player)
+	local _, _, relic = InventoryService.Find(data, uid)
+	if not relic or not table.find(relic.mutations, "Barnacled") then
+		return false
+	end
+	local new = LootRoll.RollMutations(rng)
+	relic.mutations = new
+	services.DataService.Replicate(player, "Bag", "Storage", "Stands", "Vault")
+	services.DockService.RefreshDock(player)
+	InventoryService.RecordCodex(player, relic)
+	Net.RevealRelic:FireClient(player, relic, "Barnacle Clean")
+	return true
+end
+
+function InventoryService.Start()
+	Net.RequestSell.OnServerEvent:Connect(function(player, uid)
+		if not limiter:Check(player) or typeof(uid) ~= "string" then
+			return
+		end
+		local price = InventoryService.Sell(player, uid)
+		if price > 0 then
+			Net.Notify:FireClient(player, `Sold for {NumberFormat.short(price)} Coins`, "coins")
+		end
+	end)
+
+	Net.RequestSellCommons.OnServerEvent:Connect(function(player)
+		if not limiter:Check(player) then
+			return
+		end
+		local data = services.DataService.GetData(player)
+		if not data then
+			return
+		end
+		local total, count = 0, 0
+		for _, list in { data.Bag, data.Storage } do
+			for i = #list, 1, -1 do
+				local r = list[i]
+				if r.rarity == "Common" and not r.locked and #r.mutations == 0 then
+					table.remove(list, i)
+					total += Formulas.SellPrice(r, services.DockService.GetCoinMultiplier(player))
+					count += 1
+				end
+			end
+		end
+		if count > 0 then
+			services.CurrencyService.AddCoins(player, total, "SellCommons")
+			services.QuestService.Progress(player, "Sell", count)
+			services.DataService.Replicate(player, "Bag", "Storage")
+			Net.Notify:FireClient(player, `Sold {count} Commons for {NumberFormat.short(total)} Coins`, "coins")
+		end
+	end)
+
+	Net.RequestToggleLock.OnServerEvent:Connect(function(player, uid)
+		if not limiter:Check(player) or typeof(uid) ~= "string" then
+			return
+		end
+		local data = services.DataService.GetData(player)
+		local where, _, relic = InventoryService.Find(data, uid)
+		if relic then
+			relic.locked = not relic.locked
+			services.DataService.Replicate(player, where)
+		end
+	end)
+
+	Net.RequestCleanBarnacle.OnServerEvent:Connect(function(player, uid)
+		if not limiter:Check(player) or typeof(uid) ~= "string" then
+			return
+		end
+		local data = services.DataService.GetData(player)
+		local _, _, relic = InventoryService.Find(data, uid)
+		if relic and table.find(relic.mutations, "Barnacled") then
+			services.MonetizationService.SetPendingBarnacle(player, uid)
+			Net.Offer:FireClient(player, "BarnacleClean")
+		end
+	end)
+end
+
+return InventoryService
diff --git a/src/server/Services/LeaderboardService.luau b/src/server/Services/LeaderboardService.luau
new file mode 100644
index 0000000..9c6bd95
--- /dev/null
+++ b/src/server/Services/LeaderboardService.luau
@@ -0,0 +1,162 @@
+-- LeaderboardService (Master Plan §14, §21.2): global OrderedDataStore boards written at most
+-- once per player per 5 minutes per board, top-10 refreshed every 2 minutes and shown on the
+-- plaza boards and in the Leaderboards screen.
+
+local DataStoreService = game:GetService("DataStoreService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local NumberFormat = require(Shared.NumberFormat)
+local Formulas = require(Shared.Formulas)
+
+local WRITE_INTERVAL = 300
+local READ_INTERVAL = 120
+
+local BOARDS = {
+	{ Id = "Deepest", Title = "Deepest Dive", Value = function(data)
+		return data.Stats.DeepestDepth
+	end, Format = function(v)
+		return `{NumberFormat.commas(v)}m`
+	end },
+	{ Id = "TotalValue", Title = "Dock Value", Value = function(data)
+		return math.floor(Formulas.DockValue(data))
+	end, Format = function(v)
+		return `{NumberFormat.short(v)}/s`
+	end },
+	{ Id = "Rebirths", Title = "Resurfaces", Value = function(data)
+		return data.Rebirths
+	end, Format = tostring },
+	{ Id = "Steals", Title = "Most Steals", Value = function(data)
+		return data.Stats.Steals
+	end, Format = tostring },
+	{ Id = "Codex", Title = "Codex %", Value = function(data, services)
+		return math.floor(services.InventoryService.CodexPercent(data) * 10)
+	end, Format = function(v)
+		return string.format("%.1f%%", v / 10)
+	end },
+}
+
+local LeaderboardService = {}
+local services
+local stores = {}
+local lastWrite: { [Player]: number } = {}
+local nameCache: { [number]: string } = {}
+local latest = {}
+
+function LeaderboardService.Init(s)
+	services = s
+end
+
+local function nameOf(userId: number): string
+	if nameCache[userId] then
+		return nameCache[userId]
+	end
+	local p = Players:GetPlayerByUserId(userId)
+	if p then
+		nameCache[userId] = p.DisplayName
+		return p.DisplayName
+	end
+	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
+	nameCache[userId] = if ok then name else "Player"
+	return nameCache[userId]
+end
+
+local function writePlayer(player: Player)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	for _, board in BOARDS do
+		local store = stores[board.Id]
+		if store then
+			local value = math.floor(board.Value(data, services))
+			if value > 0 then
+				pcall(store.SetAsync, store, tostring(player.UserId), value)
+			end
+		end
+	end
+end
+
+local function refreshBoards()
+	local boardsFolder = services.WorldService.Root():FindFirstChild("Plaza")
+	boardsFolder = boardsFolder and boardsFolder:FindFirstChild("Leaderboards")
+	for _, board in BOARDS do
+		local store = stores[board.Id]
+		local rows = {}
+		if store then
+			local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
+			if ok and pages then
+				for rank, entry in pages:GetCurrentPage() do
+					table.insert(rows, { Rank = rank, Name = nameOf(tonumber(entry.key) or 0), Value = board.Format(entry.value) })
+				end
+			end
+		end
+		if #rows == 0 then
+			-- Fallback: in-server ranking (Studio / DataStore outage)
+			local list = {}
+			for _, p in Players:GetPlayers() do
+				local data = services.DataService.GetData(p)
+				if data then
+					table.insert(list, { Name = p.DisplayName, Raw = board.Value(data, services) })
+				end
+			end
+			table.sort(list, function(a, b)
+				return a.Raw > b.Raw
+			end)
+			for rank, e in list do
+				if rank > 10 then
+					break
+				end
+				table.insert(rows, { Rank = rank, Name = e.Name, Value = board.Format(math.floor(e.Raw)) })
+			end
+		end
+		latest[board.Id] = { Title = board.Title, Rows = rows }
+		local part = boardsFolder and boardsFolder:FindFirstChild(board.Id)
+		local text = part and part:FindFirstChild("Board") and part.Board:FindFirstChild("Text")
+		if text then
+			local lines = { board.Title:upper(), "" }
+			for _, r in rows do
+				table.insert(lines, `{r.Rank}. {r.Name}  —  {r.Value}`)
+			end
+			text.Text = table.concat(lines, "\n")
+		end
+	end
+	Net.Leaderboards:FireAllClients(latest)
+end
+
+function LeaderboardService.Start()
+	for _, board in BOARDS do
+		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, "AbyssSalvage_LB_" .. board.Id)
+		if ok then
+			stores[board.Id] = store
+		end
+	end
+	services.DataService.OnRelease(function(player)
+		task.spawn(writePlayer, player)
+		lastWrite[player] = nil
+	end)
+	task.spawn(function()
+		task.wait(10)
+		while true do
+			for _, player in Players:GetPlayers() do
+				if os.clock() - (lastWrite[player] or 0) >= WRITE_INTERVAL then
+					lastWrite[player] = os.clock()
+					writePlayer(player)
+					task.wait(1) -- spread requests
+				end
+			end
+			refreshBoards()
+			task.wait(READ_INTERVAL)
+		end
+	end)
+	Players.PlayerAdded:Connect(function(p)
+		task.wait(5)
+		if next(latest) then
+			Net.Leaderboards:FireClient(p, latest)
+		end
+	end)
+end
+
+return LeaderboardService
diff --git a/src/server/Services/LootService.luau b/src/server/Services/LootService.luau
new file mode 100644
index 0000000..bb6d932
--- /dev/null
+++ b/src/server/Services/LootService.luau
@@ -0,0 +1,369 @@
+-- LootService (Master Plan §5.1, §7, §20.5): salvage nodes, server-side rolls, pity,
+-- sonar pre-rolls, the Auto-Salvage Drone and reveal announcements.
+--
+-- Rolls happen on the server only. A node's result is rolled per player the first time that
+-- player either pings it with sonar or salvages it, using that player's luck at that moment.
+-- The cached result is what they get when they salvage — so sonar previews are honest and
+-- re-pinging can't reroll.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local LootRoll = require(Shared.LootRoll)
+local Formulas = require(Shared.Formulas)
+local Zones = require(Shared.Config.Zones)
+local Relics = require(Shared.Config.Relics)
+local Rarities = require(Shared.Config.Rarities)
+local Economy = require(Shared.Config.Economy)
+local Build = require(script.Parent.Parent.Util.Build)
+
+local LootService = {}
+local services
+local rng = Random.new()
+local nodes = {} -- [part] = {zone, preRolls = {[Player] = roll}, holdStart = {[Player] = clock}}
+local sonarLimiter = RateLimiter.new(3, 1)
+local lastSonar: { [Player]: number } = {}
+local MAX_SALVAGE_DISTANCE = 14
+local nodeFolder: Folder
+
+function LootService.Init(s)
+	services = s
+end
+
+------------------------------------------------------------------------------------------
+-- Rolling
+------------------------------------------------------------------------------------------
+function LootService.BuildMods(player: Player, zoneIndex: number)
+	local data = services.DataService.GetData(player)
+	local zone = Zones.List[zoneIndex]
+	local rarityMult, mutationById, mutationAdd = services.EventService.GetLootMods(zone.Id)
+	local luck = services.MonetizationService.GetLuckMultiplier(player)
+		* services.EventService.GetLuckMultiplier()
+		* services.SocialService.GetPartyLuck(player)
+		* services.InventoryService.ZoneLuckBonus(data, zoneIndex)
+	return {
+		luck = luck,
+		pity = data.Pity[zone.Id] or 0,
+		rarityMult = rarityMult,
+		mutationMult = if services.BoostService.Active(player, "MutationPotion") then 3 else 1,
+		mutationById = mutationById,
+		mutationAdd = mutationAdd,
+	}
+end
+
+function LootService.RollFor(player: Player, zoneIndex: number)
+	local data = services.DataService.GetData(player)
+	-- FTUE (§17): first salvage is a Rusty Anchor, second a guaranteed Rare Doubloon
+	if not data.Flags.TutorialSalvage1 then
+		data.Flags.TutorialSalvage1 = true
+		return { id = "R001", rarity = "Common", mutations = {}, size = 1 }
+	elseif not data.Flags.TutorialSalvage2 then
+		data.Flags.TutorialSalvage2 = true
+		return { id = "R021", rarity = "Rare", mutations = {}, size = 1.1 }
+	end
+	return LootRoll.Roll(rng, zoneIndex, LootService.BuildMods(player, zoneIndex))
+end
+
+local function updatePity(player: Player, zoneIndex: number, rarity: string)
+	local data = services.DataService.GetData(player)
+	local zone = Zones.List[zoneIndex]
+	if Rarities.TierOf(rarity) >= Rarities.Legendary.Tier then
+		data.Pity[zone.Id] = 0
+	elseif zoneIndex >= Zones.PityMinZone then
+		data.Pity[zone.Id] = math.min((data.Pity[zone.Id] or 0) + Zones.PityStep, Zones.PityCap)
+		data.Flags.DryRolls = (data.Flags.DryRolls or 0) + 1
+		if data.Flags.DryRolls == 20 then
+			Net.Offer:FireClient(player, "SkipPity")
+		end
+	end
+	if Rarities.TierOf(rarity) >= Rarities.Legendary.Tier then
+		data.Flags.DryRolls = 0
+	end
+	services.DataService.Replicate(player, "Pity")
+end
+
+-- Called whenever a player obtains a relic from the ocean
+function LootService.OnRelicFound(player: Player, relic, zoneIndex: number)
+	local data = services.DataService.GetData(player)
+	local def = Relics.ById[relic.id]
+	data.Stats.Salvaged += 1
+	if relic.rarity == "Mythic" or relic.rarity == "Secret" then
+		data.Stats.MythicsFound += 1
+	end
+	services.DataService.Replicate(player, "Stats")
+	services.InventoryService.RecordCodex(player, relic)
+
+	local tier = Rarities.TierOf(relic.rarity)
+	services.QuestService.Progress(player, "Salvage", 1)
+	if tier >= 3 then
+		services.QuestService.Progress(player, "RarePlus", 1)
+		services.AnalyticsService.Funnel(player, "FirstRare")
+	end
+	if tier >= 4 then
+		services.QuestService.Progress(player, "EpicPlus", 1)
+	end
+	if #relic.mutations > 0 then
+		services.QuestService.Progress(player, "Mutated", 1)
+		for _, m in relic.mutations do
+			services.QuestService.Progress(player, "Mut_" .. m, 1)
+		end
+	end
+	services.QuestService.AddXp(player, Economy.Xp.Salvage + (Economy.Xp.RarityBonus[relic.rarity] or 0))
+	services.AnalyticsService.Funnel(player, "FirstSalvage")
+
+	Net.RevealRelic:FireClient(player, relic, "Salvage")
+
+	local mut = if #relic.mutations > 0 then table.concat(relic.mutations, " ") .. " " else ""
+	local huge = if relic.size >= 1.35 then "HUGE " else ""
+	local label = `{huge}{mut}{def.Name}`
+	local announce = Rarities[relic.rarity].Announce
+	if announce == "local" then
+		services.AnnouncementService.Near(player, `{player.DisplayName} found a LEGENDARY {label}!`, relic.rarity)
+		if not services.MonetizationService.Owns(player, "LuckySonar") and rng:NextNumber() < 0.35 then
+			task.delay(4, function()
+				Net.Offer:FireClient(player, "LuckySonar")
+			end)
+		end
+		if not data.Flags.LikePrompted then
+			data.Flags.LikePrompted = true
+			Net.Notify:FireClient(player, "Enjoying Abyss Salvage? Give it a 👍 and ⭐ to support new zones!", "info")
+		end
+	elseif announce == "server" then
+		services.AnnouncementService.Server(`{player.DisplayName} found a MYTHIC {label}!`, relic.rarity)
+	elseif announce == "global" then
+		services.AnnouncementService.Global(`{player.DisplayName} found a SECRET {label}!`, relic.rarity)
+	end
+	services.AnalyticsService.Custom(player, "RelicFound", tier, { CustomField01 = relic.rarity, CustomField02 = Zones.List[zoneIndex].Id })
+end
+
+-- SkipPity product: an instant roll on the Legendary table (§15.3)
+function LootService.GrantLegendaryRoll(player: Player): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local zoneIndex = math.clamp(data.Suit, 2, 5)
+	local relic = services.InventoryService.CreateRelic(player, {
+		id = LootRoll.RollRelicId(rng, zoneIndex, "Legendary"),
+		rarity = "Legendary",
+		mutations = LootRoll.RollMutations(rng, LootService.BuildMods(player, zoneIndex)),
+		size = LootRoll.RollSize(rng),
+	})
+	services.InventoryService.AddToStorage(player, relic)
+	data.Pity[Zones.List[zoneIndex].Id] = 0
+	data.Flags.DryRolls = 0
+	LootService.OnRelicFound(player, relic, zoneIndex)
+	return true
+end
+
+------------------------------------------------------------------------------------------
+-- Nodes
+------------------------------------------------------------------------------------------
+local spawnNode
+
+local function nodeZoneColor(zoneIndex: number): Color3
+	return ({
+		Color3.fromRGB(255, 240, 180),
+		Color3.fromRGB(180, 255, 200),
+		Color3.fromRGB(150, 200, 255),
+		Color3.fromRGB(120, 255, 255),
+		Color3.fromRGB(255, 120, 90),
+	})[zoneIndex]
+end
+
+local function getPreRoll(player: Player, node)
+	local roll = node.preRolls[player]
+	if not roll then
+		roll = LootService.RollFor(player, node.zone)
+		node.preRolls[player] = roll
+	end
+	return roll
+end
+
+local function salvage(player: Player, part: BasePart, skipHold: boolean?): boolean
+	local node = nodes[part]
+	if not node or node.taken then
+		return false
+	end
+	local char = player.Character
+	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+	local hum = char and char:FindFirstChildOfClass("Humanoid")
+	if not hrp or not hum or hum.Health <= 0 then
+		return false
+	end
+	-- §23 distance check
+	if (hrp.Position - part.Position).Magnitude > MAX_SALVAGE_DISTANCE + (if skipHold then 10 else 0) then
+		return false
+	end
+	-- §23 server-timed hold
+	if not skipHold then
+		local started = node.holdStart[player]
+		local data = services.DataService.GetData(player)
+		local required = Formulas.SalvageSeconds(data) * 0.8 - 0.15
+		if not started or os.clock() - started < required then
+			return false
+		end
+	end
+	if services.InventoryService.BagFull(player) then
+		Net.Notify:FireClient(player, "Bag full! Head back to your dock.", "error")
+		if not services.MonetizationService.Owns(player, "BigBag") then
+			Net.Offer:FireClient(player, "BigBag")
+		end
+		return false
+	end
+
+	local roll = getPreRoll(player, node)
+	node.taken = true
+	local relic = services.InventoryService.CreateRelic(player, roll)
+	services.InventoryService.AddToBag(player, relic)
+	updatePity(player, node.zone, relic.rarity)
+	LootService.OnRelicFound(player, relic, node.zone)
+
+	local zoneIndex = node.zone
+	nodes[part] = nil
+	part:Destroy()
+	task.delay(rng:NextNumber(15, 30), function()
+		spawnNode(zoneIndex)
+	end)
+	return true
+end
+
+spawnNode = function(zoneIndex: number)
+	local pos = services.WorldService.RandomPointInZone(zoneIndex, rng)
+	local part = Build.Part({
+		Name = "Node",
+		Shape = Enum.PartType.Ball,
+		Size = Vector3.one * 2.2,
+		CFrame = CFrame.new(pos),
+		Color = nodeZoneColor(zoneIndex),
+		Material = Enum.Material.Neon,
+		CanCollide = false,
+		Parent = nodeFolder,
+	})
+	part:SetAttribute("Zone", zoneIndex)
+	Build.Instance("PointLight", { Range = 14, Brightness = 2, Color = part.Color, Parent = part })
+	local prompt = Build.Prompt(part, "Salvage", "Glinting relic", Formulas.SalvageSeconds({}), "Salvage")
+	prompt.MaxActivationDistance = MAX_SALVAGE_DISTANCE
+	local node = { zone = zoneIndex, preRolls = {}, holdStart = {}, taken = false }
+	nodes[part] = node
+	prompt.PromptButtonHoldBegan:Connect(function(player)
+		node.holdStart[player] = os.clock()
+	end)
+	prompt.PromptButtonHoldEnded:Connect(function(player)
+		task.delay(0.1, function()
+			node.holdStart[player] = nil
+		end)
+	end)
+	prompt.Triggered:Connect(function(player)
+		salvage(player, part)
+	end)
+end
+
+function LootService.NodesNear(position: Vector3, range: number)
+	local out = {}
+	for part, node in nodes do
+		if not node.taken and (part.Position - position).Magnitude <= range then
+			table.insert(out, { part = part, node = node })
+		end
+	end
+	return out
+end
+
+local function onSonar(player: Player)
+	if not sonarLimiter:Check(player) then
+		return
+	end
+	local data = services.DataService.GetData(player)
+	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+	if not data or not hrp then
+		return
+	end
+	local now = os.clock()
+	if (lastSonar[player] or 0) + Formulas.SonarCooldown(data) > now then
+		return
+	end
+	lastSonar[player] = now
+	services.PredatorService.AddNoise(player, 35)
+
+	local sonarLevel = data.Upgrades.Sonar or 0
+	local showRarity = sonarLevel >= 5
+	local showMutation = sonarLevel >= 10 or services.MonetizationService.Owns(player, "MutationScan")
+	local results = {}
+	for _, entry in LootService.NodesNear(hrp.Position, Formulas.SonarRange(data)) do
+		local info = { Position = entry.part.Position }
+		if showRarity or showMutation then
+			local roll = getPreRoll(player, entry.node)
+			if showRarity then
+				info.Rarity = roll.rarity
+			end
+			if showMutation then
+				info.Mutations = roll.mutations
+			end
+		end
+		table.insert(results, info)
+		if #results >= 40 then
+			break
+		end
+	end
+	Net.SonarResult:FireClient(player, results, Formulas.SonarRange(data))
+	-- Dive Party: share ping positions (not previews) with nearby members (§14)
+	local party = services.SocialService.GetParty(player)
+	if party then
+		local shared = {}
+		for _, info in results do
+			table.insert(shared, { Position = info.Position })
+		end
+		for _, member in party do
+			local mhrp = member ~= player and member.Character and member.Character:FindFirstChild("HumanoidRootPart")
+			if mhrp and (mhrp.Position - hrp.Position).Magnitude < 300 then
+				Net.SonarResult:FireClient(member, shared, Formulas.SonarRange(data), player.DisplayName)
+			end
+		end
+	end
+end
+
+function LootService.Start()
+	nodeFolder = services.WorldService.Root():FindFirstChild("Nodes")
+	for _, zone in Zones.List do
+		for _ = 1, zone.NodeCount do
+			spawnNode(zone.Index)
+		end
+	end
+
+	Net.UseSonar.OnServerEvent:Connect(onSonar)
+
+	-- Auto-Salvage Drone pass (§15.2): Common/Uncommon within 20 studs, every 2s
+	task.spawn(function()
+		while true do
+			task.wait(2)
+			for _, player in Players:GetPlayers() do
+				if services.MonetizationService.Owns(player, "Drone") then
+					local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+					if hrp and hrp.Position.Y < 0 and not services.InventoryService.BagFull(player) then
+						for _, entry in LootService.NodesNear(hrp.Position, 20) do
+							local roll = getPreRoll(player, entry.node)
+							if Rarities.TierOf(roll.rarity) <= 2 then
+								salvage(player, entry.part, true)
+								break
+							end
+						end
+					end
+				end
+			end
+		end
+	end)
+
+	Players.PlayerRemoving:Connect(function(p)
+		lastSonar[p] = nil
+		sonarLimiter:Remove(p)
+		for _, node in nodes do
+			node.preRolls[p] = nil
+			node.holdStart[p] = nil
+		end
+	end)
+end
+
+return LootService
diff --git a/src/server/Services/MonetizationService.luau b/src/server/Services/MonetizationService.luau
new file mode 100644
index 0000000..53a4b4a
--- /dev/null
+++ b/src/server/Services/MonetizationService.luau
@@ -0,0 +1,497 @@
+-- MonetizationService (Master Plan §15, §22): game passes (incl. bundles), developer products
+-- with idempotent ProcessReceipt, Abyss Pass+ subscription, Premium perks, Starter Pack timer,
+-- policy-gated crates.
+--
+-- ProcessReceipt rules (§22.2): this is the ONLY script that sets ProcessReceipt; return
+-- NotProcessedYet on any failure; never grant a PurchaseId twice; only return PurchaseGranted
+-- after the grant is saved (DataService.SaveNow).
+--
+-- Studio testing: items whose id is still 0 are granted instantly in Studio when "bought",
+-- so every handler can be exercised before real IDs exist. In a live server they are refused.
+
+local MarketplaceService = game:GetService("MarketplaceService")
+local Players = game:GetService("Players")
+local RunService = game:GetService("RunService")
+local HttpService = game:GetService("HttpService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local Signal = require(Shared.Signal)
+local RateLimiter = require(Shared.RateLimiter)
+local Passes = require(Shared.Config.Passes)
+local Products = require(Shared.Config.Products)
+local Economy = require(Shared.Config.Economy)
+local Formulas = require(Shared.Formulas)
+local WeightedRandom = require(Shared.WeightedRandom)
+
+local MonetizationService = {}
+MonetizationService.PassGranted = Signal.new() -- (player, key)
+
+local services
+local ownedCache: { [Player]: { [string]: boolean } } = {}
+local subCache: { [Player]: boolean } = {}
+local passIdToKey: { [number]: string } = {}
+local productIdToKey: { [number]: string } = {}
+local pendingBarnacle: { [Player]: string } = {}
+local limiter = RateLimiter.new(4, 0.5)
+local rng = Random.new()
+
+for key, p in Passes do
+	if p.id ~= 0 then
+		passIdToKey[p.id] = key
+	end
+end
+for key, p in Products do
+	if p.id ~= 0 then
+		productIdToKey[p.id] = key
+	end
+end
+
+function MonetizationService.Init(s)
+	services = s
+end
+
+function MonetizationService.Owns(player: Player, key: string): boolean
+	local cache = ownedCache[player]
+	return cache ~= nil and cache[key] == true
+end
+
+function MonetizationService.OwnedSet(player: Player): { [string]: boolean }
+	return ownedCache[player] or {}
+end
+
+function MonetizationService.HasActiveSubscription(player: Player): boolean
+	return subCache[player] == true
+end
+
+function MonetizationService.IsPremium(player: Player): boolean
+	return player.MembershipType == Enum.MembershipType.Premium
+end
+
+function MonetizationService.PushOwnership(player: Player)
+	services.DataService.Push(player, {
+		Passes = ownedCache[player] or {},
+		Subscribed = subCache[player] == true,
+		Premium = MonetizationService.IsPremium(player),
+	})
+end
+
+local function grantPassKey(player: Player, key: string)
+	local cache = ownedCache[player]
+	if not cache then
+		return
+	end
+	local def = Passes[key]
+	if def and def.grants then
+		for _, sub in def.grants do
+			cache[sub] = true
+		end
+	end
+	cache[key] = true
+	MonetizationService.PushOwnership(player)
+	MonetizationService.PassGranted:Fire(player, key)
+end
+MonetizationService.GrantPassKey = grantPassKey -- admin/testing
+
+local function loadOwnership(player: Player)
+	ownedCache[player] = ownedCache[player] or {}
+	for key, def in Passes do
+		if def.id ~= 0 then
+			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, def.id)
+			if ok and owns then
+				grantPassKey(player, key)
+			end
+		end
+	end
+	MonetizationService.PushOwnership(player)
+end
+
+function MonetizationService.RefreshSubscription(player: Player)
+	if Economy.SubscriptionId == "" then
+		subCache[player] = false
+		return
+	end
+	local ok, status = pcall(function()
+		return MarketplaceService:GetUserSubscriptionStatusAsync(player, Economy.SubscriptionId)
+	end)
+	subCache[player] = ok and status ~= nil and status.IsSubscribed == true
+	MonetizationService.PushOwnership(player)
+end
+
+-- §22.2 luck stack: passes, potions, subscription, rebirth (events applied by LootService)
+function MonetizationService.GetLuckMultiplier(player: Player): number
+	local data = services.DataService.GetData(player)
+	local m = 1
+	if MonetizationService.Owns(player, "LuckySonar") then
+		m *= 1.25
+	end
+	if MonetizationService.HasActiveSubscription(player) then
+		m *= 1 + Economy.SubLuckBonus
+	end
+	if services.BoostService.Active(player, "LuckPotion") then
+		m *= 2
+	end
+	if data then
+		m *= Formulas.RebirthLuck(data.Rebirths)
+	end
+	return m
+end
+
+-- Multiplier from purchases/membership on Coins income
+function MonetizationService.GetCoinMultiplier(player: Player): number
+	local m = 1
+	if MonetizationService.Owns(player, "VIP") then
+		m *= Economy.VipCoinMult
+	end
+	local bonus = 0
+	if MonetizationService.HasActiveSubscription(player) then
+		bonus += Economy.SubCoinBonus
+	end
+	if MonetizationService.IsPremium(player) then
+		bonus += Economy.PremiumCoinBonus
+	end
+	return m * (1 + bonus)
+end
+
+------------------------------------------------------------------------------------------
+-- Product handlers: return true on success. They must not yield for long.
+------------------------------------------------------------------------------------------
+local function rollCrate(player: Player)
+	local item = WeightedRandom.pick(Economy.Crate, rng)
+	if item.Kind == "Pearls" then
+		services.CurrencyService.AddPearls(player, item.Amount, "Crate")
+	elseif item.Kind == "Boost" then
+		services.BoostService.Add(player, item.Id, item.Seconds)
+	elseif item.Kind == "Relic" then
+		services.InventoryService.GrantRandomRelic(player, item.Rarity, "Crate")
+	end
+	return item
+end
+
+local handlers: { [string]: (Player, any) -> boolean } = {
+	OxygenRefill = function(player)
+		return services.DiveService.RefillOxygen(player)
+	end,
+	Revive = function(player)
+		return services.DiveService.ReviveInPlace(player)
+	end,
+	Flares5 = function(player)
+		local data = services.DataService.GetData(player)
+		data.Flares += Products.Flares5.flares
+		services.DataService.Replicate(player, "Flares")
+		return true
+	end,
+	GateRecharge = function(player)
+		services.DockService.ResetGateCooldown(player)
+		return true
+	end,
+	ServerLuck = function(player)
+		services.EventService.StartServerBoost("Luck", 2, Products.ServerLuck.seconds, player)
+		services.AnnouncementService.Server(
+			`{player.DisplayName} activated a SERVER LUCK BOOST! 2x luck for 15 minutes!`,
+			"Mythic"
+		)
+		return true
+	end,
+	LuckPotion = function(player)
+		return services.BoostService.Add(player, "LuckPotion", Products.LuckPotion.seconds)
+	end,
+	MutationPotion = function(player)
+		return services.BoostService.Add(player, "MutationPotion", Products.MutationPotion.seconds)
+	end,
+	StarterPack = function(player)
+		local data = services.DataService.GetData(player)
+		data.StarterPackBought = true
+		services.CurrencyService.AddCoins(player, Products.StarterPack.coins, "StarterPack")
+		services.CurrencyService.AddPearls(player, Products.StarterPack.pearls, "StarterPack")
+		if data.Suit < 2 then
+			data.Suit = 2
+			services.DataService.Replicate(player, "Suit")
+			services.UpgradeService.PushDerived(player)
+		end
+		services.InventoryService.GrantRandomRelic(player, "Rare", "StarterPack")
+		services.DataService.Replicate(player, "StarterPackBought")
+		return true
+	end,
+	SkipPity = function(player)
+		return services.LootService.GrantLegendaryRoll(player)
+	end,
+	BarnacleClean = function(player)
+		local uid = pendingBarnacle[player]
+		pendingBarnacle[player] = nil
+		if uid and services.InventoryService.CleanBarnacle(player, uid) then
+			return true
+		end
+		-- Nothing to clean any more: compensate instead of retrying forever
+		return services.CurrencyService.AddPearls(player, 40, "BarnacleRefund")
+	end,
+	TierSkip = function(player)
+		return services.QuestService.AddSeasonXp(player, Economy.TidePass.XpPerTier)
+	end,
+	TidePassPremium = function(player)
+		return services.QuestService.UnlockPremium(player)
+	end,
+	CrateSingle = function(player)
+		local item = rollCrate(player)
+		Net.Notify:FireClient(player, "Crate: " .. item.label, "reward")
+		return true
+	end,
+	CrateTriple = function(player)
+		local labels = {}
+		for _ = 1, 3 do
+			table.insert(labels, rollCrate(player).label)
+		end
+		Net.Notify:FireClient(player, "Crates: " .. table.concat(labels, ", "), "reward")
+		return true
+	end,
+	RenameDock = function(player)
+		local data = services.DataService.GetData(player)
+		data.RenameTokens += 1
+		services.DataService.Replicate(player, "RenameTokens")
+		return true
+	end,
+}
+
+for _, key in { "CoinsS", "CoinsM", "CoinsL", "CoinsXL", "CoinsXXL" } do
+	handlers[key] = function(player)
+		local def = Products[key]
+		return services.CurrencyService.GrantIncomeMinutes(player, def.incomeMinutes, def.floor)
+	end
+end
+for _, key in { "Pearls100", "Pearls550", "Pearls1200", "Pearls2600", "Pearls7000" } do
+	handlers[key] = function(player)
+		return services.CurrencyService.AddPearls(player, Products[key].pearls, "PearlPack")
+	end
+end
+
+local function grantProduct(player: Player, key: string, purchaseId: string, robux: number?): boolean
+	local profile = services.DataService.Get(player)
+	if not profile then
+		return false
+	end
+	if profile.Data.PurchaseHistory[purchaseId] then
+		return true -- already handled (idempotent)
+	end
+	local handler = handlers[key]
+	if not handler then
+		warn("[Monetization] no handler for product " .. key)
+		return false
+	end
+	local ok, result = pcall(handler, player)
+	if not ok or result ~= true then
+		warn(`[Monetization] handler {key} failed: {result}`)
+		return false
+	end
+	profile.Data.PurchaseHistory[purchaseId] = os.time()
+	profile.Data.ProductCounts[key] = (profile.Data.ProductCounts[key] or 0) + 1
+	if not services.DataService.SaveNow(player) then
+		-- Grant stays in memory; Roblox retries and the PurchaseId check prevents a double grant.
+		return false
+	end
+	services.AnalyticsService.LogPurchase(player, "product", key, robux)
+	return true
+end
+
+local function processReceipt(receiptInfo): Enum.ProductPurchaseDecision
+	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
+	if not player then
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	local key = productIdToKey[receiptInfo.ProductId]
+	if not key then
+		warn("[Monetization] unknown product id", receiptInfo.ProductId)
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	if grantProduct(player, key, receiptInfo.PurchaseId, receiptInfo.CurrencySpent) then
+		return Enum.ProductPurchaseDecision.PurchaseGranted
+	end
+	return Enum.ProductPurchaseDecision.NotProcessedYet
+end
+
+-- Simulated receipt for Studio / admin testing
+function MonetizationService.SimulateProduct(player: Player, key: string): boolean
+	return grantProduct(player, key, "SIM-" .. HttpService:GenerateGUID(false), 0)
+end
+
+------------------------------------------------------------------------------------------
+-- Purchase requests (server owns every prompt, so policy gates can't be bypassed: §22.4)
+------------------------------------------------------------------------------------------
+function MonetizationService.StarterPackAvailable(player: Player): boolean
+	local data = services.DataService.GetData(player)
+	if not data or data.StarterPackBought or (data.StarterPackShownAt or 0) == 0 then
+		return false
+	end
+	return os.time() - data.StarterPackShownAt < Products.StarterPack.offerHours * 3600
+end
+
+function MonetizationService.SetPendingBarnacle(player: Player, uid: string)
+	pendingBarnacle[player] = uid
+end
+
+local function promptPass(player: Player, key: string)
+	local def = Passes[key]
+	if not def or MonetizationService.Owns(player, key) then
+		return
+	end
+	services.AnalyticsService.Custom(player, "PromptShown", def.price, { CustomField01 = key })
+	if def.id == 0 then
+		if RunService:IsStudio() then
+			grantPassKey(player, key)
+			Net.Notify:FireClient(player, `[Studio] Granted pass {def.name}`, "info")
+		else
+			Net.Notify:FireClient(player, "This item isn't on sale yet.", "error")
+		end
+		return
+	end
+	MarketplaceService:PromptGamePassPurchase(player, def.id)
+end
+
+local function promptProduct(player: Player, key: string)
+	local def = Products[key]
+	if not def then
+		return
+	end
+	if def.paidRandom and not services.PolicyWrapper.CanBuyRandomItems(player) then
+		Net.Notify:FireClient(player, "Mystery Crates aren't available in your region.", "error")
+		return
+	end
+	if key == "StarterPack" and not MonetizationService.StarterPackAvailable(player) then
+		return
+	end
+	if key == "Revive" and not services.DiveService.CanRevive(player) then
+		return
+	end
+	if key == "TidePassPremium" then
+		local data = services.DataService.GetData(player)
+		if data and data.TidePass.Premium then
+			return
+		end
+	end
+	services.AnalyticsService.Custom(player, "PromptShown", def.price, { CustomField01 = key })
+	if def.id == 0 then
+		if RunService:IsStudio() then
+			local ok = MonetizationService.SimulateProduct(player, key)
+			Net.Notify:FireClient(player, `[Studio] Simulated {def.name}: {ok and "granted" or "failed"}`, "info")
+		else
+			Net.Notify:FireClient(player, "This item isn't on sale yet.", "error")
+		end
+		return
+	end
+	MarketplaceService:PromptProductPurchase(player, def.id)
+end
+
+local function onRequestPurchase(player: Player, kind: any, key: any)
+	if not limiter:Check(player) then
+		return
+	end
+	if typeof(kind) ~= "string" or typeof(key) ~= "string" then
+		return
+	end
+	if kind == "Pass" then
+		promptPass(player, key)
+	elseif kind == "Product" then
+		promptProduct(player, key)
+	elseif kind == "Subscription" then
+		if Economy.SubscriptionId ~= "" then
+			pcall(function()
+				MarketplaceService:PromptSubscriptionPurchase(player, Economy.SubscriptionId)
+			end)
+		elseif RunService:IsStudio() then
+			subCache[player] = not subCache[player]
+			MonetizationService.PushOwnership(player)
+			Net.Notify:FireClient(player, `[Studio] Pass+ {subCache[player] and "ON" or "OFF"}`, "info")
+		end
+	elseif kind == "Premium" then
+		pcall(function()
+			MarketplaceService:PromptPremiumPurchase(player)
+		end)
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Daily perks (§15.1 VIP chest, §15.4 Pass+ pearls, §15.7 Premium chest)
+------------------------------------------------------------------------------------------
+local function today(): number
+	return os.time() // 86400
+end
+
+function MonetizationService.GrantDailyPerks(player: Player)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	local d = today()
+	if MonetizationService.Owns(player, "VIP") and data.LastVipChestDay ~= d then
+		data.LastVipChestDay = d
+		services.CurrencyService.AddPearls(player, 20, "VipChest")
+		services.CurrencyService.GrantIncomeMinutes(player, 10, 1000)
+		Net.Notify:FireClient(player, "VIP Chest: +20 Pearls and 10 minutes of income!", "reward")
+	end
+	if MonetizationService.HasActiveSubscription(player) and data.LastSubPearlsDay ~= d then
+		data.LastSubPearlsDay = d
+		services.CurrencyService.AddPearls(player, Economy.SubDailyPearls, "SubDaily")
+		Net.Notify:FireClient(player, `Abyss Pass+: +{Economy.SubDailyPearls} Pearls`, "reward")
+	end
+	if MonetizationService.IsPremium(player) and os.time() - data.LastPremiumChest >= 86400 then
+		data.LastPremiumChest = os.time()
+		services.CurrencyService.AddPearls(player, 15, "PremiumChest")
+		services.BoostService.Add(player, "LuckPotion", 300)
+		Net.Notify:FireClient(player, "Premium Chest: +15 Pearls and a 5-minute Luck Potion!", "reward")
+	end
+end
+
+function MonetizationService.Start()
+	MarketplaceService.ProcessReceipt = processReceipt
+
+	services.DataService.ProfileLoaded:Connect(function(player)
+		loadOwnership(player)
+		MonetizationService.RefreshSubscription(player)
+		MonetizationService.GrantDailyPerks(player)
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		ownedCache[p] = nil
+		subCache[p] = nil
+		pendingBarnacle[p] = nil
+		limiter:Remove(p)
+	end)
+
+	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
+		local key = passIdToKey[passId]
+		if purchased and key then
+			grantPassKey(player, key)
+			services.AnalyticsService.LogPurchase(player, "pass", key, Passes[key].price)
+			Net.Notify:FireClient(player, `Thanks! {Passes[key].name} unlocked.`, "reward")
+		end
+	end)
+
+	pcall(function()
+		Players.UserSubscriptionStatusChanged:Connect(function(player, subscriptionId)
+			if subscriptionId == Economy.SubscriptionId then
+				MonetizationService.RefreshSubscription(player)
+			end
+		end)
+	end)
+	Players.PlayerMembershipChanged:Connect(function(player)
+		MonetizationService.PushOwnership(player)
+	end)
+
+	Net.RequestPurchase.OnServerEvent:Connect(onRequestPurchase)
+	Net.OfferShown.OnServerEvent:Connect(function(player, key)
+		if typeof(key) == "string" and limiter:Check(player) then
+			services.AnalyticsService.Custom(player, "OfferShown", 1, { CustomField01 = key })
+		end
+	end)
+
+	-- Hourly re-check for players who stay past midnight UTC
+	task.spawn(function()
+		while true do
+			task.wait(600)
+			for _, p in Players:GetPlayers() do
+				MonetizationService.GrantDailyPerks(p)
+			end
+		end
+	end)
+end
+
+return MonetizationService
diff --git a/src/server/Services/PolicyWrapper.luau b/src/server/Services/PolicyWrapper.luau
new file mode 100644
index 0000000..10c5157
--- /dev/null
+++ b/src/server/Services/PolicyWrapper.luau
@@ -0,0 +1,43 @@
+-- PolicyWrapper (Master Plan §16, §22.4): PolicyService lookups, cached per player.
+-- Fails CLOSED: if the lookup errors, paid random items are treated as restricted.
+
+local PolicyService = game:GetService("PolicyService")
+local Players = game:GetService("Players")
+
+local PolicyWrapper = {}
+local cache: { [Player]: any } = {}
+
+local function fetch(player: Player)
+	local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
+	if ok and info then
+		cache[player] = info
+	end
+	return cache[player]
+end
+
+function PolicyWrapper.CanBuyRandomItems(player: Player): boolean
+	local info = cache[player] or fetch(player)
+	if not info then
+		return false
+	end
+	return not info.ArePaidRandomItemsRestricted
+end
+
+function PolicyWrapper.IsSubjectToChinaPolicies(player: Player): boolean
+	local info = cache[player] or fetch(player)
+	return info ~= nil and info.IsSubjectToChinaPolicies == true
+end
+
+function PolicyWrapper.Start()
+	Players.PlayerAdded:Connect(function(p)
+		task.spawn(fetch, p)
+	end)
+	for _, p in Players:GetPlayers() do
+		task.spawn(fetch, p)
+	end
+	Players.PlayerRemoving:Connect(function(p)
+		cache[p] = nil
+	end)
+end
+
+return PolicyWrapper
diff --git a/src/server/Services/PredatorService.luau b/src/server/Services/PredatorService.luau
new file mode 100644
index 0000000..b8b1885
--- /dev/null
+++ b/src/server/Services/PredatorService.luau
@@ -0,0 +1,541 @@
+-- PredatorService (Master Plan §10): the Leviathan state machine and secondary hazards.
+--   Patrol → Investigate (noise) → Hunt (sight) → Lunge (1s telegraphed wind-up) → Cooldown
+-- Movement is server-simulated on anchored parts (network ownership stays on the server);
+-- clients only receive positions via replication plus a lightweight PredatorHint for audio/UI.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Economy = require(Shared.Config.Economy)
+local World = require(Shared.Config.World)
+local Zones = require(Shared.Config.Zones)
+local Mutations = require(Shared.Config.Mutations)
+local Formulas = require(Shared.Formulas)
+local Build = require(script.Parent.Parent.Util.Build)
+
+local L = Economy.Leviathan
+local SURFACE = World.WaterSurfaceY
+local TICK = 1 / 20
+
+local PredatorService = {}
+local services
+local rng = Random.new()
+local leviathans = {}
+local hazards = {}
+local noise: { [Player]: number } = {}
+local hunted: { [Player]: boolean } = {}
+local flareLimiter = RateLimiter.new(3, 0.5)
+local creatureFolder: Folder
+
+function PredatorService.Init(s)
+	services = s
+end
+
+function PredatorService.AddNoise(player: Player, amount: number)
+	local data = services.DataService.GetData(player)
+	local mult = if data then Formulas.NoiseMultiplier(data) else 1
+	noise[player] = math.min(100, (noise[player] or 0) + amount * mult)
+end
+
+function PredatorService.WasHunted(player: Player): boolean
+	return hunted[player] == true
+end
+
+function PredatorService.ClearHunted(player: Player)
+	hunted[player] = nil
+end
+
+------------------------------------------------------------------------------------------
+-- Leviathan
+------------------------------------------------------------------------------------------
+local function randomDeepPoint(): Vector3
+	local r = World.OceanRadius - 40
+	local depth = rng:NextNumber(L.MinDepth + 30, World.SeabedDepth - 40)
+	return Vector3.new(rng:NextNumber(-r, r), SURFACE - depth, rng:NextNumber(-r, r))
+end
+
+local function buildLeviathanModel(): Model
+	local model = Instance.new("Model")
+	model.Name = "Leviathan"
+	local head = Build.Part({
+		Name = "Head",
+		Size = Vector3.new(10, 8, 16),
+		Color = Color3.fromRGB(25, 30, 40),
+		Material = Enum.Material.Slate,
+		CanCollide = false,
+		CanQuery = false,
+		Parent = model,
+	})
+	model.PrimaryPart = head
+	for _, x in { -1, 1 } do
+		local eye = Build.Part({
+			Name = "Eye",
+			Shape = Enum.PartType.Ball,
+			Size = Vector3.one * 2,
+			Color = Color3.fromRGB(255, 40, 30),
+			Material = Enum.Material.Neon,
+			CanCollide = false,
+			CanQuery = false,
+			Parent = model,
+		})
+		eye.CFrame = head.CFrame * CFrame.new(x * 3.5, 2, -7)
+		local w = Instance.new("WeldConstraint")
+		w.Part0, w.Part1 = head, eye
+		w.Parent = eye
+	end
+	local light = Instance.new("SpotLight")
+	light.Color = Color3.fromRGB(255, 60, 40)
+	light.Range = 40
+	light.Angle = 60
+	light.Brightness = 3
+	light.Face = Enum.NormalId.Front
+	light.Parent = head
+	-- Body segments trail behind the head (positioned every tick)
+	local segments = {}
+	for i = 1, 7 do
+		local seg = Build.Part({
+			Name = "Seg" .. i,
+			Size = Vector3.new(9 - i * 0.8, 7 - i * 0.6, 12),
+			Color = Color3.fromRGB(30, 35, 50),
+			Material = Enum.Material.Slate,
+			CanCollide = false,
+			CanQuery = false,
+			Parent = model,
+		})
+		table.insert(segments, seg)
+	end
+	model.Parent = creatureFolder
+	return model, segments
+end
+
+local function spawnLeviathan()
+	local model, segments = buildLeviathanModel()
+	local pos = randomDeepPoint()
+	local lev = {
+		model = model,
+		segments = segments,
+		trail = {},
+		pos = pos,
+		look = Vector3.new(0, 0, -1),
+		state = "Patrol",
+		waypoint = randomDeepPoint(),
+		target = nil,
+		investigate = nil,
+		timer = 0,
+		lungeDir = nil,
+		distractedUntil = 0,
+		flarePos = nil,
+	}
+	for _ = 1, #segments * 4 do
+		table.insert(lev.trail, pos)
+	end
+	table.insert(leviathans, lev)
+	return lev
+end
+
+local function despawnLeviathan()
+	local lev = table.remove(leviathans)
+	if lev then
+		lev.model:Destroy()
+	end
+end
+
+local function moveToward(lev, goal: Vector3, speed: number, dt: number)
+	local delta = goal - lev.pos
+	local dist = delta.Magnitude
+	if dist < 0.1 then
+		return dist
+	end
+	local dir = delta / dist
+	-- smooth turning
+	local turned = lev.look:Lerp(dir, math.clamp(dt * 3, 0, 1))
+	lev.look = if turned.Magnitude > 1e-3 then turned.Unit else dir
+	local step = math.min(dist, speed * dt)
+	lev.pos += lev.look * step
+	-- keep inside the deep zone
+	local minY = SURFACE - World.SeabedDepth + 10
+	local maxY = SURFACE - L.MinDepth + 60
+	lev.pos = Vector3.new(
+		math.clamp(lev.pos.X, -World.OceanRadius + 20, World.OceanRadius - 20),
+		math.clamp(lev.pos.Y, minY, maxY),
+		math.clamp(lev.pos.Z, -World.OceanRadius + 20, World.OceanRadius - 20)
+	)
+	return dist
+end
+
+local function render(lev)
+	local head = lev.model.PrimaryPart
+	lev.model:PivotTo(CFrame.lookAt(lev.pos, lev.pos + lev.look))
+	table.insert(lev.trail, 1, lev.pos)
+	table.remove(lev.trail)
+	for i, seg in lev.segments do
+		local a = lev.trail[math.min(#lev.trail, i * 4)]
+		local b = lev.trail[math.min(#lev.trail, i * 4 - 2)] or a
+		if (b - a).Magnitude > 0.01 then
+			seg.CFrame = CFrame.lookAt(a, b)
+		else
+			seg.Position = a
+		end
+	end
+	return head
+end
+
+local function playerInfo(player: Player)
+	local char = player.Character
+	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+	local hum = char and char:FindFirstChildOfClass("Humanoid")
+	if not hrp or not hum or hum.Health <= 0 then
+		return nil
+	end
+	if (char:GetAttribute("SpawnShield") or 0) > os.clock() then
+		return nil
+	end
+	local depth = SURFACE - hrp.Position.Y
+	if depth < L.MinDepth - 20 then
+		return nil
+	end
+	return hrp, hum
+end
+
+local function canSee(lev, pos: Vector3): boolean
+	local delta = pos - lev.pos
+	local dist = delta.Magnitude
+	if dist > L.SightRange then
+		return false
+	end
+	local angle = math.deg(math.acos(math.clamp(lev.look:Dot(delta.Unit), -1, 1)))
+	return angle <= L.SightConeDeg or dist < 15
+end
+
+local function tickLeviathan(lev, dt: number)
+	local now = os.clock()
+	-- Flare distraction (§10.1 co-op)
+	if lev.distractedUntil > now and lev.flarePos then
+		lev.state = "Distracted"
+		moveToward(lev, lev.flarePos, L.HuntSpeed, dt)
+		render(lev)
+		return
+	elseif lev.state == "Distracted" then
+		lev.state = "Patrol"
+		lev.target = nil
+	end
+
+	if lev.state == "Patrol" or lev.state == "Investigate" then
+		-- Look for prey
+		local best, bestScore = nil, 0
+		for _, player in Players:GetPlayers() do
+			local hrp = playerInfo(player)
+			if hrp then
+				local dist = (hrp.Position - lev.pos).Magnitude
+				if canSee(lev, hrp.Position) then
+					local score = 200 - dist
+					if score > bestScore then
+						best, bestScore = player, score
+					end
+				elseif dist < L.HearRange and (noise[player] or 0) > 30 then
+					lev.state = "Investigate"
+					lev.investigate = hrp.Position
+				end
+			end
+		end
+		if best then
+			lev.state = "Hunt"
+			lev.target = best
+			hunted[best] = true
+		elseif lev.state == "Investigate" and lev.investigate then
+			if moveToward(lev, lev.investigate, (L.PatrolSpeed + L.HuntSpeed) / 2, dt) < 8 then
+				lev.state = "Patrol"
+				lev.investigate = nil
+			end
+		else
+			if moveToward(lev, lev.waypoint, L.PatrolSpeed, dt) < 10 then
+				lev.waypoint = randomDeepPoint()
+			end
+		end
+	elseif lev.state == "Hunt" then
+		local target = lev.target
+		local hrp = target and target.Parent and playerInfo(target)
+		if not hrp then
+			lev.state = "Patrol"
+			lev.target = nil
+		else
+			local dist = moveToward(lev, hrp.Position, L.HuntSpeed, dt)
+			if dist > L.SightRange * 2.5 then
+				lev.state = "Patrol"
+				lev.target = nil
+			elseif dist < 28 then
+				lev.state = "WindUp"
+				lev.timer = L.WindUp
+				Net.PredatorHint:FireClient(target, { State = "WindUp", Position = lev.pos })
+			end
+		end
+	elseif lev.state == "WindUp" then
+		lev.timer -= dt
+		local target = lev.target
+		local hrp = target and target.Parent and playerInfo(target)
+		if hrp then
+			-- face the target while rearing back
+			local turned = lev.look:Lerp((hrp.Position - lev.pos).Unit, math.clamp(dt * 6, 0, 1))
+			if turned.Magnitude > 1e-3 then
+				lev.look = turned.Unit
+			end
+		end
+		if lev.timer <= 0 then
+			if hrp then
+				lev.lungeDir = (hrp.Position - lev.pos).Unit
+				lev.state = "Lunge"
+				lev.timer = 0.6
+			else
+				lev.state = "Patrol"
+			end
+		end
+	elseif lev.state == "Lunge" then
+		lev.timer -= dt
+		lev.pos += lev.lungeDir * L.LungeSpeed * dt
+		lev.look = lev.lungeDir
+		-- hit check against everyone in the path
+		for _, player in Players:GetPlayers() do
+			local hrp, hum = playerInfo(player)
+			if hrp and (hrp.Position - lev.pos).Magnitude < L.HitRadius then
+				services.DiveService.SetCause(player, "Leviathan")
+				hum:TakeDamage(hum.MaxHealth * L.HitDamage)
+				Net.Knockback:FireClient(player, lev.lungeDir * 60)
+				lev.timer = 0
+			end
+		end
+		if lev.timer <= 0 then
+			lev.state = "Cooldown"
+			lev.timer = L.CooldownSeconds
+		end
+	elseif lev.state == "Cooldown" then
+		lev.timer -= dt
+		moveToward(lev, lev.pos + lev.look * 30, L.PatrolSpeed, dt)
+		if lev.timer <= 0 then
+			lev.state = if lev.target and lev.target.Parent then "Hunt" else "Patrol"
+		end
+	end
+	render(lev)
+end
+
+local function desiredLeviathans(): number
+	local deep = 0
+	for _, player in Players:GetPlayers() do
+		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+		if hrp and SURFACE - hrp.Position.Y >= L.MinDepth then
+			deep += 1
+		end
+	end
+	local base = 1 + math.floor(deep / L.PlayersPerExtra)
+	return math.floor(base * services.EventService.LeviathanMult())
+end
+
+local function useFlare(player: Player)
+	if not flareLimiter:Check(player) then
+		return
+	end
+	local data = services.DataService.GetData(player)
+	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
+	if not data or not hrp then
+		return
+	end
+	if data.Flares <= 0 then
+		Net.Offer:FireClient(player, "Flares5")
+		return
+	end
+	data.Flares -= 1
+	services.DataService.Replicate(player, "Flares")
+	local flarePos = hrp.Position + hrp.CFrame.LookVector * 25
+	local flare = Build.Part({
+		Name = "Flare",
+		Shape = Enum.PartType.Ball,
+		Size = Vector3.one * 2,
+		CFrame = CFrame.new(flarePos),
+		Color = Color3.fromRGB(255, 80, 40),
+		Material = Enum.Material.Neon,
+		CanCollide = false,
+		Parent = creatureFolder,
+	})
+	Build.Instance("PointLight", { Range = 60, Brightness = 5, Color = flare.Color, Parent = flare })
+	task.delay(L.FlareSeconds, function()
+		flare:Destroy()
+	end)
+	for _, lev in leviathans do
+		if (lev.pos - flarePos).Magnitude < 160 then
+			lev.distractedUntil = os.clock() + L.FlareSeconds
+			lev.flarePos = flarePos
+		end
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Secondary hazards (§10.2)
+------------------------------------------------------------------------------------------
+local function spawnHazards()
+	-- Electric eels: zone 2+, dart between two points
+	for i = 1, 14 do
+		local zoneIndex = if i <= 8 then 2 else 3
+		local a = services.WorldService.RandomPointInZone(zoneIndex, rng)
+		local b = a + Vector3.new(rng:NextNumber(-60, 60), rng:NextNumber(-15, 15), rng:NextNumber(-60, 60))
+		local part = Build.Part({
+			Name = "Eel",
+			Size = Vector3.new(1.5, 1.5, 10),
+			CFrame = CFrame.new(a),
+			Color = Color3.fromRGB(230, 230, 60),
+			Material = Enum.Material.Neon,
+			CanCollide = false,
+			CanQuery = false,
+			Parent = creatureFolder,
+		})
+		table.insert(hazards, { kind = "Eel", part = part, a = a, b = b, t = rng:NextNumber(0, 1), speed = 0.25 })
+	end
+	-- Jellyfish swarms: zone 3+
+	for i = 1, 18 do
+		local zoneIndex = 3 + (i % 3)
+		local pos = services.WorldService.RandomPointInZone(zoneIndex, rng)
+		local part = Build.Part({
+			Name = "Jellyfish",
+			Shape = Enum.PartType.Ball,
+			Size = Vector3.one * 6,
+			CFrame = CFrame.new(pos),
+			Color = Color3.fromRGB(255, 120, 220),
+			Material = Enum.Material.Neon,
+			Transparency = 0.35,
+			CanCollide = false,
+			CanQuery = false,
+			Parent = creatureFolder,
+		})
+		table.insert(hazards, { kind = "Jelly", part = part, base = pos, t = rng:NextNumber(0, 10) })
+	end
+end
+
+local hazardCooldown: { [string]: number } = {}
+
+local function tickHazards(dt: number)
+	local positions = {}
+	for _, player in Players:GetPlayers() do
+		local char = player.Character
+		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+		local hum = char and char:FindFirstChildOfClass("Humanoid")
+		if hrp and hum and hum.Health > 0 and hrp.Position.Y < SURFACE - 100 then
+			table.insert(positions, { player = player, hrp = hrp, hum = hum })
+		end
+	end
+	for _, h in hazards do
+		if h.kind == "Eel" then
+			h.t += dt * h.speed
+			local alpha = (math.sin(h.t * math.pi) + 1) / 2
+			local pos = h.a:Lerp(h.b, alpha)
+			local dir = (h.b - h.a).Unit * (if math.cos(h.t * math.pi) >= 0 then 1 else -1)
+			h.part.CFrame = CFrame.lookAt(pos, pos + dir)
+		else
+			h.t += dt
+			h.part.Position = h.base + Vector3.new(math.sin(h.t * 0.5) * 4, math.sin(h.t) * 3, math.cos(h.t * 0.5) * 4)
+		end
+		for _, p in positions do
+			local dist = (p.hrp.Position - h.part.Position).Magnitude
+			if h.kind == "Eel" and dist < 6 then
+				local key = "E" .. p.player.UserId
+				if (hazardCooldown[key] or 0) < os.clock() then
+					hazardCooldown[key] = os.clock() + 2
+					local s = services.DiveService.GetState(p.player)
+					if s then
+						services.DiveService.AddOxygen(p.player, -s.maxOxygen * 0.1)
+					end
+					services.DiveService.SetCause(p.player, "Eel")
+					p.hum:TakeDamage(10)
+					Net.Knockback:FireClient(p.player, (p.hrp.Position - h.part.Position).Unit * 50)
+					Net.Notify:FireClient(p.player, "Zapped by an eel! -10% oxygen", "error")
+				end
+			elseif h.kind == "Jelly" and dist < 6 then
+				services.DiveService.SetCause(p.player, "Jellyfish")
+				p.hum:TakeDamage(p.hum.MaxHealth * 0.05 * dt)
+				p.player.Character:SetAttribute("JellySlowUntil", os.clock() + 1.5)
+			end
+		end
+	end
+end
+
+------------------------------------------------------------------------------------------
+function PredatorService.Start()
+	creatureFolder = services.WorldService.Root():FindFirstChild("Creatures")
+	spawnLeviathan()
+	spawnHazards()
+
+	Net.UseFlare.OnServerEvent:Connect(useFlare)
+
+	task.spawn(function()
+		local acc = 0
+		local hintAcc = 0
+		while true do
+			local dt = task.wait(TICK)
+			acc += dt
+			hintAcc += dt
+			for _, lev in leviathans do
+				local ok, err = pcall(tickLeviathan, lev, dt)
+				if not ok then
+					warn("[Predator] " .. tostring(err))
+				end
+			end
+			tickHazards(dt)
+			-- noise decay + cursed relics keep you loud (§7.4)
+			for _, player in Players:GetPlayers() do
+				local n = (noise[player] or 0) - 15 * dt
+				local data = services.DataService.GetData(player)
+				if data then
+					for _, relic in data.Bag do
+						for _, m in relic.mutations do
+							if Mutations.ById[m] and Mutations.ById[m].Noisy then
+								n += 10 * dt
+							end
+						end
+					end
+				end
+				noise[player] = math.clamp(n, 0, 100)
+			end
+			if acc >= 5 then
+				acc = 0
+				local want = desiredLeviathans()
+				while #leviathans < want do
+					spawnLeviathan()
+				end
+				while #leviathans > want do
+					despawnLeviathan()
+				end
+			end
+			if hintAcc >= 0.25 then
+				hintAcc = 0
+				for _, player in Players:GetPlayers() do
+					local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+					if hrp and SURFACE - hrp.Position.Y > L.MinDepth - 150 then
+						local nearest, state = math.huge, "None"
+						for _, lev in leviathans do
+							local d = (lev.pos - hrp.Position).Magnitude
+							if d < nearest then
+								nearest = d
+								state = if lev.target == player then lev.state else "Patrol"
+							end
+						end
+						Net.PredatorHint:FireClient(player, { Distance = nearest, State = state, Noise = noise[player] or 0 })
+					end
+				end
+			end
+		end
+	end)
+
+	Players.PlayerRemoving:Connect(function(p)
+		noise[p] = nil
+		hunted[p] = nil
+		flareLimiter:Remove(p)
+		for _, lev in leviathans do
+			if lev.target == p then
+				lev.target = nil
+				lev.state = "Patrol"
+			end
+		end
+	end)
+end
+
+return PredatorService
diff --git a/src/server/Services/QuestService.luau b/src/server/Services/QuestService.luau
new file mode 100644
index 0000000..796e991
--- /dev/null
+++ b/src/server/Services/QuestService.luau
@@ -0,0 +1,323 @@
+-- QuestService (Master Plan §11.3, §15.5, §17): player level/XP, daily & weekly quests,
+-- Tide Pass season track, 7-day login calendar, and onboarding timers (Starter Pack at
+-- minute 8, Session10min funnel step).
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local Quests = require(Shared.Config.Quests)
+local Economy = require(Shared.Config.Economy)
+
+local TP = Economy.TidePass
+local QuestService = {}
+local services
+local limiter = RateLimiter.new(8, 3)
+
+function QuestService.Init(s)
+	services = s
+end
+
+local function dayIndex(): number
+	return os.time() // 86400
+end
+
+local function weekIndex(): number
+	return (os.time() + 3 * 86400) // (7 * 86400) -- weeks start Monday 00:00 UTC
+end
+
+local function pick(pool, count: number, seed: number)
+	local r = Random.new(seed)
+	local copy = table.clone(pool)
+	local out = {}
+	for _ = 1, math.min(count, #copy) do
+		local i = r:NextInteger(1, #copy)
+		local q = table.remove(copy, i)
+		table.insert(out, { Id = q.Id, Progress = 0, Claimed = false })
+	end
+	return out
+end
+
+local function findDef(id: string)
+	for _, list in { Quests.Daily, Quests.Weekly } do
+		for _, q in list do
+			if q.Id == id then
+				return q
+			end
+		end
+	end
+	return nil
+end
+
+local function ensureQuests(player: Player, data)
+	local q = data.Quests
+	local d, w = dayIndex(), weekIndex()
+	local changed = false
+	if q.Day ~= d then
+		q.Day = d
+		q.Daily = pick(Quests.Daily, Quests.DailyCount, d * 7919 + player.UserId)
+		changed = true
+	end
+	if q.Week ~= w then
+		q.Week = w
+		q.Weekly = pick(Quests.Weekly, Quests.WeeklyCount, w * 104729 + player.UserId)
+		changed = true
+	end
+	if data.TidePass.SeasonId ~= TP.SeasonId then
+		data.TidePass = { SeasonId = TP.SeasonId, XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} }
+		changed = true
+	end
+	if changed then
+		services.DataService.Replicate(player, "Quests", "TidePass")
+	end
+end
+
+function QuestService.Progress(player: Player, stat: string, amount: number)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	ensureQuests(player, data)
+	local changed = false
+	for _, list in { data.Quests.Daily, data.Quests.Weekly } do
+		for _, entry in list do
+			local def = findDef(entry.Id)
+			if def and def.Stat == stat and not entry.Claimed and entry.Progress < def.Goal then
+				entry.Progress = math.min(def.Goal, entry.Progress + amount)
+				changed = true
+				if entry.Progress >= def.Goal then
+					Net.Notify:FireClient(player, `Quest complete: {def.Text}! Claim it in Quests.`, "reward")
+				end
+			end
+		end
+	end
+	if changed then
+		services.DataService.Replicate(player, "Quests")
+	end
+end
+
+function QuestService.AddXp(player: Player, amount: number)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	data.XP += amount
+	local leveled = false
+	while data.XP >= Formulas.LevelXp(data.Level) do
+		data.XP -= Formulas.LevelXp(data.Level)
+		data.Level += 1
+		leveled = true
+		services.CurrencyService.AddPearls(player, 5, "LevelUp")
+		local extra = ""
+		if data.Level == Economy.Raid.MinLevel then
+			extra = " Raiding unlocked!"
+		elseif data.Level == Economy.Social.TradeMinLevel then
+			extra = " Trading unlocked!"
+		end
+		Net.Notify:FireClient(player, `Level {data.Level}! +5 Pearls.{extra}`, "upgrade")
+	end
+	services.DataService.Replicate(player, "XP", "Level")
+	if leveled then
+		services.AnnouncementService.UpdateTitle(player)
+	end
+end
+
+function QuestService.AddSeasonXp(player: Player, amount: number): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	ensureQuests(player, data)
+	local before = data.TidePass.XP // TP.XpPerTier
+	data.TidePass.XP = math.min(data.TidePass.XP + amount, TP.Tiers * TP.XpPerTier)
+	local after = data.TidePass.XP // TP.XpPerTier
+	if after > before then
+		Net.Notify:FireClient(player, `Tide Pass tier {after} reached!`, "reward")
+	end
+	services.DataService.Replicate(player, "TidePass")
+	return true
+end
+
+function QuestService.UnlockPremium(player: Player): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	ensureQuests(player, data)
+	data.TidePass.Premium = true
+	services.DataService.Replicate(player, "TidePass")
+	Net.Notify:FireClient(player, "Tide Pass Premium unlocked!", "reward")
+	return true
+end
+
+-- Tier rewards (§15.5)
+function QuestService.TierReward(tier: number, premium: boolean)
+	if premium then
+		if tier == TP.Tiers then
+			return { Relic = "Mythic" }
+		elseif tier % 10 == 0 then
+			return { Relic = "Epic" }
+		elseif tier % 5 == 0 then
+			return { Boost = "MutationPotion", Seconds = 600 }
+		end
+		return { Pearls = 10 }
+	end
+	if tier % 10 == 0 then
+		return { Relic = "Rare" }
+	elseif tier % 5 == 0 then
+		return { Pearls = 20 }
+	end
+	return { Coins = 500 * tier }
+end
+
+local function claimTier(player: Player, tier: number, premium: boolean)
+	local data = services.DataService.GetData(player)
+	if not data or tier % 1 ~= 0 or tier < 1 or tier > TP.Tiers then
+		return
+	end
+	ensureQuests(player, data)
+	local tp = data.TidePass
+	if tp.XP // TP.XpPerTier < tier then
+		return
+	end
+	if premium and not tp.Premium then
+		Net.Offer:FireClient(player, "TidePassPremium")
+		return
+	end
+	local claimed = if premium then tp.ClaimedPremium else tp.ClaimedFree
+	if claimed[tostring(tier)] then
+		return
+	end
+	claimed[tostring(tier)] = true
+	local lines = services.CurrencyService.GrantReward(player, QuestService.TierReward(tier, premium), "TidePass")
+	services.DataService.Replicate(player, "TidePass")
+	Net.Notify:FireClient(player, `Tier {tier}: {table.concat(lines, ", ")}`, "reward")
+end
+
+local function claimQuest(player: Player, id: string)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	ensureQuests(player, data)
+	for _, list in { data.Quests.Daily, data.Quests.Weekly } do
+		for _, entry in list do
+			if entry.Id == id then
+				local def = findDef(id)
+				if def and not entry.Claimed and entry.Progress >= def.Goal then
+					entry.Claimed = true
+					local lines = services.CurrencyService.GrantReward(player, { Coins = def.Coins, Pearls = def.Pearls }, "Quest")
+					QuestService.AddSeasonXp(player, def.Xp)
+					services.DataService.Replicate(player, "Quests")
+					Net.Notify:FireClient(player, `{def.Text}: {table.concat(lines, ", ")} +{def.Xp} Tide XP`, "reward")
+				end
+				return
+			end
+		end
+	end
+end
+
+-- 7-day login calendar (§17). Streak breaks if a day is missed (Pass+ keeps it).
+local function updateLoginStreak(player: Player, data)
+	local d = dayIndex()
+	if data.LastLoginDay == d then
+		return
+	end
+	if data.LastLoginDay == d - 1 or services.MonetizationService.HasActiveSubscription(player) then
+		data.LoginStreak += 1
+	else
+		data.LoginStreak = 1
+	end
+	data.LastLoginDay = d
+	services.DataService.Replicate(player, "LoginStreak", "LastLoginDay", "LastDailyClaimDay")
+end
+
+local function claimDaily(player: Player)
+	local data = services.DataService.GetData(player)
+	if not data or data.LastDailyClaimDay == dayIndex() then
+		return
+	end
+	data.LastDailyClaimDay = dayIndex()
+	local dayInCycle = ((data.LoginStreak - 1) % #Economy.DailyRewards) + 1
+	local lines = services.CurrencyService.GrantReward(player, Economy.DailyRewards[dayInCycle], "DailyLogin")
+	services.DataService.Replicate(player, "LastDailyClaimDay")
+	Net.Notify:FireClient(player, `Day {dayInCycle} reward: {table.concat(lines, ", ")}`, "reward")
+end
+
+function QuestService.Start()
+	services.DataService.ProfileLoaded:Connect(function(player, profile)
+		ensureQuests(player, profile.Data)
+		updateLoginStreak(player, profile.Data)
+		services.AnalyticsService.Funnel(player, "Join")
+	end)
+
+	Net.RequestClaimQuest.OnServerEvent:Connect(function(player, id)
+		if limiter:Check(player) and typeof(id) == "string" then
+			claimQuest(player, id)
+		end
+	end)
+	Net.RequestClaimDaily.OnServerEvent:Connect(function(player)
+		if limiter:Check(player) then
+			claimDaily(player)
+		end
+	end)
+	Net.RequestClaimTier.OnServerEvent:Connect(function(player, tier, premium)
+		if limiter:Check(player) and typeof(tier) == "number" then
+			claimTier(player, tier, premium == true)
+		end
+	end)
+	Net.RequestBuyTidePassPearls.OnServerEvent:Connect(function(player)
+		local data = services.DataService.GetData(player)
+		if not limiter:Check(player) or not data or data.TidePass.Premium then
+			return
+		end
+		if services.CurrencyService.SpendPearls(player, TP.PremiumPearlCost, "TidePassPremium") then
+			QuestService.UnlockPremium(player)
+		else
+			Net.Notify:FireClient(player, `Need {TP.PremiumPearlCost} Pearls`, "error")
+		end
+	end)
+
+	-- Onboarding timers: Starter Pack at minute 8 (§15.10), Session10min funnel, day rollover
+	task.spawn(function()
+		local sessionStart: { [Player]: number } = {}
+		while true do
+			task.wait(15)
+			for _, player in Players:GetPlayers() do
+				local data = services.DataService.GetData(player)
+				if data then
+					sessionStart[player] = sessionStart[player] or os.time()
+					local sessionSeconds = os.time() - sessionStart[player]
+					if
+						data.StarterPackShownAt == 0
+						and not data.StarterPackBought
+						and data.PlayTime >= Economy.StarterPackMinute * 60
+					then
+						data.StarterPackShownAt = os.time()
+						services.DataService.Replicate(player, "StarterPackShownAt")
+						services.UpgradeService.PushDerived(player)
+						Net.Offer:FireClient(player, "StarterPack")
+					end
+					if sessionSeconds >= 600 then
+						services.AnalyticsService.Funnel(player, "Session10min")
+					end
+					ensureQuests(player, data)
+					updateLoginStreak(player, data)
+				end
+			end
+			for p in sessionStart do
+				if not p.Parent then
+					sessionStart[p] = nil
+				end
+			end
+		end
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return QuestService
diff --git a/src/server/Services/RaidService.luau b/src/server/Services/RaidService.luau
new file mode 100644
index 0000000..501742c
--- /dev/null
+++ b/src/server/Services/RaidService.luau
@@ -0,0 +1,457 @@
+-- RaidService (Master Plan §9, Appendix E): steal validation, carry state, steal-back,
+-- fairness guardrails, revenge teleport and the raid tutorial ghost (§17 step 11).
+--
+-- Anti-dupe: while a relic is being carried it stays in the OWNER's profile (flagged as being
+-- stolen). It only moves to the raider in one server step when the raider reaches their dock.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Relics = require(Shared.Config.Relics)
+local Rarities = require(Shared.Config.Rarities)
+local Mutations = require(Shared.Config.Mutations)
+local Economy = require(Shared.Config.Economy)
+local Build = require(script.Parent.Parent.Util.Build)
+
+local R = Economy.Raid
+
+local RaidService = {}
+local services
+local limiter = RateLimiter.new(4, 1)
+local holdStart: { [Player]: { dock: any, slot: number, t: number } } = {}
+local carrying: { [Player]: any } = {}
+local beingStolen: { [Player]: { [string]: Player } } = {}
+local raiderCooldown: { [Player]: number } = {}
+local victimImmuneUntil: { [Player]: number } = {}
+local victimLog: { [Player]: { number } } = {}
+local revenge: { [Player]: { thief: Player, untilTime: number } } = {}
+
+function RaidService.Init(s)
+	services = s
+end
+
+function RaidService.IsBeingStolen(owner: Player, uid: string): boolean
+	return beingStolen[owner] ~= nil and beingStolen[owner][uid] ~= nil
+end
+
+function RaidService.IsCarrying(player: Player): boolean
+	return carrying[player] ~= nil
+end
+
+local function stealsEnabled(): boolean
+	if not R.Enabled then
+		return false
+	end
+	if game.PrivateServerId ~= "" and not R.PrivateServerSteals then
+		return false
+	end
+	return true
+end
+
+function RaidService.IsShielded(owner: Player): (boolean, string?)
+	local data = services.DataService.GetData(owner)
+	if not data then
+		return true, "loading"
+	end
+	if data.PlayTime < R.NewPlayerShieldSeconds then
+		return true, "New player shield"
+	end
+	if (victimImmuneUntil[owner] or 0) > os.time() then
+		return true, "Recently robbed"
+	end
+	if os.time() - services.DockService.JoinedAt(owner) < R.JoinLockSeconds then
+		return true, "Dock Lock"
+	end
+	if services.DockService.GateActive(owner) then
+		return true, "Laser Gate"
+	end
+	local log = victimLog[owner]
+	if log then
+		local recent = 0
+		for _, t in log do
+			if os.time() - t < 3600 then
+				recent += 1
+			end
+		end
+		if recent >= R.MaxPerVictimPerHour then
+			return true, "Hourly limit"
+		end
+	end
+	return false, nil
+end
+
+function RaidService.InPowerBand(raider: Player, owner: Player): boolean
+	local rv = math.max(Formulas.DockValue(services.DataService.GetData(raider)), 50)
+	local ov = math.max(Formulas.DockValue(services.DataService.GetData(owner)), 1)
+	local ratio = ov / rv
+	return ratio >= R.PowerBandMin and ratio <= R.PowerBandMax
+end
+
+------------------------------------------------------------------------------------------
+-- Carry visuals
+------------------------------------------------------------------------------------------
+local function attachCarryVisual(raider: Player, relic)
+	local char = raider.Character
+	local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")) :: BasePart?
+	if not torso then
+		return
+	end
+	local def = Relics.ById[relic.id]
+	local model = Build.RelicModel(def, Rarities[relic.rarity].Color, relic.mutations, Mutations.ById, relic.size)
+	model.Name = "CarriedRelic"
+	model.Anchored = false
+	model.Massless = true
+	model.CFrame = torso.CFrame * CFrame.new(0, 0.5, 1.6)
+	local weld = Instance.new("WeldConstraint")
+	weld.Part0, weld.Part1 = torso, model
+	weld.Parent = model
+	model.Parent = char
+	local hl = Instance.new("Highlight")
+	hl.Name = "ThiefHighlight"
+	hl.FillColor = Color3.fromRGB(255, 50, 50)
+	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
+	hl.FillTransparency = 0.6
+	hl.Parent = char
+	local bb = Build.Billboard(torso, "THIEF!", UDim2.fromOffset(120, 40), Vector3.new(0, 4, 0), Color3.fromRGB(255, 70, 70))
+	bb.Name = "ThiefTag"
+	bb.AlwaysOnTop = true
+	bb.MaxDistance = 300
+	char:SetAttribute("CarrySlow", R.CarrySpeedMult)
+end
+
+local function clearCarryVisual(raider: Player)
+	local char = raider.Character
+	if not char then
+		return
+	end
+	for _, name in { "CarriedRelic", "ThiefHighlight" } do
+		local x = char:FindFirstChild(name)
+		if x then
+			x:Destroy()
+		end
+	end
+	for _, d in char:GetDescendants() do
+		if d.Name == "ThiefTag" then
+			d:Destroy()
+		end
+	end
+	char:SetAttribute("CarrySlow", nil)
+end
+
+local function endCarry(raider: Player, success: boolean, recoveredBy: Player?)
+	local c = carrying[raider]
+	if not c then
+		return
+	end
+	carrying[raider] = nil
+	clearCarryVisual(raider)
+	Net.CarryChanged:FireClient(raider, nil)
+	local owner = c.owner
+	if beingStolen[owner] then
+		beingStolen[owner][c.uid] = nil
+	end
+	raiderCooldown[raider] = os.clock() + R.RaiderCooldown
+	local def = Relics.ById[c.relicId]
+
+	if not success then
+		if raider.Parent then
+			Net.Notify:FireClient(raider, `The {def.Name} was knocked loose!`, "error")
+		end
+		if owner.Parent then
+			services.DockService.RefreshDock(owner)
+			Net.Notify:FireClient(owner, `Your {def.Name} is back on its stand!`, "reward")
+		end
+		if recoveredBy and recoveredBy ~= owner and recoveredBy.Parent then
+			-- Bounty for anyone who stops a thief (§9.1)
+			local relic = services.DataService.GetData(owner).Stands[tostring(c.slot)]
+			local bounty = relic and math.floor(Formulas.SellPrice(relic) * 0.1) or 100
+			services.CurrencyService.AddCoins(recoveredBy, math.max(bounty, 100), "Bounty")
+			Net.Notify:FireClient(recoveredBy, `Thief stopped! Bounty +{NumberFormat.short(math.max(bounty, 100))}`, "coins")
+		end
+		services.AnalyticsService.Custom(raider, "RaidFail", 1)
+		return
+	end
+
+	-- Success: move the relic in one step
+	local ownerData = services.DataService.GetData(owner)
+	local relic = ownerData and ownerData.Stands[tostring(c.slot)]
+	if not relic or relic.uid ~= c.uid then
+		return
+	end
+	services.DockService.RemoveDisplayed(owner, c.slot)
+	relic.placedAt = nil
+	services.DockService.AddRelicToDock(raider, relic)
+
+	local raiderData = services.DataService.GetData(raider)
+	raiderData.Stats.Steals += 1
+	ownerData.Stats.TimesRobbed += 1
+	services.DataService.Replicate(raider, "Stats")
+	services.DataService.Replicate(owner, "Stats")
+	victimImmuneUntil[owner] = os.time() + R.VictimImmunity
+	victimLog[owner] = victimLog[owner] or {}
+	table.insert(victimLog[owner], os.time())
+	revenge[owner] = { thief = raider, untilTime = os.clock() + R.RevengeWindow }
+
+	services.QuestService.Progress(raider, "Steal", 1)
+	services.QuestService.AddXp(raider, Economy.Xp.Steal)
+	services.AnalyticsService.Custom(raider, "RaidSuccess", 1, { CustomField01 = relic.rarity })
+	services.AnalyticsService.Custom(owner, "Robbed", 1, { CustomField01 = relic.rarity })
+	Net.Notify:FireClient(raider, `You stole a {def.Name}!`, "reward")
+	Net.Robbed:FireClient(owner, {
+		Thief = raider.DisplayName,
+		Relic = def.Name,
+		Rarity = relic.rarity,
+		RevengeSeconds = R.RevengeWindow,
+		HasVault = services.MonetizationService.Owns(owner, "VaultLock"),
+	})
+	if Rarities.TierOf(relic.rarity) >= Rarities.Legendary.Tier then
+		services.AnnouncementService.Server(`{raider.DisplayName} stole a {relic.rarity} {def.Name} from {owner.DisplayName}!`, relic.rarity)
+	end
+end
+
+function RaidService.OnCarrierDied(player: Player)
+	endCarry(player, false, nil)
+end
+
+------------------------------------------------------------------------------------------
+-- Steal request (Appendix E)
+------------------------------------------------------------------------------------------
+local function trySteal(raider: Player, dock, slot: number)
+	if not limiter:Check(raider) then
+		return
+	end
+	local owner = dock.Owner
+	local deny = function(msg: string)
+		Net.Notify:FireClient(raider, msg, "error")
+	end
+	if not owner or owner == raider then
+		return
+	end
+	if not stealsEnabled() then
+		return deny("Stealing is disabled in this server.")
+	end
+	local rData, oData = services.DataService.GetData(raider), services.DataService.GetData(owner)
+	if not (rData and oData) then
+		return
+	end
+	if rData.Level < R.MinLevel then
+		return deny(`Raiding unlocks at level {R.MinLevel}.`)
+	end
+	if carrying[raider] then
+		return deny("You're already carrying a relic!")
+	end
+	local shielded, why = RaidService.IsShielded(owner)
+	if shielded then
+		return deny(`This dock is protected ({why}).`)
+	end
+	if not RaidService.InPowerBand(raider, owner) then
+		return deny("That dock is outside your power band.")
+	end
+	if (raiderCooldown[raider] or 0) > os.clock() then
+		return deny(`Steal cooldown: {math.ceil(raiderCooldown[raider] - os.clock())}s`)
+	end
+	local hrp = raider.Character and raider.Character:FindFirstChild("HumanoidRootPart")
+	if not hrp or not services.WorldService.IsInsideDock(dock, hrp.Position) then
+		return
+	end
+	local relic = oData.Stands[tostring(slot)]
+	if not relic then
+		return
+	end
+	if relic.rarity == "Secret" and not R.AllowSecretSteal then
+		return deny("Secret relics can't be stolen.")
+	end
+	if services.DockService.PlacedRecently(owner, slot, R.PlacedProtectSeconds) then
+		return deny("That relic was just placed — it's protected for a moment.")
+	end
+	if RaidService.IsBeingStolen(owner, relic.uid) then
+		return
+	end
+	-- Server-timed hold (§23)
+	local h = holdStart[raider]
+	if not h or h.dock ~= dock or h.slot ~= slot or os.clock() - h.t < R.HoldSeconds - 0.3 then
+		return
+	end
+	holdStart[raider] = nil
+
+	beingStolen[owner] = beingStolen[owner] or {}
+	beingStolen[owner][relic.uid] = raider
+	carrying[raider] = { owner = owner, slot = slot, uid = relic.uid, relicId = relic.id, start = os.clock() }
+	attachCarryVisual(raider, relic)
+	-- hide the relic on the stand while it's carried
+	local stand = dock.Stands[slot]
+	local m = stand:FindFirstChild("RelicModel")
+	if m then
+		m.Transparency = 0.85
+	end
+	Net.CarryChanged:FireClient(raider, { Relic = relic.id, Owner = owner.DisplayName })
+	Net.Intruder:FireClient(owner, { Name = raider.DisplayName, UserId = raider.UserId, Stealing = Relics.ById[relic.id].Name })
+	Net.Notify:FireClient(raider, "Got it! Run back to YOUR dock before someone tags you!", "info")
+end
+
+------------------------------------------------------------------------------------------
+-- Raid tutorial ghost (§17 step 11)
+------------------------------------------------------------------------------------------
+local function runRaidTutorial(player: Player)
+	local data = services.DataService.GetData(player)
+	local dock = services.DockService.GetDock(player)
+	if not data or not dock or data.Flags.RaidTutorialDone then
+		return
+	end
+	local slot, relic
+	for k, r in data.Stands do
+		if not relic or Formulas.RelicCPS(r) < Formulas.RelicCPS(relic) then
+			slot, relic = tonumber(k), r
+		end
+	end
+	if not relic then
+		return
+	end
+	local stand = dock.Stands[slot]
+	local ghost = Build.Part({
+		Name = "TutorialGhost",
+		Shape = Enum.PartType.Ball,
+		Size = Vector3.one * 4,
+		CFrame = CFrame.new(stand.Position + Vector3.new(0, 4, 0)),
+		Color = Color3.fromRGB(200, 230, 255),
+		Material = Enum.Material.ForceField,
+		CanCollide = false,
+		Parent = services.WorldService.Root(),
+	})
+	Build.Billboard(ghost, "Ghost Thief", UDim2.fromOffset(140, 36), Vector3.new(0, 3, 0), Color3.fromRGB(200, 230, 255))
+	Net.Notify:FireClient(player, "A ghost is stealing your relic! Touch it to get it back!", "error")
+	Net.Intruder:FireClient(player, { Name = "Ghost Thief", UserId = 0, Stealing = Relics.ById[relic.id].Name, Tutorial = true })
+	local target = Vector3.new(0, ghost.Position.Y, 0)
+	local started = os.clock()
+	task.spawn(function()
+		while ghost.Parent and os.clock() - started < 45 do
+			local dt = task.wait(0.1)
+			local dir = target - ghost.Position
+			if dir.Magnitude > 1 then
+				ghost.Position += dir.Unit * 6 * dt
+			end
+			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+			if hrp and (hrp.Position - ghost.Position).Magnitude < 7 then
+				data.Flags.RaidTutorialDone = true
+				services.AnalyticsService.Funnel(player, "RaidTutorial")
+				Net.Notify:FireClient(
+					player,
+					"Recovered! Real thieves carry relics to their dock — tag them first. Laser Gates and Vault slots keep you safe.",
+					"reward"
+				)
+				services.CurrencyService.AddPearls(player, 10, "RaidTutorial")
+				break
+			end
+		end
+		if ghost.Parent then
+			ghost:Destroy()
+		end
+		data.Flags.RaidTutorialDone = true
+	end)
+end
+
+function RaidService.Start()
+	for _, dock in services.WorldService.GetDocks() do
+		for i, stand in dock.Stands do
+			local prompt = stand:FindFirstChild("Steal") :: ProximityPrompt
+			prompt.HoldDuration = R.HoldSeconds
+			prompt.PromptButtonHoldBegan:Connect(function(player)
+				holdStart[player] = { dock = dock, slot = i, t = os.clock() }
+			end)
+			prompt.Triggered:Connect(function(player)
+				trySteal(player, dock, i)
+			end)
+		end
+	end
+
+	Net.RequestRevenge.OnServerEvent:Connect(function(player)
+		local r = revenge[player]
+		revenge[player] = nil
+		if not r or r.untilTime < os.clock() or not r.thief.Parent then
+			return
+		end
+		local thiefDock = services.DockService.GetDock(r.thief)
+		local char = player.Character
+		if thiefDock and char then
+			services.SecurityService.AllowTeleport(player)
+			char:PivotTo(thiefDock.CFrame * CFrame.new(0, 4, 32))
+		end
+	end)
+
+	-- Carry loop: success at own dock, steal-back by touch
+	task.spawn(function()
+		while true do
+			task.wait(0.1)
+			for raider, c in carrying do
+				local char = raider.Character
+				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+				if not raider.Parent or not hrp or not c.owner.Parent then
+					endCarry(raider, false, nil)
+					continue
+				end
+				local myDock = services.DockService.GetDock(raider)
+				if myDock and services.WorldService.IsInsideDock(myDock, hrp.Position) then
+					endCarry(raider, true, nil)
+					continue
+				end
+				for _, other in Players:GetPlayers() do
+					if other ~= raider then
+						local ohrp = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
+						local ohum = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
+						if ohrp and ohum and ohum.Health > 0 and (ohrp.Position - hrp.Position).Magnitude < R.StealBackRadius then
+							endCarry(raider, false, other)
+							break
+						end
+					end
+				end
+			end
+		end
+	end)
+
+	-- Raid tutorial trigger at ~10 minutes of playtime
+	task.spawn(function()
+		while true do
+			task.wait(20)
+			for _, player in Players:GetPlayers() do
+				local data = services.DataService.GetData(player)
+				if
+					data
+					and not data.Flags.RaidTutorialDone
+					and not data.Flags.RaidTutorialStarted
+					and data.PlayTime >= 600
+					and next(data.Stands)
+				then
+					data.Flags.RaidTutorialStarted = true -- only offer once
+					runRaidTutorial(player)
+				end
+			end
+		end
+	end)
+
+	services.DataService.OnRelease(function(player)
+		-- Leaving while carrying: relic stays with the owner
+		endCarry(player, false, nil)
+		-- Owner leaving while being robbed: cancel the raid so the relic saves with them
+		for raider, c in carrying do
+			if c.owner == player then
+				endCarry(raider, false, nil)
+			end
+		end
+		beingStolen[player] = nil
+		raiderCooldown[player] = nil
+		victimImmuneUntil[player] = nil
+		victimLog[player] = nil
+		revenge[player] = nil
+		holdStart[player] = nil
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return RaidService
diff --git a/src/server/Services/RebirthService.luau b/src/server/Services/RebirthService.luau
new file mode 100644
index 0000000..27ee2a6
--- /dev/null
+++ b/src/server/Services/RebirthService.luau
@@ -0,0 +1,117 @@
+-- RebirthService — "Resurface" (Master Plan §12).
+-- Requirement: Pressure Mk II suit + LifetimeCoins >= 5M * 3^n.
+-- Resets Coins, upgrades (Display slots are kept so displayed relics stay put), suit and bag.
+-- Keeps relics, Codex, Pearls, passes, cosmetics, level. Grants +50% Coins, +2% luck (cap 30%)
+-- and a Rebirth Token for the talent tree.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Economy = require(Shared.Config.Economy)
+
+local RB = Economy.Rebirth
+local RebirthService = {}
+local services
+local limiter = RateLimiter.new(3, 0.5)
+
+function RebirthService.Init(s)
+	services = s
+end
+
+function RebirthService.CanRebirth(data): (boolean, string?)
+	if data.Suit < RB.RequiredSuit then
+		return false, "Requires the Pressure Mk II suit"
+	end
+	local need = Formulas.RebirthRequirement(data.Rebirths)
+	if data.LifetimeCoins < need then
+		return false, `Requires {NumberFormat.short(need)} lifetime Coins`
+	end
+	return true, nil
+end
+
+local function rebirth(player: Player)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	local ok, why = RebirthService.CanRebirth(data)
+	if not ok then
+		Net.Notify:FireClient(player, why, "error")
+		return
+	end
+	if services.RaidService.IsCarrying(player) or services.DiveService.IsDiving(player) then
+		Net.Notify:FireClient(player, "Return to your dock first.", "error")
+		return
+	end
+	local keepDisplay = data.Upgrades.Display
+	data.Coins = 0
+	data.Uncollected = 0
+	data.Upgrades = { Display = keepDisplay }
+	data.Suit = if (data.Talents.StartNeoprene or 0) > 0 then 2 else 1
+	for _, relic in data.Bag do
+		table.insert(data.Storage, relic)
+	end
+	data.Bag = {}
+	data.Rebirths += 1
+	data.RebirthTokens += 1
+	services.DataService.Replicate(player, "Coins", "Uncollected", "Upgrades", "Suit", "Bag", "Storage", "Rebirths", "RebirthTokens")
+	services.CurrencyService.RefreshLeaderstats(player, data)
+	services.UpgradeService.PushDerived(player)
+	services.UpgradeService.ApplySuitVisual(player)
+	services.DockService.RefreshDock(player)
+	services.AnalyticsService.Custom(player, "Rebirth", data.Rebirths)
+	services.AnnouncementService.Server(`{player.DisplayName} RESURFACED (x{data.Rebirths})!`, "Epic")
+	services.AnnouncementService.UpdateTitle(player)
+	Net.Notify:FireClient(
+		player,
+		`Resurfaced! Coins x{Formulas.RebirthMultiplier(data.Rebirths)}, +1 Rebirth Token.`,
+		"upgrade"
+	)
+end
+
+local function buyTalent(player: Player, id: string)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return
+	end
+	for _, t in RB.Talents do
+		if t.Id == id then
+			local level = data.Talents[id] or 0
+			if level >= t.Max then
+				return Net.Notify:FireClient(player, `{t.Name} is maxed.`, "info")
+			end
+			if data.RebirthTokens < t.Cost then
+				return Net.Notify:FireClient(player, "Not enough Rebirth Tokens.", "error")
+			end
+			data.RebirthTokens -= t.Cost
+			data.Talents[id] = level + 1
+			services.DataService.Replicate(player, "Talents", "RebirthTokens")
+			services.UpgradeService.PushDerived(player)
+			Net.Notify:FireClient(player, `Talent: {t.Name} Lv {level + 1}`, "upgrade")
+			return
+		end
+	end
+end
+
+function RebirthService.Start()
+	Net.RequestRebirth.OnServerEvent:Connect(function(player)
+		if limiter:Check(player) then
+			rebirth(player)
+		end
+	end)
+	Net.RequestTalent.OnServerEvent:Connect(function(player, id)
+		if limiter:Check(player) and typeof(id) == "string" then
+			buyTalent(player, id)
+		end
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return RebirthService
diff --git a/src/server/Services/SecurityService.luau b/src/server/Services/SecurityService.luau
new file mode 100644
index 0000000..b5253c1
--- /dev/null
+++ b/src/server/Services/SecurityService.luau
@@ -0,0 +1,98 @@
+-- SecurityService (Master Plan §23): movement sanity checks, text filtering helper, and
+-- exploit flag logging. Remote rate limits and argument checks live with each handler.
+--
+-- "Treat the client as a keyboard and a monitor. It only asks; the server decides."
+
+local Players = game:GetService("Players")
+local TextService = game:GetService("TextService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Formulas = require(Shared.Formulas)
+local Upgrades = require(Shared.Config.Upgrades)
+
+local CHECK_INTERVAL = 1
+local TOLERANCE = 1.5 -- flag anything faster than 1.5x the expected max (§23)
+local FLAGS_BEFORE_KICK = 8
+
+local SecurityService = {}
+local services
+local lastPos: { [Player]: Vector3 } = {}
+local flags: { [Player]: number } = {}
+local allowedTeleport: { [Player]: number } = {}
+
+function SecurityService.Init(s)
+	services = s
+end
+
+-- Services that legitimately teleport a character call this first
+function SecurityService.AllowTeleport(player: Player)
+	allowedTeleport[player] = os.clock() + 2
+end
+
+-- Filters text for display to everyone (dock names). Returns nil if filtering fails.
+function SecurityService.FilterForBroadcast(player: Player, text: string): string?
+	local ok, result = pcall(function()
+		local filtered = TextService:FilterStringAsync(text, player.UserId)
+		return filtered:GetNonChatStringForBroadcastAsync()
+	end)
+	if ok and typeof(result) == "string" and result ~= "" then
+		return result
+	end
+	return nil
+end
+
+local function expectedMax(player: Player): number
+	local data = services.DataService.GetData(player)
+	if not data then
+		return 100
+	end
+	local swim = Formulas.SwimSpeed(data, services.MonetizationService.OwnedSet(player)) * Upgrades.Base.BoostMult
+	return math.max(swim, 32) + 20 -- walking/jumping/falling headroom
+end
+
+function SecurityService.Start()
+	task.spawn(function()
+		while true do
+			task.wait(CHECK_INTERVAL)
+			for _, player in Players:GetPlayers() do
+				local char = player.Character
+				local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+				if hrp then
+					local pos = hrp.Position
+					local prev = lastPos[player]
+					lastPos[player] = pos
+					if prev and (allowedTeleport[player] or 0) < os.clock() then
+						-- Horizontal speed only: falling into the ocean from a dock is legit
+						local flat = Vector3.new(pos.X - prev.X, 0, pos.Z - prev.Z).Magnitude / CHECK_INTERVAL
+						local vertical = math.abs(pos.Y - prev.Y) / CHECK_INTERVAL
+						local limit = expectedMax(player) * TOLERANCE
+						if flat > limit or (pos.Y < 0 and vertical > limit * 2) then
+							flags[player] = (flags[player] or 0) + 1
+							warn(`[Security] {player.Name} moved {math.floor(flat)} studs/s (limit {math.floor(limit)})`)
+							if flags[player] >= FLAGS_BEFORE_KICK then
+								services.AnalyticsService.Custom(player, "ExploitKick", flags[player])
+								player:Kick("Unexpected movement detected.")
+							end
+						else
+							flags[player] = math.max(0, (flags[player] or 0) - 0.25)
+						end
+					end
+				end
+			end
+		end
+	end)
+	Players.PlayerAdded:Connect(function(p)
+		p.CharacterAdded:Connect(function()
+			lastPos[p] = nil
+			allowedTeleport[p] = os.clock() + 5
+		end)
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		lastPos[p] = nil
+		flags[p] = nil
+		allowedTeleport[p] = nil
+	end)
+end
+
+return SecurityService
diff --git a/src/server/Services/SocialService.luau b/src/server/Services/SocialService.luau
new file mode 100644
index 0000000..3477ed2
--- /dev/null
+++ b/src/server/Services/SocialService.luau
@@ -0,0 +1,185 @@
+-- SocialService (Master Plan §14): friend boost, group perk, Dive Parties (shared sonar,
+-- +10% luck per member) and invite rewards.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Economy = require(Shared.Config.Economy)
+
+local S = Economy.Social
+local SocialService = {}
+local services
+local limiter = RateLimiter.new(5, 1)
+local friendCache: { [Player]: { [number]: boolean } } = {}
+local inGroup: { [Player]: boolean } = {}
+local parties: { [Player]: { Player } } = {} -- member -> shared member list
+local partyInvites: { [Player]: { from: Player, t: number } } = {}
+
+function SocialService.Init(s)
+	services = s
+end
+
+local function isFriend(a: Player, b: Player): boolean
+	local cache = friendCache[a]
+	if not cache then
+		cache = {}
+		friendCache[a] = cache
+	end
+	if cache[b.UserId] == nil then
+		local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
+		cache[b.UserId] = ok and result == true
+	end
+	return cache[b.UserId]
+end
+
+function SocialService.FriendCount(player: Player): number
+	local n = 0
+	for _, other in Players:GetPlayers() do
+		if other ~= player and isFriend(player, other) then
+			n += 1
+		end
+	end
+	return n
+end
+
+function SocialService.GetCoinMultiplier(player: Player): number
+	local friendBonus = math.min(SocialService.FriendCount(player) * S.FriendBoostPer, S.FriendBoostMax)
+	local group = if inGroup[player] then S.GroupBonus else 0
+	return 1 + friendBonus + group
+end
+
+function SocialService.GetParty(player: Player): { Player }?
+	return parties[player]
+end
+
+function SocialService.GetPartyLuck(player: Player): number
+	local party = parties[player]
+	if not party then
+		return 1
+	end
+	return 1 + (#party - 1) * S.PartyLuckPer
+end
+
+local function pushParty(list: { Player })
+	local names = {}
+	for _, p in list do
+		table.insert(names, { Name = p.DisplayName, UserId = p.UserId })
+	end
+	for _, p in list do
+		Net.PartyUpdated:FireClient(p, { Members = names })
+	end
+end
+
+local function leaveParty(player: Player)
+	local party = parties[player]
+	if not party then
+		return
+	end
+	parties[player] = nil
+	local i = table.find(party, player)
+	if i then
+		table.remove(party, i)
+	end
+	if player.Parent then
+		Net.PartyUpdated:FireClient(player, { Members = {} })
+	end
+	if #party <= 1 then
+		for _, p in party do
+			parties[p] = nil
+			Net.PartyUpdated:FireClient(p, { Members = {} })
+		end
+	else
+		pushParty(party)
+	end
+end
+
+function SocialService.Start()
+	services.DataService.ProfileLoaded:Connect(function(player, profile)
+		if S.GroupId ~= 0 then
+			local ok, result = pcall(player.IsInGroup, player, S.GroupId)
+			inGroup[player] = ok and result == true
+		end
+		-- Invite reward (§14): referred players earn Pearls for both after 10 minutes
+		local okJoin, joinData = pcall(player.GetJoinData, player)
+		local referrer = okJoin and joinData and joinData.ReferredByPlayerId
+		if referrer and referrer ~= 0 and not profile.Data.Flags.InviteRewarded then
+			task.delay(600, function()
+				if not player.Parent or profile.Data.Flags.InviteRewarded then
+					return
+				end
+				profile.Data.Flags.InviteRewarded = true
+				services.CurrencyService.AddPearls(player, 25, "InviteReward")
+				Net.Notify:FireClient(player, "Thanks for joining a friend! +25 Pearls", "reward")
+				local inviter = Players:GetPlayerByUserId(referrer)
+				if inviter then
+					services.CurrencyService.AddPearls(inviter, 25, "InviteReward")
+					Net.Notify:FireClient(inviter, `{player.DisplayName} played 10 minutes! +25 Pearls`, "reward")
+				end
+			end)
+		end
+		-- Friend joined notice
+		for _, other in Players:GetPlayers() do
+			if other ~= player and isFriend(other, player) then
+				Net.Notify:FireClient(other, `Your friend {player.DisplayName} joined! +{math.floor(S.FriendBoostPer * 100)}% Coins`, "info")
+				services.AnalyticsService.Custom(other, "FriendJoined", 1)
+			end
+		end
+	end)
+
+	Net.PartyInvite.OnServerEvent:Connect(function(player, targetUserId)
+		if not limiter:Check(player) or typeof(targetUserId) ~= "number" then
+			return
+		end
+		local target = Players:GetPlayerByUserId(targetUserId)
+		if not target or target == player or parties[target] then
+			return
+		end
+		local party = parties[player]
+		if party and #party >= S.PartyMax then
+			return Net.Notify:FireClient(player, "Your party is full.", "error")
+		end
+		partyInvites[target] = { from = player, t = os.clock() }
+		Net.PartyUpdated:FireClient(target, { Invite = player.DisplayName, FromUserId = player.UserId })
+	end)
+
+	Net.PartyRespond.OnServerEvent:Connect(function(player, accept)
+		local inv = partyInvites[player]
+		partyInvites[player] = nil
+		if not inv or os.clock() - inv.t > 60 or accept ~= true or not inv.from.Parent then
+			return
+		end
+		if parties[player] then
+			leaveParty(player)
+		end
+		local party = parties[inv.from]
+		if not party then
+			party = { inv.from }
+			parties[inv.from] = party
+		end
+		if #party >= S.PartyMax then
+			return
+		end
+		table.insert(party, player)
+		parties[player] = party
+		pushParty(party)
+		services.AnalyticsService.Custom(player, "PartyFormed", #party)
+	end)
+
+	Net.PartyLeave.OnServerEvent:Connect(leaveParty)
+
+	Players.PlayerRemoving:Connect(function(p)
+		leaveParty(p)
+		friendCache[p] = nil
+		inGroup[p] = nil
+		partyInvites[p] = nil
+		limiter:Remove(p)
+		for _, cache in friendCache do
+			cache[p.UserId] = nil
+		end
+	end)
+end
+
+return SocialService
diff --git a/src/server/Services/TradeService.luau b/src/server/Services/TradeService.luau
new file mode 100644
index 0000000..1a7526a
--- /dev/null
+++ b/src/server/Services/TradeService.luau
@@ -0,0 +1,262 @@
+-- TradeService (Master Plan §14, §23): two-sided trade window, both confirm, 5s countdown,
+-- server-side re-validation and an atomic swap (relic UIDs are moved, never copied).
+-- Only Storage relics can be traded (not the dive bag, not displayed, not locked).
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Economy = require(Shared.Config.Economy)
+local Relics = require(Shared.Config.Relics)
+
+local MAX_ITEMS = 8
+local TradeService = {}
+local services
+local limiter = RateLimiter.new(8, 3)
+local sessions: { [Player]: any } = {}
+local invites: { [Player]: { [Player]: number } } = {} -- target -> {from -> clock}
+
+function TradeService.Init(s)
+	services = s
+end
+
+local function partnerOf(session, player: Player): Player
+	return if session.a == player then session.b else session.a
+end
+
+local function relicsFor(player: Player, uids: { string })
+	local data = services.DataService.GetData(player)
+	local out = {}
+	for _, uid in uids do
+		for _, r in data.Storage do
+			if r.uid == uid then
+				table.insert(out, r)
+			end
+		end
+	end
+	return out
+end
+
+local function push(session)
+	for _, p in { session.a, session.b } do
+		local partner = partnerOf(session, p)
+		Net.TradeUpdated:FireClient(p, {
+			Kind = "Session",
+			Partner = partner.DisplayName,
+			MyOffer = relicsFor(p, session.offers[p]),
+			TheirOffer = relicsFor(partner, session.offers[partner]),
+			MyConfirm = session.confirmed[p] == true,
+			TheirConfirm = session.confirmed[partner] == true,
+			Countdown = if session.countdownEnd then math.max(0, session.countdownEnd - os.clock()) else nil,
+		})
+	end
+end
+
+local function close(session, reason: string)
+	for _, p in { session.a, session.b } do
+		if sessions[p] == session then
+			sessions[p] = nil
+			if p.Parent then
+				Net.TradeUpdated:FireClient(p, { Kind = "Closed", Reason = reason })
+			end
+		end
+	end
+	session.closed = true
+end
+
+local function validOffer(player: Player, uids: { string }): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local seen = {}
+	for _, uid in uids do
+		if seen[uid] then
+			return false
+		end
+		seen[uid] = true
+		local found = false
+		for _, r in data.Storage do
+			if r.uid == uid and not r.locked then
+				found = true
+			end
+		end
+		if not found then
+			return false
+		end
+	end
+	return true
+end
+
+local function execute(session)
+	local a, b = session.a, session.b
+	if not (validOffer(a, session.offers[a]) and validOffer(b, session.offers[b])) then
+		close(session, "Trade items changed — cancelled.")
+		return
+	end
+	local da, db = services.DataService.GetData(a), services.DataService.GetData(b)
+	-- Take from both first, then give (same server step, no yields)
+	local fromA, fromB = {}, {}
+	for _, uid in session.offers[a] do
+		table.insert(fromA, (services.InventoryService.Take(da, uid)))
+	end
+	for _, uid in session.offers[b] do
+		table.insert(fromB, (services.InventoryService.Take(db, uid)))
+	end
+	for _, r in fromA do
+		table.insert(db.Storage, r)
+		services.InventoryService.RecordCodex(b, r)
+	end
+	for _, r in fromB do
+		table.insert(da.Storage, r)
+		services.InventoryService.RecordCodex(a, r)
+	end
+	local stamp = os.time()
+	local function log(data, partner: Player, gave, got)
+		data.TradeLog = data.TradeLog or {}
+		local names = function(list)
+			local n = {}
+			for _, r in list do
+				table.insert(n, Relics.ById[r.id].Name)
+			end
+			return table.concat(n, ", ")
+		end
+		table.insert(data.TradeLog, { t = stamp, with = partner.UserId, gave = names(gave), got = names(got) })
+		while #data.TradeLog > 20 do
+			table.remove(data.TradeLog, 1)
+		end
+	end
+	log(da, b, fromA, fromB)
+	log(db, a, fromB, fromA)
+	services.DataService.Replicate(a, "Storage", "TradeLog")
+	services.DataService.Replicate(b, "Storage", "TradeLog")
+	services.AnalyticsService.Custom(a, "TradeCompleted", #fromA + #fromB)
+	services.AnalyticsService.Custom(b, "TradeCompleted", #fromA + #fromB)
+	close(session, "Trade complete!")
+	-- Save both right away so a crash can't roll back one side only
+	task.spawn(services.DataService.SaveNow, a)
+	task.spawn(services.DataService.SaveNow, b)
+end
+
+local function canTrade(player: Player): (boolean, string?)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false, "Loading"
+	end
+	if data.Level < Economy.Social.TradeMinLevel then
+		return false, `Trading unlocks at level {Economy.Social.TradeMinLevel}`
+	end
+	if services.RaidService.IsCarrying(player) then
+		return false, "Busy"
+	end
+	return true, nil
+end
+
+function TradeService.Start()
+	Net.TradeRequest.OnServerEvent:Connect(function(player, targetUserId)
+		if not limiter:Check(player) or typeof(targetUserId) ~= "number" then
+			return
+		end
+		local target = Players:GetPlayerByUserId(targetUserId)
+		if not target or target == player or sessions[player] or sessions[target] then
+			return
+		end
+		local ok, why = canTrade(player)
+		if not ok then
+			return Net.Notify:FireClient(player, why, "error")
+		end
+		ok, why = canTrade(target)
+		if not ok then
+			return Net.Notify:FireClient(player, `{target.DisplayName} can't trade yet.`, "error")
+		end
+		invites[target] = invites[target] or {}
+		invites[target][player] = os.clock()
+		Net.TradeUpdated:FireClient(target, { Kind = "Invite", From = player.DisplayName, FromUserId = player.UserId })
+		Net.Notify:FireClient(player, `Trade request sent to {target.DisplayName}`, "info")
+	end)
+
+	Net.TradeRespond.OnServerEvent:Connect(function(player, fromUserId, accept)
+		if not limiter:Check(player) or typeof(fromUserId) ~= "number" then
+			return
+		end
+		local from = Players:GetPlayerByUserId(fromUserId)
+		local inv = invites[player]
+		if not from or not inv or not inv[from] or os.clock() - inv[from] > 60 then
+			return
+		end
+		inv[from] = nil
+		if accept ~= true then
+			return Net.Notify:FireClient(from, `{player.DisplayName} declined the trade.`, "info")
+		end
+		if sessions[player] or sessions[from] then
+			return
+		end
+		local session = { a = from, b = player, offers = { [from] = {}, [player] = {} }, confirmed = {}, countdownEnd = nil }
+		sessions[from] = session
+		sessions[player] = session
+		push(session)
+	end)
+
+	Net.TradeSetOffer.OnServerEvent:Connect(function(player, uids)
+		local session = sessions[player]
+		if not session or not limiter:Check(player) or typeof(uids) ~= "table" then
+			return
+		end
+		local clean = {}
+		for i, uid in uids do
+			if typeof(uid) == "string" and i <= MAX_ITEMS then
+				table.insert(clean, uid)
+			end
+		end
+		if not validOffer(player, clean) then
+			return
+		end
+		session.offers[player] = clean
+		session.confirmed = {}
+		session.countdownEnd = nil
+		push(session)
+	end)
+
+	Net.TradeConfirm.OnServerEvent:Connect(function(player)
+		local session = sessions[player]
+		if not session or not limiter:Check(player) then
+			return
+		end
+		session.confirmed[player] = true
+		if session.confirmed[session.a] and session.confirmed[session.b] then
+			local token = {}
+			session.token = token
+			session.countdownEnd = os.clock() + Economy.Social.TradeCountdown
+			push(session)
+			task.delay(Economy.Social.TradeCountdown, function()
+				if not session.closed and session.token == token and session.confirmed[session.a] and session.confirmed[session.b] then
+					execute(session)
+				end
+			end)
+		else
+			push(session)
+		end
+	end)
+
+	Net.TradeCancel.OnServerEvent:Connect(function(player)
+		local session = sessions[player]
+		if session then
+			close(session, `{player.DisplayName} cancelled the trade.`)
+		end
+	end)
+
+	services.DataService.OnRelease(function(player)
+		local session = sessions[player]
+		if session then
+			close(session, "Partner left.")
+		end
+		invites[player] = nil
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+end
+
+return TradeService
diff --git a/src/server/Services/UpgradeService.luau b/src/server/Services/UpgradeService.luau
new file mode 100644
index 0000000..1024996
--- /dev/null
+++ b/src/server/Services/UpgradeService.luau
@@ -0,0 +1,182 @@
+-- UpgradeService (Master Plan §11): Coin upgrade tracks and suit tiers.
+-- Also pushes derived stats (oxygen, speed, bag size…) to the client for display and sets
+-- character attributes the client SwimController reads.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local Net = require(Shared.Net)
+local RateLimiter = require(Shared.RateLimiter)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Upgrades = require(Shared.Config.Upgrades)
+
+local UpgradeService = {}
+local services
+local limiter = RateLimiter.new(8, 4)
+
+function UpgradeService.Init(s)
+	services = s
+end
+
+function UpgradeService.Derived(player: Player)
+	local data = services.DataService.GetData(player)
+	if not data then
+		return nil
+	end
+	local passes = services.MonetizationService.OwnedSet(player)
+	local subscribed = services.MonetizationService.HasActiveSubscription(player)
+	return {
+		MaxOxygen = Formulas.MaxOxygen(data, passes),
+		SwimSpeed = Formulas.SwimSpeed(data, passes),
+		BagSize = Formulas.BagSize(data, passes),
+		StandCount = Formulas.StandCount(data, passes),
+		VaultCount = Formulas.VaultCount(data, passes),
+		SalvageSeconds = Formulas.SalvageSeconds(data),
+		SonarRange = Formulas.SonarRange(data),
+		SonarCooldown = Formulas.SonarCooldown(data),
+		OfflineRate = Formulas.OfflineRate(data),
+		OfflineCapHours = Formulas.OfflineCapHours(data, passes, subscribed),
+		CoinMult = services.DockService.GetCoinMultiplier(player),
+		Luck = services.MonetizationService.GetLuckMultiplier(player) * services.EventService.GetLuckMultiplier(),
+		RebirthRequirement = Formulas.RebirthRequirement(data.Rebirths),
+		StarterPackAvailable = services.MonetizationService.StarterPackAvailable(player),
+		StarterPackShownAt = data.StarterPackShownAt,
+		CanBuyRandom = services.PolicyWrapper.CanBuyRandomItems(player),
+	}
+end
+
+function UpgradeService.PushDerived(player: Player)
+	local d = UpgradeService.Derived(player)
+	if not d then
+		return
+	end
+	services.DataService.Push(player, { Derived = d })
+	local char = player.Character
+	if char then
+		char:SetAttribute("SwimSpeed", d.SwimSpeed)
+		char:SetAttribute("SalvageSeconds", d.SalvageSeconds)
+	end
+end
+
+function UpgradeService.Purchase(player: Player, trackId: string): boolean
+	local data = services.DataService.GetData(player)
+	local track = Upgrades.ById[trackId]
+	if not data or not track then
+		return false
+	end
+	local level = data.Upgrades[trackId] or 0
+	if level >= track.Max then
+		Net.Notify:FireClient(player, `{track.Name} is maxed!`, "info")
+		return false
+	end
+	local cost = Upgrades.Cost(trackId, level)
+	if not services.CurrencyService.SpendCoins(player, cost, "Upgrade_" .. trackId) then
+		Net.Notify:FireClient(player, `Need {NumberFormat.short(cost)} Coins`, "error")
+		return false
+	end
+	data.Upgrades[trackId] = level + 1
+	services.DataService.Replicate(player, "Upgrades")
+	UpgradeService.PushDerived(player)
+	if trackId == "Display" or trackId == "Gate" then
+		services.DockService.RefreshDock(player)
+	end
+	services.QuestService.Progress(player, "Upgrade", 1)
+	services.AnalyticsService.Funnel(player, "FirstUpgrade")
+	Net.Notify:FireClient(player, `{track.Name} → Lv {level + 1}`, "upgrade")
+	return true
+end
+
+function UpgradeService.BuySuit(player: Player): boolean
+	local data = services.DataService.GetData(player)
+	if not data then
+		return false
+	end
+	local nextIndex = data.Suit + 1
+	local suit = Upgrades.Suits[nextIndex]
+	if not suit then
+		return false
+	end
+	if suit.ComingSoon then
+		Net.Notify:FireClient(player, `{suit.Name} arrives with The Sunken Throne update!`, "info")
+		return false
+	end
+	if not services.CurrencyService.SpendCoins(player, suit.Cost, "Suit_" .. suit.Id) then
+		Net.Notify:FireClient(player, `Need {NumberFormat.short(suit.Cost)} Coins`, "error")
+		return false
+	end
+	data.Suit = nextIndex
+	services.DataService.Replicate(player, "Suit")
+	UpgradeService.PushDerived(player)
+	UpgradeService.ApplySuitVisual(player)
+	services.AnalyticsService.Custom(player, "ZoneUnlocked", nextIndex)
+	if nextIndex == 2 then
+		services.AnalyticsService.Funnel(player, "KelpSuit")
+	end
+	Net.Notify:FireClient(player, `New suit: {suit.Name}! You can now dive safely to zone {nextIndex}.`, "upgrade")
+	return true
+end
+
+-- Tints the R15 character to show the suit tier (stand-in until suit accessories exist)
+function UpgradeService.ApplySuitVisual(player: Player)
+	local data = services.DataService.GetData(player)
+	local char = player.Character
+	if not data or not char then
+		return
+	end
+	local suit = Upgrades.Suits[data.Suit]
+	for _, part in char:GetChildren() do
+		if part:IsA("BasePart") and part.Name ~= "Head" and part.Name ~= "HumanoidRootPart" then
+			part.Color = suit.Color
+		end
+	end
+	for _, c in char:GetChildren() do
+		if c:IsA("Shirt") or c:IsA("Pants") then
+			c:Destroy()
+		end
+	end
+end
+
+function UpgradeService.Start()
+	Net.RequestUpgrade.OnServerEvent:Connect(function(player, trackId)
+		if limiter:Check(player) and typeof(trackId) == "string" then
+			UpgradeService.Purchase(player, trackId)
+		end
+	end)
+	Net.RequestBuySuit.OnServerEvent:Connect(function(player)
+		if limiter:Check(player) then
+			UpgradeService.BuySuit(player)
+		end
+	end)
+	services.DataService.ProfileLoaded:Connect(function(player)
+		local function onChar(char)
+			char:WaitForChild("Humanoid", 5)
+			task.wait(0.5)
+			UpgradeService.PushDerived(player)
+			UpgradeService.ApplySuitVisual(player)
+		end
+		player.CharacterAdded:Connect(onChar)
+		if player.Character then
+			task.spawn(onChar, player.Character)
+		end
+		UpgradeService.PushDerived(player)
+	end)
+	services.MonetizationService.PassGranted:Connect(function(player)
+		UpgradeService.PushDerived(player)
+	end)
+	Players.PlayerRemoving:Connect(function(p)
+		limiter:Remove(p)
+	end)
+	-- Periodic refresh (boost expiry, events, friend count changes)
+	task.spawn(function()
+		while true do
+			task.wait(15)
+			for _, p in Players:GetPlayers() do
+				UpgradeService.PushDerived(p)
+			end
+		end
+	end)
+end
+
+return UpgradeService
diff --git a/src/server/Services/WorldService.luau b/src/server/Services/WorldService.luau
new file mode 100644
index 0000000..a7b4085
--- /dev/null
+++ b/src/server/Services/WorldService.luau
@@ -0,0 +1,496 @@
+-- WorldService: generates the graybox world at runtime (Master Plan §6, §8.1, §19).
+-- Ocean volume with five depth zones, a central Harbor plaza, a ring of 16 docks, air pockets,
+-- zone landmarks and plaza props (leaderboards, Server Luck Totem, VIP lounge).
+-- Replace with art kits later; services only depend on the dock/zone data exposed here.
+
+local Workspace = game:GetService("Workspace")
+local Lighting = game:GetService("Lighting")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage.Shared
+local World = require(Shared.Config.World)
+local Zones = require(Shared.Config.Zones)
+local Build = require(script.Parent.Parent.Util.Build)
+
+local WorldService = {}
+local services
+local docks = {}
+local airPockets = {}
+local root: Folder
+local rng = Random.new(1337) -- deterministic layout
+
+local SURFACE = World.WaterSurfaceY
+local R = World.OceanRadius
+
+function WorldService.Init(s)
+	services = s
+end
+
+local function folder(name: string, parent: Instance): Folder
+	local f = Instance.new("Folder")
+	f.Name = name
+	f.Parent = parent
+	return f
+end
+
+local function buildOcean()
+	local ocean = folder("Ocean", root)
+	-- Water surface (visual only; swimming is handled by the client SwimController)
+	Build.Part({
+		Name = "WaterSurface",
+		Size = Vector3.new(R * 2 + 600, 1, R * 2 + 600),
+		CFrame = CFrame.new(0, SURFACE - 0.5, 0),
+		Color = Color3.fromRGB(30, 140, 200),
+		Material = Enum.Material.Glass,
+		Transparency = 0.45,
+		CanCollide = false,
+		CanQuery = false,
+		CastShadow = false,
+		Parent = ocean,
+	})
+	-- Seabed
+	Build.Part({
+		Name = "Seabed",
+		Size = Vector3.new(R * 2 + 40, 8, R * 2 + 40),
+		CFrame = CFrame.new(0, SURFACE - World.SeabedDepth - 4, 0),
+		Color = Color3.fromRGB(40, 20, 20),
+		Material = Enum.Material.Basalt,
+		Parent = ocean,
+	})
+	-- Invisible bounds (parts are limited to 2048 studs per axis, so split vertically)
+	local half = World.SeabedDepth / 2
+	for _, seg in { 0, 1 } do
+		local h = half + 40
+		local cy = SURFACE + 40 - seg * half - h / 2
+		for _, d in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
+			Build.Part({
+				Name = "Bound",
+				Size = if d[1] ~= 0 then Vector3.new(4, h, R * 2) else Vector3.new(R * 2, h, 4),
+				CFrame = CFrame.new(d[1] * R, cy, d[2] * R),
+				Transparency = 1,
+				CanQuery = false,
+				Parent = ocean,
+			})
+		end
+	end
+
+	-- Zone dressing: rocks, kelp, wrecks, vents. Landmarks act as points of interest.
+	local palette = {
+		{ Color3.fromRGB(240, 120, 110), Enum.Material.Sand, "Coral" },
+		{ Color3.fromRGB(40, 120, 60), Enum.Material.Grass, "Kelp" },
+		{ Color3.fromRGB(90, 70, 50), Enum.Material.WoodPlanks, "Wreck" },
+		{ Color3.fromRGB(30, 30, 50), Enum.Material.Slate, "Rock" },
+		{ Color3.fromRGB(60, 15, 15), Enum.Material.Basalt, "Vent" },
+	}
+	for _, zone in Zones.List do
+		local zf = folder(zone.Id, ocean)
+		local style = palette[zone.Index]
+		for i = 1, 40 do
+			local depth = rng:NextNumber(zone.MinDepth + 10, zone.MaxDepth - 10)
+			local pos = Vector3.new(rng:NextNumber(-R + 30, R - 30), SURFACE - depth, rng:NextNumber(-R + 30, R - 30))
+			if style[3] == "Kelp" then
+				Build.Part({
+					Name = "Kelp",
+					Shape = Enum.PartType.Cylinder,
+					Size = Vector3.new(rng:NextNumber(40, 90), 2, 2),
+					CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
+					Color = style[1],
+					Material = style[2],
+					CanCollide = false,
+					Parent = zf,
+				})
+			else
+				Build.Part({
+					Name = style[3],
+					Size = Vector3.new(rng:NextNumber(6, 26), rng:NextNumber(4, 18), rng:NextNumber(6, 26)),
+					CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0),
+					Color = style[1],
+					Material = style[2],
+					Parent = zf,
+				})
+			end
+			if style[3] == "Vent" and i % 4 == 0 then
+				Build.Part({
+					Name = "VentGlow",
+					Shape = Enum.PartType.Ball,
+					Size = Vector3.one * 5,
+					CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)),
+					Color = Color3.fromRGB(255, 60, 20),
+					Material = Enum.Material.Neon,
+					CanCollide = false,
+					Parent = zf,
+				})
+			end
+		end
+		-- 3 landmarks per zone (§6 points of interest)
+		for i = 1, 3 do
+			local depth = zone.MinDepth + (zone.MaxDepth - zone.MinDepth) * (i / 4)
+			local angle = (i / 3) * math.pi * 2 + zone.Index
+			local pos = Vector3.new(math.cos(angle) * R * 0.55, SURFACE - depth, math.sin(angle) * R * 0.55)
+			local lm = Build.Part({
+				Name = "Landmark",
+				Size = Vector3.new(30, 50, 30),
+				CFrame = CFrame.new(pos),
+				Color = style[1]:Lerp(Color3.new(1, 1, 1), 0.2),
+				Material = style[2],
+				Parent = zf,
+			})
+			lm:SetAttribute("Zone", zone.Index)
+			Build.Instance("PointLight", { Range = 40, Brightness = 1, Color = style[1], Parent = lm })
+		end
+	end
+
+	-- Air pockets (§6): rare oxygen refills in zones 3–5
+	local af = folder("AirPockets", ocean)
+	for zoneIndex, count in World.AirPocketsPerZone do
+		local zone = Zones.List[zoneIndex]
+		for _ = 1, count do
+			local depth = rng:NextNumber(zone.MinDepth + 40, zone.MaxDepth - 40)
+			local p = Build.Part({
+				Name = "AirPocket",
+				Shape = Enum.PartType.Ball,
+				Size = Vector3.one * 8,
+				CFrame = CFrame.new(rng:NextNumber(-R + 60, R - 60), SURFACE - depth, rng:NextNumber(-R + 60, R - 60)),
+				Color = Color3.fromRGB(180, 240, 255),
+				Material = Enum.Material.Neon,
+				Transparency = 0.3,
+				CanCollide = false,
+				Parent = af,
+			})
+			Build.Instance("PointLight", { Range = 30, Brightness = 2, Color = p.Color, Parent = p })
+			table.insert(airPockets, p)
+		end
+	end
+end
+
+local function buildPlaza()
+	local plaza = folder("Plaza", root)
+	local top = SURFACE + World.DockHeight
+	Build.Part({
+		Name = "Harbor",
+		Shape = Enum.PartType.Cylinder,
+		Size = Vector3.new(2, World.PlazaRadius * 2, World.PlazaRadius * 2),
+		CFrame = CFrame.new(0, top - 1, 0) * CFrame.Angles(0, 0, math.rad(90)),
+		Color = Color3.fromRGB(160, 130, 95),
+		Material = Enum.Material.WoodPlanks,
+		Parent = plaza,
+	})
+	local spawn = Instance.new("SpawnLocation")
+	spawn.Name = "HarborSpawn"
+	spawn.Anchored = true
+	spawn.Size = Vector3.new(10, 1, 10)
+	spawn.CFrame = CFrame.new(0, top + 0.5, 0)
+	spawn.Neutral = true
+	spawn.Duration = 0
+	spawn.Transparency = 0.5
+	spawn.Parent = plaza
+
+	-- Leaderboard boards (§14) — LeaderboardService fills the SurfaceGuis
+	local boards = folder("Leaderboards", plaza)
+	local names = { "Deepest", "TotalValue", "Rebirths", "Steals", "Codex" }
+	for i, name in names do
+		local a = (i - 1) / #names * math.pi * 2
+		local pos = Vector3.new(math.cos(a) * 45, top + 9, math.sin(a) * 45)
+		local board = Build.Part({
+			Name = name,
+			Size = Vector3.new(14, 16, 1),
+			CFrame = CFrame.lookAt(pos, Vector3.new(0, top + 9, 0)),
+			Color = Color3.fromRGB(20, 30, 45),
+			Parent = boards,
+		})
+		local sg = Instance.new("SurfaceGui")
+		sg.Name = "Board"
+		sg.Face = Enum.NormalId.Front
+		sg.CanvasSize = Vector2.new(400, 460)
+		sg.Parent = board
+		local list = Instance.new("TextLabel")
+		list.Name = "Text"
+		list.Size = UDim2.fromScale(1, 1)
+		list.BackgroundTransparency = 1
+		list.TextColor3 = Color3.new(1, 1, 1)
+		list.Font = Enum.Font.GothamMedium
+		list.TextSize = 22
+		list.TextXAlignment = Enum.TextXAlignment.Left
+		list.TextYAlignment = Enum.TextYAlignment.Top
+		list.Text = name .. "\nLoading…"
+		list.Parent = sg
+	end
+
+	-- Server Luck Totem (§15.3)
+	local totem = Build.Part({
+		Name = "LuckTotem",
+		Size = Vector3.new(4, 14, 4),
+		CFrame = CFrame.new(0, top + 7, -18),
+		Color = Color3.fromRGB(80, 255, 140),
+		Material = Enum.Material.Neon,
+		Parent = plaza,
+	})
+	Build.Billboard(totem, "SERVER LUCK TOTEM\n2x luck for everyone", UDim2.fromOffset(240, 60), Vector3.new(0, 10, 0))
+	local totemPrompt = Build.Prompt(totem, "Boost Server Luck", "199 R$", 0, "LuckPrompt")
+	totemPrompt.Triggered:Connect(function(player)
+		local Net = require(Shared.Net)
+		Net.Offer:FireClient(player, "ServerLuck")
+	end)
+
+	-- VIP lounge (§15.2 "VIP door you can see but not enter")
+	local lounge = Build.Part({
+		Name = "VipLounge",
+		Size = Vector3.new(30, 1, 30),
+		CFrame = CFrame.new(0, top + 30, 50),
+		Color = Color3.fromRGB(255, 200, 60),
+		Material = Enum.Material.Marble,
+		Parent = plaza,
+	})
+	Build.Billboard(lounge, "VIP LOUNGE", UDim2.fromOffset(200, 50), Vector3.new(0, 6, 0), Color3.fromRGB(255, 210, 80))
+	local door = Build.Part({
+		Name = "VipDoor",
+		Size = Vector3.new(8, 12, 1),
+		CFrame = CFrame.new(0, top + 6, 30),
+		Color = Color3.fromRGB(255, 200, 60),
+		Material = Enum.Material.Neon,
+		Transparency = 0.3,
+		Parent = plaza,
+	})
+	Build.Billboard(door, "VIP", UDim2.fromOffset(120, 40), Vector3.new(0, 8, 0), Color3.fromRGB(255, 210, 80))
+	local doorPrompt = Build.Prompt(door, "Enter VIP Lounge", "VIP Diver", 0, "VipPrompt")
+	doorPrompt.Triggered:Connect(function(player)
+		if services.MonetizationService.Owns(player, "VIP") then
+			local char = player.Character
+			local hrp = char and char:FindFirstChild("HumanoidRootPart")
+			if hrp then
+				services.SecurityService.AllowTeleport(player)
+				char:PivotTo(lounge.CFrame + Vector3.new(0, 4, 0))
+			end
+		else
+			local Net = require(Shared.Net)
+			Net.Offer:FireClient(player, "VIP")
+		end
+	end)
+end
+
+local function buildDock(index: number)
+	local angle = (index - 1) / World.DockCount * math.pi * 2
+	local center = Vector3.new(math.cos(angle) * World.DockRingRadius, SURFACE + World.DockHeight, math.sin(angle) * World.DockRingRadius)
+	-- Dock faces outward (look away from the plaza); local -Z points to the open ocean
+	local cf = CFrame.lookAt(center, center + Vector3.new(center.X, 0, center.Z).Unit)
+	local model = Instance.new("Model")
+	model.Name = "Dock" .. index
+	model.Parent = root.Docks
+
+	local size = World.DockSize
+	local platform = Build.Part({
+		Name = "Platform",
+		Size = size,
+		CFrame = cf * CFrame.new(0, -1, 0),
+		Color = Color3.fromRGB(150, 115, 80),
+		Material = Enum.Material.WoodPlanks,
+		Parent = model,
+	})
+	model.PrimaryPart = platform
+	-- Pillars into the water
+	for _, x in { -1, 1 } do
+		for _, z in { -1, 1 } do
+			Build.Part({
+				Name = "Pillar",
+				Size = Vector3.new(2, World.DockHeight + 20, 2),
+				CFrame = cf * CFrame.new(x * (size.X / 2 - 2), -(World.DockHeight + 20) / 2, z * (size.Z / 2 - 2)),
+				Color = Color3.fromRGB(90, 70, 50),
+				Material = Enum.Material.Wood,
+				Parent = model,
+			})
+		end
+	end
+	-- Walkway to the plaza
+	local inner = cf * CFrame.new(0, -1, size.Z / 2)
+	local plazaEdge = Vector3.new(0, inner.Position.Y, 0) + (Vector3.new(center.X, 0, center.Z).Unit * World.PlazaRadius)
+	local walkLen = (inner.Position - plazaEdge).Magnitude
+	Build.Part({
+		Name = "Walkway",
+		Size = Vector3.new(6, 1, walkLen),
+		CFrame = CFrame.lookAt((inner.Position + plazaEdge) / 2, plazaEdge),
+		Color = Color3.fromRGB(130, 100, 70),
+		Material = Enum.Material.WoodPlanks,
+		Parent = model,
+	})
+	-- Dive ramp on the ocean side
+	Build.Instance("WedgePart", {
+		Name = "DiveRamp",
+		Anchored = true,
+		Size = Vector3.new(10, 3, 10),
+		CFrame = cf * CFrame.new(0, 0.5, -size.Z / 2 - 5) * CFrame.Angles(0, math.rad(180), 0),
+		Color = Color3.fromRGB(60, 160, 220),
+		Parent = model,
+	})
+
+	-- Sign
+	local sign = Build.Part({
+		Name = "Sign",
+		Size = Vector3.new(16, 5, 1),
+		CFrame = cf * CFrame.new(0, 7, size.Z / 2 - 1),
+		Color = Color3.fromRGB(40, 50, 70),
+		Parent = model,
+	})
+	local signGui = Build.Billboard(sign, "Empty Dock", UDim2.fromOffset(260, 70), Vector3.new(0, 4, 0))
+	signGui.MaxDistance = 250
+
+	-- Stands: 5 rows x 7 columns grid
+	local stands = {}
+	local cols = 7
+	for i = 1, World.MaxStands do
+		local row = (i - 1) // cols
+		local col = (i - 1) % cols
+		local x = (col - (cols - 1) / 2) * World.StandSpacing
+		local z = size.Z / 2 - 8 - row * World.StandSpacing
+		local stand = Build.Part({
+			Name = "Stand" .. i,
+			Shape = Enum.PartType.Cylinder,
+			Size = Vector3.new(2, 4, 4),
+			CFrame = cf * CFrame.new(x, 1, z) * CFrame.Angles(0, 0, math.rad(90)),
+			Color = Color3.fromRGB(200, 200, 210),
+			Material = Enum.Material.Marble,
+			Transparency = 1,
+			CanCollide = false,
+			Parent = model,
+		})
+		stand:SetAttribute("StandIndex", i)
+		local place = Build.Prompt(stand, "Display", "Stand " .. i, 0, "Place")
+		place.Enabled = false
+		local steal = Build.Prompt(stand, "Steal", "Relic", 2.5, "Steal")
+		steal.Enabled = false
+		steal.KeyboardKeyCode = Enum.KeyCode.F
+		steal.UIOffset = Vector2.new(0, 60)
+		local label = Build.Billboard(stand, "", UDim2.fromOffset(140, 36), Vector3.new(0, 4.5, 0))
+		label.Name = "Info"
+		label.MaxDistance = 40
+		stands[i] = stand
+	end
+	-- Vault stands (§8.1)
+	local vault = {}
+	for i = 1, 2 do
+		local stand = Build.Part({
+			Name = "Vault" .. i,
+			Shape = Enum.PartType.Cylinder,
+			Size = Vector3.new(2, 4, 4),
+			CFrame = cf * CFrame.new((i == 1 and -1 or 1) * (size.X / 2 - 4), 1, -size.Z / 2 + 6) * CFrame.Angles(0, 0, math.rad(90)),
+			Color = Color3.fromRGB(255, 200, 60),
+			Material = Enum.Material.Foil,
+			Transparency = 1,
+			CanCollide = false,
+			Parent = model,
+		})
+		stand:SetAttribute("VaultIndex", i)
+		local place = Build.Prompt(stand, "Vault", "Vault " .. i, 0, "Place")
+		place.Enabled = false
+		local label = Build.Billboard(stand, "", UDim2.fromOffset(140, 36), Vector3.new(0, 4.5, 0))
+		label.Name = "Info"
+		label.MaxDistance = 40
+		vault[i] = stand
+	end
+
+	-- Coin collector pad (§8.1)
+	local pad = Build.Part({
+		Name = "CollectorPad",
+		Size = Vector3.new(5, 0.6, 5),
+		CFrame = cf * CFrame.new(-size.X / 2 + 3, 0.3, size.Z / 2 - 4),
+		Color = Color3.fromRGB(60, 230, 120),
+		Material = Enum.Material.Neon,
+		CanCollide = false,
+		Parent = model,
+	})
+	local padGui = Build.Billboard(pad, "0", UDim2.fromOffset(160, 40), Vector3.new(0, 4, 0), Color3.fromRGB(120, 255, 160))
+	padGui.MaxDistance = 80
+
+	-- Laser gate visual (§8.4)
+	local gate = Build.Part({
+		Name = "LaserGate",
+		Size = Vector3.new(size.X + 2, 16, size.Z + 2),
+		CFrame = cf * CFrame.new(0, 7, 0),
+		Color = Color3.fromRGB(255, 40, 60),
+		Material = Enum.Material.ForceField,
+		Transparency = 1,
+		CanCollide = false,
+		CanQuery = false,
+		Parent = model,
+	})
+	local gateButton = Build.Part({
+		Name = "GateButton",
+		Size = Vector3.new(2, 3, 2),
+		CFrame = cf * CFrame.new(size.X / 2 - 2, 1.5, size.Z / 2 - 4),
+		Color = Color3.fromRGB(255, 40, 60),
+		Material = Enum.Material.Neon,
+		Parent = model,
+	})
+	local gatePrompt = Build.Prompt(gateButton, "Activate Laser Gate", "Dock Defense", 0, "GatePrompt")
+	gatePrompt.Enabled = false
+
+	local dock = {
+		Index = index,
+		CFrame = cf,
+		Model = model,
+		Platform = platform,
+		Stands = stands,
+		Vault = vault,
+		Pad = pad,
+		PadLabel = padGui.Label,
+		Sign = signGui.Label,
+		Gate = gate,
+		GatePrompt = gatePrompt,
+		SpawnCFrame = cf * CFrame.new(0, 4, size.Z / 2 - 4) * CFrame.Angles(0, math.rad(180), 0),
+		Owner = nil,
+	}
+	docks[index] = dock
+	return dock
+end
+
+function WorldService.GetDocks()
+	return docks
+end
+
+function WorldService.GetAirPockets()
+	return airPockets
+end
+
+-- Is a world position inside a dock's raid area?
+function WorldService.IsInsideDock(dock, position: Vector3, margin: number?): boolean
+	local rel = dock.CFrame:PointToObjectSpace(position)
+	local size = World.DockSize
+	local m = margin or 2
+	return math.abs(rel.X) <= size.X / 2 + m and math.abs(rel.Z) <= size.Z / 2 + m and rel.Y > -9 and rel.Y < 30
+end
+
+function WorldService.DepthOf(position: Vector3): number
+	return SURFACE - position.Y
+end
+
+function WorldService.RandomPointInZone(zoneIndex: number, r: Random?): Vector3
+	local zone = Zones.List[zoneIndex]
+	local g = r or rng
+	local depth = g:NextNumber(zone.MinDepth + 8, zone.MaxDepth - 8)
+	return Vector3.new(g:NextNumber(-R + 20, R - 20), SURFACE - depth, g:NextNumber(-R + 20, R - 20))
+end
+
+function WorldService.Start()
+	root = folder("AbyssWorld", Workspace)
+	folder("Docks", root)
+	folder("Relics", root)
+	folder("Nodes", root)
+	folder("Creatures", root)
+	folder("Drops", root)
+
+	Lighting.ClockTime = 14
+	Lighting.Brightness = 2
+	Lighting.FogStart = 0
+	Lighting.FogEnd = 2000
+
+	buildOcean()
+	buildPlaza()
+	for i = 1, World.DockCount do
+		buildDock(i)
+	end
+end
+
+function WorldService.Root(): Folder
+	return root
+end
+
+return WorldService
diff --git a/src/server/Util/Build.luau b/src/server/Util/Build.luau
new file mode 100644
index 0000000..2216074
--- /dev/null
+++ b/src/server/Util/Build.luau
@@ -0,0 +1,124 @@
+-- Small helpers for building graybox geometry and GUI on the server.
+
+local Build = {}
+
+function Build.Part(props): BasePart
+	local className = props.ClassName or "Part"
+	local p = Instance.new(className)
+	p.Anchored = true
+	p.TopSurface = Enum.SurfaceType.Smooth
+	p.BottomSurface = Enum.SurfaceType.Smooth
+	for k, v in props do
+		if k ~= "ClassName" and k ~= "Parent" and k ~= "Children" then
+			(p :: any)[k] = v
+		end
+	end
+	if props.Children then
+		for _, c in props.Children do
+			c.Parent = p
+		end
+	end
+	p.Parent = props.Parent
+	return p
+end
+
+function Build.Instance(className: string, props)
+	local inst = Instance.new(className)
+	for k, v in props or {} do
+		if k ~= "Parent" and k ~= "Children" then
+			(inst :: any)[k] = v
+		end
+	end
+	if props and props.Children then
+		for _, c in props.Children do
+			c.Parent = inst
+		end
+	end
+	if props and props.Parent then
+		inst.Parent = props.Parent
+	end
+	return inst
+end
+
+function Build.Billboard(parent: Instance, text: string, size: UDim2?, offset: Vector3?, color: Color3?)
+	local bb = Instance.new("BillboardGui")
+	bb.Size = size or UDim2.fromOffset(200, 50)
+	bb.StudsOffset = offset or Vector3.new(0, 3, 0)
+	bb.AlwaysOnTop = false
+	bb.MaxDistance = 120
+	local label = Instance.new("TextLabel")
+	label.Name = "Label"
+	label.Size = UDim2.fromScale(1, 1)
+	label.BackgroundTransparency = 1
+	label.Text = text
+	label.TextScaled = true
+	label.Font = Enum.Font.GothamBold
+	label.TextColor3 = color or Color3.new(1, 1, 1)
+	label.TextStrokeTransparency = 0.4
+	label.Parent = bb
+	bb.Parent = parent
+	return bb
+end
+
+function Build.Prompt(parent: Instance, action: string, object: string, hold: number?, name: string?)
+	local pp = Instance.new("ProximityPrompt")
+	pp.Name = name or "Prompt"
+	pp.ActionText = action
+	pp.ObjectText = object
+	pp.HoldDuration = hold or 0
+	pp.MaxActivationDistance = 12
+	pp.RequiresLineOfSight = false
+	pp.Parent = parent
+	return pp
+end
+
+-- Builds a simple relic display model from its config row (graybox art)
+function Build.RelicModel(def, rarityColor: Color3, mutations: { string }?, mutationDefs, size: number?)
+	local scale = 1.4 * (size or 1)
+	local shape = def.Shape
+	local p = Instance.new("Part")
+	p.Name = def.Id
+	p.Anchored = true
+	p.CanCollide = false
+	p.CanQuery = false
+	p.Material = Enum.Material.SmoothPlastic
+	p.Color = rarityColor
+	if shape == "Ball" then
+		p.Shape = Enum.PartType.Ball
+		p.Size = Vector3.one * scale
+	elseif shape == "Cylinder" then
+		p.Shape = Enum.PartType.Cylinder
+		p.Size = Vector3.new(scale * 1.2, scale, scale)
+	elseif shape == "Wedge" then
+		p:Destroy()
+		p = Instance.new("WedgePart")
+		p.Name = def.Id
+		p.Anchored = true
+		p.CanCollide = false
+		p.CanQuery = false
+		p.Color = rarityColor
+		p.Size = Vector3.new(scale * 0.6, scale, scale * 1.2)
+	else
+		p.Size = Vector3.new(scale, scale * 0.8, scale)
+	end
+	local tierGlow = rarityColor
+	if mutations and #mutations > 0 then
+		local m = mutationDefs[mutations[1]]
+		if m then
+			p.Color = m.Color
+			local mat = Enum.Material[m.Material]
+			if mat then
+				p.Material = mat
+			end
+			tierGlow = m.Color
+		end
+	end
+	local light = Instance.new("PointLight")
+	light.Color = tierGlow
+	light.Range = 8
+	light.Brightness = 1.5
+	light.Parent = p
+	return p
+end
+
+return Build
diff --git a/src/server/init.server.luau b/src/server/init.server.luau
index ec610e9..0437ad3 100644
--- a/src/server/init.server.luau
+++ b/src/server/init.server.luau
@@ -1 +1,67 @@
-print("Hello world, from server!")
+-- Server boot (Master Plan §20.3): creates remotes, then loads services in dependency order.
+-- Each service may expose Init(services) (store references, no yielding) and Start()
+-- (connect events, spawn loops). All Inits run before any Start.
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+Net.Setup()
+
+local ORDER = {
+	"PolicyWrapper",
+	"DataService",
+	"AnalyticsService",
+	"CurrencyService",
+	"BoostService",
+	"MonetizationService",
+	"InventoryService",
+	"WorldService",
+	"EventService",
+	"UpgradeService",
+	"DockService",
+	"LootService",
+	"DiveService",
+	"PredatorService",
+	"RaidService",
+	"TradeService",
+	"SocialService",
+	"QuestService",
+	"RebirthService",
+	"LeaderboardService",
+	"AnnouncementService",
+	"CodesService",
+	"AdminService",
+	"SecurityService",
+}
+
+local services = {}
+for _, name in ORDER do
+	local module = script.Services:FindFirstChild(name)
+	assert(module, "Missing service " .. name)
+	services[name] = require(module)
+end
+
+for _, name in ORDER do
+	local svc = services[name]
+	if svc.Init then
+		local ok, err = pcall(svc.Init, services)
+		if not ok then
+			warn(`[Boot] {name}.Init failed: {err}`)
+		end
+	end
+end
+
+for _, name in ORDER do
+	local svc = services[name]
+	if svc.Start then
+		task.spawn(function()
+			local ok, err = pcall(svc.Start)
+			if not ok then
+				warn(`[Boot] {name}.Start failed: {err}`)
+			end
+		end)
+	end
+end
+
+print(`[Abyss Salvage] server booted ({#ORDER} services)`)
