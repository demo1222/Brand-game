diff --git a/src/client/Controllers/AudioController.luau b/src/client/Controllers/AudioController.luau
new file mode 100644
index 0000000..ebc3962
--- /dev/null
+++ b/src/client/Controllers/AudioController.luau
@@ -0,0 +1,101 @@
+-- AudioController (Master Plan §19.3): adaptive music layers and key SFX.
+-- Asset IDs are left empty on purpose: use only Roblox-licensed or commissioned audio (§16).
+-- Fill in the ids below; empty entries are skipped silently.
+
+local Players = game:GetService("Players")
+local RunService = game:GetService("RunService")
+local SoundService = game:GetService("SoundService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+
+local SOUND_IDS = {
+	ReefMusic = "", -- calm reef melody
+	DeepDrone = "", -- deep ambient drone
+	HuntLayer = "", -- percussion when the Leviathan hunts you
+	Heartbeat = "", -- low oxygen
+	Roar = "", -- Leviathan wind-up
+	Reveal = "", -- rarity reveal (pitched per tier)
+	Alarm = "", -- dock intruder bell
+}
+
+local AudioController = {}
+local controllers
+local sounds: { [string]: Sound } = {}
+local huntUntil = 0
+
+function AudioController.Init(c)
+	controllers = c
+end
+
+local function make(name: string, looped: boolean): Sound?
+	local id = SOUND_IDS[name]
+	if id == "" then
+		return nil
+	end
+	local s = Instance.new("Sound")
+	s.Name = name
+	s.SoundId = id
+	s.Looped = looped
+	s.Volume = 0
+	s.Parent = SoundService
+	sounds[name] = s
+	if looped then
+		s:Play()
+	end
+	return s
+end
+
+function AudioController.Play(name: string, pitch: number?)
+	local s = sounds[name]
+	if s then
+		local settings = controllers.State.Get("Settings")
+		s.Volume = (settings and settings.SFX or 0.8)
+		s.PlaybackSpeed = pitch or 1
+		s:Play()
+	end
+end
+
+function AudioController.Start()
+	for _, n in { "ReefMusic", "DeepDrone", "HuntLayer", "Heartbeat" } do
+		make(n, true)
+	end
+	for _, n in { "Roar", "Reveal", "Alarm" } do
+		make(n, false)
+	end
+	Net.PredatorHint.OnClientEvent:Connect(function(hint)
+		if hint.State == "Hunt" or hint.State == "WindUp" or hint.State == "Lunge" then
+			huntUntil = os.clock() + 4
+		end
+		if hint.State == "WindUp" then
+			AudioController.Play("Roar")
+		end
+	end)
+	Net.Intruder.OnClientEvent:Connect(function()
+		AudioController.Play("Alarm")
+	end)
+	RunService.Heartbeat:Connect(function(dt)
+		local settings = controllers.State.Get("Settings")
+		local music = settings and settings.Music or 0.6
+		local depth = controllers.SwimController.Depth
+		local o2 = controllers.HUDController and controllers.HUDController.O2Fraction or 1
+		local targets = {
+			ReefMusic = if depth < 400 then music else 0,
+			DeepDrone = if depth >= 300 then music else 0,
+			HuntLayer = if huntUntil > os.clock() then music else 0,
+			Heartbeat = if depth > 0 and o2 < 0.25 then 0.8 else 0,
+		}
+		for name, target in targets do
+			local s = sounds[name]
+			if s then
+				s.Volume += (target - s.Volume) * math.clamp(dt * 2, 0, 1)
+			end
+		end
+	end)
+	Players.LocalPlayer.CharacterAdded:Connect(function()
+		huntUntil = 0
+	end)
+end
+
+return AudioController
diff --git a/src/client/Controllers/HUDController.luau b/src/client/Controllers/HUDController.luau
new file mode 100644
index 0000000..d01b87d
--- /dev/null
+++ b/src/client/Controllers/HUDController.luau
@@ -0,0 +1,344 @@
+-- HUDController (Master Plan §18.1): currencies, depth/zone meter, oxygen bar, bag count,
+-- menu buttons, mobile action buttons, events list, intruder/carry/predator alerts and the
+-- low-oxygen quick buy.
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local NumberFormat = require(Shared.NumberFormat)
+local Zones = require(Shared.Config.Zones)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local New, T = Kit.New, Kit.Theme
+local player = Players.LocalPlayer
+
+local HUDController = {}
+HUDController.O2Fraction = 1
+local controllers
+local refs = {}
+local lastStatus = nil
+
+function HUDController.Init(c)
+	controllers = c
+end
+
+local function iconButton(parent, text: string, color: Color3, onClick, order: number)
+	return Kit.Button(text, color, onClick, {
+		Size = UDim2.fromOffset(56, 56),
+		TextSize = 22,
+		LayoutOrder = order,
+		Parent = parent,
+	})
+end
+
+local function build()
+	local root = controllers.UIController.Root
+	local UI = controllers.UIController
+
+	-- Currencies (top-left)
+	local top = Kit.Panel({
+		Name = "Currencies",
+		Position = UDim2.fromOffset(12, 12),
+		Size = UDim2.fromOffset(260, 74),
+		Parent = root,
+	}, { Kit.Padding(8), Kit.List(2) })
+	refs.coins = Kit.Label({ Text = "🪙 0", Font = T.Bold, TextSize = 22, Size = UDim2.new(1, 0, 0, 28), Parent = top })
+	refs.income = Kit.Label({ Text = "+0/s", TextColor3 = T.Good, TextSize = 14, Size = UDim2.new(1, 0, 0, 16), Parent = top })
+	refs.pearls = Kit.Label({ Text = "🫧 0 Pearls", TextColor3 = Color3.fromRGB(200, 230, 255), TextSize = 16, Size = UDim2.new(1, 0, 0, 18), Parent = top })
+
+	-- Menu buttons (right column)
+	local menu = New("Frame", {
+		Name = "Menu",
+		BackgroundTransparency = 1,
+		AnchorPoint = Vector2.new(1, 0),
+		Position = UDim2.new(1, -12, 0, 12),
+		Size = UDim2.fromOffset(56, 600),
+		Parent = root,
+	}, { Kit.List(6) })
+	local shop = iconButton(menu, "🛒", T.Gold, function()
+		UI.Toggle("Shop")
+	end, 1)
+	shop.TextColor3 = Color3.fromRGB(40, 25, 0)
+	iconButton(menu, "🎒", T.PanelLight, function()
+		UI.Toggle("Bag")
+	end, 2)
+	iconButton(menu, "⬆️", T.PanelLight, function()
+		UI.Toggle("Upgrades")
+	end, 3)
+	iconButton(menu, "📖", T.PanelLight, function()
+		UI.Toggle("Codex")
+	end, 4)
+	iconButton(menu, "📜", T.PanelLight, function()
+		UI.Toggle("Quests")
+	end, 5)
+	iconButton(menu, "🔄", T.PanelLight, function()
+		UI.Toggle("Rebirth")
+	end, 6)
+	iconButton(menu, "🏆", T.PanelLight, function()
+		UI.Toggle("Leaderboards")
+	end, 7)
+	iconButton(menu, "👥", T.PanelLight, function()
+		UI.Toggle("Players")
+	end, 8)
+	iconButton(menu, "⚙️", T.PanelLight, function()
+		UI.Toggle("Settings")
+	end, 9)
+
+	-- Depth / zone meter (top-centre)
+	refs.depth = Kit.Panel({
+		Name = "Depth",
+		AnchorPoint = Vector2.new(0.5, 0),
+		Position = UDim2.new(0.5, 0, 0, 8),
+		Size = UDim2.fromOffset(300, 40),
+		Visible = false,
+		Parent = root,
+	})
+	refs.depthLabel = Kit.Label({
+		Text = "",
+		Font = T.Bold,
+		TextSize = 18,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		Size = UDim2.fromScale(1, 1),
+		Parent = refs.depth,
+	})
+
+	-- Oxygen + bag (bottom-left)
+	local bottom = New("Frame", {
+		Name = "Bottom",
+		BackgroundTransparency = 1,
+		AnchorPoint = Vector2.new(0, 1),
+		Position = UDim2.new(0, 12, 1, -12),
+		Size = UDim2.fromOffset(300, 120),
+		Parent = root,
+	})
+	local o2Frame, setO2 = Kit.Bar({ Size = UDim2.fromOffset(280, 28), Position = UDim2.fromOffset(0, 60), Text = "O₂ 100%", Parent = bottom })
+	refs.o2Frame, refs.setO2 = o2Frame, setO2
+	refs.bag = Kit.Label({ Text = "🎒 0/3", Font = T.Bold, TextSize = 18, Position = UDim2.fromOffset(0, 94), Size = UDim2.fromOffset(280, 24), Parent = bottom })
+	refs.quickRefill = Kit.Button("Refill O₂ · 25 R$", T.Bad, function()
+		Net.RequestPurchase:FireServer("Product", "OxygenRefill")
+	end, { Size = UDim2.fromOffset(180, 44), Position = UDim2.fromOffset(0, 10), Visible = false, Parent = bottom })
+
+	-- Action buttons (bottom-right)
+	local actions = New("Frame", {
+		Name = "Actions",
+		BackgroundTransparency = 1,
+		AnchorPoint = Vector2.new(1, 1),
+		Position = UDim2.new(1, -12, 1, -12),
+		Size = UDim2.fromOffset(250, 190),
+		Parent = root,
+	})
+	local function action(text, color, pos, onDown, onUp)
+		local b = Kit.Button(text, color, nil, { Size = UDim2.fromOffset(72, 56), Position = pos, TextSize = 14, Parent = actions })
+		b.MouseButton1Down:Connect(onDown)
+		if onUp then
+			b.MouseButton1Up:Connect(onUp)
+			b.MouseLeave:Connect(onUp)
+		end
+		return b
+	end
+	action("Sonar\n[Q]", T.Accent, UDim2.fromOffset(0, 0), function()
+		controllers.SonarController.Ping()
+	end)
+	refs.flare = action("Flare\n[G] 3", Color3.fromRGB(230, 90, 40), UDim2.fromOffset(88, 0), function()
+		Net.UseFlare:FireServer()
+	end)
+	action("Surface\n[R]", Color3.fromRGB(90, 120, 220), UDim2.fromOffset(176, 0), function()
+		Net.RequestInstantSurface:FireServer()
+	end)
+	action("▲ Up", T.PanelLight, UDim2.fromOffset(0, 66), function()
+		controllers.SwimController.SetVertical(1)
+	end, function()
+		controllers.SwimController.SetVertical(0)
+	end)
+	action("▼ Down", T.PanelLight, UDim2.fromOffset(0, 130), function()
+		controllers.SwimController.SetVertical(-1)
+	end, function()
+		controllers.SwimController.SetVertical(0)
+	end)
+	action("Boost\n⇧", T.Good, UDim2.fromOffset(88, 98), function()
+		controllers.SwimController.SetBoost(true)
+	end, function()
+		controllers.SwimController.SetBoost(false)
+	end)
+	actions.Visible = true
+
+	-- Events list (left)
+	refs.events = New("Frame", {
+		Name = "Events",
+		BackgroundTransparency = 1,
+		Position = UDim2.fromOffset(12, 96),
+		Size = UDim2.fromOffset(240, 200),
+		Parent = root,
+	}, { Kit.List(4) })
+
+	-- Alerts (centre)
+	refs.alert = Kit.Label({
+		Name = "Alert",
+		Text = "",
+		Visible = false,
+		Font = T.Bold,
+		TextSize = 22,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		TextColor3 = T.Bad,
+		TextStrokeTransparency = 0.2,
+		AnchorPoint = Vector2.new(0.5, 0),
+		Position = UDim2.new(0.5, 0, 0, 150),
+		Size = UDim2.fromOffset(520, 60),
+		Parent = root,
+	})
+	refs.carry = Kit.Label({
+		Name = "Carry",
+		Text = "",
+		Visible = false,
+		Font = T.Bold,
+		TextSize = 20,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		TextColor3 = T.Gold,
+		TextStrokeTransparency = 0.2,
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -140),
+		Size = UDim2.fromOffset(520, 40),
+		Parent = root,
+	})
+	refs.predator = Kit.Label({
+		Name = "Predator",
+		Text = "",
+		Visible = false,
+		Font = T.Bold,
+		TextSize = 18,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		TextColor3 = Color3.fromRGB(255, 90, 90),
+		AnchorPoint = Vector2.new(0.5, 0),
+		Position = UDim2.new(0.5, 0, 0, 52),
+		Size = UDim2.fromOffset(420, 26),
+		Parent = root,
+	})
+end
+
+local function refreshCurrencies()
+	local S = controllers.State
+	refs.coins.Text = "🪙 " .. NumberFormat.short(S.Get("Coins") or 0)
+	refs.pearls.Text = "🫧 " .. NumberFormat.commas(S.Get("Pearls") or 0) .. " Pearls"
+	refs.income.Text = "+" .. NumberFormat.short(S.Get("IncomePerSecond") or 0) .. "/s"
+	local bag = S.Get("Bag") or {}
+	local size = S.Derived("BagSize") or 3
+	refs.bag.Text = `🎒 {#bag}/{size}`
+	refs.bag.TextColor3 = if #bag >= size then T.Bad else T.Text
+	refs.flare.Text = `Flare\n[G] {S.Get("Flares") or 0}`
+end
+
+local function onStatus(status)
+	lastStatus = status
+	local frac = status.O2 / math.max(status.Max, 1)
+	HUDController.O2Fraction = frac
+	local color = if frac < 0.25 then T.Bad elseif frac < 0.5 then T.Gold else T.Accent
+	refs.setO2(frac, color, `O₂ {math.floor(frac * 100)}%  ({math.floor(status.O2)}s)`)
+	if frac < 0.25 and status.Zone > 0 then
+		-- pulse
+		refs.o2Frame.BackgroundColor3 = if (os.clock() * 4) % 2 < 1 then Color3.fromRGB(80, 0, 0) else Color3.fromRGB(10, 15, 25)
+	else
+		refs.o2Frame.BackgroundColor3 = Color3.fromRGB(10, 15, 25)
+	end
+	refs.quickRefill.Visible = frac < 0.15 and status.Zone > 0 and not controllers.State.Owns("DoubleOxygen")
+	if status.Zone > 0 then
+		local zone = Zones.List[status.Zone]
+		refs.depth.Visible = true
+		local warn = if status.Pressure then "  ⚠ PRESSURE" else ""
+		refs.depthLabel.Text = `Depth {math.floor(status.Depth)}m ▼  {zone.Name}{warn}`
+		refs.depthLabel.TextColor3 = if status.Pressure then T.Bad else T.Text
+	else
+		refs.depth.Visible = false
+	end
+end
+
+local function refreshEvents(list)
+	Kit.Clear(refs.events)
+	for i, e in list do
+		Kit.Label({
+			Text = `⚡ {e.Name} · {NumberFormat.time(e.Remaining)}\n{e.Desc}`,
+			TextSize = 13,
+			Font = T.Bold,
+			TextColor3 = e.Color or T.Accent,
+			TextStrokeTransparency = 0.4,
+			Size = UDim2.new(1, 0, 0, 34),
+			LayoutOrder = i,
+			Parent = refs.events,
+		})
+	end
+end
+
+function HUDController.Start()
+	build()
+	controllers.State.Changed:Connect(refreshCurrencies)
+	Net.DiveStatus.OnClientEvent:Connect(onStatus)
+	Net.EventsChanged.OnClientEvent:Connect(refreshEvents)
+
+	local alertToken = 0
+	local function alert(text: string, seconds: number)
+		alertToken += 1
+		local my = alertToken
+		refs.alert.Text = text
+		refs.alert.Visible = true
+		task.delay(seconds, function()
+			if alertToken == my then
+				refs.alert.Visible = false
+			end
+		end)
+	end
+	Net.Intruder.OnClientEvent:Connect(function(info)
+		if info.Stealing then
+			alert(`🚨 {info.Name} is STEALING your {info.Stealing}! Tag them!`, 6)
+		else
+			alert(`🔔 {info.Name} entered your dock`, 3)
+		end
+	end)
+	Net.CarryChanged.OnClientEvent:Connect(function(info)
+		if info then
+			refs.carry.Text = `Carrying a stolen relic from {info.Owner} — get to YOUR dock!`
+			refs.carry.Visible = true
+		else
+			refs.carry.Visible = false
+		end
+	end)
+	Net.PredatorHint.OnClientEvent:Connect(function(hint)
+		local lowScare = (controllers.State.Get("Settings") or {}).LowScare
+		if hint.State == "WindUp" then
+			refs.predator.Text = if lowScare then "Leviathan lunging — turn!" else "⚠ IT'S LUNGING — TURN NOW! ⚠"
+			refs.predator.Visible = true
+		elseif hint.Distance and hint.Distance < 120 then
+			refs.predator.Text = if hint.State == "Hunt" then "The Leviathan is hunting you!" else "Something huge is nearby…"
+			refs.predator.Visible = true
+		else
+			refs.predator.Visible = false
+		end
+	end)
+
+	UserInputService.InputBegan:Connect(function(input, processed)
+		if processed then
+			return
+		end
+		local k = input.KeyCode
+		if k == Enum.KeyCode.Q then
+			controllers.SonarController.Ping()
+		elseif k == Enum.KeyCode.G then
+			Net.UseFlare:FireServer()
+		elseif k == Enum.KeyCode.R then
+			Net.RequestInstantSurface:FireServer()
+		elseif k == Enum.KeyCode.B then
+			controllers.UIController.Toggle("Bag")
+		elseif k == Enum.KeyCode.U then
+			controllers.UIController.Toggle("Upgrades")
+		elseif k == Enum.KeyCode.M then
+			controllers.UIController.Toggle("Shop")
+		end
+	end)
+	player.CharacterAdded:Connect(function()
+		refs.predator.Visible = false
+		refs.carry.Visible = false
+	end)
+end
+
+return HUDController
diff --git a/src/client/Controllers/LightingController.luau b/src/client/Controllers/LightingController.luau
new file mode 100644
index 0000000..d9b1e48
--- /dev/null
+++ b/src/client/Controllers/LightingController.luau
@@ -0,0 +1,76 @@
+-- LightingController (Master Plan §19.1): depth-based atmosphere, tweened on the client only.
+
+local Lighting = game:GetService("Lighting")
+local RunService = game:GetService("RunService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Zones = require(Shared.Config.Zones)
+
+local LightingController = {}
+local controllers
+local cc: ColorCorrectionEffect
+local bloom: BloomEffect
+local surface = {
+	FogColor = Color3.fromRGB(190, 220, 240),
+	FogEnd = 2500,
+	Ambient = Color3.fromRGB(130, 130, 140),
+	Brightness = 2,
+}
+
+function LightingController.Init(c)
+	controllers = c
+end
+
+local function lerpZone(depth: number)
+	local zone = Zones.ForDepth(depth)
+	if not zone then
+		return surface.FogColor, surface.FogEnd, surface.Ambient, surface.Brightness
+	end
+	-- blend toward the next zone as you approach its boundary
+	local nextZone = Zones.List[zone.Index + 1]
+	local t = (depth - zone.MinDepth) / (zone.MaxDepth - zone.MinDepth)
+	local fogColor, fogEnd, ambient = zone.FogColor, zone.FogEnd, zone.Ambient
+	if nextZone and t > 0.7 then
+		local a = (t - 0.7) / 0.3
+		fogColor = fogColor:Lerp(nextZone.FogColor, a)
+		fogEnd = fogEnd + (nextZone.FogEnd - fogEnd) * a
+		ambient = ambient:Lerp(nextZone.Ambient, a)
+	end
+	local brightness = math.clamp(2 - depth / 600, 0.05, 2)
+	return fogColor, fogEnd, ambient, brightness
+end
+
+function LightingController.Start()
+	cc = Instance.new("ColorCorrectionEffect")
+	cc.Name = "DepthCC"
+	cc.Parent = Lighting
+	bloom = Instance.new("BloomEffect")
+	bloom.Name = "DepthBloom"
+	bloom.Intensity = 0.6
+	bloom.Threshold = 1.2
+	bloom.Size = 30
+	bloom.Parent = Lighting
+	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
+	atmosphere.Parent = Lighting
+
+	RunService.RenderStepped:Connect(function(dt)
+		local depth = controllers.SwimController.Depth
+		local fogColor, fogEnd, ambient, brightness = lerpZone(depth)
+		local a = math.clamp(dt * 3, 0, 1)
+		Lighting.FogColor = Lighting.FogColor:Lerp(fogColor, a)
+		Lighting.FogEnd = Lighting.FogEnd + (fogEnd - Lighting.FogEnd) * a
+		Lighting.FogStart = if depth > 0 then 0 else 200
+		Lighting.Ambient = Lighting.Ambient:Lerp(ambient, a)
+		Lighting.OutdoorAmbient = Lighting.Ambient
+		Lighting.Brightness = Lighting.Brightness + (brightness - Lighting.Brightness) * a
+		atmosphere.Density = if depth > 0 then 0.6 else 0.3
+		atmosphere.Color = Lighting.FogColor
+		cc.TintColor = if depth > 0 then Color3.new(1, 1, 1):Lerp(fogColor, 0.35) else Color3.new(1, 1, 1)
+		cc.Saturation = if depth > 400 then -0.2 else 0.1
+		-- emissive rare items pop in the dark (bloom stronger at depth)
+		bloom.Intensity = if depth > 400 then 1.2 else 0.5
+	end)
+end
+
+return LightingController
diff --git a/src/client/Controllers/MenuController.luau b/src/client/Controllers/MenuController.luau
new file mode 100644
index 0000000..30e1136
--- /dev/null
+++ b/src/client/Controllers/MenuController.luau
@@ -0,0 +1,734 @@
+-- MenuController (Master Plan §18.2): Bag/Dock Manager, Upgrades, Codex, Quests & Tide Pass,
+-- Rebirth, Leaderboards, Players (trade/party), Trade window and Settings.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Relics = require(Shared.Config.Relics)
+local Rarities = require(Shared.Config.Rarities)
+local Mutations = require(Shared.Config.Mutations)
+local Upgrades = require(Shared.Config.Upgrades)
+local Zones = require(Shared.Config.Zones)
+local Quests = require(Shared.Config.Quests)
+local Economy = require(Shared.Config.Economy)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local New, T = Kit.New, Kit.Theme
+local player = Players.LocalPlayer
+local MenuController = {}
+local controllers
+local S -- State
+local leaderboardData = {}
+local tradeState = nil
+local tradeSelection: { [string]: boolean } = {}
+local codexZone = 1
+
+function MenuController.Init(c)
+	controllers = c
+	S = c.State
+end
+
+local function relicLine(relic): string
+	local def = Relics.ById[relic.id]
+	local mut = if #relic.mutations > 0 then table.concat(relic.mutations, " ") .. " " else ""
+	local huge = if relic.size >= 1.35 then "HUGE " else ""
+	return `{huge}{mut}{def.Name}`
+end
+
+local function row(parent: Instance, order: number, height: number?)
+	return New("Frame", {
+		BackgroundColor3 = T.PanelLight,
+		Size = UDim2.new(1, -8, 0, height or 56),
+		LayoutOrder = order,
+		Parent = parent,
+	}, { Kit.Corner(8) })
+end
+
+local function header(parent: Instance, order: number, text: string)
+	return Kit.Label({ Text = text, Font = T.Bold, TextSize = 17, TextColor3 = T.Accent, LayoutOrder = order, Size = UDim2.new(1, -8, 0, 26), Parent = parent })
+end
+
+local function scrollBody(body: Frame, top: number?)
+	local scroll = Kit.Scroll({ Position = UDim2.fromOffset(0, top or 0), Size = UDim2.new(1, 0, 1, -(top or 0)), Parent = body })
+	Kit.List(6).Parent = scroll
+	return scroll
+end
+
+local function firstFreeStand(): number?
+	local stands = S.Get("Stands") or {}
+	for i = 1, S.Derived("StandCount") or 6 do
+		if not stands[tostring(i)] then
+			return i
+		end
+	end
+	return nil
+end
+
+------------------------------------------------------------------------------------------
+-- Bag / Dock Manager
+------------------------------------------------------------------------------------------
+local bagScroll
+local function renderBag()
+	Kit.Clear(bagScroll)
+	local order = 0
+	local function o()
+		order += 1
+		return order
+	end
+	local mult = S.Derived("CoinMult") or 1
+	local function relicRow(relic, where: string)
+		local r = row(bagScroll, o(), 60)
+		local rarity = Rarities[relic.rarity]
+		Kit.Label({
+			Text = `{rarity.Icon} {relicLine(relic)}{relic.locked and " 🔒" or ""}`,
+			TextColor3 = if relic.rarity == "Secret" then Color3.new(1, 1, 1) else rarity.Color,
+			Font = T.Bold,
+			Position = UDim2.fromOffset(10, 4),
+			Size = UDim2.new(1, -370, 0, 26),
+			Parent = r,
+		})
+		Kit.Label({
+			Text = `{relic.rarity} · {relic.size}x · +{NumberFormat.short(Formulas.RelicCPS(relic) * mult)}/s`,
+			TextColor3 = T.Muted,
+			TextSize = 13,
+			Position = UDim2.fromOffset(10, 30),
+			Size = UDim2.new(1, -370, 0, 22),
+			Parent = r,
+		})
+		local buttons = New("Frame", {
+			BackgroundTransparency = 1,
+			AnchorPoint = Vector2.new(1, 0.5),
+			Position = UDim2.new(1, -6, 0.5, 0),
+			Size = UDim2.fromOffset(360, 48),
+			Parent = r,
+		}, { Kit.List(4, true, Enum.HorizontalAlignment.Right) })
+		if where == "Stands" or where == "Vault" then
+			Kit.Button("Take", T.PanelLight, function()
+				Net.RequestPickupRelic:FireServer(tonumber(relic._slot), where == "Vault")
+			end, { Size = UDim2.fromOffset(70, 44), Parent = buttons })
+			return
+		end
+		if table.find(relic.mutations, "Barnacled") then
+			Kit.Button("Clean", Color3.fromRGB(150, 130, 100), function()
+				Net.RequestCleanBarnacle:FireServer(relic.uid)
+			end, { Size = UDim2.fromOffset(64, 44), TextSize = 13, Parent = buttons })
+		end
+		Kit.Button(relic.locked and "Unlock" or "Lock", T.PanelLight, function()
+			Net.RequestToggleLock:FireServer(relic.uid)
+		end, { Size = UDim2.fromOffset(64, 44), TextSize = 13, Parent = buttons })
+		if not relic.locked then
+			Kit.Button(`Sell {NumberFormat.short(Formulas.SellPrice(relic, mult))}`, T.Bad, function()
+				Net.RequestSell:FireServer(relic.uid)
+			end, { Size = UDim2.fromOffset(84, 44), TextSize = 13, Parent = buttons })
+		end
+		Kit.Button("Display", T.Good, function()
+			local slot = firstFreeStand()
+			if slot then
+				Net.RequestPlaceRelic:FireServer(relic.uid, slot, false)
+			else
+				controllers.UIController.Toast("All stands are full! Upgrade Display Slots.", "error")
+				if not S.Owns("ExtraSlots") then
+					controllers.OfferController.Show("ExtraSlots")
+				end
+			end
+		end, { Size = UDim2.fromOffset(70, 44), TextSize = 13, Parent = buttons })
+		if (S.Derived("VaultCount") or 0) > 0 then
+			Kit.Button("Vault", T.Gold, function()
+				local vault = S.Get("Vault") or {}
+				for i = 1, S.Derived("VaultCount") do
+					if not vault[tostring(i)] then
+						Net.RequestPlaceRelic:FireServer(relic.uid, i, true)
+						return
+					end
+				end
+				controllers.UIController.Toast("Vault slots are full.", "error")
+			end, { Size = UDim2.fromOffset(60, 44), TextSize = 13, TextColor3 = Color3.fromRGB(40, 25, 0), Parent = buttons })
+		end
+	end
+
+	local bag = S.Get("Bag") or {}
+	header(bagScroll, o(), `DIVE BAG {#bag}/{S.Derived("BagSize") or 3} — lost if you die! Swim home to secure it.`)
+	for _, relic in bag do
+		relicRow(relic, "Bag")
+	end
+	local storage = S.Get("Storage") or {}
+	local tools = row(bagScroll, o(), 52)
+	tools.BackgroundTransparency = 1
+	Kit.Label({ Text = `STORAGE ({#storage})`, Font = T.Bold, TextColor3 = T.Accent, Size = UDim2.new(0.5, 0, 1, 0), Parent = tools })
+	Kit.Button("Sell all Commons", T.Bad, function()
+		Net.RequestSellCommons:FireServer()
+	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(160, 44), Parent = tools })
+	table.sort(storage, function(a, b)
+		return Formulas.RelicCPS(a) > Formulas.RelicCPS(b)
+	end)
+	for _, relic in storage do
+		relicRow(relic, "Storage")
+	end
+	header(bagScroll, o(), `ON DISPLAY · +{NumberFormat.short(S.Get("IncomePerSecond") or 0)}/s`)
+	for slot, relic in S.Get("Stands") or {} do
+		local copy = table.clone(relic)
+		copy._slot = slot
+		relicRow(copy, "Stands")
+	end
+	for slot, relic in S.Get("Vault") or {} do
+		local copy = table.clone(relic)
+		copy._slot = slot
+		relicRow(copy, "Vault")
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Upgrades
+------------------------------------------------------------------------------------------
+local upScroll
+local function renderUpgrades()
+	Kit.Clear(upScroll)
+	local order = 0
+	local levels = S.Get("Upgrades") or {}
+	local coins = S.Get("Coins") or 0
+	local suitIndex = S.Get("Suit") or 1
+	local nextSuit = Upgrades.Suits[suitIndex + 1]
+	order += 1
+	local sr = row(upScroll, order, 64)
+	Kit.Label({
+		Text = `Suit: {Upgrades.Suits[suitIndex].Name} (safe to zone {suitIndex}: {Zones.List[math.min(suitIndex, 5)].Name})`,
+		Font = T.Bold,
+		Position = UDim2.fromOffset(10, 6),
+		Size = UDim2.new(1, -170, 0, 24),
+		Parent = sr,
+	})
+	Kit.Label({
+		Text = if nextSuit then `Next: {nextSuit.Name}{nextSuit.ComingSoon and " (coming soon)" or ""}` else "Max suit!",
+		TextColor3 = T.Muted,
+		TextSize = 14,
+		Position = UDim2.fromOffset(10, 32),
+		Size = UDim2.new(1, -170, 0, 22),
+		Parent = sr,
+	})
+	if nextSuit then
+		Kit.Button(NumberFormat.short(nextSuit.Cost), if coins >= nextSuit.Cost then T.Good else T.PanelLight, function()
+			Net.RequestBuySuit:FireServer()
+		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(140, 48), Parent = sr })
+	end
+	for _, track in Upgrades.Tracks do
+		order += 1
+		local lvl = levels[track.Id] or 0
+		local r = row(upScroll, order, 58)
+		Kit.Label({ Text = `{track.Name}  Lv {lvl}/{track.Max}`, Font = T.Bold, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -170, 0, 24), Parent = r })
+		Kit.Label({ Text = track.Desc, TextColor3 = T.Muted, TextSize = 14, Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -170, 0, 22), Parent = r })
+		if lvl >= track.Max then
+			Kit.Label({ Text = "MAX", Font = T.Bold, TextColor3 = T.Gold, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Size = UDim2.fromOffset(80, 30), Parent = r })
+		else
+			local cost = Upgrades.Cost(track.Id, lvl)
+			Kit.Button(NumberFormat.short(cost), if coins >= cost then T.Good else T.PanelLight, function()
+				Net.RequestUpgrade:FireServer(track.Id)
+			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(140, 46), Parent = r })
+		end
+	end
+	order += 1
+	local g = row(upScroll, order, 58)
+	Kit.Label({ Text = "Laser Gate: blocks raids on your dock", Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -170, 1, 0), Parent = g })
+	Kit.Button("Activate", T.Bad, function()
+		Net.ActivateGate:FireServer()
+	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(140, 46), Parent = g })
+end
+
+------------------------------------------------------------------------------------------
+-- Codex
+------------------------------------------------------------------------------------------
+local codexScroll, codexTitle
+local function renderCodex()
+	Kit.Clear(codexScroll)
+	local codex = S.Get("Codex") or {}
+	local total, found = 0, 0
+	for _, def in Relics.List do
+		if def.Zone == codexZone then
+			total += 1
+			local entry = codex[def.Id]
+			if entry then
+				found += 1
+			end
+			local rarity = Rarities[def.Rarity]
+			local cell = New("Frame", {
+				BackgroundColor3 = if entry then T.PanelLight else Color3.fromRGB(15, 20, 30),
+				Size = UDim2.fromOffset(150, 90),
+				Parent = codexScroll,
+			}, { Kit.Corner(8), Kit.Padding(6) })
+			if entry then
+				Kit.Stroke(rarity.Color, 1.5).Parent = cell
+				local muts = 0
+				for _ in entry do
+					muts += 1
+				end
+				Kit.Label({ Text = def.Name, Font = T.Bold, TextSize = 14, TextColor3 = rarity.Color, Size = UDim2.new(1, 0, 0, 34), Parent = cell })
+				Kit.Label({
+					Text = `{def.Rarity}\nVariants: {muts}/{#Mutations.List + 1}`,
+					TextSize = 12,
+					TextColor3 = T.Muted,
+					Position = UDim2.fromOffset(0, 36),
+					Size = UDim2.new(1, 0, 0, 34),
+					Parent = cell,
+				})
+			else
+				Kit.Label({ Text = "???", Font = T.Bold, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 0.6), Parent = cell })
+				Kit.Label({
+					Text = def.Rarity,
+					TextSize = 12,
+					TextColor3 = T.Muted,
+					TextXAlignment = Enum.TextXAlignment.Center,
+					Position = UDim2.fromScale(0, 0.6),
+					Size = UDim2.fromScale(1, 0.4),
+					Parent = cell,
+				})
+			end
+		end
+	end
+	codexTitle.Text = `{Zones.List[codexZone].Name}: {found}/{total} ({math.floor(found / math.max(total, 1) * 100)}%) · 100% = +5% luck in this zone`
+end
+
+------------------------------------------------------------------------------------------
+-- Quests, login calendar, Tide Pass
+------------------------------------------------------------------------------------------
+local questScroll
+local function questDef(id: string)
+	for _, list in { Quests.Daily, Quests.Weekly } do
+		for _, q in list do
+			if q.Id == id then
+				return q
+			end
+		end
+	end
+	return nil
+end
+
+local function renderQuests()
+	Kit.Clear(questScroll)
+	local order = 0
+	local function o()
+		order += 1
+		return order
+	end
+	-- Login calendar
+	local streak = S.Get("LoginStreak") or 1
+	local claimedToday = (S.Get("LastDailyClaimDay") or 0) == os.time() // 86400
+	header(questScroll, o(), `DAILY LOGIN · streak {streak} day{streak == 1 and "" or "s"}`)
+	local cal = row(questScroll, o(), 70)
+	cal.BackgroundTransparency = 1
+	Kit.List(4, true).Parent = cal
+	local dayInCycle = ((streak - 1) % #Economy.DailyRewards) + 1
+	for i, reward in Economy.DailyRewards do
+		local label = if reward.Coins and reward.Pearls
+			then `{NumberFormat.short(reward.Coins)}🪙\n{reward.Pearls}🫧`
+			elseif reward.Coins then `{NumberFormat.short(reward.Coins)}🪙`
+			elseif reward.Pearls then `{reward.Pearls}🫧`
+			elseif reward.Relic then `{reward.Relic}\nrelic`
+			else "Luck\npotion"
+		local isToday = i == dayInCycle
+		Kit.Button(`Day {i}\n{label}`, if isToday and not claimedToday then T.Gold elseif i < dayInCycle or (isToday and claimedToday) then T.Good else T.PanelLight, function()
+			if isToday and not claimedToday then
+				Net.RequestClaimDaily:FireServer()
+			end
+		end, { Size = UDim2.fromOffset(82, 66), TextSize = 12, LayoutOrder = i, Parent = cal })
+	end
+
+	local q = S.Get("Quests") or {}
+	for _, section in { { "DAILY QUESTS", q.Daily or {} }, { "WEEKLY QUESTS", q.Weekly or {} } } do
+		header(questScroll, o(), section[1])
+		for _, entry in section[2] do
+			local def = questDef(entry.Id)
+			if def then
+				local r = row(questScroll, o(), 54)
+				local reward = (def.Coins and `{NumberFormat.short(def.Coins)} Coins` or "") .. (def.Pearls and `{def.Pearls} Pearls` or "")
+				Kit.Label({ Text = def.Text, Font = T.Bold, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -150, 0, 24), Parent = r })
+				Kit.Label({
+					Text = `{entry.Progress}/{def.Goal} · {reward} · +{def.Xp} Tide XP`,
+					TextColor3 = T.Muted,
+					TextSize = 13,
+					Position = UDim2.fromOffset(10, 28),
+					Size = UDim2.new(1, -150, 0, 22),
+					Parent = r,
+				})
+				local done = entry.Progress >= def.Goal
+				Kit.Button(if entry.Claimed then "Claimed" elseif done then "Claim" else "…", if done and not entry.Claimed then T.Gold else T.PanelLight, function()
+					if done and not entry.Claimed then
+						Net.RequestClaimQuest:FireServer(entry.Id)
+					end
+				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 44), Parent = r })
+			end
+		end
+	end
+
+	-- Tide Pass
+	local tp = S.Get("TidePass") or { XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} }
+	local tier = tp.XP // Economy.TidePass.XpPerTier
+	header(questScroll, o(), `TIDE PASS {Economy.TidePass.SeasonId} · Tier {tier}/{Economy.TidePass.Tiers} ({tp.XP % Economy.TidePass.XpPerTier}/{Economy.TidePass.XpPerTier} XP)`)
+	if not tp.Premium then
+		local r = row(questScroll, o(), 56)
+		r.BackgroundTransparency = 1
+		Kit.List(6, true).Parent = r
+		Kit.Button("Premium · 499 R$", T.Gold, function()
+			Net.RequestPurchase:FireServer("Product", "TidePassPremium")
+		end, { Size = UDim2.fromOffset(170, 48), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = r })
+		Kit.Button(`Premium · {Economy.TidePass.PremiumPearlCost} Pearls`, T.Accent, function()
+			Net.RequestBuyTidePassPearls:FireServer()
+		end, { Size = UDim2.fromOffset(200, 48), Parent = r })
+	end
+	for t = 1, Economy.TidePass.Tiers do
+		local r = row(questScroll, o(), 48)
+		Kit.Label({ Text = `Tier {t}`, Font = T.Bold, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0, 70, 1, 0), Parent = r })
+		local reached = tier >= t
+		local function claimButton(premium: boolean, x: number)
+			local claimed = (if premium then tp.ClaimedPremium else tp.ClaimedFree)[tostring(t)]
+			local text = if premium then "Premium" else "Free"
+			Kit.Button(
+				if claimed then `{text} ✓` elseif reached then `Claim {text}` else text,
+				if claimed then T.Good elseif reached and (not premium or tp.Premium) then T.Gold else T.PanelLight,
+				function()
+					if reached and not claimed then
+						Net.RequestClaimTier:FireServer(t, premium)
+					end
+				end,
+				{ Position = UDim2.fromOffset(x, 4), Size = UDim2.fromOffset(140, 40), TextSize = 13, Parent = r }
+			)
+		end
+		claimButton(false, 90)
+		claimButton(true, 240)
+		if not reached and t > tier + 3 then
+			break -- keep the list short; reveal as you progress
+		end
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Rebirth
+------------------------------------------------------------------------------------------
+local rebirthScroll
+local function renderRebirth()
+	Kit.Clear(rebirthScroll)
+	local n = S.Get("Rebirths") or 0
+	local need = S.Derived("RebirthRequirement") or Formulas.RebirthRequirement(n)
+	local lifetime = S.Get("LifetimeCoins") or 0
+	local suitOk = (S.Get("Suit") or 1) >= Economy.Rebirth.RequiredSuit
+	local coinOk = lifetime >= need
+	local lines = {
+		`Resurfaces: {n}  ·  Rebirth Tokens: {S.Get("RebirthTokens") or 0}`,
+		"",
+		`Requirements:`,
+		`{suitOk and "✅" or "❌"} Own the {Upgrades.Suits[Economy.Rebirth.RequiredSuit].Name} suit`,
+		`{coinOk and "✅" or "❌"} {NumberFormat.short(lifetime)} / {NumberFormat.short(need)} lifetime Coins`,
+		"",
+		`You gain: Coins x{Formulas.RebirthMultiplier(n)} → x{Formulas.RebirthMultiplier(n + 1)}, +2% luck (max 30%), +1 Rebirth Token, a new helmet trim.`,
+		"You keep: relics on stands, storage, Codex, Pearls, passes, level, Display Slots.",
+		"Resets: Coins, upgrades, suit, dive bag.",
+	}
+	Kit.Label({ Text = table.concat(lines, "\n"), TextSize = 15, LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 200), TextYAlignment = Enum.TextYAlignment.Top, Parent = rebirthScroll })
+	Kit.Button("RESURFACE", if suitOk and coinOk then T.Gold else T.PanelLight, function()
+		Net.RequestRebirth:FireServer()
+	end, { LayoutOrder = 2, Size = UDim2.fromOffset(220, 52), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = rebirthScroll })
+	header(rebirthScroll, 3, "TALENT TREE")
+	local talents = S.Get("Talents") or {}
+	for i, t in Economy.Rebirth.Talents do
+		local r = row(rebirthScroll, 3 + i, 56)
+		local lvl = talents[t.Id] or 0
+		Kit.Label({ Text = `{t.Name}  {lvl}/{t.Max}`, Font = T.Bold, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -150, 0, 24), Parent = r })
+		Kit.Label({ Text = t.Desc, TextColor3 = T.Muted, TextSize = 13, Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -150, 0, 22), Parent = r })
+		Kit.Button(if lvl >= t.Max then "MAX" else `{t.Cost} Token`, T.Accent, function()
+			Net.RequestTalent:FireServer(t.Id)
+		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 44), Parent = r })
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Leaderboards
+------------------------------------------------------------------------------------------
+local lbScroll
+local function renderLeaderboards()
+	Kit.Clear(lbScroll)
+	local order = 0
+	for _, id in { "Deepest", "TotalValue", "Rebirths", "Steals", "Codex" } do
+		local board = leaderboardData[id]
+		if board then
+			order += 1
+			header(lbScroll, order, board.Title:upper())
+			local lines = {}
+			for _, r in board.Rows do
+				table.insert(lines, `{r.Rank}. {r.Name} — {r.Value}`)
+			end
+			order += 1
+			Kit.Label({ Text = if #lines > 0 then table.concat(lines, "\n") else "No entries yet", TextSize = 14, LayoutOrder = order, Size = UDim2.new(1, -8, 0, math.max(1, #lines) * 18 + 6), Parent = lbScroll })
+		end
+	end
+	if order == 0 then
+		Kit.Label({ Text = "Loading leaderboards…", Parent = lbScroll })
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Players (trade / party)
+------------------------------------------------------------------------------------------
+local playersScroll
+local function renderPlayers()
+	Kit.Clear(playersScroll)
+	local order = 0
+	Kit.Button("Leave party", T.PanelLight, function()
+		Net.PartyLeave:FireServer()
+	end, { LayoutOrder = 0, Size = UDim2.fromOffset(160, 44), Parent = playersScroll })
+	for _, other in Players:GetPlayers() do
+		if other ~= player then
+			order += 1
+			local r = row(playersScroll, order, 56)
+			Kit.Label({ Text = other.DisplayName, Font = T.Bold, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -280, 1, 0), Parent = r })
+			Kit.Button("Party", T.Accent, function()
+				Net.PartyInvite:FireServer(other.UserId)
+				controllers.UIController.Toast(`Party invite sent to {other.DisplayName}`, "info")
+			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -140, 0.5, 0), Size = UDim2.fromOffset(120, 44), Parent = r })
+			Kit.Button("Trade", T.Gold, function()
+				Net.TradeRequest:FireServer(other.UserId)
+			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 44), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = r })
+		end
+	end
+	if order == 0 then
+		Kit.Label({ Text = "Nobody else is here yet — invite friends for +10% Coins each!", LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 40), Parent = playersScroll })
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Trade window
+------------------------------------------------------------------------------------------
+local tradeScroll
+local function renderTrade()
+	Kit.Clear(tradeScroll)
+	local st = tradeState
+	if not st then
+		Kit.Label({ Text = "No active trade.", Parent = tradeScroll })
+		return
+	end
+	local order = 0
+	local function o()
+		order += 1
+		return order
+	end
+	header(tradeScroll, o(), `Trading with {st.Partner}` .. (if st.Countdown then ` · completing in {math.ceil(st.Countdown)}s` else ""))
+	local function list(title: string, relics)
+		header(tradeScroll, o(), title)
+		if #relics == 0 then
+			Kit.Label({ Text = "(nothing)", TextColor3 = T.Muted, LayoutOrder = o(), Parent = tradeScroll })
+		end
+		for _, relic in relics do
+			Kit.Label({ Text = `{Rarities[relic.rarity].Icon} {relicLine(relic)} (+{NumberFormat.short(Formulas.RelicCPS(relic))}/s)`, TextColor3 = Rarities[relic.rarity].Color, LayoutOrder = o(), Parent = tradeScroll })
+		end
+	end
+	list(`Your offer {st.MyConfirm and "✅" or ""}`, st.MyOffer)
+	list(`Their offer {st.TheirConfirm and "✅" or ""}`, st.TheirOffer)
+	local actions = row(tradeScroll, o(), 54)
+	actions.BackgroundTransparency = 1
+	Kit.List(6, true).Parent = actions
+	Kit.Button("Confirm", T.Good, function()
+		Net.TradeConfirm:FireServer()
+	end, { Size = UDim2.fromOffset(140, 48), Parent = actions })
+	Kit.Button("Cancel", T.Bad, function()
+		Net.TradeCancel:FireServer()
+	end, { Size = UDim2.fromOffset(140, 48), Parent = actions })
+	header(tradeScroll, o(), "Pick from your storage (max 8) — changing the offer resets confirmations")
+	for _, relic in S.Get("Storage") or {} do
+		if not relic.locked then
+			local selected = tradeSelection[relic.uid] == true
+			Kit.Button(`{selected and "☑" or "☐"} {relicLine(relic)} ({relic.rarity})`, if selected then T.Accent else T.PanelLight, function()
+				tradeSelection[relic.uid] = not selected or nil
+				local uids = {}
+				for uid in tradeSelection do
+					table.insert(uids, uid)
+				end
+				Net.TradeSetOffer:FireServer(uids)
+			end, { Size = UDim2.new(1, -8, 0, 44), TextSize = 14, LayoutOrder = o(), TextXAlignment = Enum.TextXAlignment.Left, Parent = tradeScroll })
+		end
+	end
+end
+
+------------------------------------------------------------------------------------------
+-- Settings
+------------------------------------------------------------------------------------------
+local settingsScroll
+local function renderSettings()
+	Kit.Clear(settingsScroll)
+	local settings = table.clone(S.Get("Settings") or { Music = 0.6, SFX = 0.8, LowScare = false })
+	local function stepper(order: number, label: string, key: string)
+		local r = row(settingsScroll, order, 54)
+		Kit.Label({ Text = `{label}: {math.floor(settings[key] * 100)}%`, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), Parent = r })
+		Kit.Button("−", T.PanelLight, function()
+			settings[key] = math.max(0, settings[key] - 0.1)
+			Net.UpdateSettings:FireServer(settings)
+		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -66, 0.5, 0), Size = UDim2.fromOffset(52, 44), Parent = r })
+		Kit.Button("+", T.PanelLight, function()
+			settings[key] = math.min(1, settings[key] + 0.1)
+			Net.UpdateSettings:FireServer(settings)
+		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(52, 44), Parent = r })
+	end
+	stepper(1, "Music", "Music")
+	stepper(2, "Sound effects", "SFX")
+	local ls = row(settingsScroll, 3, 54)
+	Kit.Label({ Text = "Lower jump scares", Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -140, 1, 0), Parent = ls })
+	Kit.Button(settings.LowScare and "ON" or "OFF", settings.LowScare and T.Good or T.PanelLight, function()
+		settings.LowScare = not settings.LowScare
+		Net.UpdateSettings:FireServer(settings)
+	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(110, 44), Parent = ls })
+
+	local codeRow = row(settingsScroll, 4, 54)
+	local box = New("TextBox", {
+		PlaceholderText = "Enter code",
+		Text = "",
+		ClearTextOnFocus = false,
+		BackgroundColor3 = T.Bg,
+		TextColor3 = T.Text,
+		Font = T.Font,
+		TextSize = 16,
+		Position = UDim2.fromOffset(8, 7),
+		Size = UDim2.new(1, -140, 0, 40),
+		Parent = codeRow,
+	}, { Kit.Corner(8) })
+	Kit.Button("Redeem", T.Accent, function()
+		Net.RequestRedeemCode:FireServer(box.Text)
+	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(110, 44), Parent = codeRow })
+
+	local nameRow = row(settingsScroll, 5, 54)
+	local nameBox = New("TextBox", {
+		PlaceholderText = `Dock name ({S.Get("RenameTokens") or 0} rename tokens)`,
+		Text = "",
+		ClearTextOnFocus = false,
+		BackgroundColor3 = T.Bg,
+		TextColor3 = T.Text,
+		Font = T.Font,
+		TextSize = 16,
+		Position = UDim2.fromOffset(8, 7),
+		Size = UDim2.new(1, -140, 0, 40),
+		Parent = nameRow,
+	}, { Kit.Corner(8) })
+	Kit.Button("Rename", T.Gold, function()
+		Net.RenameDock:FireServer(nameBox.Text)
+	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(110, 44), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = nameRow })
+
+	Kit.Label({
+		Text = "Graphics quality follows your Roblox settings (Esc → Settings). Controls: WASD swim · Space up · Ctrl/C down · Shift boost · Q sonar · G flare · R instant surface · B bag · U upgrades · M shop",
+		TextColor3 = T.Muted,
+		TextSize = 13,
+		LayoutOrder = 6,
+		Size = UDim2.new(1, -8, 0, 60),
+		Parent = settingsScroll,
+	})
+end
+
+------------------------------------------------------------------------------------------
+function MenuController.Start()
+	local UI = controllers.UIController
+	UI.RegisterWindow("Bag", "Bag & Dock", function(body)
+		bagScroll = scrollBody(body)
+	end, renderBag)
+	UI.RegisterWindow("Upgrades", "Upgrades", function(body)
+		upScroll = scrollBody(body)
+	end, renderUpgrades)
+	UI.RegisterWindow("Codex", "Codex", function(body)
+		local tabs = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = body }, { Kit.List(6, true) })
+		for i, zone in Zones.List do
+			Kit.Button(zone.Name, T.PanelLight, function()
+				codexZone = i
+				renderCodex()
+			end, { Size = UDim2.fromOffset(130, 40), TextSize = 13, LayoutOrder = i, Parent = tabs })
+		end
+		codexTitle = Kit.Label({ Text = "", Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 24), Parent = body })
+		codexScroll = Kit.Scroll({ Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 1, -76), Parent = body })
+		New("UIGridLayout", { CellSize = UDim2.fromOffset(150, 90), CellPadding = UDim2.fromOffset(6, 6), Parent = codexScroll })
+	end, renderCodex)
+	UI.RegisterWindow("Quests", "Quests & Tide Pass", function(body)
+		questScroll = scrollBody(body)
+	end, renderQuests)
+	UI.RegisterWindow("Rebirth", "Resurface", function(body)
+		rebirthScroll = scrollBody(body)
+	end, renderRebirth)
+	UI.RegisterWindow("Leaderboards", "Leaderboards", function(body)
+		lbScroll = scrollBody(body)
+	end, renderLeaderboards)
+	UI.RegisterWindow("Players", "Players", function(body)
+		playersScroll = scrollBody(body)
+	end, renderPlayers)
+	UI.RegisterWindow("Trade", "Trade", function(body)
+		tradeScroll = scrollBody(body)
+	end, renderTrade)
+	UI.RegisterWindow("Settings", "Settings", function(body)
+		settingsScroll = scrollBody(body)
+	end, renderSettings)
+
+	S.Changed:Connect(function(keys)
+		if keys.Bag or keys.Storage or keys.Stands or keys.Vault or keys.Derived or keys.IncomePerSecond then
+			UI.Refresh("Bag")
+		end
+		if keys.Upgrades or keys.Coins or keys.Suit then
+			UI.Refresh("Upgrades")
+		end
+		if keys.Codex then
+			UI.Refresh("Codex")
+		end
+		if keys.Quests or keys.TidePass or keys.LastDailyClaimDay then
+			UI.Refresh("Quests")
+		end
+		if keys.Rebirths or keys.Talents or keys.RebirthTokens or keys.LifetimeCoins then
+			UI.Refresh("Rebirth")
+		end
+		if keys.Settings or keys.RenameTokens then
+			UI.Refresh("Settings")
+		end
+		if keys.Storage then
+			UI.Refresh("Trade")
+		end
+	end)
+	Net.Leaderboards.OnClientEvent:Connect(function(data)
+		leaderboardData = data
+		UI.Refresh("Leaderboards")
+	end)
+	Net.TradeUpdated.OnClientEvent:Connect(function(st)
+		if st.Kind == "Invite" then
+			controllers.OfferController.Confirm(`{st.From} wants to trade with you.`, "Accept", function(accepted)
+				Net.TradeRespond:FireServer(st.FromUserId, accepted)
+			end)
+		elseif st.Kind == "Session" then
+			tradeState = st
+			if not UI.IsOpen("Trade") then
+				tradeSelection = {}
+				UI.Open("Trade")
+			else
+				renderTrade()
+			end
+		elseif st.Kind == "Closed" then
+			tradeState = nil
+			tradeSelection = {}
+			UI.Toast(st.Reason, "info")
+			if UI.IsOpen("Trade") then
+				UI.Close()
+			end
+		end
+	end)
+	Net.PartyUpdated.OnClientEvent:Connect(function(info)
+		if info.Invite then
+			controllers.OfferController.Confirm(`{info.Invite} invited you to a Dive Party (+10% luck each).`, "Join", function(accepted)
+				Net.PartyRespond:FireServer(accepted)
+			end)
+		elseif info.Members then
+			local names = {}
+			for _, m in info.Members do
+				table.insert(names, m.Name)
+			end
+			UI.Toast(if #names > 0 then "Party: " .. table.concat(names, ", ") else "You left the party.", "info")
+		end
+	end)
+	Players.PlayerAdded:Connect(function()
+		UI.Refresh("Players")
+	end)
+	Players.PlayerRemoving:Connect(function()
+		task.defer(UI.Refresh, "Players")
+	end)
+end
+
+return MenuController
diff --git a/src/client/Controllers/OfferController.luau b/src/client/Controllers/OfferController.luau
new file mode 100644
index 0000000..aa9b6fa
--- /dev/null
+++ b/src/client/Controllers/OfferController.luau
@@ -0,0 +1,241 @@
+-- OfferController (Master Plan §15.10, §22.5): contextual offers, death screen with revive
+-- timer, "You were robbed" screen with revenge, offline-earnings popup and confirm dialogs.
+-- Rule: at most one UNPROMPTED offer per 10 minutes; contextual offers are always allowed
+-- because the player can simply dismiss them.
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local NumberFormat = require(Shared.NumberFormat)
+local Passes = require(Shared.Config.Passes)
+local Products = require(Shared.Config.Products)
+local Economy = require(Shared.Config.Economy)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local New, T = Kit.New, Kit.Theme
+local OfferController = {}
+local controllers
+local lastUnprompted = -math.huge
+local current: Frame? = nil
+
+local UNPROMPTED = { StarterPack = true, Drone = true }
+
+local OFFER_TEXT = {
+	DoubleOxygen = "Out of air? Double your tank — forever.",
+	BigBag = "Bag full! Carry 4 more relics every dive.",
+	ExtraSlots = "Stands full! Add 4 more display stands.",
+	VaultLock = "Protect your best relics: 2 unstealable vault slots + keep 1 relic when you die.",
+	LuckySonar = "So close! +25% luck on every rare roll.",
+	InstantSurface = "Teleport home once per dive — never lose a bag in the deep again.",
+	Drone = "Let a drone collect Common & Uncommon relics around you.",
+	AutoCollect = "Never walk to the collector pad again.",
+	StarterPack = "One-time offer: 10K Coins, 100 Pearls, the Neoprene suit and a Rare relic!",
+	Flares5 = "Out of flares! 5 flares distract the Leviathan for 6s each.",
+	GateRecharge = "Recharge your Laser Gate right now.",
+	SkipPity = "Unlucky streak? Roll the Legendary table instantly.",
+	ServerLuck = "Give EVERYONE in the server 2x luck for 15 minutes. Your name gets announced!",
+	BarnacleClean = "Scrub off the barnacles and reroll this relic's mutation.",
+	TidePassPremium = "Unlock the premium Tide Pass track.",
+	RenameDock = "Give your dock a custom name.",
+	VIP = "VIP Divers earn 1.5x Coins and get into the VIP lounge.",
+}
+
+function OfferController.Init(c)
+	controllers = c
+end
+
+local function closeCurrent()
+	if current then
+		current:Destroy()
+		current = nil
+	end
+end
+
+local function modal(height: number?): Frame
+	closeCurrent()
+	local f = Kit.Panel({
+		Name = "Modal",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = UDim2.fromOffset(380, height or 230),
+		Parent = controllers.UIController.Overlay,
+	}, { Kit.Padding(14), Kit.List(8, false, Enum.HorizontalAlignment.Center) })
+	Kit.Pop(f)
+	current = f
+	return f
+end
+
+local function buttonsRow(parent: Frame, order: number)
+	return New("Frame", {
+		BackgroundTransparency = 1,
+		Size = UDim2.new(1, 0, 0, 52),
+		LayoutOrder = order,
+		Parent = parent,
+	}, { Kit.List(8, true, Enum.HorizontalAlignment.Center) })
+end
+
+-- Generic offer for a pass or product key
+function OfferController.Show(key: string)
+	local pass = Passes[key]
+	local product = Products[key]
+	if not pass and not product then
+		return
+	end
+	if pass and controllers.State.Owns(key) then
+		return
+	end
+	if UNPROMPTED[key] then
+		if os.clock() - lastUnprompted < Economy.UnpromptedOfferCooldown then
+			return
+		end
+		lastUnprompted = os.clock()
+	end
+	Net.OfferShown:FireServer(key)
+	local def = pass or product
+	local f = modal()
+	Kit.Label({ Text = def.name, Font = T.Bold, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), Parent = f })
+	Kit.Label({
+		Text = OFFER_TEXT[key] or def.desc or "",
+		TextSize = 16,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		LayoutOrder = 2,
+		Size = UDim2.new(1, 0, 0, 70),
+		Parent = f,
+	})
+	local row = buttonsRow(f, 3)
+	Kit.Button(`Buy · {def.price} R$`, T.Gold, function()
+		Net.RequestPurchase:FireServer(if pass then "Pass" else "Product", key)
+		closeCurrent()
+	end, { Size = UDim2.fromOffset(170, 48), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = row })
+	Kit.Button("No thanks", T.PanelLight, closeCurrent, { Size = UDim2.fromOffset(130, 48), Parent = row })
+end
+
+function OfferController.Confirm(text: string, okLabel: string, callback: (boolean) -> ())
+	local f = modal(190)
+	Kit.Label({ Text = text, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 70), Parent = f })
+	local row = buttonsRow(f, 2)
+	Kit.Button(okLabel, T.Good, function()
+		closeCurrent()
+		callback(true)
+	end, { Size = UDim2.fromOffset(140, 48), Parent = row })
+	Kit.Button("Decline", T.PanelLight, function()
+		closeCurrent()
+		callback(false)
+	end, { Size = UDim2.fromOffset(140, 48), Parent = row })
+	task.delay(30, function()
+		if current == f then
+			closeCurrent()
+			callback(false)
+		end
+	end)
+end
+
+local function deathScreen(info)
+	local f = modal(260)
+	local lowScare = (controllers.State.Get("Settings") or {}).LowScare
+	local causeText = ({
+		Leviathan = if lowScare then "The Leviathan got you." else "THE LEVIATHAN GOT YOU",
+		Oxygen = "You ran out of air.",
+		Pressure = "The pressure was too much — get a stronger suit.",
+		Eel = "Shocked by an eel.",
+		Jellyfish = "Stung by jellyfish.",
+	})[info.Cause] or "You were knocked out."
+	Kit.Label({ Text = causeText, Font = T.Bold, TextSize = 20, TextColor3 = T.Bad, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), Parent = f })
+	local bagText = if info.BagCount > 0
+		then `Your bag ({info.BagCount} relics, ~{NumberFormat.short(info.BagValue)} Coins) will sink in`
+		else "Your bag was empty."
+	local timerLabel = Kit.Label({ Text = bagText, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 50), Parent = f })
+	if info.Kept then
+		Kit.Label({ Text = "Vault Lock kept your most valuable relic safe.", TextColor3 = T.Good, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 20), Parent = f })
+	end
+	local row = buttonsRow(f, 4)
+	if info.BagCount > 0 or info.Underwater then
+		if info.FreeRevive then
+			Kit.Button("Free revive (Pass+)", T.Accent, function()
+				Net.RequestFreeRevive:FireServer()
+				closeCurrent()
+			end, { Size = UDim2.fromOffset(170, 48), Parent = row })
+		end
+		Kit.Button(`Revive here · {Products.Revive.price} R$`, T.Gold, function()
+			Net.RequestPurchase:FireServer("Product", "Revive")
+		end, { Size = UDim2.fromOffset(190, 48), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = row })
+	end
+	Kit.Button("Respawn", T.PanelLight, closeCurrent, { Size = UDim2.fromOffset(110, 48), Parent = row })
+	local deadline = os.clock() + info.Timer
+	task.spawn(function()
+		while current == f and os.clock() < deadline do
+			if info.BagCount > 0 then
+				timerLabel.Text = `{bagText} {math.ceil(deadline - os.clock())}s. Other divers can loot it!`
+			end
+			task.wait(0.2)
+		end
+		if current == f then
+			closeCurrent()
+		end
+	end)
+end
+
+local function robbedScreen(info)
+	local f = modal(250)
+	Kit.Label({ Text = "YOU WERE ROBBED!", Font = T.Bold, TextSize = 22, TextColor3 = T.Bad, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), Parent = f })
+	Kit.Label({ Text = `{info.Thief} stole your {info.Rarity} {info.Relic}.`, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 40), Parent = f })
+	local row = buttonsRow(f, 3)
+	Kit.Button(`Revenge! ({info.RevengeSeconds}s)`, T.Bad, function()
+		Net.RequestRevenge:FireServer()
+		closeCurrent()
+	end, { Size = UDim2.fromOffset(170, 48), Parent = row })
+	if not info.HasVault then
+		Kit.Button(`Vault Lock · {Passes.VaultLock.price} R$`, T.Gold, function()
+			Net.RequestPurchase:FireServer("Pass", "VaultLock")
+			closeCurrent()
+		end, { Size = UDim2.fromOffset(170, 48), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = row })
+	end
+	Kit.Button("Close", T.PanelLight, closeCurrent, { Size = UDim2.fromOffset(100, 40), LayoutOrder = 4, Parent = f })
+end
+
+local function offlineScreen(info)
+	local f = modal(240)
+	Kit.Label({ Text = "Welcome back, diver!", Font = T.Bold, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), Parent = f })
+	Kit.Label({
+		Text = `Your dock earned {NumberFormat.short(info.Amount)} Coins while you were away ({NumberFormat.time(math.min(info.Elapsed, info.CapHours * 3600))}, cap {info.CapHours}h).`,
+		TextSize = 16,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		LayoutOrder = 2,
+		Size = UDim2.new(1, 0, 0, 60),
+		Parent = f,
+	})
+	local row = buttonsRow(f, 3)
+	Kit.Button("Collect", T.Good, function()
+		Net.RequestClaimOffline:FireServer(false)
+		closeCurrent()
+	end, { Size = UDim2.fromOffset(130, 48), Parent = row })
+	if info.CanDouble then
+		Kit.Button(`Collect 2x (Pass+)`, T.Accent, function()
+			Net.RequestClaimOffline:FireServer(true)
+			closeCurrent()
+		end, { Size = UDim2.fromOffset(170, 48), Parent = row })
+	else
+		Kit.Button("2x with Pass+", T.Gold, function()
+			Net.RequestClaimOffline:FireServer(false)
+			closeCurrent()
+			controllers.ShopController.OpenTab("Pass+")
+		end, { Size = UDim2.fromOffset(170, 48), TextColor3 = Color3.fromRGB(40, 25, 0), Parent = row })
+	end
+end
+
+function OfferController.Start()
+	Net.Offer.OnClientEvent:Connect(OfferController.Show)
+	Net.PlayerDied.OnClientEvent:Connect(deathScreen)
+	Net.Revived.OnClientEvent:Connect(function()
+		closeCurrent()
+		controllers.UIController.Toast("Revived! Your bag is safe.", "reward")
+	end)
+	Net.Robbed.OnClientEvent:Connect(robbedScreen)
+	Net.OfflineEarnings.OnClientEvent:Connect(function(info)
+		task.wait(2)
+		offlineScreen(info)
+	end)
+end
+
+return OfferController
diff --git a/src/client/Controllers/PromptController.luau b/src/client/Controllers/PromptController.luau
new file mode 100644
index 0000000..b257526
--- /dev/null
+++ b/src/client/Controllers/PromptController.luau
@@ -0,0 +1,72 @@
+-- PromptController: shows each player only the ProximityPrompts that make sense for them
+-- (owners see Display/Take, others see Steal) and applies the player's own salvage hold time.
+-- Purely cosmetic: the server validates every trigger regardless.
+
+local Players = game:GetService("Players")
+local Workspace = game:GetService("Workspace")
+
+local player = Players.LocalPlayer
+local PromptController = {}
+
+local function myDock(model: Instance?): boolean
+	return model ~= nil and model:GetAttribute("OwnerUserId") == player.UserId
+end
+
+local function applyStand(stand: BasePart)
+	local dockModel = stand.Parent
+	local visible = stand:GetAttribute("Visible") == true
+	local hasRelic = stand:GetAttribute("HasRelic") == true
+	local mine = myDock(dockModel)
+	local place = stand:FindFirstChild("Place") :: ProximityPrompt?
+	local steal = stand:FindFirstChild("Steal") :: ProximityPrompt?
+	if place then
+		place.Enabled = visible and mine
+	end
+	if steal then
+		steal.Enabled = visible and hasRelic and not mine and dockModel:GetAttribute("OwnerUserId") ~= nil
+	end
+end
+
+function PromptController.Start()
+	local root = Workspace:WaitForChild("AbyssWorld", 30)
+	if not root then
+		return
+	end
+	local docks = root:WaitForChild("Docks")
+	local nodes = root:WaitForChild("Nodes")
+
+	nodes.DescendantAdded:Connect(function(d)
+		if d:IsA("ProximityPrompt") and d.Name == "Salvage" then
+			local secs = player.Character and player.Character:GetAttribute("SalvageSeconds")
+			if secs then
+				d.HoldDuration = secs
+			end
+		end
+	end)
+
+	while true do
+		local secs = player.Character and player.Character:GetAttribute("SalvageSeconds")
+		if secs then
+			for _, d in nodes:GetDescendants() do
+				if d:IsA("ProximityPrompt") and d.HoldDuration ~= secs then
+					d.HoldDuration = secs
+				end
+			end
+		end
+		for _, dock in docks:GetChildren() do
+			for _, part in dock:GetChildren() do
+				if part:GetAttribute("StandIndex") or part:GetAttribute("VaultIndex") then
+					applyStand(part)
+				elseif part.Name == "GateButton" then
+					local gp = part:FindFirstChild("GatePrompt") :: ProximityPrompt?
+					if gp and not myDock(dock) then
+						gp.Enabled = false
+					end
+				end
+			end
+		end
+		task.wait(0.5)
+	end
+end
+
+return PromptController
diff --git a/src/client/Controllers/RevealController.luau b/src/client/Controllers/RevealController.luau
new file mode 100644
index 0000000..990ca41
--- /dev/null
+++ b/src/client/Controllers/RevealController.luau
@@ -0,0 +1,166 @@
+-- RevealController (Master Plan §7.1 reveal effects, §18.3): rarity reveal card with
+-- tier-specific flair. Reveals become skippable (tap) after the first 10.
+
+local TweenService = game:GetService("TweenService")
+local Lighting = game:GetService("Lighting")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local Formulas = require(Shared.Formulas)
+local NumberFormat = require(Shared.NumberFormat)
+local Relics = require(Shared.Config.Relics)
+local Rarities = require(Shared.Config.Rarities)
+local Mutations = require(Shared.Config.Mutations)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local New, T = Kit.New, Kit.Theme
+local RevealController = {}
+local controllers
+local seen = 0
+local queue = {}
+local showing = false
+
+function RevealController.Init(c)
+	controllers = c
+end
+
+local function showNext()
+	if showing or #queue == 0 then
+		return
+	end
+	showing = true
+	local entry = table.remove(queue, 1)
+	local relic = entry.relic
+	local def = Relics.ById[relic.id]
+	local rarity = Rarities[relic.rarity]
+	local tier = rarity.Tier
+	seen += 1
+
+	local overlay = controllers.UIController.Overlay
+	local card = Kit.Panel({
+		Name = "Reveal",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.42),
+		Size = UDim2.fromOffset(340, 200),
+		BackgroundColor3 = Color3.fromRGB(8, 12, 22),
+		Parent = overlay,
+	}, { Kit.Padding(12), Kit.List(4, false, Enum.HorizontalAlignment.Center) })
+	local stroke = card:FindFirstChildOfClass("UIStroke")
+	stroke.Color = rarity.Color
+	stroke.Thickness = if tier >= 5 then 4 else 2
+
+	local mutText = ""
+	if #relic.mutations > 0 then
+		local parts = {}
+		for _, m in relic.mutations do
+			table.insert(parts, `{m} x{Mutations.ById[m] and Mutations.ById[m].Mult or 1}`)
+		end
+		mutText = table.concat(parts, " · ")
+	end
+	Kit.Label({
+		Text = `{rarity.Icon} {relic.rarity:upper()} {rarity.Icon}`,
+		Font = T.Bold,
+		TextSize = if tier >= 6 then 30 else 24,
+		TextColor3 = if relic.rarity == "Secret" then Color3.new(1, 1, 1) else rarity.Color,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		Size = UDim2.new(1, 0, 0, 34),
+		Parent = card,
+	})
+	Kit.Label({
+		Text = (if relic.size >= 1.35 then "HUGE! " else "") .. def.Name,
+		Font = T.Bold,
+		TextSize = 22,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		Size = UDim2.new(1, 0, 0, 28),
+		Parent = card,
+	})
+	if mutText ~= "" then
+		local m = Mutations.ById[relic.mutations[1]]
+		Kit.Label({
+			Text = mutText,
+			Font = T.Bold,
+			TextSize = 16,
+			TextColor3 = m and m.Color or T.Accent,
+			TextXAlignment = Enum.TextXAlignment.Center,
+			Size = UDim2.new(1, 0, 0, 20),
+			Parent = card,
+		})
+	end
+	Kit.Label({
+		Text = `Size {relic.size}x · +{NumberFormat.short(Formulas.RelicCPS(relic))} Coins/s when displayed`,
+		TextColor3 = T.Muted,
+		TextSize = 14,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		Size = UDim2.new(1, 0, 0, 18),
+		Parent = card,
+	})
+	Kit.Label({
+		Text = `"{def.Lore}"`,
+		TextColor3 = T.Muted,
+		TextSize = 13,
+		Font = Enum.Font.GothamMedium,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		Size = UDim2.new(1, 0, 0, 34),
+		Parent = card,
+	})
+	Kit.Pop(card)
+
+	-- Tier flair: screen glow (Epic), slow-mo blur (Legendary), flash (Mythic+)
+	local blur
+	if tier >= 5 then
+		blur = Instance.new("BlurEffect")
+		blur.Size = 12
+		blur.Parent = Lighting
+	end
+	if tier >= 4 then
+		local glow = New("Frame", {
+			BackgroundColor3 = rarity.Color,
+			BackgroundTransparency = 0.6,
+			Size = UDim2.fromScale(1, 1),
+			ZIndex = 0,
+			Parent = overlay,
+		})
+		TweenService:Create(glow, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
+		task.delay(1.3, function()
+			glow:Destroy()
+		end)
+	end
+	if controllers.AudioController then
+		controllers.AudioController.Play("Reveal", 0.8 + tier * 0.08)
+	end
+
+	local duration = ({ 1.4, 1.6, 2, 2.4, 3.2, 4.5, 6 })[tier] or 2
+	local done = false
+	local function finish()
+		if done then
+			return
+		end
+		done = true
+		if blur then
+			blur:Destroy()
+		end
+		card:Destroy()
+		showing = false
+		showNext()
+	end
+	if seen > 10 then
+		local skip = New("TextButton", {
+			BackgroundTransparency = 1,
+			Text = "",
+			Size = UDim2.fromScale(1, 1),
+			Parent = card,
+		})
+		skip.Activated:Connect(finish)
+	end
+	task.delay(duration, finish)
+end
+
+function RevealController.Start()
+	Net.RevealRelic.OnClientEvent:Connect(function(relic, source)
+		table.insert(queue, { relic = relic, source = source })
+		showNext()
+	end)
+end
+
+return RevealController
diff --git a/src/client/Controllers/ShopController.luau b/src/client/Controllers/ShopController.luau
new file mode 100644
index 0000000..e709acb
--- /dev/null
+++ b/src/client/Controllers/ShopController.luau
@@ -0,0 +1,260 @@
+-- ShopController (Master Plan §15, §18.2): tabs for Passes, Boosts, Coins, Pearls, Crates and
+-- Abyss Pass+. VIP banner always on top. Every prompt previews its benefit first (§18.3).
+-- Crate odds are displayed from the exact table the server rolls (§16).
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local NumberFormat = require(Shared.NumberFormat)
+local WeightedRandom = require(Shared.WeightedRandom)
+local Passes = require(Shared.Config.Passes)
+local Products = require(Shared.Config.Products)
+local Economy = require(Shared.Config.Economy)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local New, T = Kit.New, Kit.Theme
+local ShopController = {}
+local controllers
+local content: ScrollingFrame
+local currentTab = "Passes"
+
+local PASS_ORDER = {
+	"VIP",
+	"DoubleOxygen",
+	"Drone",
+	"LuckySonar",
+	"VaultLock",
+	"ExtraSlots",
+	"BigBag",
+	"InstantSurface",
+	"SpeedFins",
+	"AutoCollect",
+	"MutationScan",
+	"Radio",
+	"DeepDiverBundle",
+	"CollectorBundle",
+}
+local BOOSTS = { "LuckPotion", "MutationPotion", "ServerLuck", "Flares5", "OxygenRefill", "SkipPity", "TierSkip", "RenameDock" }
+local COINS = { "CoinsS", "CoinsM", "CoinsL", "CoinsXL", "CoinsXXL" }
+local PEARLS = { "Pearls100", "Pearls550", "Pearls1200", "Pearls2600", "Pearls7000" }
+
+function ShopController.Init(c)
+	controllers = c
+end
+
+-- §18.3 concrete previews
+local function preview(key: string): string?
+	local S = controllers.State
+	if key == "DoubleOxygen" then
+		local o = S.Derived("MaxOxygen") or 60
+		return `Dive time {math.floor(o)}s → {math.floor(o + 60)}s`
+	elseif key == "BigBag" then
+		local b = S.Derived("BagSize") or 3
+		return `Bag {b} → {b + 4} slots`
+	elseif key == "ExtraSlots" then
+		local n = S.Derived("StandCount") or 6
+		return `Stands {n} → {n + 4}`
+	elseif key == "VIP" then
+		local inc = S.Get("IncomePerSecond") or 0
+		return `Income +{NumberFormat.short(inc)}/s → +{NumberFormat.short(inc * 1.5)}/s`
+	elseif key == "SpeedFins" then
+		local s = S.Derived("SwimSpeed") or 24
+		return `Swim speed {math.floor(s)} → {math.floor(s * 1.3)}`
+	end
+	return nil
+end
+
+local function card(order: number, title: string, desc: string, priceText: string, owned: boolean, onBuy, highlight: Color3?)
+	local f = New("Frame", {
+		BackgroundColor3 = T.PanelLight,
+		Size = UDim2.new(1, -8, 0, 78),
+		LayoutOrder = order,
+		Parent = content,
+	}, { Kit.Corner(10) })
+	if highlight then
+		Kit.Stroke(highlight, 2).Parent = f
+	end
+	Kit.Label({ Text = title, Font = T.Bold, TextSize = 18, Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -160, 0, 24), Parent = f })
+	Kit.Label({
+		Text = desc,
+		TextColor3 = T.Muted,
+		TextSize = 14,
+		Position = UDim2.fromOffset(12, 30),
+		Size = UDim2.new(1, -160, 0, 44),
+		TextYAlignment = Enum.TextYAlignment.Top,
+		Parent = f,
+	})
+	local b = Kit.Button(if owned then "Owned ✓" else priceText, if owned then T.Good else T.Gold, if owned then nil else onBuy, {
+		AnchorPoint = Vector2.new(1, 0.5),
+		Position = UDim2.new(1, -10, 0.5, 0),
+		Size = UDim2.fromOffset(130, 50),
+		TextColor3 = if owned then Color3.new(1, 1, 1) else Color3.fromRGB(40, 25, 0),
+		Parent = f,
+	})
+	b.AutoButtonColor = not owned
+	return f
+end
+
+local function buy(kind: string, key: string)
+	Net.RequestPurchase:FireServer(kind, key)
+end
+
+local function render()
+	Kit.Clear(content)
+	local S = controllers.State
+	local order = 0
+	local function nextOrder()
+		order += 1
+		return order
+	end
+	if currentTab == "Passes" then
+		for _, key in PASS_ORDER do
+			local def = Passes[key]
+			local extra = preview(key)
+			local desc = def.desc .. (if extra then "\n" .. extra else "")
+			card(nextOrder(), def.name, desc, `{def.price} R$`, S.Owns(key), function()
+				buy("Pass", key)
+			end, if key == "VIP" then T.Gold else nil)
+		end
+	elseif currentTab == "Boosts" then
+		for _, key in BOOSTS do
+			local def = Products[key]
+			local desc = ({
+				LuckPotion = "2x luck for 10 minutes",
+				MutationPotion = "3x mutation chance for 10 minutes",
+				ServerLuck = "2x rare odds for EVERYONE in the server for 15 minutes. Your name is announced!",
+				Flares5 = "Distract the Leviathan for 6 seconds",
+				OxygenRefill = "Full tank instantly",
+				SkipPity = "Instant roll on the Legendary table",
+				TierSkip = "+1 Tide Pass tier",
+				RenameDock = "Custom dock sign (filtered)",
+			})[key] or ""
+			card(nextOrder(), def.name, desc, `{def.price} R$`, false, function()
+				buy("Product", key)
+			end)
+		end
+	elseif currentTab == "Coins" then
+		local income = S.Get("IncomePerSecond") or 0
+		for _, key in COINS do
+			local def = Products[key]
+			local amount = math.max(income * def.incomeMinutes * 60, def.floor)
+			card(
+				nextOrder(),
+				`{NumberFormat.short(amount)} Coins`,
+				`{NumberFormat.time(def.incomeMinutes * 60)} of your current income`,
+				`{def.price} R$`,
+				false,
+				function()
+					buy("Product", key)
+				end
+			)
+		end
+	elseif currentTab == "Pearls" then
+		for _, key in PEARLS do
+			local def = Products[key]
+			card(nextOrder(), def.name, "Premium currency for cosmetics, crates and the Tide Pass", `{def.price} R$`, false, function()
+				buy("Product", key)
+			end)
+		end
+	elseif currentTab == "Crates" then
+		if S.Derived("CanBuyRandom") == false then
+			Kit.Label({
+				Text = "Mystery Crates aren't available in your region. Every item is also sold directly in the other tabs.",
+				TextSize = 16,
+				Size = UDim2.new(1, -8, 0, 60),
+				Parent = content,
+			})
+			return
+		end
+		local odds = WeightedRandom.percentages(Economy.Crate)
+		local lines = {}
+		for i, e in odds do
+			table.insert(lines, `{Economy.Crate[i].label}: {NumberFormat.percent(e.percent)}`)
+		end
+		Kit.Label({
+			Text = "ODDS (exact):\n" .. table.concat(lines, "\n"),
+			TextSize = 14,
+			LayoutOrder = nextOrder(),
+			Size = UDim2.new(1, -8, 0, 22 + #lines * 18),
+			Parent = content,
+		})
+		card(nextOrder(), Products.CrateSingle.name, "One random reward from the table above", `{Products.CrateSingle.price} R$`, false, function()
+			buy("Product", "CrateSingle")
+		end)
+		card(nextOrder(), Products.CrateTriple.name, "Three rolls on the table above", `{Products.CrateTriple.price} R$`, false, function()
+			buy("Product", "CrateTriple")
+		end)
+	elseif currentTab == "Pass+" then
+		card(
+			nextOrder(),
+			"Abyss Pass+ (monthly)",
+			"60 Pearls/day · +10% Coins · +10% luck · 1 free revive/day · +4h offline cap · 2x offline claim · keeps your login streak",
+			"Subscribe",
+			S.Get("Subscribed") == true,
+			function()
+				buy("Subscription", "PassPlus")
+			end,
+			T.Accent
+		)
+		card(nextOrder(), "Roblox Premium", "+10% Coins and a Premium Chest every 24h", "Get Premium", S.Get("Premium") == true, function()
+			buy("Premium", "Premium")
+		end)
+		if S.Derived("StarterPackAvailable") then
+			local remaining = Products.StarterPack.offerHours * 3600 - (os.time() - (S.Derived("StarterPackShownAt") or os.time()))
+			card(
+				nextOrder(),
+				"Starter Pack",
+				`10K Coins · 100 Pearls · Neoprene suit · Rare relic\nOffer ends in {NumberFormat.time(remaining)}`,
+				`{Products.StarterPack.price} R$`,
+				false,
+				function()
+					buy("Product", "StarterPack")
+				end,
+				T.Gold
+			)
+		end
+	end
+end
+
+local function build(body: Frame)
+	local banner = Kit.Button("👑 VIP DIVER — 1.5x Coins, VIP lounge, daily chest · 249 R$", T.Gold, function()
+		buy("Pass", "VIP")
+	end, {
+		Size = UDim2.new(1, 0, 0, 44),
+		TextColor3 = Color3.fromRGB(40, 25, 0),
+		TextScaled = true,
+		Parent = body,
+	})
+	New("UITextSizeConstraint", { MaxTextSize = 18, Parent = banner })
+	local tabs = New("Frame", {
+		BackgroundTransparency = 1,
+		Position = UDim2.fromOffset(0, 50),
+		Size = UDim2.new(1, 0, 0, 44),
+		Parent = body,
+	}, { Kit.List(6, true) })
+	for i, name in { "Passes", "Boosts", "Coins", "Pearls", "Crates", "Pass+" } do
+		Kit.Button(name, T.PanelLight, function()
+			currentTab = name
+			render()
+		end, { Size = UDim2.fromOffset(92, 40), LayoutOrder = i, TextSize = 14, Parent = tabs })
+	end
+	content = Kit.Scroll({ Position = UDim2.fromOffset(0, 100), Size = UDim2.new(1, 0, 1, -100), Parent = body })
+	Kit.List(8).Parent = content
+end
+
+function ShopController.OpenTab(tab: string)
+	currentTab = tab
+	controllers.UIController.Open("Shop")
+end
+
+function ShopController.Start()
+	controllers.UIController.RegisterWindow("Shop", "Shop", build, render)
+	controllers.State.Changed:Connect(function(keys)
+		if keys.Passes or keys.Derived or keys.Subscribed then
+			controllers.UIController.Refresh("Shop")
+		end
+	end)
+end
+
+return ShopController
diff --git a/src/client/Controllers/SonarController.luau b/src/client/Controllers/SonarController.luau
new file mode 100644
index 0000000..207ceec
--- /dev/null
+++ b/src/client/Controllers/SonarController.luau
@@ -0,0 +1,82 @@
+-- SonarController (Master Plan §5.1, §11.1): pings the server and draws temporary markers.
+-- Markers show rarity once Sonar is level 5 and mutations at level 10 / Mutation Scanner.
+
+local Workspace = game:GetService("Workspace")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local Rarities = require(Shared.Config.Rarities)
+
+local MARKER_SECONDS = 7
+local SonarController = {}
+local controllers
+local lastPing = 0
+local markerFolder: Folder
+
+function SonarController.Init(c)
+	controllers = c
+end
+
+function SonarController.Ping()
+	local cd = controllers.State.Derived("SonarCooldown") or 6
+	if os.clock() - lastPing < cd then
+		controllers.UIController.Toast(`Sonar recharging ({math.ceil(cd - (os.clock() - lastPing))}s)`, "info")
+		return
+	end
+	lastPing = os.clock()
+	Net.UseSonar:FireServer()
+end
+
+local function marker(info, from: string?)
+	local p = Instance.new("Part")
+	p.Anchored = true
+	p.CanCollide = false
+	p.CanQuery = false
+	p.Transparency = 1
+	p.Size = Vector3.one
+	p.Position = info.Position
+	local rarity = info.Rarity and Rarities[info.Rarity]
+	local color = if rarity then rarity.Color else Color3.fromRGB(120, 255, 255)
+	local bb = Instance.new("BillboardGui")
+	bb.Size = UDim2.fromOffset(110, 46)
+	bb.AlwaysOnTop = true
+	bb.MaxDistance = 400
+	bb.Parent = p
+	local label = Instance.new("TextLabel")
+	label.BackgroundTransparency = 1
+	label.Size = UDim2.fromScale(1, 1)
+	label.Font = Enum.Font.GothamBold
+	label.TextScaled = true
+	label.TextStrokeTransparency = 0.3
+	label.TextColor3 = color
+	local text = if rarity then `{rarity.Icon} {info.Rarity}` else "◎"
+	if info.Mutations and #info.Mutations > 0 then
+		text ..= "\n" .. table.concat(info.Mutations, " ")
+	end
+	if from then
+		text ..= `\n({from})`
+	end
+	label.Text = text
+	label.Parent = bb
+	p.Parent = markerFolder
+	task.delay(MARKER_SECONDS, function()
+		p:Destroy()
+	end)
+end
+
+function SonarController.Start()
+	markerFolder = Instance.new("Folder")
+	markerFolder.Name = "SonarMarkers"
+	markerFolder.Parent = Workspace
+	Net.SonarResult.OnClientEvent:Connect(function(results, range, from)
+		for _, info in results do
+			marker(info, from)
+		end
+		if not from then
+			controllers.UIController.Toast(`Sonar: {#results} relic{#results == 1 and "" or "s"} within {math.floor(range)} studs`, "info")
+		end
+	end)
+end
+
+return SonarController
diff --git a/src/client/Controllers/State.luau b/src/client/Controllers/State.luau
new file mode 100644
index 0000000..af41d34
--- /dev/null
+++ b/src/client/Controllers/State.luau
@@ -0,0 +1,38 @@
+-- Client-side mirror of the player's profile + derived values, fed by StateUpdated.
+-- Display only: the server is authoritative for everything.
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local Signal = require(Shared.Signal)
+
+local State = {}
+State.Data = {}
+State.Changed = Signal.new() -- (keysTable)
+
+function State.Get(key: string)
+	return State.Data[key]
+end
+
+function State.Derived(key: string)
+	local d = State.Data.Derived
+	return d and d[key]
+end
+
+function State.Owns(pass: string): boolean
+	local passes = State.Data.Passes
+	return passes ~= nil and passes[pass] == true
+end
+
+function State.Start()
+	Net.StateUpdated.OnClientEvent:Connect(function(payload)
+		local keys = {}
+		for k, v in payload do
+			State.Data[k] = v
+			keys[k] = true
+		end
+		State.Changed:Fire(keys)
+	end)
+end
+
+return State
diff --git a/src/client/Controllers/SwimController.luau b/src/client/Controllers/SwimController.luau
new file mode 100644
index 0000000..3a092b3
--- /dev/null
+++ b/src/client/Controllers/SwimController.luau
@@ -0,0 +1,186 @@
+-- SwimController (Master Plan §20.7): custom underwater movement.
+-- Below the water surface the character is PlatformStood and driven by a LinearVelocity
+-- (camera-relative 3D movement) plus an AlignOrientation for a "diving" pose.
+-- PC: WASD + Space (up) / Ctrl or C (down) / Shift (boost).  Mobile: joystick + HUD buttons.
+-- Server still decides oxygen, damage and loot; this only moves the client-owned character.
+
+local Players = game:GetService("Players")
+local RunService = game:GetService("RunService")
+local UserInputService = game:GetService("UserInputService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Workspace = game:GetService("Workspace")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local World = require(Shared.Config.World)
+local Upgrades = require(Shared.Config.Upgrades)
+
+local player = Players.LocalPlayer
+local SURFACE = World.WaterSurfaceY
+
+local SwimController = {}
+local vertical = 0 -- -1..1 from mobile buttons
+local boostHeld = false
+local mobileBoost = false
+local swimming = false
+local lastBoostSent = false
+local velocity = Vector3.zero
+local knock = Vector3.zero
+local linVel: LinearVelocity? = nil
+local align: AlignOrientation? = nil
+
+SwimController.Depth = 0
+
+function SwimController.SetVertical(v: number)
+	vertical = v
+end
+
+function SwimController.SetBoost(on: boolean)
+	mobileBoost = on
+end
+
+function SwimController.IsSwimming(): boolean
+	return swimming
+end
+
+local function setup(char: Model)
+	local hrp = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
+	if not hrp then
+		return
+	end
+	local att = Instance.new("Attachment")
+	att.Name = "SwimAttachment"
+	att.Parent = hrp
+	local lv = Instance.new("LinearVelocity")
+	lv.Name = "SwimVelocity"
+	lv.Attachment0 = att
+	lv.RelativeTo = Enum.ActuatorRelativeTo.World
+	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
+	lv.MaxForce = 0
+	lv.Parent = hrp
+	local ao = Instance.new("AlignOrientation")
+	ao.Name = "SwimAlign"
+	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
+	ao.Attachment0 = att
+	ao.Responsiveness = 12
+	ao.MaxTorque = 0
+	ao.Parent = hrp
+	linVel, align = lv, ao
+	swimming = false
+	velocity = Vector3.zero
+end
+
+local function keyDown(...: Enum.KeyCode): boolean
+	for _, k in { ... } do
+		if UserInputService:IsKeyDown(k) then
+			return true
+		end
+	end
+	return false
+end
+
+local function step(dt: number)
+	local char = player.Character
+	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
+	local hum = char and char:FindFirstChildOfClass("Humanoid")
+	if not hrp or not hum or hum.Health <= 0 or not linVel or not align then
+		return
+	end
+	local depth = SURFACE - hrp.Position.Y
+	SwimController.Depth = depth
+
+	-- Hysteresis so you don't flicker at the surface
+	local wantSwim = if swimming then depth > -0.5 else depth > 1.5
+	if wantSwim ~= swimming then
+		swimming = wantSwim
+		hum.PlatformStand = swimming
+		linVel.MaxForce = if swimming then 1e6 else 0
+		align.MaxTorque = if swimming then 1e6 else 0
+		if not swimming then
+			-- pop out of the water so you can climb onto a dock
+			hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(velocity.Y, 0) + 62, velocity.Z)
+		end
+	end
+	if not swimming then
+		return
+	end
+
+	local cam = Workspace.CurrentCamera
+	local look = cam.CFrame.LookVector
+	local flatLook = Vector3.new(look.X, 0, look.Z)
+	flatLook = if flatLook.Magnitude > 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)
+	local move = hum.MoveDirection
+	-- forward input follows camera pitch (§20.7 camera-relative 3D movement)
+	local forward = move:Dot(flatLook)
+	local dir = move + Vector3.new(0, look.Y * math.max(forward, 0) * 1.2, 0)
+	local up = vertical
+	if keyDown(Enum.KeyCode.Space, Enum.KeyCode.ButtonA) then
+		up = 1
+	elseif keyDown(Enum.KeyCode.LeftControl, Enum.KeyCode.C, Enum.KeyCode.ButtonB) then
+		up = -1
+	end
+	dir += Vector3.new(0, up, 0)
+	if dir.Magnitude > 1 then
+		dir = dir.Unit
+	end
+
+	local boosting = (keyDown(Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR2) or mobileBoost) and dir.Magnitude > 0.1
+	if boosting ~= lastBoostSent then
+		lastBoostSent = boosting
+		Net.SetBoost:FireServer(boosting)
+	end
+
+	local speed = char:GetAttribute("SwimSpeed") or Upgrades.Base.SwimSpeed
+	if boosting then
+		speed *= Upgrades.Base.BoostMult
+	end
+	speed *= char:GetAttribute("CarrySlow") or 1
+	speed *= char:GetAttribute("DockSlow") or 1
+	if (char:GetAttribute("JellySlowUntil") or 0) > os.clock() then
+		speed *= 0.5
+	end
+
+	local target = dir * speed
+	-- gentle sink when idle, stronger stop near the seabed
+	if dir.Magnitude < 0.05 then
+		target = Vector3.new(0, -1.5, 0)
+	end
+	velocity = velocity:Lerp(target, math.clamp(dt * 6, 0, 1)) + knock
+	knock = knock * math.clamp(1 - dt * 4, 0, 1)
+	if knock.Magnitude < 0.5 then
+		knock = Vector3.zero
+	end
+	linVel.VectorVelocity = velocity
+
+	-- Diving pose: face movement direction, pitched with vertical motion
+	local face = if velocity.Magnitude > 2 then velocity.Unit else flatLook
+	if math.abs(face.Y) > 0.98 then
+		face = (face + flatLook * 0.2).Unit
+	end
+	align.CFrame = CFrame.lookAt(Vector3.zero, face) * CFrame.Angles(math.rad(-70) * (velocity.Magnitude / math.max(speed, 1)), 0, 0)
+end
+
+function SwimController.Start()
+	player.CharacterAdded:Connect(setup)
+	if player.Character then
+		task.spawn(setup, player.Character)
+	end
+	RunService.RenderStepped:Connect(step)
+	Net.Knockback.OnClientEvent:Connect(function(impulse: Vector3)
+		if typeof(impulse) == "Vector3" then
+			knock += impulse
+		end
+	end)
+	UserInputService.InputBegan:Connect(function(input, processed)
+		if not processed and input.KeyCode == Enum.KeyCode.LeftShift then
+			boostHeld = true
+		end
+	end)
+	UserInputService.InputEnded:Connect(function(input)
+		if input.KeyCode == Enum.KeyCode.LeftShift then
+			boostHeld = false
+		end
+	end)
+end
+
+return SwimController
diff --git a/src/client/Controllers/TutorialController.luau b/src/client/Controllers/TutorialController.luau
new file mode 100644
index 0000000..9f35a25
--- /dev/null
+++ b/src/client/Controllers/TutorialController.luau
@@ -0,0 +1,154 @@
+-- TutorialController (Master Plan §17): FTUE hints driven by server flags and player state.
+-- Shows one objective at a time with a guiding beam toward the target.
+
+local Players = game:GetService("Players")
+local Workspace = game:GetService("Workspace")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Upgrades = require(Shared.Config.Upgrades)
+local NumberFormat = require(Shared.NumberFormat)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local T = Kit.Theme
+local player = Players.LocalPlayer
+local TutorialController = {}
+local controllers
+local label: TextLabel
+local beam: Beam?
+local targetAttachment: Attachment
+local targetPart: Part
+
+function TutorialController.Init(c)
+	controllers = c
+end
+
+local function myDock(): Model?
+	local root = Workspace:FindFirstChild("AbyssWorld")
+	local docks = root and root:FindFirstChild("Docks")
+	if not docks then
+		return nil
+	end
+	for _, d in docks:GetChildren() do
+		if d:GetAttribute("OwnerUserId") == player.UserId then
+			return d
+		end
+	end
+	return nil
+end
+
+local function nearestNode(pos: Vector3): BasePart?
+	local root = Workspace:FindFirstChild("AbyssWorld")
+	local nodes = root and root:FindFirstChild("Nodes")
+	if not nodes then
+		return nil
+	end
+	local best, bestDist = nil, math.huge
+	for _, n in nodes:GetChildren() do
+		if n:IsA("BasePart") then
+			local d = (n.Position - pos).Magnitude
+			if d < bestDist then
+				best, bestDist = n, d
+			end
+		end
+	end
+	return best
+end
+
+-- Returns objective text and optional world target
+local function objective(): (string?, Vector3?)
+	local S = controllers.State
+	local flags = S.Get("Flags") or {}
+	local stats = S.Get("Stats") or {}
+	local bag = S.Get("Bag") or {}
+	local storage = S.Get("Storage") or {}
+	local stands = S.Get("Stands") or {}
+	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+	if not hrp then
+		return nil
+	end
+	local dock = myDock()
+	if (stats.Dives or 0) == 0 and #bag == 0 and next(stands) == nil and #storage == 0 then
+		local ramp = dock and dock:FindFirstChild("DiveRamp")
+		return "Your dock. Your treasures. The deep awaits.\nJump off the dive ramp into the ocean!", ramp and ramp.Position
+	end
+	if (stats.Salvaged or 0) < 2 and controllers.SwimController.IsSwimming() then
+		local node = nearestNode(hrp.Position)
+		return "Swim to a glowing relic and HOLD [E] / tap to salvage it.", node and node.Position
+	end
+	if #bag > 0 then
+		local pad = dock and dock:FindFirstChild("Platform")
+		return "Swim back up to YOUR dock to secure your bag before your oxygen runs out!", pad and pad.Position
+	end
+	if #storage > 0 and next(stands) == nil then
+		local stand = dock and dock:FindFirstChild("Stand1")
+		return "Put a relic on a display stand — it earns Coins forever!", stand and stand.Position
+	end
+	if not flags.F_FirstUpgrade and next(stands) ~= nil then
+		local pad = dock and dock:FindFirstChild("CollectorPad")
+		return "Step on the green pad to collect Coins, then buy an upgrade (⬆️).", pad and pad.Position
+	end
+	if (S.Get("Suit") or 1) < 2 then
+		return `Next goal: buy the Neoprene suit ({NumberFormat.short(Upgrades.Suits[2].Cost)} Coins) to dive into the Kelp Twilight.`, nil
+	end
+	return nil
+end
+
+function TutorialController.Start()
+	label = Kit.Label({
+		Name = "Objective",
+		Text = "",
+		Visible = false,
+		Font = T.Bold,
+		TextSize = 17,
+		TextXAlignment = Enum.TextXAlignment.Center,
+		TextStrokeTransparency = 0.3,
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -200),
+		Size = UDim2.fromOffset(560, 50),
+		Parent = controllers.UIController.Root,
+	})
+	targetPart = Instance.new("Part")
+	targetPart.Name = "TutorialTarget"
+	targetPart.Anchored = true
+	targetPart.CanCollide = false
+	targetPart.CanQuery = false
+	targetPart.Transparency = 1
+	targetPart.Size = Vector3.one
+	targetPart.Parent = Workspace
+	targetAttachment = Instance.new("Attachment")
+	targetAttachment.Parent = targetPart
+
+	while true do
+		local text, target = objective()
+		label.Visible = text ~= nil
+		label.Text = text or ""
+		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
+		if target and hrp then
+			targetPart.Position = target
+			if not beam or not beam.Parent or beam.Attachment0 == nil or beam.Attachment0.Parent ~= hrp then
+				if beam then
+					beam:Destroy()
+				end
+				local a0 = hrp:FindFirstChild("TutorialAttachment") or Instance.new("Attachment")
+				a0.Name = "TutorialAttachment"
+				a0.Parent = hrp
+				beam = Instance.new("Beam")
+				beam.Attachment0 = a0 :: Attachment
+				beam.Attachment1 = targetAttachment
+				beam.Width0 = 0.6
+				beam.Width1 = 0.6
+				beam.FaceCamera = true
+				beam.Color = ColorSequence.new(Color3.fromRGB(80, 255, 200))
+				beam.Transparency = NumberSequence.new(0.3)
+				beam.Parent = targetPart
+			end
+			beam.Enabled = true
+		elseif beam then
+			beam.Enabled = false
+		end
+		task.wait(0.5)
+	end
+end
+
+return TutorialController
diff --git a/src/client/Controllers/UIController.luau b/src/client/Controllers/UIController.luau
new file mode 100644
index 0000000..5119a14
--- /dev/null
+++ b/src/client/Controllers/UIController.luau
@@ -0,0 +1,206 @@
+-- UIController: root ScreenGuis, window manager (one window at a time), toasts and banners.
+
+local Players = game:GetService("Players")
+local TweenService = game:GetService("TweenService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Shared = ReplicatedStorage:WaitForChild("Shared")
+local Net = require(Shared.Net)
+local Rarities = require(Shared.Config.Rarities)
+local Kit = require(script.Parent.Parent.UI.Kit)
+
+local New, T = Kit.New, Kit.Theme
+local player = Players.LocalPlayer
+
+local UIController = {}
+local windows = {}
+local openWindow: string? = nil
+local toastList: Frame
+local bannerFrame: Frame
+
+UIController.Root = nil :: ScreenGui?
+UIController.Overlay = nil :: ScreenGui?
+
+function UIController.Init()
+	local pg = player:WaitForChild("PlayerGui")
+	UIController.Root = New("ScreenGui", {
+		Name = "AbyssHUD",
+		ResetOnSpawn = false,
+		IgnoreGuiInset = false,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		Parent = pg,
+	})
+	UIController.Windows = New("ScreenGui", {
+		Name = "AbyssWindows",
+		ResetOnSpawn = false,
+		DisplayOrder = 5,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		Parent = pg,
+	})
+	UIController.Overlay = New("ScreenGui", {
+		Name = "AbyssOverlay",
+		ResetOnSpawn = false,
+		DisplayOrder = 10,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		Parent = pg,
+	})
+	toastList = New("Frame", {
+		Name = "Toasts",
+		BackgroundTransparency = 1,
+		AnchorPoint = Vector2.new(0.5, 0),
+		Position = UDim2.new(0.5, 0, 0, 96),
+		Size = UDim2.fromOffset(420, 300),
+		Parent = UIController.Overlay,
+	}, { Kit.List(6, false, Enum.HorizontalAlignment.Center) })
+	bannerFrame = New("Frame", {
+		Name = "Banner",
+		BackgroundTransparency = 1,
+		AnchorPoint = Vector2.new(0.5, 0),
+		Position = UDim2.new(0.5, 0, 0, 52),
+		Size = UDim2.fromOffset(640, 40),
+		Parent = UIController.Overlay,
+	})
+end
+
+-- Register a window: builder(frame) fills it, refresh() is called on open
+function UIController.RegisterWindow(name: string, title: string, build: (Frame) -> (), refresh: (() -> ())?)
+	local frame = Kit.Panel({
+		Name = name,
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.52),
+		Size = UDim2.new(0.92, 0, 0.78, 0),
+		Visible = false,
+		Parent = UIController.Windows,
+	})
+	New("UISizeConstraint", { MaxSize = Vector2.new(760, 560), Parent = frame })
+	Kit.Label({
+		Text = title,
+		Font = T.Bold,
+		TextSize = 22,
+		Position = UDim2.fromOffset(16, 10),
+		Size = UDim2.new(1, -80, 0, 30),
+		Parent = frame,
+	})
+	Kit.Button("✕", T.Bad, function()
+		UIController.Close()
+	end, { Size = UDim2.fromOffset(48, 40), Position = UDim2.new(1, -56, 0, 8), Parent = frame })
+	local body = New("Frame", {
+		Name = "Body",
+		BackgroundTransparency = 1,
+		Position = UDim2.fromOffset(12, 48),
+		Size = UDim2.new(1, -24, 1, -58),
+		Parent = frame,
+	})
+	build(body)
+	windows[name] = { frame = frame, refresh = refresh }
+end
+
+function UIController.Open(name: string)
+	if openWindow and windows[openWindow] then
+		windows[openWindow].frame.Visible = false
+	end
+	local w = windows[name]
+	if not w then
+		return
+	end
+	openWindow = name
+	if w.refresh then
+		w.refresh()
+	end
+	w.frame.Visible = true
+	Kit.Pop(w.frame)
+end
+
+function UIController.Toggle(name: string)
+	if openWindow == name then
+		UIController.Close()
+	else
+		UIController.Open(name)
+	end
+end
+
+function UIController.Close()
+	if openWindow and windows[openWindow] then
+		windows[openWindow].frame.Visible = false
+	end
+	openWindow = nil
+end
+
+function UIController.IsOpen(name: string): boolean
+	return openWindow == name
+end
+
+function UIController.Refresh(name: string)
+	if openWindow == name and windows[name].refresh then
+		windows[name].refresh()
+	end
+end
+
+local KIND_COLORS = {
+	error = T.Bad,
+	reward = T.Gold,
+	coins = T.Good,
+	upgrade = T.Accent,
+	info = T.PanelLight,
+}
+
+function UIController.Toast(text: string, kind: string?)
+	local color = KIND_COLORS[kind or "info"] or T.PanelLight
+	local toast = New("TextLabel", {
+		BackgroundColor3 = color,
+		BackgroundTransparency = 0.1,
+		Size = UDim2.fromOffset(400, 0),
+		AutomaticSize = Enum.AutomaticSize.Y,
+		Text = text,
+		TextWrapped = true,
+		TextColor3 = if kind == "reward" then Color3.fromRGB(30, 20, 0) else T.Text,
+		Font = T.Bold,
+		TextSize = 16,
+		Parent = toastList,
+	}, { Kit.Corner(10), Kit.Padding(8) })
+	Kit.Pop(toast)
+	task.delay(4, function()
+		TweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
+		task.wait(0.45)
+		toast:Destroy()
+	end)
+	local kids = toastList:GetChildren()
+	if #kids > 6 then
+		for _, k in kids do
+			if k:IsA("TextLabel") then
+				k:Destroy()
+				break
+			end
+		end
+	end
+end
+
+-- Big announcement banner (Mythic finds, events)
+function UIController.Banner(text: string, rarity: string?)
+	Kit.Clear(bannerFrame)
+	local r = Rarities[rarity or "Rare"]
+	local color = if type(r) == "table" and r.Color then r.Color else T.Accent
+	local label = New("TextLabel", {
+		BackgroundColor3 = Color3.fromRGB(10, 10, 20),
+		BackgroundTransparency = 0.2,
+		Size = UDim2.fromScale(1, 1),
+		Text = text,
+		TextScaled = true,
+		TextColor3 = if rarity == "Secret" then Color3.new(1, 1, 1) else color,
+		Font = T.Bold,
+		Parent = bannerFrame,
+	}, { Kit.Corner(10), Kit.Stroke(color, 2), New("UITextSizeConstraint", { MaxTextSize = 24 }) })
+	Kit.Pop(label)
+	task.delay(6, function()
+		if label.Parent then
+			label:Destroy()
+		end
+	end)
+end
+
+function UIController.Start()
+	Net.Notify.OnClientEvent:Connect(UIController.Toast)
+	Net.Announce.OnClientEvent:Connect(UIController.Banner)
+end
+
+return UIController
diff --git a/src/client/Main.client.lua b/src/client/Main.client.lua
deleted file mode 100644
index 28e0875..0000000
--- a/src/client/Main.client.lua
+++ /dev/null
@@ -1 +0,0 @@
--- Client entry point
diff --git a/src/client/UI/Kit.luau b/src/client/UI/Kit.luau
new file mode 100644
index 0000000..c7c7ece
--- /dev/null
+++ b/src/client/UI/Kit.luau
@@ -0,0 +1,184 @@
+-- Tiny declarative UI kit (no dependencies). Mobile-first sizes: buttons >= 48px (§18.1).
+
+local TweenService = game:GetService("TweenService")
+
+local Kit = {}
+
+Kit.Theme = {
+	Bg = Color3.fromRGB(12, 22, 38),
+	Panel = Color3.fromRGB(20, 34, 56),
+	PanelLight = Color3.fromRGB(32, 52, 82),
+	Accent = Color3.fromRGB(40, 200, 220),
+	Gold = Color3.fromRGB(255, 200, 60),
+	Good = Color3.fromRGB(70, 210, 110),
+	Bad = Color3.fromRGB(235, 70, 80),
+	Text = Color3.fromRGB(235, 245, 255),
+	Muted = Color3.fromRGB(150, 170, 195),
+	Font = Enum.Font.GothamMedium,
+	Bold = Enum.Font.GothamBold,
+}
+local T = Kit.Theme
+
+function Kit.New(className: string, props, children)
+	local inst = Instance.new(className)
+	if props then
+		for k, v in props do
+			if k ~= "Parent" then
+				(inst :: any)[k] = v
+			end
+		end
+	end
+	if children then
+		for _, c in children do
+			c.Parent = inst
+		end
+	end
+	if props and props.Parent then
+		inst.Parent = props.Parent
+	end
+	return inst
+end
+local New = Kit.New
+
+function Kit.Corner(r: number?)
+	return New("UICorner", { CornerRadius = UDim.new(0, r or 10) })
+end
+
+function Kit.Stroke(color: Color3?, thickness: number?)
+	return New("UIStroke", { Color = color or T.Accent, Thickness = thickness or 1.5, Transparency = 0.3 })
+end
+
+function Kit.Padding(px: number)
+	return New("UIPadding", {
+		PaddingTop = UDim.new(0, px),
+		PaddingBottom = UDim.new(0, px),
+		PaddingLeft = UDim.new(0, px),
+		PaddingRight = UDim.new(0, px),
+	})
+end
+
+function Kit.List(padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?)
+	return New("UIListLayout", {
+		Padding = UDim.new(0, padding or 6),
+		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
+		SortOrder = Enum.SortOrder.LayoutOrder,
+		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
+	})
+end
+
+function Kit.Label(props)
+	local p = {
+		BackgroundTransparency = 1,
+		TextColor3 = T.Text,
+		Font = T.Font,
+		TextSize = 16,
+		TextWrapped = true,
+		TextXAlignment = Enum.TextXAlignment.Left,
+		Size = UDim2.new(1, 0, 0, 22),
+	}
+	for k, v in props do
+		p[k] = v
+	end
+	return New("TextLabel", p)
+end
+
+function Kit.Button(text: string, color: Color3?, onClick: (() -> ())?, props)
+	local p = {
+		Text = text,
+		BackgroundColor3 = color or T.Accent,
+		TextColor3 = Color3.new(1, 1, 1),
+		Font = T.Bold,
+		TextSize = 16,
+		Size = UDim2.fromOffset(120, 48),
+		AutoButtonColor = true,
+	}
+	for k, v in props or {} do
+		p[k] = v
+	end
+	local b = New("TextButton", p, { Kit.Corner(10) })
+	if onClick then
+		b.Activated:Connect(onClick)
+	end
+	return b
+end
+
+function Kit.Panel(props, children)
+	local p = {
+		BackgroundColor3 = T.Panel,
+		BackgroundTransparency = 0.05,
+		BorderSizePixel = 0,
+	}
+	for k, v in props do
+		p[k] = v
+	end
+	local f = New("Frame", p, children)
+	Kit.Corner(14).Parent = f
+	Kit.Stroke(T.Accent, 1.5).Parent = f
+	return f
+end
+
+function Kit.Scroll(props)
+	local p = {
+		BackgroundTransparency = 1,
+		BorderSizePixel = 0,
+		ScrollBarThickness = 6,
+		AutomaticCanvasSize = Enum.AutomaticSize.Y,
+		CanvasSize = UDim2.new(),
+		Size = UDim2.fromScale(1, 1),
+	}
+	for k, v in props do
+		p[k] = v
+	end
+	return New("ScrollingFrame", p)
+end
+
+function Kit.Clear(container: Instance)
+	for _, c in container:GetChildren() do
+		if not c:IsA("UIListLayout") and not c:IsA("UIGridLayout") and not c:IsA("UIPadding") then
+			c:Destroy()
+		end
+	end
+end
+
+function Kit.Pop(gui: GuiObject)
+	local scale = gui:FindFirstChildOfClass("UIScale") or New("UIScale", { Parent = gui })
+	scale.Scale = 0.85
+	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
+end
+
+-- Bar with fill; returns frame and a setter(fraction, color?)
+function Kit.Bar(props)
+	local frame = New("Frame", {
+		BackgroundColor3 = Color3.fromRGB(10, 15, 25),
+		Size = props.Size or UDim2.fromOffset(240, 22),
+		Position = props.Position,
+		AnchorPoint = props.AnchorPoint,
+		Parent = props.Parent,
+	}, { Kit.Corner(8), Kit.Stroke(Color3.new(1, 1, 1), 1) })
+	local fill = New("Frame", {
+		Name = "Fill",
+		BackgroundColor3 = props.Color or T.Accent,
+		Size = UDim2.fromScale(1, 1),
+		Parent = frame,
+	}, { Kit.Corner(8) })
+	local label = Kit.Label({
+		Text = props.Text or "",
+		TextXAlignment = Enum.TextXAlignment.Center,
+		Size = UDim2.fromScale(1, 1),
+		TextSize = 14,
+		Font = T.Bold,
+		ZIndex = 3,
+		Parent = frame,
+	})
+	return frame, function(fraction: number, color: Color3?, text: string?)
+		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
+		if color then
+			fill.BackgroundColor3 = color
+		end
+		if text then
+			label.Text = text
+		end
+	end
+end
+
+return Kit
diff --git a/src/client/init.client.luau b/src/client/init.client.luau
index 5b0486b..f9619b9 100644
--- a/src/client/init.client.luau
+++ b/src/client/init.client.luau
@@ -1 +1,54 @@
-print("Hello world, from client!")
+-- Client boot (Master Plan §20.2): loads controllers, then tells the server the UI is ready.
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterGui = game:GetService("StarterGui")
+
+ReplicatedStorage:WaitForChild("Remotes") -- server creates every remote before parenting this
+local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
+
+local ORDER = {
+	"State",
+	"UIController",
+	"SwimController",
+	"LightingController",
+	"AudioController",
+	"PromptController",
+	"HUDController",
+	"SonarController",
+	"RevealController",
+	"ShopController",
+	"MenuController",
+	"OfferController",
+	"TutorialController",
+}
+
+pcall(function()
+	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
+end)
+
+local controllers = {}
+for _, name in ORDER do
+	controllers[name] = require(script.Controllers:WaitForChild(name))
+end
+for _, name in ORDER do
+	local c = controllers[name]
+	if c.Init then
+		local ok, err = pcall(c.Init, controllers)
+		if not ok then
+			warn(`[Client] {name}.Init failed: {err}`)
+		end
+	end
+end
+for _, name in ORDER do
+	local c = controllers[name]
+	if c.Start then
+		task.spawn(function()
+			local ok, err = pcall(c.Start)
+			if not ok then
+				warn(`[Client] {name}.Start failed: {err}`)
+			end
+		end)
+	end
+end
+
+Net.ClientReady:FireServer()
diff --git a/src/server/Main.server.lua b/src/server/Main.server.lua
