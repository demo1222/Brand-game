local function rarityColor(name: string): Color3
	return Kit.RarityColor(name, Rarities)
end

local function tierOf(name: string): number
	return Rarities[name] and Rarities[name].Tier or 1
end

local function newPart(folder: Instance, props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.LightInfluence = 0
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

local function ns(...): NumberSequence
	local pts = { ... }
	local kps = {}
	for i = 1, #pts, 2 do
		table.insert(kps, NumberSequenceKeypoint.new(pts[i], pts[i + 1]))
	end
	return NumberSequence.new(kps)
end

local function cs(c: Color3): ColorSequence
	return ColorSequence.new(c)
end

------------------------------------------------------------------------------------------
-- The chest: a rig of parts with offsets from the chest origin (centre of the base's bottom
-- face; local -Z faces the camera). Lid parts hang off a hinge at the back edge.
------------------------------------------------------------------------------------------
local function buildChest(folder: Folder, S: number)
	local rig = { base = {}, lid = {} }
	local baseH, depth = 0.55 * S, 0.62 * S
	local function add(group, name, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, extra)
		local props = { Name = name, Size = size, Color = color, Material = material or Enum.Material.SmoothPlastic }
		for k, v in extra or {} do
			props[k] = v
		end
		local p = newPart(folder, props)
		table.insert(group, { part = p, offset = offset, size = size })
		return p
	end
	add(rig.base, "Base", Vector3.new(S, baseH, depth), CFrame.new(0, baseH / 2, 0), WOOD, Enum.Material.WoodPlanks)
	add(rig.base, "Plinth", Vector3.new(S * 1.04, 0.08 * S, depth * 1.04), CFrame.new(0, 0.04 * S, 0), WOOD_DARK, Enum.Material.Wood)
	for _, x in { -0.3, 0.3 } do
		add(rig.base, "Band", Vector3.new(0.08 * S, baseH * 1.01, depth * 1.03), CFrame.new(x * S, baseH / 2, 0), BRASS, Enum.Material.Metal)
	end
	for _, x in { -0.5, 0.5 } do
		for _, z in { -0.5, 0.5 } do
			add(rig.base, "Corner", Vector3.new(0.12 * S, baseH * 1.02, 0.12 * S), CFrame.new(x * S, baseH / 2, z * depth), BRASS, Enum.Material.Metal)
		end
	end
	add(rig.base, "Lock", Vector3.new(0.18 * S, 0.2 * S, 0.06 * S), CFrame.new(0, baseH - 0.1 * S, -depth / 2 - 0.02 * S), BRASS, Enum.Material.Metal)
	add(rig.base, "Keyhole", Vector3.new(0.05 * S, 0.08 * S, 0.02 * S), CFrame.new(0, baseH - 0.11 * S, -depth / 2 - 0.055 * S), Color3.fromRGB(30, 20, 10))
	local seam = add(rig.base, "Seam", Vector3.new(S * 0.97, 0.05 * S, depth * 0.95), CFrame.new(0, baseH + 0.01 * S, 0), WHITE, Enum.Material.Neon, { Transparency = 0.7 })
	-- lid: a slab plus a half-sunk cylinder (a domed top), with bands; offsets from the hinge
	local hinge = CFrame.new(0, baseH + 0.03 * S, depth / 2)
	local lidH = 0.16 * S
	local function lidAdd(name, size, local_, color, material)
		return add(rig.lid, name, size, hinge:Inverse() * local_, color, material)
	end
	lidAdd("LidBox", Vector3.new(S * 1.02, lidH, depth * 1.02), CFrame.new(0, baseH + lidH / 2 + 0.03 * S, 0), WOOD, Enum.Material.WoodPlanks)
	lidAdd("LidDome", Vector3.new(S * 1.0, depth * 0.98, depth * 0.98), CFrame.new(0, baseH + lidH + 0.03 * S - depth * 0.2, 0), WOOD, Enum.Material.WoodPlanks).Shape =
		Enum.PartType.Cylinder
	for _, x in { -0.3, 0.3 } do
		lidAdd("LidBand", Vector3.new(0.08 * S, depth * 1.0, depth * 1.0), CFrame.new(x * S, baseH + lidH + 0.03 * S - depth * 0.2, 0), BRASS, Enum.Material.Metal).Shape =
			Enum.PartType.Cylinder
	end
	rig.hinge = hinge
	rig.seam = seam
	rig.baseH = baseH
	return rig
end

-- place the chest: origin CFrame, a squash scale (x/z share sx), lid angle or a free lid CFrame
local function placeChest(rig, origin: CFrame, sx: number, sy: number, lidAngle: number, lidFree: CFrame?)
	local function scaled(off: CFrame): CFrame
		local p = off.Position
		return CFrame.new(p.X * sx, p.Y * sy, p.Z * sx) * off.Rotation
	end
	for _, e in rig.base do
		e.part.CFrame = origin * scaled(e.offset)
		e.part.Size = Vector3.new(e.size.X * sx, e.size.Y * sy, e.size.Z * sx)
	end
	local hingeWorld = lidFree or (origin * scaled(rig.hinge) * CFrame.Angles(-lidAngle, 0, 0))
	for _, e in rig.lid do
		e.part.CFrame = hingeWorld * scaled(e.offset)
		e.part.Size = Vector3.new(e.size.X * sx, e.size.Y * sy, e.size.Z * sx)
	end
end

