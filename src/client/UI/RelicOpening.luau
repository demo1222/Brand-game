-- Screen layer: flash, letterbox, focus lines, rarity words
------------------------------------------------------------------------------------------
local function screenLayer()
	local gui = Instance.new("ScreenGui")
	gui.Name = "RelicOpening"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 40
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local flash = Instance.new("Frame")
	flash.BackgroundColor3 = WHITE
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 10
	flash.Parent = gui
	local bars = {}
	for _, top in { true, false } do
		local b = Instance.new("Frame")
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.AnchorPoint = Vector2.new(0, if top then 1 else 0)
		b.Position = UDim2.fromScale(0, if top then 0 else 1)
		b.Size = UDim2.fromScale(1, 0)
		b.ZIndex = 5
		b.Parent = gui
		table.insert(bars, b)
	end
	-- anime focus lines (version B), centred on the chest at the release
	local lines = Instance.new("ImageLabel")
	lines.Name = "FocusLines"
	lines.BackgroundTransparency = 1
	lines.Image = TEX.focusLines
	lines.ImageTransparency = 1
	lines.AnchorPoint = Vector2.new(0.5, 0.5)
	lines.SizeConstraint = Enum.SizeConstraint.RelativeXX
	lines.Size = UDim2.fromScale(1.5, 1.5)
	lines.ZIndex = 3
	lines.Parent = gui
	return gui, flash, bars, lines
end

local function popWord(gui: ScreenGui, text: string, color: Color3, big: boolean, comic: boolean)
	for _, n in { "Word", "WordBurst" } do
		local old = gui:FindFirstChild(n)
		if old then
			old:Destroy()
		end
	end
	if comic then
		-- our comic-burst texture behind the word: pops, turns a little, tinted to the rarity
		local burst = Instance.new("ImageLabel")
		burst.Name = "WordBurst"
		burst.BackgroundTransparency = 1
		burst.Image = TEX.comic
		burst.ImageColor3 = color
		burst.ImageTransparency = 0.15
		burst.AnchorPoint = Vector2.new(0.5, 0.5)
		burst.Position = UDim2.fromScale(0.5, 0.2)
		burst.Size = UDim2.fromOffset(if big then 400 else 310, if big then 300 else 230)
		burst.ZIndex = 7
		burst.Rotation = math.random(-20, 20)
		burst.Parent = gui
		local bs = Instance.new("UIScale")
		bs.Scale = 0.3
		bs.Parent = burst
		TweenService:Create(bs, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		TweenService:Create(burst, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Rotation = burst.Rotation + 25 }):Play()
	end
	local label = Kit.Title({
		Name = "Word",
		Text = text,
		TextSize = if big then 72 else 54,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromOffset(800, 90),
		TextWrapped = false,
		ZIndex = 8,
		Parent = gui,
	})
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(WHITE, color)
	grad.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 1.6
	scale.Parent = label
	label.Rotation = math.random(-6, 6)
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(label, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
end

-- the tease word fades away when the hold text takes over
local function clearWord(gui: ScreenGui)
	for _, n in { "Word", "WordBurst" } do
		local old = gui:FindFirstChild(n)
		if old and old:IsA("GuiObject") then
			old.Name = "OldWord"
			local s = old:FindFirstChildOfClass("UIScale")
			if s then
				TweenService:Create(s, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 }):Play()
			end
			task.delay(0.16, function()
				old:Destroy()
			end)
		end
	end
end

-- a small diamond (a turned square with an outline), for the ends of the name line
local function diamond(parent: Instance, color: Color3, x: number)
	local d = Instance.new("Frame")
	d.BackgroundColor3 = color
	d.BorderSizePixel = 0
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Position = UDim2.fromScale(x, 0.5)
	d.Size = UDim2.fromOffset(12, 12)
	d.Rotation = 45
	d.ZIndex = 9
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(20, 16, 30)
	st.Thickness = 2
	st.Parent = d
	d.Parent = parent
end

-- the hold text: the name on top, a thin line with diamond ends, the rarity word in its colour,
-- the material / mutation / income chips, and "(Click anywhere to continue)" at the bottom
local function holdCard(gui: ScreenGui, relic, def, color: Color3, tier: number)
	local card = Instance.new("Frame")
	card.Name = "Hold"
	card.BackgroundTransparency = 1
	card.AnchorPoint = Vector2.new(0.5, 0)
	card.Position = UDim2.fromScale(0.5, 0.06)
	card.Size = UDim2.new(0.92, 0, 0, 200)
	card.ZIndex = 8
	card.Parent = gui
	local max = Instance.new("UISizeConstraint")
	max.MaxSize = Vector2.new(760, 220)
	max.Parent = card
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Padding = UDim.new(0, 2)
	list.Parent = card

	local name = Kit.Title({
		Name = "RelicName",
		Text = Materials.Prefix(relic) .. (def and def.Name or relic.id),
		TextSize = 58,
		TextScaled = true,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 64),
		TextWrapped = false,
		LayoutOrder = 1,
		ZIndex = 9,
		Parent = card,
	})
	local nameMax = Instance.new("UITextSizeConstraint")
	nameMax.MaxTextSize = if tier >= 6 then 62 else 56
	nameMax.Parent = name

	-- the thin decorative line: white, fading out at both ends, rarity diamonds at the tips
	local lineHolder = Instance.new("Frame")
	lineHolder.Name = "Line"
	lineHolder.BackgroundTransparency = 1
	lineHolder.Size = UDim2.new(0.62, 0, 0, 14)
	lineHolder.LayoutOrder = 2
	lineHolder.ZIndex = 9
	lineHolder.Parent = card
	local line = Instance.new("Frame")
	line.BackgroundColor3 = WHITE
	line.BorderSizePixel = 0
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Position = UDim2.fromScale(0.5, 0.5)
	line.Size = UDim2.new(0.96, 0, 0, 3)
	line.ZIndex = 9
	line.Parent = lineHolder
	local lg = Instance.new("UIGradient")
	lg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color),
		ColorSequenceKeypoint.new(0.5, WHITE),
		ColorSequenceKeypoint.new(1, color),
	})
	lg.Transparency = ns(0, 0.6, 0.5, 0, 1, 0.6)
	lg.Parent = line
	diamond(lineHolder, color, 0.02)
	diamond(lineHolder, color, 0.98)

	local rarity = Kit.Title({
		Name = "Rarity",
		Text = string.upper(relic.rarity),
		TextSize = if tier >= 5 then 46 else 40,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 48),
		TextWrapped = false,
		LayoutOrder = 3,
		ZIndex = 9,
		Parent = card,
	})
	local rg = Instance.new("UIGradient")
	rg.Rotation = 90
	rg.Color = ColorSequence.new(color:Lerp(WHITE, 0.45), color)
	rg.Parent = rarity

	-- chips: material, mutations, income on display
	local chips = Instance.new("Frame")
	chips.Name = "Chips"
	chips.BackgroundTransparency = 1
	chips.Size = UDim2.new(1, 0, 0, 30)
	chips.LayoutOrder = 4
	chips.ZIndex = 9
	chips.Parent = card
	local cl = Instance.new("UIListLayout")
	cl.FillDirection = Enum.FillDirection.Horizontal
	cl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	cl.VerticalAlignment = Enum.VerticalAlignment.Center
	cl.SortOrder = Enum.SortOrder.LayoutOrder
	cl.Padding = UDim.new(0, 6)
	cl.Parent = chips
	local matDef = relic.material and Materials.ById[relic.material]
	if matDef then
		local chip = Kit.Pill(`{matDef.Name} x{matDef.Mult}`, matDef.Color, { TextSize = 16, Size = UDim2.fromOffset(0, 28), LayoutOrder = 0, ZIndex = 9, Parent = chips })
		Kit.Shine(chip, 2)
	end
	for i, m in relic.mutations or {} do
		local md = Mutations.ById[m]
		Kit.Pill(`{m} x{md and md.Mult or 1}`, md and md.Color or color, { TextSize = 15, Size = UDim2.fromOffset(0, 26), LayoutOrder = i, ZIndex = 9, Parent = chips })
	end
	local okCps, cps = pcall(Formulas.RelicCPS, relic)
	if okCps and cps then
		Kit.Pill(`+{NumberFormat.short(cps)} Coins/s on display`, Color3.fromRGB(40, 150, 80), {
			TextSize = 15,
			Size = UDim2.fromOffset(0, 26),
			LayoutOrder = 99,
			ZIndex = 9,
			Parent = chips,
		})
	end

	-- the pop-in: name first, then the line, the rarity and the chips
	for i, g in { name, lineHolder, rarity, chips } do
		local s = Instance.new("UIScale")
		s.Scale = 0
		s.Parent = g
		task.delay(0.07 * (i - 1), function()
			TweenService:Create(s, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end)
	end

	local hint = Kit.Label({
		Name = "Continue",
		Text = "(Click anywhere to continue)",
		Font = Enum.Font.FredokaOne,
		TextSize = 18,
		TextColor3 = WHITE,
		TextStrokeTransparency = 0.3,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -26),
		Size = UDim2.fromOffset(360, 24),
		TextWrapped = false,
		ZIndex = 9,
		Parent = gui,
	})
	task.delay(0.45, function()
		if hint.Parent then
			TweenService:Create(hint, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { TextTransparency = 0.45 }):Play()
			hint.TextTransparency = 0
		end
	end)
	return card
end

-- big four-point sparkle stars that pop at the screen edges with the bubble flash
local function edgeStars(gui: ScreenGui, color: Color3, count: number)
	local spots = {
		Vector2.new(0.06, 0.18),
		Vector2.new(0.94, 0.22),
		Vector2.new(0.1, 0.8),
		Vector2.new(0.9, 0.78),
		Vector2.new(0.2, 0.5),
		Vector2.new(0.8, 0.5),
		Vector2.new(0.03, 0.55),
		Vector2.new(0.97, 0.45),
	}
	for i = 1, math.min(count, #spots) do
		local p = spots[i]
		local star = Instance.new("ImageLabel")
		star.Name = "EdgeStar"
		star.BackgroundTransparency = 1
		star.Image = TEX.star
		star.ImageColor3 = if i % 2 == 0 then WHITE else color:Lerp(WHITE, 0.35)
		star.AnchorPoint = Vector2.new(0.5, 0.5)
		star.Position = UDim2.fromScale(p.X + (math.random() - 0.5) * 0.04, p.Y + (math.random() - 0.5) * 0.06)
		star.SizeConstraint = Enum.SizeConstraint.RelativeYY
		local sz = 0.16 + math.random() * 0.12
		star.Size = UDim2.fromScale(sz, sz)
		star.Rotation = math.random(-25, 25)
		star.ZIndex = 6
		star.Parent = gui
		local s = Instance.new("UIScale")
		s.Scale = 0
		s.Parent = star
		task.delay((i - 1) * 0.04, function()
			TweenService:Create(s, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			TweenService:Create(star, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				ImageTransparency = 1,
				Rotation = star.Rotation + 40,
			}):Play()
			task.delay(0.95, function()
				star:Destroy()
			end)
		end)
	end
end

------------------------------------------------------------------------------------------
-- Play
------------------------------------------------------------------------------------------
local SHAKE_BIND = "RelicOpeningShake"
local MAIN_BIND = "RelicOpeningMain"

function RelicOpening.Play(relic, opts)
	opts = opts or {}
	local play = opts.play or function() end
	local def = Relics.ById[relic.id]
	local tier = tierOf(relic.rarity)
	local finalColor = rarityColor(relic.rarity)
	local player = Players.LocalPlayer
	local cam = Workspace.CurrentCamera
	local camFov = cam.FieldOfView
	local folder = Instance.new("Folder")
	folder.Name = "RelicOpening"
	folder.Parent = Workspace

	-- where the chest stands: on the camera, every frame (the camera stays the player's own). The
	-- chest origin is the bottom of its base, so it sits a little below the view centre and the
	-- chest's middle lands at eye level. Local -Z faces the camera; the top tilts towards it so
	-- you look down into it a little, like a summon on its pad.
	local S = 3
	local DIST = 7.5
	local DROP_Y = -1.25
	local TILT = math.rad(-16)
	local MID = 1.25 -- the chest's middle, above its origin
	local function stageTarget(): CFrame
		local c = cam.CFrame
		return c * CFrame.new(0, DROP_Y, -DIST) * CFrame.Angles(0, math.pi, 0) * CFrame.Angles(TILT, 0, 0)
	end
	local stage = stageTarget()

	-- the diver is hidden while they would stand between the camera and the chest
	-- (set every frame after the camera scripts, which manage LocalTransparencyModifier too). Name
	-- tags and other billboards on the diver are switched off and put back as they were.
	local billboards: { [BillboardGui]: boolean } = {}
	local function hideDiver(on: boolean)
		local char = player.Character
		if not char then
			return
		end
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") or d:IsA("Decal") then
				(d :: any).LocalTransparencyModifier = if on then 1 else 0
			elseif d:IsA("BillboardGui") and on and billboards[d] == nil then
				billboards[d] = d.Enabled
				d.Enabled = false
			end
		end
		if not on then
			for b, was in billboards do
				b.Enabled = was
			end
			table.clear(billboards)
		end
	end
	local function diverInTheWay(): boolean
		local char = player.Character
		local head = char and char:FindFirstChild("Head") :: BasePart?
		if not head then
			return false
		end
		local rel = cam.CFrame:PointToObjectSpace(head.Position)
		return -rel.Z < DIST + 6 -- also when they stand just behind it (their legs show below)
	end

	local rig = buildChest(folder, S)
	local core = newPart(folder, { Name = "Core", Size = Vector3.one * 0.2, Transparency = 1 })
	local relicAnchor = newPart(folder, { Name = "RelicGlow", Size = Vector3.one * 0.2, Transparency = 1 })
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 0
	light.Shadows = false
	light.Parent = core

	-- the magic circle under the chest (version B, Rare+): a glowing SurfaceGui on a flat part
	local sigil = newPart(folder, { Name = "Sigil", Size = Vector3.new(S * 2.6, 0.05, S * 2.6), Transparency = 1 })
	local sigilGui = Instance.new("SurfaceGui")
	sigilGui.Face = Enum.NormalId.Top
	sigilGui.LightInfluence = 0
	sigilGui.Brightness = 2.2
	sigilGui.CanvasSize = Vector2.new(512, 512)
	sigilGui.Parent = sigil
	local sigilImage = Instance.new("ImageLabel")
	sigilImage.BackgroundTransparency = 1
	sigilImage.Size = UDim2.fromScale(1, 1)
	sigilImage.Image = TEX.sigil
	sigilImage.ImageTransparency = 1
	sigilImage.Parent = sigilGui
	local useSigil = tier >= 3

	-- emitters (Size is half the drawn width in Roblox)
	local leak = emitter(core, {
		Texture = TEX.sparkle,
		LightEmission = 0.6,
		Size = ns(0, 0.18, 0.5, 0.28, 1, 0),
		Transparency = ns(0, 0.2, 1, 1),
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(60, 15),
		Acceleration = Vector3.new(0, 3, 0),
		Drag = 2,
		EmissionDirection = Enum.NormalId.Top,
	})
	local dust = emitter(core, {
			Texture = TEX.dust,
			FlipbookLayout = GRID4,
			FlipbookMode = ONESHOT,
			Color = cs(Color3.fromRGB(225, 232, 238)),
			Size = ns(0, 1.2, 1, 2.2),
			Transparency = ns(0, 0.15, 1, 0.4),
			Lifetime = NumberRange.new(0.6, 0.75),
			Speed = NumberRange.new(4, 7),
			SpreadAngle = Vector2.new(180, 6),
			Drag = 4,
			Rotation = NumberRange.new(-15, 15),
	})
	local sparks = emitter(core, {
		Texture = TEX.streak,
		LightEmission = 0.6,
		Rotation = NumberRange.new(0, 360),
		Size = ns(0, 0.7, 0.6, 0.45, 1, 0),
		Transparency = ns(0, 0, 0.7, 0.2, 1, 1),
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(16, 30),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		Acceleration = Vector3.new(0, -6, 0),
	})
	local stars = emitter(core, {
		Texture = TEX.star,
		LightEmission = 0.5,
		Size = ns(0, 0.9, 1, 0),
		Transparency = ns(0, 0, 1, 0.6),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(10, 20),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-200, 200),
		Drag = 3,
	})
	local puff = emitter(core, {
		Texture = TEX.explosion,
		FlipbookLayout = GRID4,
		FlipbookMode = ONESHOT,
		LightEmission = 0.45,
		Size = ns(0, 2.6, 1, 4.6),
		Transparency = ns(0, 0, 0.8, 0.1, 1, 1),
		Lifetime = NumberRange.new(0.55, 0.6),
		Speed = NumberRange.new(0, 1),
		Rotation = NumberRange.new(0, 360),
	})
	local flareE = emitter(core, {
		Texture = TEX.flare,
		LightEmission = 0.7,
		Size = ns(0, 1.2, 1, 0),
		Transparency = ns(0, 0, 1, 0.4),
		Lifetime = NumberRange.new(0.22, 0.28),
		Speed = NumberRange.new(0, 0),
		Rotation = NumberRange.new(-20, 20),
		ZOffset = 1,
	})
	local lensE = emitter(core, {
		Texture = TEX.lensStreak,
		LightEmission = 0.8,
		Size = ns(0, S * 3.2, 1, S * 2.2),
		Transparency = ns(0, 0, 0.5, 0.3, 1, 1),
		Lifetime = NumberRange.new(0.4, 0.4),
		Speed = NumberRange.new(0, 0),
		ZOffset = 2,
	})
	local shockE = emitter(core, {
		Texture = TEX.shockwave,
		FlipbookLayout = GRID4,
		FlipbookMode = ONESHOT,
		LightEmission = 0.5,
		Size = NumberSequence.new(S * 2.4),
		Lifetime = NumberRange.new(0.5, 0.5),
		Speed = NumberRange.new(0, 0),
	})
	local chargeE = emitter(core, {
		Texture = TEX.chargeIn,
		FlipbookLayout = GRID4,
		FlipbookMode = ONESHOT,
		LightEmission = 0.55,
		Size = NumberSequence.new(S * 1.5),
		Lifetime = NumberRange.new(0.32, 0.32),
		Speed = NumberRange.new(0, 0),
	})
	local ringE = emitter(core, {
		Texture = TEX.ring,
		LightEmission = 0.5,
		Size = ns(0, S * 0.35, 1, S * 1.5),
		Transparency = ns(0, 0.05, 0.6, 0.35, 1, 1),
		Lifetime = NumberRange.new(0.4, 0.4),
		Speed = NumberRange.new(0, 0),
		Rotation = NumberRange.new(0, 360),
	})
	local embers = emitter(core, {
		Texture = TEX.embers,
		FlipbookLayout = GRID8,
		FlipbookMode = ONESHOT,
		LightEmission = 0.6,
		Size = ns(0, 0.7, 1, 0.5),
		Transparency = ns(0, 0.1, 0.8, 0.3, 1, 1),
		Lifetime = NumberRange.new(1, 1.4),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(50, 50),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 3, 0),
		Drag = 1,
	})
	local twinkle = emitter(relicAnchor, {
		Texture = TEX.twinkle,
		FlipbookLayout = GRID8,
		FlipbookMode = LOOP,
		LightEmission = 0.7,
		Size = ns(0, 0.35, 0.5, 0.55, 1, 0),
		Transparency = ns(0, 0, 1, 0.3),
		Lifetime = NumberRange.new(0.6, 0.9),
		Speed = NumberRange.new(1, 2.5),
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
	})

	-- light leaks through the seam (short rays) and the release rays (long, behind the chest)
	local leaks = {}
	for i = 1, 5 do
		leaks[i] = newPart(folder, { Name = "Leak", Size = Vector3.new(0.12, 1, 0.12), Material = Enum.Material.Neon, Transparency = 1 })
	end
	local rays = {}
	for i = 1, 8 + tier * 2 do
		rays[i] = newPart(folder, { Name = "Ray", Size = Vector3.new(0.5, 0.1, 0.05), Material = Enum.Material.Neon, Transparency = 1, Color = finalColor })
	end

	-- the reveal: a rarity bubble flash round the relic (a ForceField shell and a soft Neon core)
	-- and the god-ray backdrop's glow (a camera-facing card with our flare texture)
	local bubble = newPart(folder, { Name = "Bubble", Shape = Enum.PartType.Ball, Size = Vector3.one, Material = Enum.Material.ForceField, Color = finalColor, Transparency = 1 })
	local bubbleCore = newPart(folder, { Name = "BubbleCore", Shape = Enum.PartType.Ball, Size = Vector3.one, Material = Enum.Material.Neon, Color = finalColor:Lerp(WHITE, 0.5), Transparency = 1 })
	local backdrop = newPart(folder, { Name = "Backdrop", Size = Vector3.new(S * 4, S * 4, 0.05), Transparency = 1 })
	local backGui = Instance.new("SurfaceGui")
	backGui.Face = Enum.NormalId.Front
	backGui.LightInfluence = 0
	backGui.Brightness = 1
	backGui.CanvasSize = Vector2.new(512, 512)
	backGui.Parent = backdrop
	local backImage = Instance.new("ImageLabel")
	backImage.BackgroundTransparency = 1
	backImage.Size = UDim2.fromScale(1, 1)
	backImage.Image = TEX.flare
	backImage.ImageColor3 = finalColor:Lerp(WHITE, 0.15)
	backImage.ImageTransparency = 1
	backImage.Parent = backGui

	-- grade, blur (depth of field on the chest) and hidden HUD for the show
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "OpeningGrade"
	grade.Parent = Lighting
	TweenService:Create(grade, TweenInfo.new(0.35), { Brightness = -0.1, Saturation = -0.35, Contrast = 0.1 }):Play()
	local dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "OpeningBlur"
	dof.FarIntensity = 0
	dof.NearIntensity = 0
	dof.InFocusRadius = 6
	dof.FocusDistance = (cam.CFrame.Position - stage.Position).Magnitude
	dof.Parent = Lighting
	TweenService:Create(dof, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { FarIntensity = 0.85 }):Play()
	local playerGui = player:WaitForChild("PlayerGui")
	local hud = playerGui:FindFirstChild("AbyssHUD")
	local hudWas = hud and hud:IsA("ScreenGui") and hud.Enabled
	if hud and hud:IsA("ScreenGui") then
		hud.Enabled = false
	end

	local gui, flash, bars, lines = screenLayer()
	if tier >= 5 then
		for _, b in bars do
			TweenService:Create(b, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(1, 0.1) }):Play()
		end
	end

	-- camera shake on top of the player's own camera
	local trauma = 0
	-- (after MAIN_BIND, which places the chest from the unshaken camera, so the shake shows)
	RunService:BindToRenderStep(SHAKE_BIND, Enum.RenderPriority.Camera.Value + 2, function()
		if trauma > 0.001 then
			local k = trauma * trauma * 0.035
			local t = os.clock()
			cam.CFrame = cam.CFrame * CFrame.Angles(math.noise(t * 30, 7) * k, math.noise(t * 30, 8) * k, math.noise(t * 30, 9) * k * 0.5)
		end
	end)

	-- schedule
	local T_DROP = 0.32
	local steps = {}
	local t = T_DROP + 0.12
	for k = 1, tier do
		table.insert(steps, { t = t, rarity = Rarities.Order[k], done = false })
		t += math.max(0.2, 0.44 - 0.045 * (k - 1))
	end
	local T_SUCK = t + 0.25
	local T_BURST = T_SUCK + 0.12
	local T_HOLD = T_BURST + 0.45 -- the text pops in; from here a click ends the show

	local start = os.clock()
	local skipOffset = 0
	local seamColor = WHITE
	local lastHop = -10
	local burstDone, landed, charged = false, false, false
	local lidFree: CFrame? = nil
	local lidVel, lidSpin = Vector3.zero, Vector3.zero
	local relicModel: Model? = nil
	local finished = false
	local sigilSpin = 0
	local holding = false
	local holdFov = camFov
	local diverHidden = false
	local inputConn

	local function cleanup()
		if inputConn then
			inputConn:Disconnect()
		end
		RunService:UnbindFromRenderStep(MAIN_BIND)
		RunService:UnbindFromRenderStep(SHAKE_BIND)
		if diverHidden then
			hideDiver(false)
		end
		TweenService:Create(cam, TweenInfo.new(0.3), { FieldOfView = camFov }):Play()
		TweenService:Create(grade, TweenInfo.new(0.3), { Brightness = 0, Saturation = 0, Contrast = 0, TintColor = WHITE }):Play()
		TweenService:Create(dof, TweenInfo.new(0.3), { FarIntensity = 0 }):Play()
		task.delay(0.35, function()
			grade:Destroy()
			dof:Destroy()
		end)
		if hud and hud:IsA("ScreenGui") then
			hud.Enabled = hudWas ~= false
		end
		gui:Destroy()
		for _, e in rig.base do
			e.part.Transparency = 1
		end
		for _, e in rig.lid do
			e.part.Transparency = 1
		end
		sigilImage.ImageTransparency = 1
		backImage.ImageTransparency = 1
		bubble.Transparency = 1
		bubbleCore.Transparency = 1
		for _, p in rays do
			p.Transparency = 1
		end
		for _, p in leaks do
			p.Transparency = 1
		end
		embers.Rate = 0
		twinkle.Rate = 0
		if relicModel then
			relicModel:Destroy()
		end
		-- let the sparks, embers and confetti finish on their own
		task.delay(1.6, function()
			folder:Destroy()
		end)
	end

	local function doBurst(chestCF: CFrame, top: CFrame)
		burstDone = true
		play("Reveal", 1)
		-- hard white flash: 2 frames, then off
		flash.BackgroundTransparency = 0
		task.delay(1 / 30, function()
			flash.BackgroundTransparency = 1
		end)
		-- colour swap to the rarity hue + a tinted held whiteout for Legendary+
		if tier >= 5 then
			grade.Brightness = 0.45
			grade.TintColor = finalColor:Lerp(WHITE, 0.55)
			TweenService:Create(grade, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Brightness = 0.05, TintColor = WHITE, Saturation = 0.15 }):Play()
		else
			grade.Brightness = 0.12
			TweenService:Create(grade, TweenInfo.new(0.4), { Brightness = 0, Saturation = 0.1 }):Play()
		end
		-- FOV punch on the player's own camera
		cam.FieldOfView = camFov + 9
		TweenService:Create(cam, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { FieldOfView = camFov - 2 }):Play()
		light.Color = finalColor
		light.Brightness = 6
		TweenService:Create(light, TweenInfo.new(1.2), { Brightness = 0.8 }):Play()
		local seq = ColorSequence.new({ ColorSequenceKeypoint.new(0, WHITE), ColorSequenceKeypoint.new(0.25, finalColor), ColorSequenceKeypoint.new(1, finalColor) })
		do
			-- our burst layers
			trauma = math.min(1, 0.45 + 0.09 * tier)
			sparks.Color = seq
			stars.Color = seq
			puff.Color = ColorSequence.new(finalColor:Lerp(WHITE, 0.35), finalColor)
			sparks:Emit(30 + tier * 14)
			stars:Emit(6 + tier * 4)
			puff:Emit(2 + math.floor(tier / 2))
			shockE.Color = cs(finalColor:Lerp(WHITE, 0.25))
			shockE.Size = NumberSequence.new(S * (2 + 0.25 * tier))
			shockE:Emit(1)
			flareE.Color = cs(WHITE)
			flareE.Size = ns(0, S * (1.4 + 0.15 * tier), 1, 0)
			flareE:Emit(1)
			lensE.Color = cs(finalColor:Lerp(WHITE, 0.5))
			lensE:Emit(1)
			embers.Color = cs(finalColor:Lerp(WHITE, 0.4))
			embers.Rate = 6 + tier * 3
			embers.Enabled = true
			-- anime focus lines over the screen for Rare+
			if tier >= 3 then
				local p = cam:WorldToViewportPoint(top.Position)
				lines.Position = UDim2.fromOffset(p.X, p.Y)
				lines.ImageColor3 = finalColor:Lerp(WHITE, 0.4)
				lines.ImageTransparency = 0.05
				lines.Rotation = math.random(0, 360)
				TweenService:Create(lines, TweenInfo.new(0.7, Enum.EasingStyle.Quad), { ImageTransparency = 1, Rotation = lines.Rotation + 20 }):Play()
			end
			-- confetti: real little paper pieces, Epic and up
			if tier >= 4 then
				for i = 1, 26 + tier * 8 do
					local c = newPart(folder, { Name = "Confetti", Size = Vector3.new(0.28, 0.04, 0.18), Color = CONFETTI[(i % #CONFETTI) + 1] })
					c.CFrame = top * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
					c.Anchored = false
					c.Massless = true
					c.AssemblyLinearVelocity = chestCF.UpVector * math.random(14, 24) + chestCF.RightVector * math.random(-12, 12) + chestCF.LookVector * math.random(-8, 2)
					c.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
				end
			end
		end
		-- the lid blasts off, spinning
		lidFree = chestCF * CFrame.new(0, rig.baseH + 0.2 * S, 0)
		lidVel = chestCF.UpVector * 16 + chestCF.LookVector * -3 + chestCF.RightVector * math.random(-4, 4)
		lidSpin = Vector3.new(math.random(-9, -5), math.random(-4, 4), math.random(-6, 6))
		-- the relic itself
		if def then
			local ok, m = pcall(RelicArt.Build, def, {
				mutations = Materials.LookList(relic),
				mutationDefs = Materials.LookDefs,
				size = relic.size or 1,
				targetSize = 4.2,
				rarityColor = finalColor,
				light = false, -- this close to the camera its light washes the model out
			})
			if ok and m then
				for _, d in m:GetDescendants() do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide = false
						d.CanQuery = false
						-- big Neon bodies bloom to a white blob at this size and distance; keep the
						-- glow on small details only (seen on the Secret Nautilus, Round 6)
						local big = math.max(d.Size.X, d.Size.Y, d.Size.Z)
						if d.Material == Enum.Material.Neon and big > 1.6 then
							d.Material = Enum.Material.SmoothPlastic
						end
					end
				end
				m:ScaleTo(0.05)
				m.Parent = folder
				relicModel = m
			end
		end
		do
			twinkle.Color = cs(finalColor:Lerp(WHITE, 0.55))
			twinkle.Rate = 10 + tier * 3
			twinkle.Enabled = true
		end
		-- big sparkle stars at the screen edges, with the bubble flash
		task.delay(0.1, function()
			if gui.Parent then
				edgeStars(gui, finalColor, 3 + tier)
			end
		end)
	end

	-- the hold: the tease word goes, the name and rarity pop in, and a click ends it
	local function startHold()
		holding = true
		clearWord(gui)
		for _, b in bars do
			TweenService:Create(b, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(1, 0) }):Play()
		end
		holdCard(gui, relic, def, finalColor, tier)
		holdFov = cam.FieldOfView
	end

	local function finish()
		if finished then
			return
		end
		finished = true
		cleanup()
		if opts.onDone then
			opts.onDone()
		end
	end

	-- a tap during the tease skips to the release; once the hold text is up, a click, tap,
	-- gamepad A or Enter ends the show (a short grace stops the skip tap from also closing it)
	inputConn = UserInputService.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		local press = kind == Enum.UserInputType.MouseButton1
			or kind == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.ButtonA
			or input.KeyCode == Enum.KeyCode.Return
		if not press then
			return
		end
		local now = os.clock() - start + skipOffset
		if now < T_SUCK then
			skipOffset += T_SUCK - now
		elseif holding and now > T_HOLD + 0.35 then
			finish()
		end
	end)

	local lastClock = os.clock()
	RunService:BindToRenderStep(MAIN_BIND, Enum.RenderPriority.Camera.Value + 1, function()
		local clock = os.clock()
		local dt = math.min(clock - lastClock, 0.1)
		lastClock = clock
		local now = clock - start + skipOffset
		trauma = math.max(0, trauma - dt * 1.6)
		local tension = math.clamp((now - T_DROP) / math.max(T_SUCK - T_DROP, 0.01), 0, 1)
		-- stay on the camera, exactly (the camera scripts have run; the shake comes after)
		stage = stageTarget()
		local camPos = cam.CFrame.Position
		local inWay = diverInTheWay()
		if inWay or diverHidden then
			hideDiver(inWay)
			diverHidden = inWay
		end
		if burstDone and not holding and now >= T_HOLD then
			startHold()
		end

		-- tease steps
		for _, st in steps do
			if not st.done and now >= st.t then
				st.done = true
				local last = st.rarity == relic.rarity
				seamColor = rarityColor(st.rarity)
				lastHop = now
				popWord(gui, string.upper(st.rarity) .. (if last and tier >= 3 then "!!" elseif tier > 1 then "..." else ""), seamColor, last, true)
				play("Coins", 0.8 + 0.12 * tierOf(st.rarity))
				light.Color = seamColor
				do
					leak.Color = ColorSequence.new(WHITE, seamColor)
					leak:Emit(6)
					ringE.Color = cs(seamColor:Lerp(WHITE, 0.3))
					ringE:Emit(1)
					flareE.Color = cs(seamColor:Lerp(WHITE, 0.5))
					flareE.Size = ns(0, 0.9 + 0.15 * tierOf(st.rarity), 1, 0)
					flareE:Emit(1)
					trauma = math.max(trauma, 0.12 + 0.03 * tierOf(st.rarity))
				end
			end
		end

		-- the chest's motion: drop, hops, shake, suck-in
		local dropY = 0
		if now < T_DROP then
			local a = now / T_DROP
			dropY = (1 - a * a) * 5
		elseif not landed then
			landed = true
			dust:Emit(8)
			trauma = math.max(trauma, 0.25)
		end
		local hop = 0.32 * math.exp(-(now - lastHop) * 11) * math.sin(math.min((now - lastHop) * 14, math.pi))
		local amp = (0.03 + 0.16 * tension * tension) * (if now < T_SUCK then 1 else 0)
		local shake = CFrame.new(math.noise(now * 30, 1) * amp, 0, math.noise(now * 30, 2) * amp)
			* CFrame.Angles(math.noise(now * 25, 3) * amp * 0.4, 0, math.noise(now * 25, 4) * amp * 0.6)
		local sx, sy = 1, 1
		if now < T_DROP + 0.12 and now >= T_DROP then
			local a = (now - T_DROP) / 0.12
			sy = 1 - 0.18 * math.sin(a * math.pi)
			sx = 1 + 0.08 * math.sin(a * math.pi)
		end
		if now >= T_SUCK and now < T_BURST then
			local a = (now - T_SUCK) / (T_BURST - T_SUCK)
			sy = 1 - 0.2 * a * a
			sx = 1 + 0.09 * a * a
			grade.Brightness = -0.1 - 0.4 * a -- the dark beat
		end
		-- after the release the chest shrinks away and the relic takes its place
		local gone = 0
		if burstDone then
			local a = math.clamp((now - T_BURST) / 0.22, 0, 1)
			gone = a * a
			sx *= 1 - 0.95 * gone
			sy *= 1 - 0.95 * gone
		end
		local chestCF = stage * CFrame.new(0, dropY + hop, 0) * shake
		local top = chestCF * CFrame.new(0, rig.baseH, 0)
		local center = (stage * CFrame.new(0, MID, 0)).Position

		-- the lid: rattles open a crack with tension, then flies free after the burst
		local lidAngle = math.rad(4 + 10 * tension * tension) * (0.5 + 0.5 * math.abs(math.sin(now * 28)))
		if lidFree then
			lidVel += Vector3.new(0, -38, 0) * dt
			lidFree = (CFrame.new(lidVel * dt) * lidFree) * CFrame.Angles(lidSpin.X * dt, lidSpin.Y * dt, lidSpin.Z * dt)
		end
		placeChest(rig, chestCF, sx, if burstDone then sx else sy, lidAngle, lidFree)
		if gone >= 1 and rig.base[1].part.Transparency < 1 then
			for _, e in rig.base do
				e.part.Transparency = 1
			end
		end
		if burstDone and now - T_BURST > 1.1 and rig.lid[1].part.Transparency < 1 then
			for _, e in rig.lid do
				e.part.Transparency = 1
			end
		end

		-- blur focus stays on the chest, then on the relic
		dof.FocusDistance = (camPos - (if burstDone then center else top.Position)).Magnitude

		-- the seam glow and light
		rig.seam.Color = seamColor
		rig.seam.Transparency = if burstDone then 1 else math.clamp(0.7 - 0.6 * tension - 0.3 * math.exp(-(now - lastHop) * 8), 0, 1)
		if not burstDone then
			light.Color = seamColor
			light.Brightness = 0.6 + 3 * tension
		end
		core.CFrame = top

		-- the magic circle (Rare+): fades in with the tension, spins faster, flares at the burst
		if useSigil then
			sigilSpin += dt * (0.6 + 3 * tension + (if burstDone then 2 else 0))
			local grow = if burstDone then 1 + math.min((now - T_BURST) / 0.4, 1) * 0.5 else 1
			sigil.Size = Vector3.new(S * 2.6 * grow, 0.05, S * 2.6 * grow)
			sigil.CFrame = stage * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, sigilSpin, 0)
			sigilImage.ImageColor3 = if burstDone then finalColor else seamColor
			-- it stays on as the reveal's glowing pad (it fades back to a steady glow)
			sigilImage.ImageTransparency = if burstDone
				then math.clamp(0.1 + (now - T_BURST) / 0.6, 0.1, 0.4)
				else math.clamp(1 - tension * 0.85, 0.15, 1)
		end

		-- suck-in: the charge-in flipbook
		if not charged and now >= T_SUCK - 0.2 then
			charged = true
			chargeE.Color = cs(finalColor:Lerp(WHITE, 0.35))
			chargeE:Emit(1)
		end

		-- light leaks: motes and short rays through the seam
		leak.Rate = if burstDone then 0 else 3 + 26 * tension
		leak.Enabled = leak.Rate > 0
		local shown = math.floor(1 + tension * #leaks)
		for i, p in leaks do
			if not burstDone and i <= shown and now > T_DROP then
				local x = (i - (#leaks + 1) / 2) / #leaks * S * 0.9
				local len = 0.6 + 2.2 * tension * (0.7 + 0.3 * math.sin(now * 9 + i))
				p.Size = Vector3.new(0.1 + 0.08 * tension, len, 0.1)
				p.CFrame = top * CFrame.new(x, len / 2, -0.1) * CFrame.Angles(0, 0, -x * 0.25)
				p.Color = seamColor
				p.Transparency = 0.25 + 0.4 * (1 - tension)
			else
				p.Transparency = 1
			end
		end

		-- release
		if now >= T_BURST and not burstDone then
			doBurst(chestCF, top)
		end
		if burstDone then
			local since = now - T_BURST
			local face = CFrame.lookAt(center, camPos) -- -Z towards the camera, +Z behind
			local away = face.LookVector * -1

			-- the god-ray backdrop: rays grow fast, then turn slowly and breathe for the whole hold
			local grow = math.min(since / 0.3, 1)
			for i, p in rays do
				local a = i / #rays * math.pi * 2 + since * 0.35
				local len = S * (1.4 + 1.9 * grow) * (0.7 + 0.3 * math.sin(i * 1.7))
				-- capped and fainter at the top tiers: glowing relics (Neon bodies, auras) must still read
				p.Size = Vector3.new(math.min(0.16 + 0.02 * tier, 0.24), len, 0.05)
				p.CFrame = face * CFrame.new(0, 0, 3) * CFrame.Angles(0, 0, a) * CFrame.new(0, len / 2 + 1.2, 0)
				p.Transparency = (if since < 0.3 then 0.45 else 0.68 + 0.12 * math.sin(now * 2.2 + i)) + (if tier >= 6 then 0.1 else 0)
			end
			-- its glow card, behind the rays
			local bk = S * (2.2 + 1.4 * grow) * (1 + 0.04 * math.sin(now * 2))
			backdrop.Size = Vector3.new(bk, bk, 0.05)
			backdrop.CFrame = CFrame.lookAt(center + away * 3.3, camPos) * CFrame.Angles(0, 0, since * 0.25)
			backImage.ImageTransparency = if since < 0.3 then 0.2 else 0.5 + 0.08 * math.sin(now * 2)

			-- the bubble flash: a rarity shell that swells round the relic and fades, a soft core
			local b = math.clamp((since - 0.05) / 0.75, 0, 1)
			local bEase = 1 - (1 - b) ^ 3
			bubble.Size = Vector3.one * S * (0.6 + 1.9 * bEase)
			bubble.CFrame = CFrame.new(center)
			bubble.Transparency = if since < 0.05 then 1 else math.clamp(0.05 + 0.95 * b ^ 1.5, 0, 1)
			local c = math.clamp((since - 0.05) / 0.35, 0, 1)
			bubbleCore.Size = Vector3.one * S * (0.4 + 1.1 * c)
			bubbleCore.CFrame = CFrame.new(center)
			bubbleCore.Transparency = if since < 0.05 then 1 else math.clamp(0.25 + 0.75 * c, 0, 1)

			-- the relic pops out where the chest was: a Back-eased scale, a fast spin that settles
			-- to a slow turn, and a gentle bob; upright on screen
			local p = math.clamp((since - 0.04) / 0.35, 0, 1)
			if relicModel then
				if p < 1 then
					local s = 1.70158
					local q = p - 1
					local k = 1 + (s + 1) * q * q * q + s * q * q -- Back out
					relicModel:ScaleTo(math.max(0.05, k))
				elseif relicModel:GetScale() ~= 1 then
					relicModel:ScaleTo(1)
				end
			end
			local spin = since * 0.8 + 5 * (1 - math.exp(-since * 3))
			local bob = 0.15 * math.sin(since * 2.2) * math.min(since / 0.6, 1)
			local relicCF = CFrame.new(center + cam.CFrame.UpVector * bob) * cam.CFrame.Rotation * CFrame.Angles(0, spin, 0)
			relicAnchor.CFrame = relicCF
			if relicModel then
				relicModel:PivotTo(relicCF)
			end

			-- the hold: a slow push-in on the player's own FOV
			if holding then
				cam.FieldOfView = holdFov - math.min((now - T_HOLD) * 1.4, 7)
			end
		end
	end)
end

return RelicOpening
