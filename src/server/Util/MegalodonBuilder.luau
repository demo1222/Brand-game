-- MegalodonBuilder: builds the studded low-poly Megalodon out of Parts.
-- Generated from the artifact "Megalodon · Studded Low-Poly" (Copy Roblox Lua export),
-- wrapped as a module. Rojo syncs this into Studio. Call:
--   require(path.MegalodonBuilder).build(workspace, CFrame.new(0, 30, 0))
-- Not yet verified in Studio; this is the first pass.

local MegalodonBuilder = {}

function MegalodonBuilder.build(parent: Instance, origin: CFrame): Model
local ORIGIN = origin
local model = Instance.new("Model")
model.Name = "Megalodon"
local COLORS = {
	slate_top = Color3.fromRGB(90,102,114),
	cream_belly = Color3.fromRGB(232,222,196),
	rib_band = Color3.fromRGB(42,49,56),
	tooth_white = Color3.fromRGB(247,244,234),
	mouth_interior = Color3.fromRGB(92,34,40),
	eye_black = Color3.fromRGB(10,10,11),
	eye_glint = Color3.fromRGB(255,255,255),
}
local groups = {}
local function grp(n)
	local g = groups[n]
	if not g then g = Instance.new("Model"); g.Name = n; g.Parent = model; groups[n] = g end
	return g
end
local function style(p, col, g)
	p.Name = col; p.Anchored = true; p.Color = COLORS[col]
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = grp(g)
end
local function B(col, g, sx, sy, sz, x, y, z, ...)
	local p = Instance.new("Part")
	p.Size = Vector3.new(math.max(sx, 0.05), math.max(sy, 0.05), math.max(sz, 0.05))
	p.CFrame = ORIGIN * CFrame.new(x, y, z, ...)
	style(p, col, g)
end
local function T(col, g, ax, ay, az, bx, by, bz, cx, cy, cz, th)
	local a, b, c = Vector3.new(ax, ay, az), Vector3.new(bx, by, bz), Vector3.new(cx, cy, cz)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then c, a = a, c
	elseif acd > bcd and acd > abd then a, b = b, a end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 0.01 then return end
	local w1 = Instance.new("WedgePart")
	w1.Size = Vector3.new(th, height, math.max(math.abs(ab:Dot(back)), 0.01))
	w1.CFrame = ORIGIN * CFrame.fromMatrix((a + b) / 2, right, up, back)
	style(w1, col, g)
	local w2 = Instance.new("WedgePart")
	w2.Size = Vector3.new(th, height, math.max(math.abs(ac:Dot(back)), 0.01))
	w2.CFrame = ORIGIN * CFrame.fromMatrix((a + c) / 2, -right, up, -back)
	style(w2, col, g)
end

